<div class="container" style="max-width:1100px">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <div>
      <h1 class="mb-0">{{t 'admin.invitations.h1.team_invitations'}}</h1>
      <p class="text-muted mb-0">{{t 'admin.invitations.p.invite_clients_and_peer_assessors'}}</p>
    </div>
  </div>

  <!-- ══ Tabs ══ -->
  <ul class="nav nav-tabs mt-3" role="tablist">
    <li class="nav-item">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-clients" type="button">
        <i class="bi bi-people me-1"></i>Client Invitations
        {{#if clientInvites.length}}<span class="badge bg-secondary ms-1">{{clientInvites.length}}</span>{{/if}}
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-assessors" type="button">
        <i class="bi bi-shield-lock me-1"></i>Assessor Invitations
        {{#if assessorInvites.length}}<span class="badge bg-secondary ms-1">{{assessorInvites.length}}</span>{{/if}}
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-team" type="button">
        <i class="bi bi-person-check me-1"></i>My Team
        {{#if peerAssessors.length}}<span class="badge bg-primary ms-1">{{peerAssessors.length}}</span>{{/if}}
      </button>
    </li>
  </ul>

  <div class="tab-content mt-3">

    <!-- ══ CLIENT INVITATIONS ══ -->
    <div class="tab-pane fade show active" id="tab-clients">
      <div class="form-section">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number"><i class="bi bi-person-plus"></i></span>
            Invite a Client
          </h3>
        </div>
        <p class="text-muted small">{{t 'admin.invitations.p.the_client_must_register_using'}}</p>
        <form method="POST" action="/admin/invitations/client" class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" name="email" required placeholder="jane.doe@client-org.com">
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'admin.invitations.label.name'}}</label>
            <input type="text" class="form-control" name="name" placeholder="{{t 'admin.invitations.ph.jane_doe'}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'admin.invitations.label.organization'}}</label>
            <input type="text" class="form-control" name="organization" placeholder="{{t 'admin.invitations.ph.client_organization_name'}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">Message <small class="text-muted">{{t 'admin.invitations.small.optional'}}</small></label>
            <input type="text" class="form-control" name="message" placeholder="{{t 'admin.invitations.ph.brief_note_to_include_in'}}">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-2"></i>{{t 'admin.invitations.btn.send_client_invite'}}</button>
          </div>
        </form>
      </div>

      <!-- Existing Client Invitations -->
      <div class="form-section mt-4">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number"><i class="bi bi-list-check"></i></span>
            Sent Invitations
          </h3>
        </div>
        {{#if clientInvites.length}}
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>{{t 'admin.invitations.th.email'}}</th>
                <th>{{t 'admin.invitations.th.name'}}</th>
                <th>{{t 'admin.invitations.th.code'}}</th>
                <th>{{t 'admin.invitations.th.status'}}</th>
                <th>{{t 'admin.invitations.th.sent'}}</th>
                <th>{{t 'admin.invitations.th.expires'}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each clientInvites}}
              <tr>
                <td><code>{{this.email}}</code></td>
                <td>{{this.name}}</td>
                <td><code class="fw-bold">{{this.invite_code}}</code></td>
                <td>
                  {{#eq this.status "pending"}}<span class="badge bg-warning text-dark">{{t 'admin.invitations.span.pending'}}</span>{{/eq}}
                  {{#eq this.status "accepted"}}<span class="badge bg-success">{{t 'admin.invitations.span.accepted'}}</span>{{/eq}}
                  {{#eq this.status "revoked"}}<span class="badge bg-danger">{{t 'admin.invitations.span.revoked'}}</span>{{/eq}}
                </td>
                <td><small>{{this.created_at}}</small></td>
                <td><small>{{this.expires_at}}</small></td>
                <td>
                  {{#eq this.status "pending"}}
                  <div class="btn-group btn-group-sm">
                    <form method="POST" action="/admin/invitations/{{this.id}}/resend" class="d-inline">
                      <button type="submit" class="btn btn-outline-primary btn-sm" title="{{t 'admin.invitations.tattr.resend'}}"><i class="bi bi-arrow-repeat"></i></button>
                    </form>
                    <form method="POST" action="/admin/invitations/{{this.id}}/revoke" class="d-inline" onsubmit="return confirm('Revoke this invitation?')">
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="{{t 'admin.invitations.tattr.revoke'}}"><i class="bi bi-x-lg"></i></button>
                    </form>
                  </div>
                  {{/eq}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <p class="text-muted text-center py-3"><i class="bi bi-inbox me-2"></i>No client invitations sent yet.</p>
        {{/if}}
      </div>
    </div>

    <!-- ══ ASSESSOR INVITATIONS ══ -->
    <div class="tab-pane fade" id="tab-assessors">
      <div class="form-section">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number"><i class="bi bi-shield-plus"></i></span>
            Invite a Peer Assessor
          </h3>
        </div>
        <div class="alert alert-info small mb-3">
          <i class="bi bi-info-circle me-1"></i>
          <strong>{{t 'admin.invitations.strong.peer_assessors'}}</strong> can view and work on assessments you assign to them. Only you (as the originating assessor) can create, delete, or reassign records. You can revoke their access at any time.
        </div>
        <form method="POST" action="/admin/invitations/assessor" class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" name="email" required placeholder="colleague@agency.gc.ca">
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'admin.invitations.label.name'}}</label>
            <input type="text" class="form-control" name="name" placeholder="{{t 'admin.invitations.ph.john_smith'}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'admin.invitations.label.organization'}}</label>
            <input type="text" class="form-control" name="organization" placeholder="{{t 'admin.invitations.ph.organization'}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">Message <small class="text-muted">{{t 'admin.invitations.small.optional'}}</small></label>
            <input type="text" class="form-control" name="message" placeholder="{{t 'admin.invitations.ph.brief_note_about_the_collaboration'}}">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-dark"><i class="bi bi-shield-plus me-2"></i>{{t 'admin.invitations.btn.send_assessor_invite'}}</button>
          </div>
        </form>
      </div>

      <!-- Existing Assessor Invitations -->
      <div class="form-section mt-4">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number"><i class="bi bi-list-check"></i></span>
            Sent Assessor Invitations
          </h3>
        </div>
        {{#if assessorInvites.length}}
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>{{t 'admin.invitations.th.email'}}</th>
                <th>{{t 'admin.invitations.th.name'}}</th>
                <th>{{t 'admin.invitations.th.code'}}</th>
                <th>{{t 'admin.invitations.th.status'}}</th>
                <th>{{t 'admin.invitations.th.sent'}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each assessorInvites}}
              <tr>
                <td><code>{{this.email}}</code></td>
                <td>{{this.name}} {{#if this.accepted_name}}<span class="badge bg-success">→ {{this.accepted_name}}</span>{{/if}}</td>
                <td><code class="fw-bold">{{this.invite_code}}</code></td>
                <td>
                  {{#eq this.status "pending"}}<span class="badge bg-warning text-dark">{{t 'admin.invitations.span.pending'}}</span>{{/eq}}
                  {{#eq this.status "accepted"}}<span class="badge bg-success">{{t 'admin.invitations.span.accepted'}}</span>{{/eq}}
                  {{#eq this.status "revoked"}}<span class="badge bg-danger">{{t 'admin.invitations.span.revoked'}}</span>{{/eq}}
                </td>
                <td><small>{{this.created_at}}</small></td>
                <td>
                  {{#eq this.status "pending"}}
                  <div class="btn-group btn-group-sm">
                    <form method="POST" action="/admin/invitations/{{this.id}}/resend" class="d-inline">
                      <button type="submit" class="btn btn-outline-primary btn-sm" title="{{t 'admin.invitations.tattr.resend'}}"><i class="bi bi-arrow-repeat"></i></button>
                    </form>
                    <form method="POST" action="/admin/invitations/{{this.id}}/revoke" class="d-inline" onsubmit="return confirm('Revoke this invitation?')">
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="{{t 'admin.invitations.tattr.revoke'}}"><i class="bi bi-x-lg"></i></button>
                    </form>
                  </div>
                  {{/eq}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <p class="text-muted text-center py-3"><i class="bi bi-shield me-2"></i>No assessor invitations sent yet.</p>
        {{/if}}
      </div>
    </div>

    <!-- ══ MY TEAM ══ -->
    <div class="tab-pane fade" id="tab-team">
      <div class="form-section">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number"><i class="bi bi-people"></i></span>
            Active Peer Assessors
          </h3>
        </div>
        <p class="text-muted small">{{t 'admin.invitations.p.these_assessors_have_accepted_your'}}</p>
        {{#if peerAssessors.length}}
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>{{t 'admin.invitations.th.organization'}}</th>
                <th>{{t 'admin.invitations.th.joined'}}</th>
                <th>{{t 'admin.invitations.th.last_login'}}</th>
              </tr>
            </thead>
            <tbody>
              {{#each peerAssessors}}
              <tr>
                <td><i class="bi bi-shield-check text-primary me-1"></i>{{this.name}}</td>
                <td><code>{{this.email}}</code></td>
                <td>{{this.organization}}</td>
                <td><small>{{this.accepted_at}}</small></td>
                <td><small>{{this.last_login}}</small></td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="text-center py-4">
          <i class="bi bi-people" style="font-size:2.5rem;color:#ccc;"></i>
          <p class="text-muted mt-2">{{t 'admin.invitations.p.no_peer_assessors_yet_invite'}}</p>
        </div>
        {{/if}}
      </div>
    </div>

  </div>
</div>
