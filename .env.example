PORT=3000
NODE_ENV=development
# APP_ENV selects a per-environment file: local -> .env.local, dev -> .env.dev,
# qa -> .env.qa, (unset) -> .env (production/default). Example: APP_ENV=local npm run dev
APP_ENV=
SESSION_SECRET=replace-with-a-long-random-secret

ADMIN_EMAIL=admin@youragency.gc.ca
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Security Assessor

DATA_DIR=./data
DB_PATH=./data/sa-tool.db

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GC SA Tool <sa-tool@example.gc.ca>"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Passkeys / WebAuthn (FIDO2). Must match the domain the app is served on.
# Local: leave unset (defaults to localhost). Hosted: set to your app host.
#   WEBAUTHN_RP_ID=vanguard-saa-dev.azurewebsites.net
#   WEBAUTHN_ORIGIN=https://vanguard-saa-dev.azurewebsites.net
#
# Custom domain: set RP_ID to the registrable domain (no scheme, no port) — a
# passkey scoped to "aegis-sa.io" also works on any subdomain of it:
#   WEBAUTHN_RP_ID=aegis-sa.io
#   WEBAUTHN_ORIGIN=https://aegis-sa.io
# WEBAUTHN_ORIGIN accepts a comma-separated list, so during a domain cutover you
# can accept both hosts until the old one is retired:
#   WEBAUTHN_ORIGIN=https://aegis-sa.io,https://vanguard-saa-prod.azurewebsites.net
# NOTE: passkeys already enrolled under a different RP_ID cannot be used on the
# new domain — they are cryptographically bound to the old one and must be
# re-enrolled. TOTP keeps working as the fallback.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Set to true once the app is served exclusively over HTTPS so the session
# cookie is marked Secure. Leave unset/false while any plain-HTTP origin is used.
SECURE_COOKIES=

MAX_FILE_SIZE_MB=25

# ---------------------------------------------------------------------------
# Billing (Stripe) — hosted Checkout
# ---------------------------------------------------------------------------
# TEST-mode key (sk_test_...) for local/dev/qa; LIVE key (sk_live_...) for prod
# when you go live. Card checkout stays OFF until this is set.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of this environment's webhook endpoint
# (POST /billing/webhook). Localhost gets it from `stripe listen`; each hosted
# env has its own endpoint + secret. Required whenever STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=
# Not used: hosted Checkout needs no client-side key.
STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (Dashboard -> Products) for the paid tiers.
# Basic is the current per-user tier: create a RECURRING price of $49.99 / unit / month
# (billed per seat) and put its price_id here.
STRIPE_PRICE_BASIC=
# Legacy tiers (kept so existing subscriptions keep resolving; not offered to new sign-ups).
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PAYG_USER=
STRIPE_PRICE_PAYG_PROJECT=

# Multi-factor auth. Off by default; set MFA_ENABLED=true to require TOTP/passkey.
MFA_ENABLED=false
