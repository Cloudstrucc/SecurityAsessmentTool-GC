<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}}{{else}}Vanguard Cloud Services SA&amp;A Platform{{/if}}</title>
  <meta name="description" content="Vanguard Cloud Services security assessment and authorization platform for multi-framework compliance, self-assessment, intake, evidence, ATO/iATO, and POA&M workflows.">
  <meta name="dcterms.title" content="Vanguard Cloud Services SA&A Platform">
  <meta name="dcterms.creator" content="Vanguard Cloud Services Inc.">
  <meta name="theme-color" content="#1a2e42">

  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Vanguard design system (shared visual language) -->
  <link href="/css/vanguard-design.css" rel="stylesheet">

  <style>
    :root {
      /* Aligned to the Vanguard product-brief palette (navy-950 + sky gradient) */
      --cs-nav:#0a1626;
      --cs-blue:#143453;
      --cs-brand:#4d9fe0;
      --cs-green:#2fa06d;
      --cs-gold:#f0c36d;
      --cs-light:#f4f9fd;
      --cs-text:#17273a;
      --cs-muted:#5f7185;
      --cs-border:#dce7f2;
      --cs-grad:linear-gradient(90deg,#6d7fca 0%,#4d9fe0 50%,#7cc9ee 100%);
    }
    * { box-sizing:border-box; }
    body {
      margin:0;
      background:var(--cs-light);
      color:var(--cs-text);
      font-family:'Noto Sans',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
      line-height:1.6;
    }
    a:focus, button:focus, input:focus {
      outline:3px solid var(--cs-gold);
      outline-offset:2px;
    }
    .alert {
      border:none;
      border-radius:6px;
      box-shadow:0 4px 16px rgba(15,23,42,.1);
    }
  </style>
  {{#if extraStyles}}{{{extraStyles}}}{{/if}}
</head>
<body>
  {{#if messages.error}}
    <div class="container mt-3">
      <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>{{messages.error}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  {{/if}}
  {{#if messages.success}}
    <div class="container mt-3">
      <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <i class="bi bi-check-circle me-1"></i>{{messages.success}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  {{/if}}
  {{#if messages.info}}
    <div class="container mt-3">
      <div class="alert alert-info alert-dismissible fade show py-2 small" role="alert">
        <i class="bi bi-info-circle me-1"></i>{{messages.info}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  {{/if}}

  {{{body}}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  {{#if extraScripts}}{{{extraScripts}}}{{/if}}
</body>
</html>
