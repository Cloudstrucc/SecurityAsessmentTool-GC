<style>
.portal-hero {
  background:linear-gradient(135deg,#1a2e42 0%,#2d4a6a 52%,#3a5a7c 100%);
  padding:0 0 4rem;
  position:relative;
  overflow:hidden;
  border-bottom:3px solid #0ea5e9;
}
.portal-brand {
  padding:.85rem 0;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.portal-brand a {
  color:#fff;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  font-weight:800;
}
.portal-brand img { height:30px; width:auto; }
.portal-inner { padding-top:3rem; }
.portal-card {
  background:#fff;
  border-radius:8px;
  box-shadow:0 8px 24px rgba(15,23,42,.14);
  border:none;
  overflow:hidden;
  height:100%;
}
.portal-card .card-header {
  font-weight:700;
  font-size:.92rem;
  padding:.9rem 1.25rem;
  background:#284162;
  color:#fff;
  border:0;
}
.portal-card .card-body { padding:1.5rem; }
.btn-primary {
  background:#2563eb;
  border-color:#2563eb;
  font-weight:700;
}
.btn-primary:hover { background:#1e40af; border-color:#1e40af; }
.btn-dark {
  background:#1a2e42;
  border-color:#1a2e42;
  font-weight:700;
}
.portal-wrap {
  margin-top:-2.5rem;
  position:relative;
  z-index:2;
}
</style>

<div class="portal-hero">
  <div class="portal-brand">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/">
        <img src="/images/logo-large@2xVCS.png" alt="VCS">
        <span>Vanguard Cloud Services <span style="opacity:.45;font-weight:400;">|</span> SA&amp;A Platform</span>
      </a>
      <a href="/" class="text-white small text-decoration-none" style="opacity:.78;"><i class="bi bi-arrow-left me-1"></i>Back to landing page</a>
    </div>
  </div>
  <div class="container portal-inner">
    <div class="text-center">
      <i class="bi bi-shield-lock-fill" style="font-size:3rem;color:rgba(255,255,255,.82)"></i>
      <h1 class="text-white mt-2 mb-2">Client and Assessor Portal</h1>
      <p style="color:rgba(255,255,255,.68);max-width:560px;margin:0 auto;">Sign in, enter an assessment access code, or open the assessor workspace.</p>
    </div>
  </div>
</div>

<div class="container portal-wrap">
  <div class="row justify-content-center g-4">
    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header"><i class="bi bi-clipboard2-data me-2"></i>Submit an Intake</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">Starting a new project? Sign in to submit an intake with project details, documents, operating regions, and framework preferences.</p>
          <p class="small text-muted mb-3"><i class="bi bi-shield-lock me-1"></i>Account with MFA required.</p>
          <div class="mt-auto">
            {{#if user}}
              <a href="/intake" class="btn btn-primary w-100 py-2"><i class="bi bi-clipboard-plus me-2"></i>Start Intake</a>
            {{else}}
              <a href="/client/login" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>Client Sign In</a>
              <a href="/client/register" class="btn btn-outline-primary w-100 py-2 mt-2"><i class="bi bi-person-plus me-2"></i>Register with Invite</a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header"><i class="bi bi-key me-2"></i>Enter Access Code</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">Received an assessment invitation from a security practitioner? Enter the code to provide evidence or remediation updates.</p>
          <form action="/respond/access" method="POST" class="mt-auto">
            <div class="mb-3">
              <label for="code" class="form-label">Access Code</label>
              <input type="text" class="form-control form-control-lg text-center text-uppercase" id="code" name="code" placeholder="A1B2C3D4" maxlength="10" required style="letter-spacing:3px;font-weight:700;font-family:'Courier New',monospace">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>Access Assessment</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header" style="background:#f8fafc;color:#26374a;"><i class="bi bi-person-badge me-2"></i>Security Practitioner</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">Assessors can manage projects, review intakes and self-assessments, create assessments, tailor controls, and generate reports.</p>
          <div class="mt-auto">
            <a href="/admin/login" class="btn btn-dark w-100 py-2"><i class="bi bi-shield-check me-2"></i>Assessor Login</a>
            <a href="/admin/register" class="btn btn-outline-secondary w-100 py-2 mt-2"><i class="bi bi-person-plus me-2"></i>Register with Invite Code</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center mt-4 mb-5">
    <a href="/self-assessment" class="btn btn-outline-primary">
      <i class="bi bi-clipboard2-pulse me-1"></i>Start Security Self-Assessment
    </a>
  </div>
</div>
