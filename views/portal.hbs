<style>
.portal-hero {
  background:linear-gradient(135deg,#1a2e42 0%,#2d4a6a 52%,#3a5a7c 100%);
  padding:0 0 4rem;
  position:relative;
  overflow:hidden;
  border-bottom:3px solid #0ea5e9;
}
.portal-brand {
  padding:.85rem 0;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.portal-brand a {
  color:#fff;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  font-weight:800;
}
.portal-brand img { height:30px; width:auto; }
.portal-inner { padding-top:3rem; }
.portal-card {
  background:#fff;
  border-radius:8px;
  box-shadow:0 8px 24px rgba(15,23,42,.14);
  border:none;
  overflow:hidden;
  height:100%;
}
.portal-card .card-header {
  font-weight:700;
  font-size:.92rem;
  padding:.9rem 1.25rem;
  background:#284162;
  color:#fff;
  border:0;
}
.portal-card .card-body { padding:1.5rem; }
.btn-primary {
  background:#2563eb;
  border-color:#2563eb;
  font-weight:700;
}
.btn-primary:hover { background:#1e40af; border-color:#1e40af; }
.btn-dark {
  background:#1a2e42;
  border-color:#1a2e42;
  font-weight:700;
}
.portal-wrap {
  margin-top:-2.5rem;
  position:relative;
  z-index:2;
}
</style>

<div class="portal-hero">
  <div class="portal-brand">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/">
        <img src="/images/logo-large@2xVCS.png" alt="VCS">
        <span>{{t 'brand.company'}} <span style="opacity:.45;font-weight:400;">|</span> {{t 'brand.product'}}</span>
      </a>
      <div class="d-flex align-items-center gap-2">
        <div class="dropdown">
          <a href="#" class="text-white small text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="opacity:.78;border:1px solid rgba(255,255,255,.25);border-radius:6px;padding:.25rem .7rem;">
            <i class="bi bi-globe2 me-1"></i>{{#each supportedLangs}}{{#if this.active}}{{this.short}}{{/if}}{{/each}}
          </a>
          <ul class="dropdown-menu dropdown-menu-end" style="min-width:150px;font-size:.86rem;">
            {{#each supportedLangs}}
              <li><a class="dropdown-item {{#if this.active}}active{{/if}}" href="{{this.url}}">{{this.short}} — {{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <a href="/" class="text-white small text-decoration-none" style="opacity:.78;"><i class="bi bi-arrow-left me-1"></i>{{t 'nav.backHome'}}</a>
      </div>
    </div>
  </div>
  <div class="container portal-inner">
    <div class="text-center">
      <i class="bi bi-shield-lock-fill" style="font-size:3rem;color:rgba(255,255,255,.82)"></i>
      <h1 class="text-white mt-2 mb-2">{{t 'portal.title'}}</h1>
      <p style="color:rgba(255,255,255,.68);max-width:560px;margin:0 auto;">{{t 'portal.subtitle'}}</p>
    </div>
  </div>
</div>

<div class="container portal-wrap">
  <div class="row justify-content-center g-4">
    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header"><i class="bi bi-clipboard2-data me-2"></i>{{t 'portal.submitIntake'}}</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">{{t 'portal.submitIntakeD'}}</p>
          <p class="small text-muted mb-3"><i class="bi bi-shield-lock me-1"></i>{{t 'portal.mfaReq'}}</p>
          <div class="mt-auto">
            {{#if user}}
              <a href="/intake" class="btn btn-primary w-100 py-2"><i class="bi bi-clipboard-plus me-2"></i>{{t 'nav.startIntake'}}</a>
            {{else}}
              <a href="/client/login" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>{{t 'nav.signIn'}}</a>
              <a href="/client/register" class="btn btn-outline-primary w-100 py-2 mt-2"><i class="bi bi-person-plus me-2"></i>{{t 'nav.register'}}</a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header"><i class="bi bi-key me-2"></i>{{t 'portal.enterCode'}}</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">{{t 'portal.enterCodeD'}}</p>
          <form action="/redeem" method="POST" class="mt-auto">
            <div class="mb-3">
              <label for="code" class="form-label">{{t 'portal.accessCode'}}</label>
              <input type="text" class="form-control form-control-lg text-center text-uppercase" id="code" name="code" placeholder="{{t 'portal.ph.a1b2c3d4'}}" maxlength="16" required style="letter-spacing:3px;font-weight:700;font-family:'Courier New',monospace">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>{{t 'portal.accessBtn'}}</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="portal-card card">
        <div class="card-header" style="background:#f8fafc;color:#26374a;"><i class="bi bi-person-badge me-2"></i>{{t 'portal.practitioner'}}</div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted mb-3">{{t 'portal.practitionerD'}}</p>
          <div class="mt-auto">
            <a href="/admin/login" class="btn btn-dark w-100 py-2"><i class="bi bi-shield-check me-2"></i>{{t 'nav.assessorLogin'}}</a>
            <a href="/admin/register" class="btn btn-outline-secondary w-100 py-2 mt-2"><i class="bi bi-person-plus me-2"></i>{{t 'nav.registerInvite'}}</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center mt-4 mb-5">
    <a href="/self-assessment" class="btn btn-outline-primary">
      <i class="bi bi-clipboard2-pulse me-1"></i>{{t 'saCard.startBtn'}}
    </a>
  </div>
</div>
