<div class="vg">
<nav class="vg-nav">
  <div class="vg-container vg-nav-inner">
    <a href="{{homeHref}}" class="vg-brand">
      <span class="vg-brand-name">Vanguard Cloud Services</span>
      <span class="vg-brand-sep">|</span>
      <span class="vg-brand-product">Aegis SA</span>
    </a>
    <div class="vg-nav-links">
      <a href="/sa-tool-overview" class="vg-nav-link hide-sm">{{t 'navbar.productBrief'}}</a>
      <a href="/pricing" class="vg-nav-link hide-sm">{{t 'navbar.pricing'}}</a>
      <a href="/admin/login" class="vg-nav-link">{{t 'navbar.signIn'}}</a>
      <a href="/register?plan=trial" class="vg-btn vg-btn-primary vg-btn-sm">{{t 'navbar.startTrial'}}</a>
      {{> vg-langswitch}}
    </div>
  </div>
</nav>

<section class="vg-hero">
  <div class="vg-container-narrow">
    <span class="vg-badge vg-badge-dark" style="margin-bottom:18px">{{t 'pl.heroBadge'}}</span>
    <h1>{{t 'pl.heroH1a'}} <span class="vg-gradient-text">{{t 'pl.heroH1b'}}</span></h1>
    <p>{{t 'pl.heroSub'}}</p>
  </div>
</section>

<section class="vg-section" style="padding-top:44px">
  <div class="vg-container">
    {{#unless stripeReady}}
      <div class="vg-callout warn" style="margin-bottom:24px"><b>{{t 'pl.testModeB'}}</b> {{t 'pl.testModeT'}}</div>
    {{/unless}}

    <div class="vg-price-grid vg-price-grid-3">
      <div class="vg-plan">
        <div class="vg-plan-name">{{t 'pl.trial'}}</div>
        <div class="vg-plan-price">{{t 'pl.free'}}</div>
        <div class="vg-plan-tag">{{t 'pl.trialTag'}}</div>
        <div class="vg-plan-cta"><a href="/register?plan=trial" class="vg-btn vg-btn-ghost vg-btn-block">{{t 'pl.trialCta'}}</a></div>
        <ul class="vg-plan-features">
          <li><span class="vg-plan-highlight">{{t 'pl.trialF1'}}</span></li>
          <li><span class="vg-plan-highlight">{{t 'pl.trialF2'}}</span></li>
          <li>{{t 'pl.allFrameworks'}}</li>
            <li><span class="vg-plan-highlight">{{t 'pl.trialTokens'}}</span></li>
          <li>{{t 'pl.trialF4'}}</li>
          <li class="muted">{{t 'pl.prioritySupport'}}</li>
        </ul>
      </div>

      <div class="vg-plan featured">
        <div class="vg-plan-flag"><span class="vg-badge vg-badge-grad">{{t 'pl.mostPopular'}}</span></div>
        <div class="vg-plan-name">{{t 'pl.basic'}}</div>
        <div class="vg-plan-price">$49.99<span class="per">{{t 'pl.perUser'}}</span></div>
        <div class="vg-plan-tag">{{t 'pl.basicTag'}}</div>
        <div class="vg-plan-cta"><a href="/register?plan=basic" class="vg-btn vg-btn-primary vg-btn-block">{{t 'pl.basicCta'}}</a></div>
        <ul class="vg-plan-features">
          <li><span class="vg-plan-highlight">{{t 'pl.basicF1'}}</span></li>
          <li><span class="vg-plan-highlight">{{t 'pl.basicF2'}}</span></li>
          <li>{{t 'pl.allFrameworks'}}</li>
          <li>{{t 'pl.controlInheritance'}}</li>
            <li><span class="vg-plan-highlight">{{t 'pl.basicF3'}}</span></li>
          <li>{{t 'pl.prioritySupport'}}</li>
        </ul>
      </div>

      <div class="vg-plan">
        <div class="vg-plan-name">{{t 'pl.enterprise'}}</div>
        <div class="vg-plan-price">{{t 'pl.custom'}}</div>
        <div class="vg-plan-tag">{{t 'pl.entTag'}}</div>
        <div class="vg-plan-cta"><a href="/register?plan=enterprise" class="vg-btn vg-btn-dark vg-btn-block">{{t 'pl.entCta'}}</a></div>
        <ul class="vg-plan-features">
          <li><span class="vg-plan-highlight">{{t 'pl.entF1'}}</span></li>
          <li><span class="vg-plan-highlight">{{t 'pl.entF2'}}</span></li>
          <li><span class="vg-plan-highlight">{{t 'pl.entTokens'}}</span></li>
            <li>{{t 'pl.entF4'}}</li>
          <li>{{t 'pl.entF5'}}</li>
          <li>{{t 'pl.entF6'}}</li>
        </ul>
      </div>
    </div>

    <div class="vg-callout good" style="margin-top:30px">
      <b>{{t 'pl.compB'}}</b> {{t 'pl.compT'}}
    </div>
    <p class="vg-muted" style="font-size:13px;text-align:center;margin-top:20px">{{t 'pl.placeholderNote'}}</p>
  </div>
</section>

<footer class="vg-footer">
  <div class="vg-container">
    <div class="vg-footer-top">
      <span class="vg-footer-brand">{{t 'pl.footerBrand'}}</span>
      <span><a href="/sa-tool-overview">{{t 'navbar.productBrief'}}</a> &nbsp;·&nbsp; <a href="/pricing">{{t 'navbar.pricing'}}</a> &nbsp;·&nbsp; <a href="/admin/login">{{t 'navbar.signIn'}}</a></span>
    </div>
    <div>{{t 'pl.footerLine'}}</div>
  </div>
</footer>
</div>
