<div class="vg vg-page">
<style>
  /* Registration: completion hero + live % ring (applies to every plan). */
  .vg-reg-hero{display:flex;align-items:center;gap:18px;background:linear-gradient(120deg,var(--vg-navy-900),var(--vg-navy-800));
    border-radius:var(--vg-radius);padding:18px 20px;margin-bottom:20px;position:relative;overflow:hidden}
  .vg-reg-hero::after{content:"";position:absolute;right:-40px;top:50%;transform:translateY(-50%);width:150px;height:150px;
    border-radius:50%;background:radial-gradient(circle,rgba(124,201,238,.22),transparent 70%);pointer-events:none}
  .vg-reg-ring{--p:0;flex:0 0 auto;width:66px;height:66px;border-radius:50%;display:grid;place-items:center;position:relative;
    background:conic-gradient(var(--vg-sky-400) calc(var(--p)*1%),rgba(255,255,255,.16) 0);transition:background .45s ease}
  .vg-reg-ring::before{content:"";position:absolute;inset:7px;border-radius:50%;background:var(--vg-navy-900)}
  .vg-reg-ring span{position:relative;font-size:15px;font-weight:800;color:#fff;font-variant-numeric:tabular-nums}
  .vg-reg-meta{flex:1;min-width:0}
  .vg-reg-eyebrow{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--vg-sky-300);font-weight:700}
  .vg-reg-meta h1{font-size:21px;font-weight:750;color:#fff;margin:3px 0 4px;line-height:1.15}
  .vg-reg-meta p{font-size:13.5px;color:#cdddf0;margin:0}
  .vg-reg-meta p b{color:#fff}
  .vg-reg-bar{height:6px;border-radius:99px;background:rgba(255,255,255,.16);margin-top:11px;overflow:hidden}
  .vg-reg-bar>i{display:block;height:100%;width:0;border-radius:99px;background:var(--vg-grad);transition:width .45s ease}
  /* firm up the account inputs so they read as intentional, matching the app's fields */
  .vg-auth-card .vg-input{border:1.5px solid #cdd8e6;background:var(--vg-paper)}
  .vg-auth-card .vg-input:focus{border-color:var(--vg-sky-500)}
  .vg-reg-done{color:var(--vg-green)!important}
  @media (prefers-reduced-motion:reduce){.vg-reg-ring,.vg-reg-bar>i{transition:none}}
  @media (max-width:560px){.vg-reg-hero{gap:14px;padding:16px}.vg-reg-meta h1{font-size:19px}}

  /* Two-column registration: form (left) + Protected B guidance (right) */
  .vg-reg-2col{width:100%;max-width:960px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,360px);gap:30px;align-items:start}
  .vg-reg-2col > .vg-auth-card{max-width:none;width:100%}
  .vg-reg-aside{position:sticky;top:24px;background:var(--vg-mist);border:1px solid var(--vg-line);border-radius:var(--vg-radius-lg);padding:24px 24px;min-width:0}
  .vg-reg-aside .rs-eyebrow{font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--vg-sky-600)}
  .vg-reg-aside h2{font-size:19px;font-weight:750;color:var(--vg-navy-800);margin:6px 0 10px;line-height:1.2}
  .vg-reg-aside > p{font-size:13.5px;line-height:1.6;color:var(--vg-ink);margin:0 0 6px}
  .vg-reg-aside h3{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--vg-navy-800);margin:18px 0 9px}
  .vg-reg-aside ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
  .vg-reg-aside li{position:relative;padding-left:22px;font-size:12.75px;line-height:1.5;color:var(--vg-ink);overflow-wrap:anywhere}
  .vg-reg-aside li::before{content:"";position:absolute;left:2px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--vg-grad-soft)}
  .vg-reg-aside .rs-note{margin-top:16px;font-size:12.25px;color:var(--vg-ink);background:#fff;border-left:3px solid var(--vg-sky-500);border-radius:8px;padding:11px 13px;line-height:1.55}
  .vg-reg-aside .rs-links{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:14px}
  .vg-reg-aside .rs-links a,.vg-modal-links a{font-size:12.5px;font-weight:600;color:var(--vg-sky-600);text-decoration:none;overflow-wrap:anywhere}
  .vg-reg-aside .rs-links a:hover,.vg-modal-links a:hover{text-decoration:underline}
  @media (max-width:900px){
    .vg-reg-2col{grid-template-columns:1fr;max-width:460px}
    .vg-reg-aside{position:static;order:2}
  }

  /* Protected B (PBMM) attestation modal */
  .vg-modal-back{position:fixed;inset:0;background:rgba(10,22,38,.55);display:none;align-items:center;justify-content:center;z-index:5000;padding:18px}
  .vg-modal-back.open{display:flex}
  .vg-modal{background:#fff;border-radius:var(--vg-radius-lg);max-width:560px;width:100%;box-shadow:var(--vg-shadow-lg);max-height:90vh;display:flex;flex-direction:column;overflow:hidden;border-top:5px solid var(--vg-navy-800)}
  .vg-modal:focus{outline:none}
  .vg-modal-head{display:flex;align-items:flex-start;gap:12px;padding:20px 22px 10px}
  .vg-modal-head .ico{flex:0 0 auto;width:38px;height:38px;border-radius:10px;background:var(--vg-soft);color:var(--vg-navy-800);display:grid;place-items:center;font-size:18px}
  .vg-modal-head h2{font-size:18px;font-weight:750;color:var(--vg-navy-800);margin:0;line-height:1.2}
  .vg-modal-head p{font-size:12.5px;color:var(--vg-muted);margin:3px 0 0}
  .vg-modal-body{padding:8px 22px 4px;overflow:auto}
  .vg-modal-body p{font-size:13px;line-height:1.6;color:var(--vg-ink);margin:0 0 12px}
  .vg-modal-body .consent{background:var(--vg-mist);border-radius:10px;padding:12px 14px;font-size:12.5px;color:var(--vg-ink);margin-bottom:4px}
  .vg-modal-links{display:flex;flex-wrap:wrap;gap:8px 16px;margin:2px 0 14px}
  .vg-modal-foot{padding:14px 22px 20px;border-top:1px solid var(--vg-line);display:flex;flex-direction:column;gap:14px;flex:0 0 auto}
  .vg-modal-foot .chk{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--vg-ink)}
  .vg-modal-foot .chk input{margin-top:3px;flex:0 0 auto}
  .vg-modal-foot .btns{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
  .vg-modal-foot .btns .vg-btn{width:auto}
  .vg-modal-foot .btns .vg-btn[disabled]{opacity:.5;cursor:not-allowed}
  @media (prefers-reduced-motion:no-preference){.vg-modal-back.open .vg-modal{animation:vgPop .22s ease}}
  @keyframes vgPop{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}
</style>
