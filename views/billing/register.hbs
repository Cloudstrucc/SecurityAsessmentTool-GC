<script>
// Protected B (PBMM) attestation gate — shown before an account is created,
// for BOTH the password submit and the passkey sign-up.
window.PBMMAttest = (function(){
  var ok = false, pending = null, lastFocus = null;
  var back = document.getElementById('pbmmBack');
  var modal = back ? back.querySelector('.vg-modal') : null;
  var chk = document.getElementById('pbmmChk');
  var confirmBtn = document.getElementById('pbmmConfirm');
  var cancelBtn = document.getElementById('pbmmCancel');
  var hidden = document.getElementById('pbmmAttested');
  var form = document.querySelector('form[action="/register"]');
  function open(){
    if (!back) return;
    lastFocus = document.activeElement;
    if (chk) chk.checked = false;
    if (confirmBtn) confirmBtn.disabled = true;
    back.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (modal) modal.focus();
  }
  function close(){
    if (!back) return;
    back.classList.remove('open');
    document.body.style.overflow = '';
    pending = null;
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function require(cb){ if (ok){ cb && cb(); return; } pending = cb; open(); }
  if (chk && confirmBtn) chk.addEventListener('change', function(){ confirmBtn.disabled = !chk.checked; });
  if (confirmBtn) confirmBtn.addEventListener('click', function(){
    if (chk && !chk.checked) return;
    ok = true;
    if (hidden) hidden.value = '1';
    var cb = pending; pending = null;
    back.classList.remove('open'); document.body.style.overflow = '';
    if (cb) cb();
  });
  if (cancelBtn) cancelBtn.addEventListener('click', close);
  if (back) back.addEventListener('click', function(e){ if (e.target === back) close(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && back && back.classList.contains('open')) close(); });
  if (form) form.addEventListener('submit', function(e){
    if (ok) return;                 // already attested → let it submit
    e.preventDefault();             // (native required-field validation has already passed)
    require(function(){ if (hidden) hidden.value = '1'; form.submit(); });
  });
  return { ok: function(){ return ok; }, require: require };
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
(function(){
  var btn = document.getElementById('passkeyRegBtn');
  var form = document.querySelector('form[action="/register"]');
  var errEl = document.getElementById('passkeyRegError');
  if (!btn || !form) return;
  function err(m){ errEl.textContent = m; errEl.style.display = 'block'; }
  btn.addEventListener('click', async function(){
    errEl.style.display = 'none';
    if (!window.SimpleWebAuthnBrowser) { err('Passkeys are not supported in this browser.'); return; }
    // Basic client validation (name/email/org/agree).
    var fd = new FormData(form);
    if (!fd.get('first_name') || !fd.get('last_name') || !fd.get('email') || !fd.get('organization')) { err('Please fill in your name, organization and email first.'); return; }
    if (!form.querySelector('input[name="agree"]').checked) { err('Please accept the Terms of Service.'); return; }
    // Require the Protected B attestation before creating the account.
    if (window.PBMMAttest && !window.PBMMAttest.ok()) { window.PBMMAttest.require(function(){ btn.click(); }); return; }
    var original = btn.innerHTML; btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>&nbsp;Creating account…';
    try {
      fd.append('passwordless', '1');
      fd.append('pbmm_attested', '1');
      var body = new URLSearchParams(fd).toString();
      var r = await fetch('/register', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: body });
      var data = await r.json();
      if (!r.ok || !data.ok) throw new Error(data.error || 'Could not create the account.');
      // Now register the passkey (the session is authenticated).
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>&nbsp;Waiting for passkey…';
      var optR = await fetch('/api/webauthn/register-options', { method:'POST', headers:{'Content-Type':'application/json'} });
      var opts = await optR.json();
      if (!optR.ok) throw new Error(opts.error || 'Could not start passkey setup.');
      var reg = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts });
      var vR = await fetch('/api/webauthn/register-verify', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(reg) });
      var vData = await vR.json();
      if (!vR.ok || !vData.verified) throw new Error(vData.error || 'Passkey registration failed.');
      window.location = data.next || '/billing/welcome';
    } catch (e) {
      err((e && e.message) ? e.message : 'Passkey sign-up failed.');
      btn.disabled = false; btn.innerHTML = original;
    }
  });
})();

// Live profile-completion meter in the hero (updates as the form is filled).
(function(){
  var form = document.querySelector('form[action="/register"]');
  var ring = document.getElementById('regRing');
  var pctEl = document.getElementById('regPct');
  var bar = document.getElementById('regBar');
  var pctText = document.getElementById('regPct');
  var sub = document.getElementById('regSub');
  if (!form || !ring) return;
  var subDefault = sub ? sub.innerHTML : '';
  function val(n){ var el = form.elements[n]; return el ? String(el.value || '').trim() : ''; }
  function update(){
    var checks = [
      !!val('first_name'),
      !!val('last_name'),
      !!val('organization'),
      /.+@.+\..+/.test(val('email')),
      val('password').length >= 10,
      form.elements['agree'] && form.elements['agree'].checked
    ];
    var done = checks.filter(Boolean).length;
    var pct = Math.round(done / checks.length * 100);
    ring.style.setProperty('--p', pct);
    pctText.textContent = pct + '%';
    bar.style.width = pct + '%';
    var complete = pct === 100;
    pctEl.classList.toggle('vg-reg-done', complete);
    if (sub) sub.innerHTML = complete
      ? '<b>All set</b> — create your account to continue.'
      : subDefault;
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  update();
})();
</script>

