<div class="vg vg-page">
<nav class="vg-nav">
  <div class="vg-container vg-nav-inner">
    <a href="{{homeHref}}" class="vg-brand">
      <span class="vg-brand-name">Vanguard Cloud Services</span>
      <span class="vg-brand-sep">|</span>
      <span class="vg-brand-product">Aegis SA</span>
    </a>
    <div class="vg-nav-links">{{> vg-langswitch}}</div>
  </div>
</nav>

<div class="vg-auth-wrap">
  <div class="vg-auth-card">
    {{#if invalid}}
      <div class="vg-auth-head"><h1>Invitation not found</h1><p>This invitation link is invalid, already used, or expired.</p></div>
      <div class="vg-callout warn">Ask your administrator to send a new invitation.</div>
      <a href="/" class="vg-btn vg-btn-ghost vg-btn-block">Back to home</a>
    {{else}}
      <div class="vg-auth-head">
        <h1>Join {{#if org}}{{org.name}}{{else}}your team{{/if}}</h1>
        <p>You've been invited{{#if inv.grant_admin}} as an <strong>admin</strong>{{/if}}. Create your account to continue — you'll never fill assessments anonymously.</p>
      </div>

      <div class="vg-callout info" style="margin-top:0">Invited email: <b>{{inv.email}}</b></div>

      <form method="POST" action="/redeem/{{code}}">
        <div class="vg-field-row">
          <div class="vg-field"><label class="vg-label">First name</label><input class="vg-input" name="first_name" value="{{formData.first_name}}" required></div>
          <div class="vg-field"><label class="vg-label">Last name</label><input class="vg-input" name="last_name" value="{{formData.last_name}}" required></div>
        </div>
        <div class="vg-field"><label class="vg-label">Password</label><input class="vg-input" type="password" name="password" placeholder="At least 10 characters" required>
          <div class="vg-hint">Multi-factor authentication is set up right after you continue.</div>
        </div>
        <label style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--vg-muted);margin:6px 0 18px">
          <input type="checkbox" name="agree" value="1" required style="margin-top:3px">
          <span>I agree to the Terms of Service and Privacy Policy.</span>
        </label>
        <button class="vg-btn vg-btn-primary vg-btn-block vg-btn-lg" type="submit">Create account &amp; continue</button>
      </form>
      <div class="vg-or">or</div>
      <button type="button" id="pkRedeemBtn" class="vg-btn vg-btn-block vg-btn-lg"
        data-email="{{inv.email}}" data-org="{{#if org}}{{org.name}}{{/if}}" data-code="{{code}}"
        style="border:1px solid var(--vg-sky-600);color:var(--vg-sky-600);background:#fff">
        {{t 'auth.registerWithPasskey'}}
      </button>
      <div id="pkRedeemErr" style="color:#b91c1c;font-size:13px;margin-top:8px;display:none"></div>
      <script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
      <script>
      (function(){
        var btn = document.getElementById('pkRedeemBtn');
        if (!btn || !window.SimpleWebAuthnBrowser) return;
        var err = document.getElementById('pkRedeemErr');
        btn.addEventListener('click', async function(){
          err.style.display = 'none';
          var fn = (document.querySelector('[name=first_name]')||{}).value || '';
          var ln = (document.querySelector('[name=last_name]')||{}).value || '';
          var agree = document.querySelector('[name=agree]');
          if (!fn.trim() || !ln.trim()) { err.textContent = 'Enter your first and last name.'; err.style.display = 'block'; return; }
          if (agree && !agree.checked) { err.textContent = 'Please accept the Terms of Service to continue.'; err.style.display = 'block'; return; }
          var original = btn.innerHTML; btn.disabled = true; btn.textContent = 'Waiting for passkey…';
          try {
            var optResp = await fetch('/api/webauthn/signup-options', { method:'POST', headers:{'Content-Type':'application/json'},
              body: JSON.stringify({ name: (fn+' '+ln).trim(), email: btn.dataset.email, organization: btn.dataset.org || '', invite_code: btn.dataset.code, role: 'assessor' }) });
            var opts = await optResp.json();
            if (!optResp.ok) throw new Error(opts.error || 'Could not start passkey registration.');
            var att = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts });
            var v = await fetch('/api/webauthn/signup-verify', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(att) });
            var data = await v.json();
            if (!v.ok || !data.success) throw new Error(data.error || 'Passkey registration failed.');
            window.location = data.redirect || '/admin/dashboard';
          } catch (e) {
            err.textContent = (e && e.name === 'NotAllowedError') ? 'Passkey registration was cancelled.' : ((e && e.message) ? e.message : 'Passkey registration failed.');
            err.style.display = 'block'; btn.disabled = false; btn.innerHTML = original;
          }
        });
      })();
      </script>
      <p style="text-align:center;font-size:14px;color:var(--vg-muted);margin:0">Already have an account? <a href="/admin/login" style="color:var(--vg-sky-600);font-weight:600;text-decoration:none">Sign in</a></p>
    {{/if}}
  </div>
</div>

<footer class="vg-footer">
  <div class="vg-container"><div>Aegis SA · Vanguard Cloud Services · vanguardcs.ca</div></div>
</footer>
</div>
