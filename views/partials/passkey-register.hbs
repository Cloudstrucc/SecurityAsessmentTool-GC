{{!-- Passwordless "Register with a passkey" option. Include on any registration
      page that has #name / #email / #organization inputs and a [name=invite_code].
      Pass the account role: {{> passkey-register role="client"}} or role="assessor".
      The account is created only when the passkey is confirmed (see
      /api/webauthn/signup-verify) — an abandoned attempt leaves nothing behind. --}}
<div class="d-flex align-items-center my-3 text-muted small">
  <span class="flex-grow-1 border-top"></span><span class="px-2">{{t 'auth.or'}}</span><span class="flex-grow-1 border-top"></span>
</div>
<button type="button" id="passkeyRegisterBtn" class="btn btn-outline-primary w-100 py-2">
  <i class="bi bi-fingerprint me-2"></i>{{t 'auth.registerWithPasskey'}}
</button>
<div id="passkeyRegisterError" class="text-danger small mt-2 d-none"></div>

<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
(function(){
  var btn = document.getElementById('passkeyRegisterBtn');
  if (!btn || !window.SimpleWebAuthnBrowser) return;
  var errEl = document.getElementById('passkeyRegisterError');
  var ROLE = '{{role}}' || 'client';
  var WAIT = {{{tjs 'auth.waitingPasskey'}}};
  var CANCELLED = {{{tjs 'auth.cancelledPasskey'}}};
  var NEEDINFO = {{{tjs 'auth.passkeyNeedNameEmail'}}};
  function val(id){ var el = document.getElementById(id); return el ? el.value.trim() : ''; }
  btn.addEventListener('click', async function(){
    errEl.classList.add('d-none');
    var name = val('name'), email = val('email'), organization = val('organization');
    var inviteEl = document.querySelector('[name=invite_code]');
    var invite_code = inviteEl ? inviteEl.value.trim() : '';
    if (!name || !email) { errEl.textContent = NEEDINFO; errEl.classList.remove('d-none'); return; }
    var original = btn.innerHTML; btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + WAIT;
    try {
      var optResp = await fetch('/api/webauthn/signup-options', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, email: email, organization: organization, invite_code: invite_code, role: ROLE })
      });
      var opts = await optResp.json();
      if (!optResp.ok) throw new Error(opts.error || 'Could not start passkey registration.');
      var attestation = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts });
      var vResp = await fetch('/api/webauthn/signup-verify', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(attestation)
      });
      var data = await vResp.json();
      if (!vResp.ok || !data.success) throw new Error(data.error || 'Passkey registration failed.');
      window.location = data.redirect || '/';
    } catch (e) {
      errEl.textContent = (e && e.name === 'NotAllowedError') ? CANCELLED : ((e && e.message) ? e.message : 'Passkey registration failed.');
      errEl.classList.remove('d-none');
      btn.disabled = false; btn.innerHTML = original;
    }
  });
})();
</script>
