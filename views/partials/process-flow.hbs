{{!--
  Business process flow (chevron) for a project / intake / assessment.
  Params: flow (from config/process-flows.js), titleKey, idPrefix
  Every label comes from the pf.* i18n keys — no hardcoded English.
--}}
{{#if flow.stages.length}}
<div class="card mb-4">
  <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span><i class="bi bi-diagram-3 me-2"></i>{{t titleKey}}</span>
    <span class="badge bg-light text-dark border">{{t 'pf.stageOf' n=flow.currentIndex total=flow.total}}</span>
  </div>
  <div class="card-body">

    <div class="pf-track" role="list">
      {{#each flow.stages}}
        <button type="button" role="listitem"
                class="pf-chev pf-{{this.state}}"
                data-bs-toggle="collapse" data-bs-target="#{{../idPrefix}}-st-{{this.key}}"
                aria-expanded="{{#if this.isCurrent}}true{{else}}false{{/if}}"
                aria-controls="{{../idPrefix}}-st-{{this.key}}"
                title="{{t this.labelKey}}">
          <span class="pf-num">
            {{#if this.isComplete}}<i class="bi bi-check-lg"></i>{{else}}{{this.index}}{{/if}}
          </span>
          <span class="pf-body">
            <span class="pf-label">{{t this.labelKey}}</span>
            <span class="pf-sub">
              {{#if this.isComplete}}{{t 'pf.complete'}}{{else}}{{#if this.isCurrent}}{{t 'pf.current'}}{{else}}{{t 'pf.upcoming'}}{{/if}}{{/if}}
              · {{this.doneCount}}/{{this.stepCount}}
            </span>
          </span>
        </button>
      {{/each}}
    </div>

    {{#if flow.nextStep}}
      <div class="pf-next mt-3">
        <i class="bi bi-arrow-right-circle-fill me-2"></i>
        <strong>{{t 'pf.nextStep'}}:</strong>
        {{#if flow.nextStep.href}}
          <a href="{{flow.nextStep.href}}">{{t flow.nextStep.labelKey}}</a>
        {{else}}
          {{t flow.nextStep.labelKey}}
        {{/if}}
      </div>
    {{else}}
      <div class="pf-next pf-next-done mt-3">
        <i class="bi bi-check-circle-fill me-2"></i>{{t 'pf.allDone'}}
      </div>
    {{/if}}

    <div id="{{idPrefix}}-acc" class="mt-3">
      {{#each flow.stages}}
        <div class="collapse{{#if this.isCurrent}} show{{/if}}"
             id="{{../idPrefix}}-st-{{this.key}}" data-bs-parent="#{{../idPrefix}}-acc">
          <div class="pf-panel">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
              <strong class="small text-uppercase text-muted">{{t 'pf.checklist'}} — {{t this.labelKey}}</strong>
              {{#if this.href}}
                <a href="{{this.href}}" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-box-arrow-up-right me-1"></i>{{t 'pf.openRecord'}}
                  {{#if this.recordLabel}}<span class="ms-1 opacity-75">{{this.recordLabel}}</span>{{/if}}
                </a>
              {{/if}}
            </div>
            <ul class="pf-steps">
              {{#each this.steps}}
                <li class="{{#if this.done}}pf-done{{/if}}">
                  {{#if this.done}}
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                  {{else}}
                    <i class="bi bi-circle text-secondary me-2"></i>
                  {{/if}}
                  {{#if this.href}}
                    <a href="{{this.href}}">{{t this.labelKey}}</a>
                  {{else}}
                    <span>{{t this.labelKey}}</span>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      {{/each}}
    </div>

  </div>
</div>

<style>
  /* Chevron track: scrolls horizontally on small screens rather than
     forcing the page to scroll (see the app-wide responsive rules). */
  .pf-track{display:flex;gap:4px;overflow-x:auto;padding-bottom:4px}
  .pf-chev{flex:1 1 0;min-width:150px;display:flex;align-items:center;gap:9px;
    border:none;text-align:left;padding:10px 14px 10px 20px;cursor:pointer;
    background:#eef1f5;color:#5a6b7d;position:relative;
    clip-path:polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%, 14px 50%)}
  .pf-track .pf-chev:first-child{clip-path:polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%);
    border-top-left-radius:6px;border-bottom-left-radius:6px}
  .pf-track .pf-chev:last-child{clip-path:polygon(0 0, 100% 0, 100% 100%, 0 100%, 14px 50%);
    border-top-right-radius:6px;border-bottom-right-radius:6px}
  .pf-chev:hover{filter:brightness(.97)}
  .pf-chev:focus-visible{outline:3px solid var(--gc-link,#2b4380);outline-offset:2px}
  .pf-num{flex:0 0 auto;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;
    font-size:12px;font-weight:800;background:rgba(0,0,0,.10)}
  .pf-body{display:flex;flex-direction:column;line-height:1.15;min-width:0}
  .pf-label{font-weight:700;font-size:.86rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pf-sub{font-size:.7rem;opacity:.85;white-space:nowrap}
  .pf-complete{background:#d6f0e0;color:#14663b}
  .pf-complete .pf-num{background:#198754;color:#fff}
  .pf-current{background:var(--gc-link,#2b4380);color:#fff}
  .pf-current .pf-num{background:rgba(255,255,255,.25);color:#fff}
  .pf-upcoming{background:#eef1f5;color:#6c7a89}
  .pf-blocked{background:#fbe6e6;color:#9b2c2c}
  .pf-next{background:#f6f8fb;border:1px solid #e3e8ef;border-radius:8px;padding:9px 12px;font-size:.9rem}
  .pf-next-done{background:#eaf7ef;border-color:#c9e7d5;color:#14663b}
  .pf-panel{background:#f8f9fb;border:1px solid #e3e8ef;border-radius:8px;padding:12px 14px}
  .pf-steps{list-style:none;margin:0;padding:0}
  .pf-steps li{padding:5px 0;font-size:.9rem;border-bottom:1px solid #edf0f4}
  .pf-steps li:last-child{border-bottom:none}
  .pf-steps li.pf-done{color:#4a5b6b}
  .pf-steps a{text-decoration:none}
  .pf-steps a:hover{text-decoration:underline}
  @media (max-width:575.98px){
    .pf-chev{min-width:132px;padding:9px 12px 9px 18px}
    .pf-label{font-size:.8rem}
  }
</style>
{{/if}}
