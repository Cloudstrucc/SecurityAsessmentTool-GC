<div class="container">
  <div class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">{{#if heading}}{{heading}}{{else}}Assessments{{/if}}</h1>
      <p class="text-muted mb-0">{{#if blurb}}{{blurb}}{{else}}All security assessment packages — the SA&amp;A record for each system, from tailoring through evidence, audit and authorization.{{/if}}</p>
      <div class="rule"></div>
    </div>
    {{#if filter}}<a href="/admin/assessments" class="btn btn-outline-secondary"><i class="bi bi-list me-1"></i>{{t 'ui.allAssessments'}}</a>{{/if}}
  </div>

  <div class="card">
    <div class="card-body p-0">
      {{#if assessments.length}}
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>{{t 'ui.project'}}</th>
                <th>{{t 'ui.type'}}</th>
                <th>{{t 'ui.status'}}</th>
                <th>{{t 'ui.score'}}</th>
                <th>{{t 'ui.result'}}</th>
                <th>{{t 'ui.inviteCode'}}</th>
                <th>{{t 'ui.created'}}</th>
                <th>{{t 'ui.updated'}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each assessments}}
                <tr>
                  <td class="fw-semibold">{{this.project_name}}</td>
                  <td class="text-capitalize">{{this.type}}</td>
                  <td>{{{statusBadge this.status}}}</td>
                  <td>
                    {{#if this.overall_score}}
                      <span class="fw-bold {{#ifCond this.overall_score '>=' 80}}text-success{{else}}text-danger{{/ifCond}}">
                        {{this.overall_score}}%
                      </span>
                    {{else}}
                      <span class="text-muted">—</span>
                    {{/if}}
                  </td>
                  <td>{{#if this.result}}{{{statusBadge this.result}}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
                  <td><code class="small">{{this.invite_code}}</code></td>
                  <td class="small text-muted">{{formatDate this.created_at}}</td>
                  <td class="small text-muted">{{formatDate this.updated_at}}</td>
                  <td class="text-end text-nowrap">
                    <a href="/admin/assessments/{{this.id}}" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye me-1"></i>{{t 'ui.view'}}
                    </a>
                    {{#if (eq this.status 'draft')}}
                      <form action="/admin/assessments/{{this.id}}/delete" method="POST" class="d-inline ms-1"
                        onsubmit="return confirm('Delete this draft assessment? This cannot be undone.')">
                        <input type="hidden" name="return_to" value="/admin/assessments">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="{{t 'ui.deleteDraft'}}">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="p-5 text-center text-muted">
          <i class="bi bi-clipboard-plus" style="font-size:3rem"></i>
          {{#if filter}}
            <p class="mt-3 mb-2">{{t 'ui.nothingHereYet'}}</p>
            <p class="small">{{blurb}} None match right now — they'll appear as assessments progress.</p>
          {{else}}
            <p class="mt-3 mb-2">{{t 'ui.noAssessmentsYet'}}</p>
            <p class="small">{{t 'ui.anAssessmentIsTheSa'}}</p>
          {{/if}}
          <a href="/admin/projects" class="btn btn-primary"><i class="bi bi-folder2-open me-1"></i>{{t 'ui.viewProjects'}}</a>
        </div>
      {{/if}}
    </div>
  </div>
</div>
