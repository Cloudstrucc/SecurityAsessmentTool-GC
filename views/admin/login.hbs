<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-lg-5">
      <div class="text-center mb-4">
        <i class="bi bi-shield-lock-fill" style="font-size:3rem;color:var(--gc-red)"></i>
        <h2 class="mt-2" style="color:var(--gc-nav)">{{t 'auth.loginTitle'}}</h2>
        <p class="text-muted">{{t 'auth.saPortal'}}</p>
      </div>
      <div class="card">
        <div class="card-body p-4">
          {{#if mfaSetup}}
            <div class="alert alert-info small">
              {{t 'auth.mfaSetupInstructions'}}
            </div>
            <div class="text-center mb-3">
              <div class="p-3 bg-white d-inline-block rounded border">
                <img src="{{qrCodeUrl}}" alt="MFA QR Code" style="width:200px;height:200px;">
              </div>
            </div>
            <div class="bg-light p-2 rounded text-center small mb-3" style="font-family:'Courier New',monospace;letter-spacing:1px;word-break:break-all;">
              {{secret}}
            </div>
            <form action="/admin/mfa-setup" method="POST">
              <label class="form-label fw-semibold">{{t 'auth.authCode'}}</label>
              <input type="text" class="form-control form-control-lg text-center mb-3" name="token" required maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" inputmode="numeric" placeholder="000000">
              <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-check-circle me-2"></i>{{t 'auth.verifyEnableMfa'}}
              </button>
            </form>
          {{else if mfaStep}}
            {{#if hasWebAuthn}}
              <div id="adminPasskeySection">
                <div class="text-center mb-3">
                  <i class="bi bi-person-bounding-box" style="font-size:3rem;color:var(--gc-nav)"></i>
                </div>
                <p class="text-center text-muted small">{{t 'auth.passkeyOrTotp'}}</p>
                <div id="adminPasskeyError" class="alert alert-danger small py-2 d-none"></div>
                <button class="btn btn-primary w-100 py-2 mb-3" id="adminPasskeyBtn" data-user-id="{{userId}}">
                  <i class="bi bi-person-bounding-box me-1"></i>{{t 'auth.signInPasskey'}}
                </button>
                <div class="text-center">
                  <a href="#" class="small text-muted" id="adminSwitchToTotp"><i class="bi bi-key me-1"></i>{{t 'auth.useTotpInstead'}}</a>
                </div>
              </div>
            {{/if}}
            <div id="adminTotpSection" {{#if hasWebAuthn}}class="d-none"{{/if}}>
              <div class="alert alert-info small mb-3">
                <i class="bi bi-shield-lock me-1"></i>{{t 'auth.enter6digit'}}
              </div>
              <form action="/admin/login" method="POST">
                <input type="hidden" name="_mfa_step" value="1">
                <label class="form-label fw-semibold">{{t 'auth.authCode'}}</label>
                <input type="text" class="form-control form-control-lg text-center mb-3" name="token" required maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" inputmode="numeric" placeholder="000000" {{#unless hasWebAuthn}}autofocus{{/unless}}>
                <button type="submit" class="btn btn-primary w-100 py-2">
                  <i class="bi bi-check-circle me-2"></i>{{t 'auth.verifySignIn'}}
                </button>
              </form>
              {{#if hasWebAuthn}}
                <div class="text-center mt-3">
                  <a href="#" class="small text-muted" id="adminSwitchToPasskey"><i class="bi bi-person-bounding-box me-1"></i>{{t 'auth.usePasskeyInstead'}}</a>
                </div>
              {{/if}}
            </div>
          {{else}}
            <form action="/admin/login" method="POST">
              <div class="mb-3">
                <label for="email" class="form-label">{{t 'auth.email'}}</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                  <input type="email" class="form-control" id="email" name="email" required autofocus placeholder="{{t 'ui.assessorAgencyGcCa'}}" value="{{prefillEmail}}">
                </div>
              </div>
              <div class="mb-4">
                <label for="password" class="form-label">{{t 'auth.password'}}</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-lock"></i></span>
                  <input type="password" class="form-control" id="password" name="password" required placeholder="{{t 'auth.passwordPlaceholder'}}">
                </div>
              </div>
              <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>{{t 'auth.signIn'}}
              </button>
            </form>
            <div class="d-flex align-items-center my-3 text-muted small">
              <span class="flex-grow-1 border-top"></span><span class="px-2">or</span><span class="flex-grow-1 border-top"></span>
            </div>
            <button type="button" id="passkeyLoginBtn" class="btn btn-outline-primary w-100 py-2">
              <i class="bi bi-fingerprint me-2"></i>{{t 'ui.signInWithAPasskey'}}
            </button>
            <div id="passkeyLoginError" class="text-danger small mt-2 d-none"></div>
          {{/if}}
        </div>
      </div>
      <div class="text-center mt-3">
        <a href="/" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>{{t 'auth.backPortal'}}</a>
      </div>
    </div>
  </div>
</div>

{{#unless mfaStep}}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
(function(){
  var btn = document.getElementById('passkeyLoginBtn');
  if (!btn || !window.SimpleWebAuthnBrowser) return;
  var errEl = document.getElementById('passkeyLoginError');
  btn.addEventListener('click', async function(){
    errEl.classList.add('d-none');
    var original = btn.innerHTML; btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Waiting for passkey…';
    try {
      var optResp = await fetch('/api/webauthn/login-options', { method:'POST', headers:{'Content-Type':'application/json'} });
      var opts = await optResp.json();
      if (!optResp.ok) throw new Error(opts.error || 'Could not start passkey sign-in.');
      var assertion = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: opts });
      var vResp = await fetch('/api/webauthn/login-verify', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(assertion) });
      var data = await vResp.json();
      if (!vResp.ok || !data.success) throw new Error(data.error || 'Passkey sign-in failed.');
      window.location = data.redirect || '/admin/dashboard';
    } catch (e) {
      errEl.textContent = (e && e.message) ? e.message : 'Passkey sign-in failed. Try your password.';
      errEl.classList.remove('d-none');
      btn.disabled = false; btn.innerHTML = original;
    }
  });
})();
</script>
{{/unless}}

{{#if mfaStep}}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const passkeySection = document.getElementById('adminPasskeySection');
  const totpSection = document.getElementById('adminTotpSection');
  document.getElementById('adminSwitchToTotp')?.addEventListener('click', function(e) {
    e.preventDefault();
    passkeySection?.classList.add('d-none');
    totpSection?.classList.remove('d-none');
    totpSection?.querySelector('input[name="token"]')?.focus();
  });
  document.getElementById('adminSwitchToPasskey')?.addEventListener('click', function(e) {
    e.preventDefault();
    totpSection?.classList.add('d-none');
    passkeySection?.classList.remove('d-none');
  });

  document.getElementById('adminPasskeyBtn')?.addEventListener('click', async function() {
    const errEl = document.getElementById('adminPasskeyError');
    const userId = this.dataset.userId;
    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + {{{tjs 'auth.waitingPasskey'}}};
    errEl.classList.add('d-none');
    try {
      const optResp = await fetch('/api/webauthn/auth-options', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: parseInt(userId) })
      });
      const opts = await optResp.json();
      if (opts.error) throw new Error(opts.error);
      const authResult = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: opts });
      const verifyResp = await fetch('/api/webauthn/auth-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...authResult, _userId: userId })
      });
      const verifyData = await verifyResp.json();
      if (!verifyData.success || !verifyData.sig_token) throw new Error(verifyData.error || 'Verification failed');
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/login';
      form.innerHTML = '<input type="hidden" name="_webauthn_step" value="1"><input type="hidden" name="_sig_token" value="' + verifyData.sig_token + '">';
      document.body.appendChild(form);
      form.submit();
    } catch (err) {
      errEl.textContent = err.name === 'NotAllowedError' ? {{{tjs 'auth.cancelledUseTotp'}}} : err.message;
      errEl.classList.remove('d-none');
      this.disabled = false;
      this.innerHTML = '<i class="bi bi-person-bounding-box me-1"></i>' + {{{tjs 'auth.tryPasskeyAgain'}}};
    }
  });
});
</script>
{{/if}}
