    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-check2-circle me-2"></i>{{t 'ik.acceptTitle'}}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{t 'ik.cancel'}}"></button>
