<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{project.id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
      <h1 class="mb-0">{{t 'ui.newAssessment'}}</h1>
      <p class="text-muted mb-0">{{project.name}} — Select &amp; tailor {{framework.label}} controls</p>
    </div>
  </div>

  <div class="alert alert-info">
    <i class="bi bi-lightbulb me-2"></i>
    <strong>{{controlCount}} controls recommended</strong> {{#if usingTailoredRecommendation}}from the tailored project context{{else}}from the full baseline{{/if}}
    ({{frameworkSummary}}).
    Review the recommended controls, approve or reject selections, add more manually later, and then create the assessment package.
    {{#if usingTailoredRecommendation}}<br><small class="text-muted">Full baseline available: {{baselineCount}} controls. The assessor remains in control of the final selected set.</small>{{/if}}
    {{#if saaReason}}<br><small class="text-muted">Determination: {{saaReason}}</small>{{/if}}
    {{#if intake}}<br><small class="text-muted">{{t 'ui.linkedIntake'}} <code>{{intake.ref_code}}</code></small>{{/if}}
  </div>

  {{#if showProfileCard}}
  <div class="card mb-3" id="controlProfile">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <span><i class="bi bi-sliders me-2"></i>{{t 'ui.controlProfile'}}</span>
      {{#if profile.overridden}}<span class="badge bg-warning text-dark">{{t 'ui.adjustedForThisAssessment'}}</span>{{else}}<span class="badge bg-secondary">{{t 'ui.projectBaseline'}}</span>{{/if}}
    </div>
    <div class="card-body">
      <p class="text-muted small mb-3">{{t 'ui.confidentialityStaysTheFormalBaseline'}}<span class="text-uppercase">{{profile.confidentiality}}</span>{{t 'ui.retune'}} <strong>{{t 'ui.integrity'}}</strong> {{t 'ui.and'}} <strong>{{t 'ui.availability'}}</strong> {{t 'ui.toChangeTheResolvedProfile'}}</p>
      <form method="GET" action="/admin/projects/{{project.id}}/assessments/new" class="row g-2 align-items-end">
        {{#if allParam}}<input type="hidden" name="all" value="1">{{/if}}
        <input type="hidden" name="confidentiality" value="{{profile.confidentiality}}">
        <div class="col-md-3">
          <label class="form-label small mb-1">{{t 'ui.confidentialityBaseline'}}</label>
          <input class="form-control form-control-sm text-capitalize" value="{{profile.confidentiality}}" disabled>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">{{t 'ui.integrity2'}}</label>
          <select class="form-select form-select-sm text-capitalize" name="integrity">
            {{#each levelOptions}}<option value="{{this}}" {{#if (eq this ../profile.integrity)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">{{t 'ui.availability2'}}</label>
          <select class="form-select form-select-sm text-capitalize" name="availability">
            {{#each levelOptions}}<option value="{{this}}" {{#if (eq this ../profile.availability)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-primary btn-sm"><i class="bi bi-arrow-repeat me-1"></i>{{t 'ui.updateControls'}}</button>
          {{#if profile.overridden}}<a href="/admin/projects/{{project.id}}/assessments/new{{#if allParam}}?all=1{{/if}}" class="btn btn-outline-secondary btn-sm">{{t 'ui.reset'}}</a>{{/if}}
        </div>
      </form>
      <div class="small text-muted mt-2">{{t 'ui.resolvedProfile'}} <span class="badge bg-info text-dark">{{profile.id}}</span> {{t 'ui.recommendedSetUpdatesWhenYou'}}</div>
    </div>
  </div>
  {{/if}}

  <div class="d-flex gap-2 mb-3">
    {{#if usingTailoredRecommendation}}
      <a href="/admin/projects/{{project.id}}/assessments/new?all=1" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-list-ul me-1"></i>Review Full Baseline ({{baselineCount}})
      </a>
    {{else}}
      <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-stars me-1"></i>{{t 'ui.useTailoredRecommendation'}}
      </a>
    {{/if}}
    {{#if isItsgFramework}}
      <a href="/admin/projects/{{project.id}}/guidance" class="btn btn-outline-success btn-sm">
        <i class="bi bi-file-text me-1"></i>{{t 'ui.viewGcWebGuidanceReport'}}
      </a>
    {{/if}}
  </div>

  {{#if documents.length}}
    <div class="card mb-3">
      <div class="card-header bg-light"><i class="bi bi-stars me-2"></i>{{t 'ui.aiAssistedControlSelectionInputs'}}</div>
      <div class="card-body small">
        <p class="text-muted mb-2">{{t 'ui.theTailoredRecommendationCanUse'}}</p>
        <div class="d-flex flex-wrap gap-2">
          {{#each documents}}
            <span class="badge bg-light text-dark border"><i class="bi bi-file-earmark me-1"></i>{{this.original_name}}</span>
          {{/each}}
        </div>
      </div>
    </div>
  {{/if}}

  <form method="POST" action="/admin/projects/{{project.id}}/assessments/new" id="assessmentForm">
    {{#if showProfileCard}}
    <input type="hidden" name="security_profile" value="{{profile.id}}">
    <input type="hidden" name="confidentiality_level" value="{{profile.confidentiality}}">
    <input type="hidden" name="integrity_level" value="{{profile.integrity}}">
    <input type="hidden" name="availability_level" value="{{profile.availability}}">
    {{/if}}

    <!-- Sticky toolbar -->
    <div class="progress-sticky">
      <div class="d-flex justify-content-between align-items-center">
        {{!-- Reports SCOPE, not selection. Reading "0 of N selected" after a bulk
              tailor-out made a successful action look like a no-op. --}}
        <div>
          <span class="fw-semibold" id="selectedCount">{{controlCount}}</span>
          {{t 'bk.ofInScope' total=controlCount}}
          <span id="tailoredOutNote" class="text-muted ms-2" hidden>
            · <span id="tailoredOutCount">0</span> {{t 'bk.tailoredOutLabel'}}
          </span>
          <span id="bulkFlash" class="ms-2 badge text-bg-success" hidden></span>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(true)">{{t 'ui.selectAll'}}</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(false)">{{t 'ui.deselectAll'}}</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-clipboard-check me-1"></i>{{t 'ui.createAssessment'}}
          </button>
        </div>
      </div>
    </div>

    {{#each families}}
      <div class="form-section" id="family-{{this.code}}">
        <div class="family-header">
          <span class="family-code badge rounded-pill text-bg-primary">{{this.code}}</span>
          <h3 class="family-name">{{this.name}}</h3>
          <p class="family-meta">
            {{t 'cf.familyCount' n=this.controls.length}}
            <span class="ms-2">
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none"
                onclick="toggleFamily('{{this.code}}', true)">{{t 'bk.selectFamily'}}</button>
              <span class="text-muted mx-1">·</span>
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-danger"
                onclick="toggleFamily('{{this.code}}', false)">{{t 'bk.tailorOutFamily'}}</button>
            </span>
          </p>
        </div>

        {{#each this.controls}}
          <div class="control-card {{#if this.inheritedFrom}}inherited{{/if}}" id="card-{{this.id}}">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input control-toggle" name="control_ids"
                  value="{{this.id}}" id="ctrl-{{this.id}}" checked onchange="updateCount()">
                <label for="ctrl-{{this.id}}" class="control-id mb-0">{{this.id}}</label>
                <span class="control-title">{{this.title}}</span>
              </div>
              <div class="d-flex gap-1">
                <span class="badge bg-secondary">{{this.priority}}</span>
                {{#if this.inheritedFrom}}
                  <span class="badge bg-info"><i class="bi bi-arrow-left-right me-1"></i>{{t 'ui.inherited'}}</span>
                {{/if}}
                {{#if this.hasTemplate}}
                  <span class="badge bg-success"><i class="bi bi-recycle me-1"></i>{{t 'ui.template'}}</span>
                {{/if}}
              </div>
            </div>

            <p class="control-desc mb-2">{{this.description}}</p>

            {{#if this.tailoringRationale}}
              <div class="tailor-why mb-3">
                <span class="tailor-why-k"><i class="bi bi-info-circle me-1"></i>{{t 'tl.whyInScope'}}</span>
                <span class="tailor-why-v">{{this.tailoringRationale}}</span>
              </div>
            {{/if}}

            <!-- Hidden fields for standard data -->
            <input type="hidden" name="offered_ids" value="{{this.id}}">
            <input type="hidden" name="rationale_{{this.id}}" value="{{this.tailoringRationale}}">
            <input type="hidden" name="title_{{this.id}}" value="{{this.title}}">
            <input type="hidden" name="desc_{{this.id}}" value="{{this.description}}">
            <input type="hidden" name="control_guidance_{{this.id}}" value="{{this.controlGuidance}}">
            <input type="hidden" name="priority_{{this.id}}" value="{{this.priority}}">
            <input type="hidden" name="risk_{{this.id}}" value="{{this.riskLevel}}">
            <input type="hidden" name="family_{{this.id}}" value="{{this.family}}">
            <input type="hidden" name="family_name_{{this.id}}" value="{{this.familyName}}">
            <input type="hidden" name="framework_{{this.id}}" value="{{this.framework}}">
            {{#if this.inheritedFrom}}
              <input type="hidden" name="inherited[{{this.id}}]" value="1">
              <input type="hidden" name="inherited_from[{{this.id}}]" value="{{this.inheritedFrom}}">
            {{/if}}

            <!-- Tailoring fields (collapsible) -->
            {{!-- domId: a control id like AC-17(1) is not a valid CSS selector. --}}
            <div class="collapse {{#if this.hasTemplate}}show{{/if}}" id="tailor-{{domId this.id}}">
              <div class="row g-2 mt-1">
                <div class="col-md-6">
                  <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label small fw-semibold mb-1">{{t 'ui.tailoredDescription'}}</label>
                    {{!-- Bound by a delegated listener, NOT an inline onclick: the
                          handler used to interpolate {{{json title}}} into a
                          double-quoted attribute, and the quotes JSON adds closed
                          the attribute early, so the handler was truncated to
                          "aiRefineControl('AC-1', " and every button was dead. --}}
                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none js-ai-refine"
                      style="font-size:12px;color:#6d28d9"
                      data-cid="{{this.id}}" data-title="{{this.title}}"><i class="bi bi-stars me-1"></i>{{t 'ui.refineWithAi'}}</button>
                  </div>
                  <textarea class="form-control form-control-sm" name="tailored[{{this.id}}]" id="tailored-{{this.id}}" rows="3"
                    placeholder="{{t 'ui.typeAQuickNoteThen'}}">{{this.tailoredDescription}}</textarea>
                </div>
                <div class="col-md-6">
                  <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label small fw-semibold mb-1">{{t 'ui.evidenceGuidance'}}</label>
                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none js-ai-guidance"
                      style="font-size:12px;color:#6d28d9"
                      data-cid="{{this.id}}" data-title="{{this.title}}"><i class="bi bi-stars me-1"></i>{{t 'bk.generateGuidance'}}</button>
                  </div>
                  <textarea class="form-control form-control-sm" name="guidance[{{this.id}}]" id="guidance-{{this.id}}" rows="3"
                    placeholder="{{t 'ui.whatEvidenceTheProjectOwner'}}">{{this.evidenceGuidance}}</textarea>
                </div>
              </div>
              {{#if this.inheritedFrom}}
                <div class="mt-2 p-2 rounded" style="background:#e8f4f8">
                  <small class="text-info fw-semibold">
                    <i class="bi bi-arrow-left-right me-1"></i>
                    Potentially inherited from: {{this.inheritedFrom}}
                  </small>
                </div>
              {{/if}}
              <div class="row g-2 mt-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold">{{t 'ui.applicability'}}</label>
                  <select class="form-select form-select-sm" name="applicable[{{this.id}}]">
                    <option value="1" selected>{{t 'ui.inScope'}}</option>
                    <option value="0">{{t 'ui.outOfScope'}}</option>
                  </select>
                </div>
                <div class="col-md-8">
                  <label class="form-label small fw-semibold">{{t 'tl.scopeOutReason'}}</label>
                  <input type="text" class="form-control form-control-sm"
                    name="scoped_out_reason[{{this.id}}]" placeholder="{{t 'tl.scopeOutReasonPh'}}">
                </div>
              </div>
            </div>

            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 mt-2"
              data-bs-toggle="collapse" data-bs-target="#tailor-{{domId this.id}}">
              <i class="bi bi-pencil-square me-1"></i>{{t 'ui.tailor'}}
            </button>
          </div>
        {{/each}}
      </div>
    {{/each}}

    {{!-- Floating bulk-action bar: shows as soon as anything is selected. --}}
    <div class="bulk-bar" id="bulkBar" role="region" aria-label="{{t 'bk.barLabel'}}">
      <span class="bulk-n"><strong id="bulkCount">0</strong> {{t 'bk.selected'}}</span>
      <input type="text" class="bulk-reason" id="bulkReason" autocomplete="off"
        placeholder="{{t 'bk.reasonPh'}}" aria-label="{{t 'bk.reasonPh'}}">
      <button type="button" class="btn btn-sm btn-outline-danger" onclick="bulkTailorOut()">
        <i class="bi bi-dash-circle me-1"></i>{{t 'bk.tailorOutSelected'}}
      </button>
      <button type="button" class="btn btn-sm btn-outline-light" id="bulkKeepOnly" onclick="bulkKeepOnly()">
        <i class="bi bi-bullseye me-1"></i>{{t 'bk.keepOnly'}}
      </button>
      <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleAll(true)">
        <i class="bi bi-check2-square me-1"></i>{{t 'ui.selectAll'}}
      </button>
      <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleAll(false)">
        <i class="bi bi-x-square me-1"></i>{{t 'bk.clear'}}
      </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 mb-5">
      <a href="/admin/projects/{{project.id}}" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i>{{t 'ui.cancel'}}
      </a>
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-clipboard-check me-2"></i>{{t 'ui.createAssessmentPackage'}}
      </button>
    </div>
  </form>
</div>

<script>
const BK_I18N = {
  tailoredOut: {{{tjs 'bk.flashTailoredOut'}}},
  keptOnly: {{{tjs 'bk.flashKeptOnly'}}}
};
const AI_I18N = {
  working: {{{tjs 'bk.aiWorking'}}},
  failed: {{{tjs 'bk.aiFailed'}}}
};
function updateCount() {
  const boxes = document.querySelectorAll('.control-toggle');
  const checked = document.querySelectorAll('.control-toggle:checked').length;
  document.getElementById('selectedCount').textContent = checked;
  // A control that is not selected is tailored OUT of this assessment — say so,
  // otherwise the only number on screen is the one that just went to zero.
  const out = boxes.length - checked;
  const note = document.getElementById('tailoredOutNote');
  const outEl = document.getElementById('tailoredOutCount');
  if (outEl) outEl.textContent = out;
  if (note) note.hidden = (out === 0);
  bulkBar(checked, boxes.length);
}

// Transient confirmation in the sticky header, so a bulk action says what it did.
let bulkFlashTimer = null;
function bulkFlash(message) {
  const el = document.getElementById('bulkFlash');
  if (!el) return;
  el.textContent = message;
  el.hidden = false;
  clearTimeout(bulkFlashTimer);
  bulkFlashTimer = setTimeout(() => { el.hidden = true; }, 6000);
}
function toggleAll(state) {
  document.querySelectorAll('.control-toggle').forEach(cb => { cb.checked = state; });
  updateCount();
}
function familyOfId(id) { return String(id).split(/[.\-(]/)[0].toUpperCase(); }
function toggleFamily(code, state) {
  document.querySelectorAll('.control-toggle').forEach(cb => {
    if (familyOfId(cb.value) === String(code).toUpperCase()) cb.checked = state;
  });
  updateCount();
}

// ── Floating bulk-action bar ────────────────────────────────────────────────
// Appears as soon as anything is selected so "Select all" has somewhere to go:
// the sticky header counts, this acts.
function bulkBar(checked, total) {
  const bar = document.getElementById('bulkBar');
  if (!bar) return;
  bar.classList.toggle('on', checked > 0);
  const n = document.getElementById('bulkCount');
  if (n) n.textContent = checked;
  const keep = document.getElementById('bulkKeepOnly');
  if (keep) keep.disabled = (checked === total);
}
function bulkTailorOut() {
  const sel = Array.prototype.filter.call(document.querySelectorAll('.control-toggle'), cb => cb.checked);
  if (!sel.length) return;
  // The reason comes from the bar's own field rather than a native prompt(),
  // which blocks the page and does not match the rest of the UI.
  const box = document.getElementById('bulkReason');
  const reason = box ? box.value : '';
  sel.forEach(cb => {
    cb.checked = false;
    const card = document.getElementById('card-' + cb.value);
    if (card) card.style.opacity = '.5';
    const r = document.querySelector('[name="scoped_out_reason[' + CSS.escape(cb.value) + ']"]');
    if (r && reason.trim()) r.value = reason.trim();
  });
  if (box) box.value = '';
  updateCount();
  bulkFlash(BK_I18N.tailoredOut.replace('{n}', sel.length));
}
function bulkKeepOnly() {
  const keep = new Set(Array.prototype.filter.call(document.querySelectorAll('.control-toggle'), cb => cb.checked)
    .map(cb => cb.value));
  document.querySelectorAll('.control-toggle').forEach(cb => {
    cb.checked = keep.has(cb.value);
    const card = document.getElementById('card-' + cb.value);
    if (card) card.style.opacity = cb.checked ? '' : '.5';
  });
  updateCount();
  bulkFlash(BK_I18N.keptOnly.replace('{n}', keep.size));
}
document.addEventListener('DOMContentLoaded', updateCount);
</script>

{{> ai-assess-helper }}
<script>
// ── Wire the Aegis SA Assistant into control tailoring (create mode) ──
(function(){
  function escAttr(s){ return String(s).replace(/"/g,'&quot;'); }
  var form = document.getElementById('assessmentForm');
  var addBox = document.getElementById('aiAddedControls');
  if (form && !addBox) { addBox = document.createElement('div'); addBox.id = 'aiAddedControls'; form.insertBefore(addBox, form.firstChild); }
  function ctrlTitle(id){ var lbl=document.querySelector('#card-'+CSS.escape(id)+' .control-title'); return lbl?lbl.textContent.trim():''; }
  function injectControl(id, a){
    if (document.getElementById('ctrl-'+id)) { document.getElementById('ctrl-'+id).checked = true; return; }
    var fam = (id.split(/[.\-(]/)[0]) || id;
    var div = document.createElement('div'); div.className='control-card'; div.id='card-'+id;
    div.style.cssText='border:1px dashed #a78bfa;border-radius:8px;padding:8px 10px;margin:6px 0;background:#faf7ff';
    div.innerHTML =
      '<div class="d-flex align-items-center gap-2">'+
      '<input type="checkbox" class="form-check-input control-toggle" name="control_ids" value="'+id+'" id="ctrl-'+id+'" checked onchange="updateCount()">'+
      '<strong>'+id+'</strong> <span class="badge bg-info text-dark">added by AI</span>'+
      (a && a.reason ? '<span class="text-muted small ms-1">'+escAttr(a.reason)+'</span>' : '')+'</div>'+
      '<input type="hidden" name="offered_ids" value="'+id+'">'+
      '<input type="hidden" name="rationale_'+id+'" value="'+escAttr((a && a.reason) || 'Added during tailoring by the Aegis SA Assistant.')+'">'+
      '<input type="hidden" name="title_'+id+'" value="'+id+'">'+
      '<input type="hidden" name="family_'+id+'" value="'+fam+'">'+
      '<input type="hidden" name="priority_'+id+'" value="P1">'+
      (a && a.tailoring ? '<input type="hidden" name="tailored['+id+']" value="'+escAttr(a.tailoring)+'">' : '');
    (document.getElementById('aiAddedControls')||form).appendChild(div);
  }
  // The assistant can target whole families rather than listing hundreds of IDs:
  //   families: ["AU","SC"]   → every currently-rendered control in those families
  //   exceptFamilies: ["AC"]  → every rendered control NOT in those families
  // Both are resolved here against the controls actually on the page.
  function familyOf(id){ return String(id).split(/[.\-(]/)[0].toUpperCase(); }
  function allRenderedIds(){
    return Array.prototype.map.call(document.querySelectorAll('.control-toggle'), function(cb){ return cb.value; });
  }
  function expandIds(a){
    var out = (a.controlIds || []).slice();
    var fams = (a.families || []).map(function(f){ return String(f).toUpperCase(); });
    var except = (a.exceptFamilies || []).map(function(f){ return String(f).toUpperCase(); });
    if (fams.length || except.length) {
      allRenderedIds().forEach(function(id){
        var f = familyOf(id);
        var hit = fams.length ? fams.indexOf(f) > -1 : true;
        if (except.length && except.indexOf(f) > -1) hit = false;
        if (hit && out.indexOf(id) === -1) out.push(id);
      });
    }
    return out;
  }

  window.AIAssistConfig = {
    mode: 'create',
    projectId: {{project.id}},
    frameworkLabel: {{{json framework.label}}},
    profileSummary: {{{json frameworkSummary}}},
    baselineCount: {{baselineCount}},
    projectContext: {{{json project.name}}} + ' — ' + ({{{json project.description}}} || '').slice(0, 400),
    subtitle: 'Tailoring · approve any change',
    getSelected: function(){
      return Array.prototype.map.call(document.querySelectorAll('.control-toggle:checked'), function(cb){
        return { id: cb.value, title: ctrlTitle(cb.value) };
      });
    },
    applyActions: function(actions){
      (actions||[]).forEach(function(a){
        var op=(a.op||'').toLowerCase();
        (expandIds(a)).forEach(function(id){
          var cb=document.getElementById('ctrl-'+id);
          if(op==='remove'){ if(cb){ cb.checked=false; var c=document.getElementById('card-'+id); if(c) c.style.opacity='.5'; } }
          else if(op==='add'){ if(cb){ cb.checked=true; var c2=document.getElementById('card-'+id); if(c2) c2.style.opacity=''; } else { injectControl(id, a); } }
          else if(op==='tailor'){ var ta=document.querySelector('[name="tailored['+id+']"]'); if(ta && a.tailoring){ ta.value=a.tailoring; ta.style.boxShadow='0 0 0 2px #c4b5fd'; } }
        });
      });
      updateCount();
    }
  };
})();

// Per-control "Refine with AI": expand a note into a fuller draft (approval-gated).
// With an empty field it generates from the control itself rather than doing
// nothing — an empty box used to return silently, which read as a dead button.
async function aiRefineControl(id, title, btn, target){
  var ta=target||document.getElementById('tailored-'+id); if(!ta) return;
  var summary=(ta.value||'').trim();
  var mode=ta.dataset.aiMode||'tailoring';
  var orig=btn.innerHTML; btn.disabled=true;
  btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> '+AI_I18N.working;
  try{
    var g=document.querySelector('[name="control_guidance_'+id+'"]');
    var r=await fetch('/api/ai/refine-answer',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({controlId:id,controlTitle:title||'',controlGuidance:g?g.value:'',
        userSummary:summary,mode:mode,projectId:{{project.id}},
        frameworkLabel:(window.AIAssistConfig&&AIAssistConfig.frameworkLabel)||'ITSG-33'})});
    var data=await r.json();
    if(!r.ok||!data.success) throw new Error(data.error||AI_I18N.failed);
    aiShowRefinePreview(ta, data.refined);
  }catch(e){ alert(e.message||AI_I18N.failed); }
  btn.disabled=false; btn.innerHTML=orig;
}

// One delegated listener for every per-control AI button on the page, including
// controls the assistant injects after load.
document.addEventListener('click', function(ev){
  var btn=ev.target.closest('.js-ai-refine, .js-ai-guidance');
  if(!btn) return;
  ev.preventDefault();
  var id=btn.dataset.cid;
  var isGuidance=btn.classList.contains('js-ai-guidance');
  var target=document.getElementById((isGuidance?'guidance-':'tailored-')+id);
  if(target) target.dataset.aiMode=isGuidance?'guidance':'tailoring';
  aiRefineControl(id, btn.dataset.title||'', btn, target);
});
function aiShowRefinePreview(ta, refined){
  var esc=function(s){return String(s).replace(/[&<>]/g,function(m){return({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]);});};
  var old=ta.parentNode.querySelector('.ai-refine-preview'); if(old) old.remove();
  var box=document.createElement('div'); box.className='ai-refine-preview';
  box.style.cssText='border:1px solid #ddd6fe;background:#faf7ff;border-radius:8px;padding:8px 10px;margin-top:6px;font-size:12.5px';
  box.innerHTML='<div class="fw-semibold mb-1" style="color:#6d28d9"><i class="bi bi-stars me-1"></i>AI-refined draft — approve to replace</div>'+
    '<div style="white-space:pre-wrap;color:#22303a">'+esc(refined)+'</div>'+
    '<div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-sm btn-primary py-0 aiap">Approve</button><button type="button" class="btn btn-sm btn-outline-secondary py-0 aidz">Discard</button></div>';
  box.querySelector('.aiap').onclick=function(){ ta.value=refined; ta.style.boxShadow='0 0 0 2px #c4b5fd'; box.remove(); };
  box.querySelector('.aidz').onclick=function(){ box.remove(); };
  ta.parentNode.appendChild(box);
}
</script>
