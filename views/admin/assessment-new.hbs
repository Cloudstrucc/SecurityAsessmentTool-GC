<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{project.id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
      <h1 class="mb-0">New Assessment</h1>
      <p class="text-muted mb-0">{{project.name}} — Select &amp; tailor {{framework.label}} controls</p>
    </div>
  </div>

  <div class="alert alert-info">
    <i class="bi bi-lightbulb me-2"></i>
    <strong>{{controlCount}} controls recommended</strong> {{#if usingTailoredRecommendation}}from the tailored project context{{else}}from the full baseline{{/if}}
    ({{frameworkSummary}}).
    Review the recommended controls, approve or reject selections, add more manually later, and then create the assessment package.
    {{#if usingTailoredRecommendation}}<br><small class="text-muted">Full baseline available: {{baselineCount}} controls. The assessor remains in control of the final selected set.</small>{{/if}}
    {{#if saaReason}}<br><small class="text-muted">Determination: {{saaReason}}</small>{{/if}}
    {{#if intake}}<br><small class="text-muted">Linked intake: <code>{{intake.ref_code}}</code></small>{{/if}}
  </div>

  {{#if showProfileCard}}
  <div class="card mb-3" id="controlProfile">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <span><i class="bi bi-sliders me-2"></i>Control profile</span>
      {{#if profile.overridden}}<span class="badge bg-warning text-dark">Adjusted for this assessment</span>{{else}}<span class="badge bg-secondary">Project baseline</span>{{/if}}
    </div>
    <div class="card-body">
      <p class="text-muted small mb-3">Confidentiality stays the formal baseline (<span class="text-uppercase">{{profile.confidentiality}}</span>). Retune <strong>integrity</strong> and <strong>availability</strong> to change the resolved profile and the recommended control set for this assessment — this does not change the project's intake record.</p>
      <form method="GET" action="/admin/projects/{{project.id}}/assessments/new" class="row g-2 align-items-end">
        {{#if allParam}}<input type="hidden" name="all" value="1">{{/if}}
        <input type="hidden" name="confidentiality" value="{{profile.confidentiality}}">
        <div class="col-md-3">
          <label class="form-label small mb-1">Confidentiality (baseline)</label>
          <input class="form-control form-control-sm text-capitalize" value="{{profile.confidentiality}}" disabled>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">Integrity</label>
          <select class="form-select form-select-sm text-capitalize" name="integrity">
            {{#each levelOptions}}<option value="{{this}}" {{#if (eq this ../profile.integrity)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">Availability</label>
          <select class="form-select form-select-sm text-capitalize" name="availability">
            {{#each levelOptions}}<option value="{{this}}" {{#if (eq this ../profile.availability)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-primary btn-sm"><i class="bi bi-arrow-repeat me-1"></i>Update controls</button>
          {{#if profile.overridden}}<a href="/admin/projects/{{project.id}}/assessments/new{{#if allParam}}?all=1{{/if}}" class="btn btn-outline-secondary btn-sm">Reset</a>{{/if}}
        </div>
      </form>
      <div class="small text-muted mt-2">Resolved profile: <span class="badge bg-info text-dark">{{profile.id}}</span> · recommended set updates when you change integrity or availability.</div>
    </div>
  </div>
  {{/if}}

  <div class="d-flex gap-2 mb-3">
    {{#if usingTailoredRecommendation}}
      <a href="/admin/projects/{{project.id}}/assessments/new?all=1" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-list-ul me-1"></i>Review Full Baseline ({{baselineCount}})
      </a>
    {{else}}
      <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-stars me-1"></i>Use Tailored Recommendation
      </a>
    {{/if}}
    {{#if isItsgFramework}}
      <a href="/admin/projects/{{project.id}}/guidance" class="btn btn-outline-success btn-sm">
        <i class="bi bi-file-text me-1"></i>View GC Web Guidance Report Instead
      </a>
    {{/if}}
  </div>

  {{#if documents.length}}
    <div class="card mb-3">
      <div class="card-header bg-light"><i class="bi bi-stars me-2"></i>AI-Assisted Control Selection Inputs</div>
      <div class="card-body small">
        <p class="text-muted mb-2">The tailored recommendation can use these uploaded project documents as context. You can still add or remove controls before saving.</p>
        <div class="d-flex flex-wrap gap-2">
          {{#each documents}}
            <span class="badge bg-light text-dark border"><i class="bi bi-file-earmark me-1"></i>{{this.original_name}}</span>
          {{/each}}
        </div>
      </div>
    </div>
  {{/if}}

  <form method="POST" action="/admin/projects/{{project.id}}/assessments/new" id="assessmentForm">
    {{#if showProfileCard}}
    <input type="hidden" name="security_profile" value="{{profile.id}}">
    <input type="hidden" name="confidentiality_level" value="{{profile.confidentiality}}">
    <input type="hidden" name="integrity_level" value="{{profile.integrity}}">
    <input type="hidden" name="availability_level" value="{{profile.availability}}">
    {{/if}}

    <!-- Sticky toolbar -->
    <div class="progress-sticky">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="fw-semibold" id="selectedCount">{{controlCount}}</span> of {{controlCount}} controls selected
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(true)">Select All</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(false)">Deselect All</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-clipboard-check me-1"></i>Create Assessment
          </button>
        </div>
      </div>
    </div>

    {{#each families}}
      <div class="form-section" id="family-{{this.code}}">
        <div class="section-header">
          <h3 class="section-title">
            <span class="section-number">{{this.code}}</span>
            {{this.name}}
          </h3>
          <p class="section-description">{{this.controls.length}} control(s) in this family</p>
        </div>

        {{#each this.controls}}
          <div class="control-card {{#if this.inheritedFrom}}inherited{{/if}}" id="card-{{this.id}}">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input control-toggle" name="control_ids"
                  value="{{this.id}}" id="ctrl-{{this.id}}" checked onchange="updateCount()">
                <label for="ctrl-{{this.id}}" class="control-id mb-0">{{this.id}}</label>
                <span class="control-title">{{this.title}}</span>
              </div>
              <div class="d-flex gap-1">
                <span class="badge bg-secondary">{{this.priority}}</span>
                {{#if this.inheritedFrom}}
                  <span class="badge bg-info"><i class="bi bi-arrow-left-right me-1"></i>Inherited</span>
                {{/if}}
                {{#if this.hasTemplate}}
                  <span class="badge bg-success"><i class="bi bi-recycle me-1"></i>Template</span>
                {{/if}}
              </div>
            </div>

            <p class="control-desc mb-3">{{this.description}}</p>

            <!-- Hidden fields for standard data -->
            <input type="hidden" name="title_{{this.id}}" value="{{this.title}}">
            <input type="hidden" name="desc_{{this.id}}" value="{{this.description}}">
            <input type="hidden" name="control_guidance_{{this.id}}" value="{{this.controlGuidance}}">
            <input type="hidden" name="priority_{{this.id}}" value="{{this.priority}}">
            <input type="hidden" name="risk_{{this.id}}" value="{{this.riskLevel}}">
            <input type="hidden" name="family_{{this.id}}" value="{{this.family}}">
            <input type="hidden" name="family_name_{{this.id}}" value="{{this.familyName}}">
            <input type="hidden" name="framework_{{this.id}}" value="{{this.framework}}">
            {{#if this.inheritedFrom}}
              <input type="hidden" name="inherited[{{this.id}}]" value="1">
              <input type="hidden" name="inherited_from[{{this.id}}]" value="{{this.inheritedFrom}}">
            {{/if}}

            <!-- Tailoring fields (collapsible) -->
            <div class="collapse {{#if this.hasTemplate}}show{{/if}}" id="tailor-{{this.id}}">
              <div class="row g-2 mt-1">
                <div class="col-md-6">
                  <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label small fw-semibold mb-1">Tailored Description</label>
                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:12px;color:#6d28d9"
                      onclick="aiRefineControl('{{this.id}}', {{{json this.title}}}, this)"><i class="bi bi-stars me-1"></i>Refine with AI</button>
                  </div>
                  <textarea class="form-control form-control-sm" name="tailored[{{this.id}}]" id="tailored-{{this.id}}" rows="3"
                    placeholder="Type a quick note, then 'Refine with AI' for a fuller draft…">{{this.tailoredDescription}}</textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Evidence Guidance</label>
                  <textarea class="form-control form-control-sm" name="guidance[{{this.id}}]" rows="3"
                    placeholder="What evidence the project owner should provide...">{{this.evidenceGuidance}}</textarea>
                </div>
              </div>
              {{#if this.inheritedFrom}}
                <div class="mt-2 p-2 rounded" style="background:#e8f4f8">
                  <small class="text-info fw-semibold">
                    <i class="bi bi-arrow-left-right me-1"></i>
                    Potentially inherited from: {{this.inheritedFrom}}
                  </small>
                </div>
              {{/if}}
              <div class="mt-2">
                <label class="form-label small fw-semibold">Applicability</label>
                <select class="form-select form-select-sm" name="applicable[{{this.id}}]" style="max-width:200px">
                  <option value="1" selected>In Scope</option>
                  <option value="0">Out of Scope</option>
                </select>
              </div>
            </div>

            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 mt-2"
              data-bs-toggle="collapse" data-bs-target="#tailor-{{this.id}}">
              <i class="bi bi-pencil-square me-1"></i>Tailor
            </button>
          </div>
        {{/each}}
      </div>
    {{/each}}

    <div class="d-flex justify-content-between align-items-center mt-4 mb-5">
      <a href="/admin/projects/{{project.id}}" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i>Cancel
      </a>
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-clipboard-check me-2"></i>Create Assessment Package
      </button>
    </div>
  </form>
</div>

<script>
function updateCount() {
  const checked = document.querySelectorAll('.control-toggle:checked').length;
  document.getElementById('selectedCount').textContent = checked;
}
function toggleAll(state) {
  document.querySelectorAll('.control-toggle').forEach(cb => { cb.checked = state; });
  updateCount();
}
</script>

{{> ai-assess-helper }}
<script>
// ── Wire the Aegis SA Assistant into control tailoring (create mode) ──
(function(){
  function escAttr(s){ return String(s).replace(/"/g,'&quot;'); }
  var form = document.getElementById('assessmentForm');
  var addBox = document.getElementById('aiAddedControls');
  if (form && !addBox) { addBox = document.createElement('div'); addBox.id = 'aiAddedControls'; form.insertBefore(addBox, form.firstChild); }
  function ctrlTitle(id){ var lbl=document.querySelector('#card-'+CSS.escape(id)+' .control-title'); return lbl?lbl.textContent.trim():''; }
  function injectControl(id, a){
    if (document.getElementById('ctrl-'+id)) { document.getElementById('ctrl-'+id).checked = true; return; }
    var fam = (id.split(/[.\-(]/)[0]) || id;
    var div = document.createElement('div'); div.className='control-card'; div.id='card-'+id;
    div.style.cssText='border:1px dashed #a78bfa;border-radius:8px;padding:8px 10px;margin:6px 0;background:#faf7ff';
    div.innerHTML =
      '<div class="d-flex align-items-center gap-2">'+
      '<input type="checkbox" class="form-check-input control-toggle" name="control_ids" value="'+id+'" id="ctrl-'+id+'" checked onchange="updateCount()">'+
      '<strong>'+id+'</strong> <span class="badge bg-info text-dark">added by AI</span>'+
      (a && a.reason ? '<span class="text-muted small ms-1">'+escAttr(a.reason)+'</span>' : '')+'</div>'+
      '<input type="hidden" name="title_'+id+'" value="'+id+'">'+
      '<input type="hidden" name="family_'+id+'" value="'+fam+'">'+
      '<input type="hidden" name="priority_'+id+'" value="P1">'+
      (a && a.tailoring ? '<input type="hidden" name="tailored['+id+']" value="'+escAttr(a.tailoring)+'">' : '');
    (document.getElementById('aiAddedControls')||form).appendChild(div);
  }
  window.AIAssistConfig = {
    mode: 'create',
    projectId: {{project.id}},
    frameworkLabel: {{{json framework.label}}},
    profileSummary: {{{json frameworkSummary}}},
    baselineCount: {{baselineCount}},
    projectContext: {{{json project.name}}} + ' — ' + ({{{json project.description}}} || '').slice(0, 400),
    subtitle: 'Tailoring · approve any change',
    getSelected: function(){
      return Array.prototype.map.call(document.querySelectorAll('.control-toggle:checked'), function(cb){
        return { id: cb.value, title: ctrlTitle(cb.value) };
      });
    },
    applyActions: function(actions){
      (actions||[]).forEach(function(a){
        var op=(a.op||'').toLowerCase();
        (a.controlIds||[]).forEach(function(id){
          var cb=document.getElementById('ctrl-'+id);
          if(op==='remove'){ if(cb){ cb.checked=false; var c=document.getElementById('card-'+id); if(c) c.style.opacity='.5'; } }
          else if(op==='add'){ if(cb){ cb.checked=true; var c2=document.getElementById('card-'+id); if(c2) c2.style.opacity=''; } else { injectControl(id, a); } }
          else if(op==='tailor'){ var ta=document.querySelector('[name="tailored['+id+']"]'); if(ta && a.tailoring){ ta.value=a.tailoring; ta.style.boxShadow='0 0 0 2px #c4b5fd'; } }
        });
      });
      updateCount();
    }
  };
})();

// Per-control "Refine with AI": expand a brief note into a fuller draft (approval-gated).
async function aiRefineControl(id, title, btn){
  var ta=document.getElementById('tailored-'+id); if(!ta) return;
  var summary=(ta.value||'').trim();
  if(summary.length<3){ ta.focus(); ta.setAttribute('placeholder','Type a short note first, then Refine with AI…'); return; }
  var orig=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> Refining…';
  try{
    var g=document.querySelector('[name="control_guidance_'+id+'"]');
    var r=await fetch('/api/ai/refine-answer',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({controlId:id,controlTitle:title||'',controlGuidance:g?g.value:'',userSummary:summary,frameworkLabel:(window.AIAssistConfig&&AIAssistConfig.frameworkLabel)||'ITSG-33'})});
    var data=await r.json();
    if(!r.ok||!data.success) throw new Error(data.error||'Could not refine.');
    aiShowRefinePreview(ta, data.refined);
  }catch(e){ alert(e.message); }
  btn.disabled=false; btn.innerHTML=orig;
}
function aiShowRefinePreview(ta, refined){
  var esc=function(s){return String(s).replace(/[&<>]/g,function(m){return({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]);});};
  var old=ta.parentNode.querySelector('.ai-refine-preview'); if(old) old.remove();
  var box=document.createElement('div'); box.className='ai-refine-preview';
  box.style.cssText='border:1px solid #ddd6fe;background:#faf7ff;border-radius:8px;padding:8px 10px;margin-top:6px;font-size:12.5px';
  box.innerHTML='<div class="fw-semibold mb-1" style="color:#6d28d9"><i class="bi bi-stars me-1"></i>AI-refined draft — approve to replace</div>'+
    '<div style="white-space:pre-wrap;color:#22303a">'+esc(refined)+'</div>'+
    '<div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-sm btn-primary py-0 aiap">Approve</button><button type="button" class="btn btn-sm btn-outline-secondary py-0 aidz">Discard</button></div>';
  box.querySelector('.aiap').onclick=function(){ ta.value=refined; ta.style.boxShadow='0 0 0 2px #c4b5fd'; box.remove(); };
  box.querySelector('.aidz').onclick=function(){ box.remove(); };
  ta.parentNode.appendChild(box);
}
</script>
