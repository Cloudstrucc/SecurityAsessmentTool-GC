          <div class="help-card"><div class="tag">{{t 'ah.tagReview'}}</div><b>{{t 'ah.c2Title'}}</b><span>{{t 'ah.c2Body'}}</span></div>
          <div class="help-card"><div class="tag">{{t 'ah.tagEvidence'}}</div><b>{{t 'ah.c3Title'}}</b><span>{{t 'ah.c3Body'}}</span></div>
