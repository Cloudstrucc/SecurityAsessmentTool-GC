      <div class="help-toc-inner">
        <div class="toc-label">{{t 'hf.contents'}}</div>
        <a href="?section=getting-started" data-sec="getting-started"><i class="bi bi-compass"></i> {{t 'hf.sGettingStarted'}}</a>
        <a href="?section=projects" data-sec="projects"><i class="bi bi-folder2-open"></i> {{t 'hf.sProjects'}}</a>
