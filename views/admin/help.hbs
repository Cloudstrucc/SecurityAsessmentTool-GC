<style>
  .help-page .rule{height:3px;width:56px;background:var(--cs-grad);border-radius:2px;margin-top:.4rem}
  .help-layout{display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:start}
  .help-toc{position:sticky;top:16px}
  .help-toc-inner{background:#fff;border:1px solid var(--cs-border);border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:2px}
  .help-toc .toc-label{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:var(--cs-muted);padding:6px 10px 8px}
  .help-toc a{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:8px;color:var(--cs-link);text-decoration:none;font-size:.9rem}
  .help-toc a:hover{background:#f1f5f9}
  .help-toc a.active{background:#eef6fd;color:var(--cs-nav);font-weight:700}
  .help-toc a .bi{font-size:1rem;width:18px;text-align:center}
  .help-content{min-width:0}
  .help-sec{background:#fff;border:1px solid var(--cs-border);border-radius:14px;padding:20px 24px;margin-bottom:18px;scroll-margin-top:16px;position:relative}
  .help-sec h2{font-size:1.25rem;display:flex;align-items:center;gap:10px;margin:0 0 12px;color:var(--cs-blue)}
  .help-sec h3{font-size:1rem;color:var(--cs-blue);margin:18px 0 6px}
  .help-sec p{margin:0 0 10px;line-height:1.65}
  .help-sec ul{margin:0 0 10px;padding-left:1.1rem}
  .help-sec li{margin-bottom:6px;line-height:1.6}
  .help-sec .new-badge{position:absolute;top:16px;right:18px;background:#eaf7f1;border:1px solid #8fd0b3;color:#1c6f4a;font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.5px;padding:2px 9px;border-radius:20px}
  .help-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:6px 0 10px}
  .help-card{border:1px solid var(--cs-border);border-radius:10px;padding:11px 13px;background:#fbfdff;display:flex;flex-direction:column;gap:3px}
  .help-card .tag{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--cs-accent-dk)}
  .help-card b{color:var(--cs-blue)} .help-card span{font-size:.86rem;color:var(--cs-muted)}
  .help-ex{list-style:none;padding-left:0}
  .help-ex li{display:flex;gap:8px;align-items:flex-start;background:#f6f9fc;border:1px solid var(--cs-border);border-radius:8px;padding:8px 11px;margin-bottom:6px;font-size:.9rem}
  .help-ex .bi{color:var(--cs-accent-dk)}
  .help-note{display:flex;gap:9px;align-items:flex-start;background:#eef6fd;border:1px solid #cfe4f6;border-radius:8px;padding:10px 13px;font-size:.9rem;color:var(--cs-text)}
  .help-note .bi{color:var(--cs-accent-dk);font-size:1.1rem}
  @media(max-width:860px){.help-layout{grid-template-columns:1fr}.help-toc{position:static}.help-toc-inner{flex-direction:row;flex-wrap:wrap;overflow-x:auto}}
</style>

<script>
(function(){
  var toc = document.querySelectorAll('.help-toc a[data-sec]');
  var secs = document.querySelectorAll('.help-sec');
  var lockUntil = 0; // while set (deep-link / click settling), the scroll-spy won't fight the URL
  function setActive(id){
    toc.forEach(function(a){ a.classList.toggle('active', a.getAttribute('data-sec')===id); });
  }
  function updateUrl(id){ try{ history.replaceState(null,'','?section='+id); }catch(e){} }
  function scrollToSection(id, smooth){
    var el = document.getElementById(id); if(!el) return;
    el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
  }
  // Click a TOC item → scroll + update URL (no full navigation).
  toc.forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var id = a.getAttribute('data-sec');
      lockUntil = Date.now() + 700;
      setActive(id); updateUrl(id); scrollToSection(id, true);
    });
  });
  // Scroll-spy: reflect the section in view in the TOC + the URL (unless locked).
  if('IntersectionObserver' in window){
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting && Date.now() > lockUntil){ setActive(en.target.id); updateUrl(en.target.id); }
      });
    }, { rootMargin:'-20% 0px -70% 0px', threshold:0 });
    secs.forEach(function(s){ obs.observe(s); });
  }
  // Deep link: /admin/help?section=slug (also accepts a bare ?slug like ?assistant).
  function initialSection(){
    var p = new URLSearchParams(location.search);
    if(p.get('section') && document.getElementById(p.get('section'))) return p.get('section');
    for(var k of p.keys()){ if(document.getElementById(k)) return k; } // ?assistant
    return null;
  }
  var start = initialSection();
  if(start && start !== 'getting-started'){
    lockUntil = Date.now() + 1200; // don't let the observer overwrite the deep link while we settle
    setActive(start);
    // Wait for fonts/layout, then jump precisely.
    window.addEventListener('load', function(){ setTimeout(function(){ scrollToSection(start); updateUrl(start); }, 80); });
    setTimeout(function(){ scrollToSection(start); }, 250);
  } else { setActive('getting-started'); }
})();
</script>
