<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{project.name}}</h1>
      <p class="text-muted mb-0">{{t 'ui.projectDetailsAssessments'}}</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/projects/{{project.id}}/guidance" class="btn btn-outline-success">
        <i class="bi bi-file-text me-1"></i>{{t 'ui.webGuidance'}}
      </a>
      {{#if isArchived}}
        <form action="/admin/projects/{{project.id}}/unarchive" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-counterclockwise me-1"></i>{{t 'ui.restore'}}
          </button>
        </form>
      {{else}}
        <form action="/admin/projects/{{project.id}}/archive" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-secondary" title="{{t 'ui.hideFromTheDashboardWithout'}}">
            <i class="bi bi-archive me-1"></i>{{t 'ui.archive'}}
          </button>
        </form>
      {{/if}}
      <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteProjectModal">
        <i class="bi bi-trash me-1"></i>{{t 'ui.deleteProject'}}
      </button>
    </div>
  </div>

  {{> process-flow flow=projectFlow titleKey='pf.title' idPrefix='pfproj'}}

  {{#if isArchived}}
    <div class="alert alert-dark d-flex align-items-center" role="alert">
      <i class="bi bi-archive-fill me-2"></i>
      <div>{{t 'ux.archivedBanner'}}</div>
    </div>
  {{/if}}

  <div class="row g-4">
    <!-- Project Info -->
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header"><i class="bi bi-info-circle me-2"></i>{{t 'ui.projectInformation'}}</div>
        <div class="card-body">
          <table class="table table-borderless mb-0">
            <tr>
              <td class="fw-semibold text-muted" style="width:40%">{{t 'ui.classification'}}</td>
              <td><span class="badge bg-info">{{project.data_classification}}</span></td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">{{t 'ui.framework'}}</td>
              <td>
                <span class="badge bg-light text-dark border">{{project.security_framework}}</span>
                {{#if project.framework_baseline}}<div class="small text-muted mt-1">{{project.framework_baseline}}{{#if project.framework_category}} · {{project.framework_category}}{{/if}}</div>{{/if}}
              </td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">{{t 'ui.hosting'}}</td>
              <td>{{project.hosting_type}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">{{t 'ui.appType'}}</td>
              <td>{{project.app_type}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">PII</td>
              <td>
                {{#if project.has_pii}}
                  <span class="badge bg-warning"><i class="bi bi-person-badge me-1"></i>{{t 'ui.yes'}}</span>
                {{else}}
                  <span class="badge bg-secondary">No</span>
                {{/if}}
              </td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">{{t 'ui.status'}}</td>
              <td>{{{statusBadge project.status}}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">{{t 'ui.created'}}</td>
              <td>{{formatDate project.created_at}}</td>
            </tr>
          </table>

          {{#if project.description}}
            <hr>
            <h6 class="fw-semibold text-muted mb-2">{{t 'ui.description'}}</h6>
            <p class="small mb-0">{{project.description}}</p>
          {{/if}}

          {{#if techNames.length}}
            <hr>
            <h6 class="fw-semibold text-muted mb-2">{{t 'ui.technologyStack'}}</h6>
            <div class="d-flex flex-wrap gap-1">
              {{#each techNames}}
                <span class="badge bg-light text-dark border">{{this}}</span>
              {{/each}}
            </div>
          {{/if}}
        </div>
      </div>

      <!-- Contacts -->
      <div class="card mt-3">
        <div class="card-header bg-light"><i class="bi bi-people me-2"></i>{{t 'ui.keyContacts'}}</div>
        <div class="card-body">
          {{#if project.project_owner_name}}
            <div class="mb-3">
              <div class="small text-muted text-uppercase fw-bold">{{t 'ui.projectOwnerArchitect'}}</div>
              <div class="fw-semibold">{{project.project_owner_name}}</div>
              {{#if project.project_owner_email}}<div class="small text-muted">{{project.project_owner_email}}</div>{{/if}}
            </div>
          {{/if}}
          {{#if project.project_authority_name}}
            <div class="mb-3">
              <div class="small text-muted text-uppercase fw-bold">{{t 'ui.projectAuthority'}}</div>
              <div class="fw-semibold">{{project.project_authority_name}}</div>
              {{#if project.project_authority_email}}<div class="small text-muted">{{project.project_authority_email}}</div>{{/if}}
            </div>
          {{/if}}
          {{#if project.cio_name}}
            <div>
              <div class="small text-muted text-uppercase fw-bold">{{t 'ui.cioDelegatedAuthority'}}</div>
              <div class="fw-semibold">{{project.cio_name}}</div>
              {{#if project.cio_email}}<div class="small text-muted">{{project.cio_email}}</div>{{/if}}
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mt-3" id="reporting">
        <div class="card-header bg-light"><i class="bi bi-palette me-2"></i>{{t 'ui.reportBranding'}}</div>
        <div class="card-body">
          <form method="POST" action="/admin/projects/{{project.id}}/branding" enctype="multipart/form-data">
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="organization_name">{{t 'ui.organizationName'}}</label>
              <input type="text" class="form-control form-control-sm" id="organization_name" name="organization_name" value="{{branding.organization_name}}" placeholder="{{t 'ui.vanguardCybersecurity'}}">
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="logo">{{t 'ui.organizationLogo'}}</label>
              <input type="file" class="form-control form-control-sm" id="logo" name="logo" accept=".png,.jpg,.jpeg">
              {{#if branding.logo_original_name}}<div class="form-text">Current logo: {{branding.logo_original_name}}</div>{{/if}}
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="report_subtitle">{{t 'ui.reportSubtitle'}}</label>
              <input type="text" class="form-control form-control-sm" id="report_subtitle" name="report_subtitle" value="{{branding.report_subtitle}}">
            </div>
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label small fw-semibold" for="classification_label">{{t 'ui.classificationLabel'}}</label>
                <input type="text" class="form-control form-control-sm" id="classification_label" name="classification_label" value="{{branding.classification_label}}" placeholder="{{t 'ui.protectedB'}}">
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold" for="assessor_company_name">{{t 'ui.assessorCompany'}}</label>
                <input type="text" class="form-control form-control-sm" id="assessor_company_name" name="assessor_company_name" value="{{branding.assessor_company_name}}" placeholder="{{t 'ui.vanguardcsCa'}}">
              </div>
            </div>
            <button type="submit" class="btn btn-sm btn-primary mt-3"><i class="bi bi-save me-1"></i>{{t 'ui.saveBranding'}}</button>
          </form>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header bg-light"><i class="bi bi-person-check me-2"></i>{{t 'ui.assignment'}}</div>
        <div class="card-body">
          {{#if intakeAssignments.length}}
            <div class="small text-muted fw-semibold mb-1">{{t 'ui.intake'}}</div>
            {{#each intakeAssignments}}
              <div class="d-flex justify-content-between small mb-1">
                <span>{{#if this.assignee_name}}{{this.assignee_name}}{{else}}{{this.assignee_email}}{{/if}}</span>
                <span class="badge bg-light text-dark border">{{this.assignee_role}} {{#if (eq this.status 'pending')}}pending{{/if}}</span>
              </div>
            {{/each}}
          {{/if}}
          {{#if assessmentAssignments.length}}
            <div class="small text-muted fw-semibold mt-2 mb-1">{{t 'ui.assessment'}}</div>
            {{#each assessmentAssignments}}
              <div class="d-flex justify-content-between small mb-1">
                <span>{{#if this.assignee_name}}{{this.assignee_name}}{{else}}{{this.assignee_email}}{{/if}}</span>
                <span class="badge bg-light text-dark border">{{this.assignee_role}} {{#if (eq this.status 'pending')}}pending{{/if}}</span>
              </div>
            {{/each}}
          {{/if}}
          {{#unless intakeAssignments.length}}
            {{#unless assessmentAssignments.length}}
              <p class="text-muted small mb-3">{{t 'ui.noAssignmentsYet'}}</p>
            {{/unless}}
          {{/unless}}

          <form method="POST" action="/admin/projects/{{project.id}}/assign" class="mt-3">
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="assign_target">{{t 'ui.assign'}}</label>
              <select class="form-select form-select-sm" id="assign_target" name="assign_target">
                <option value="all">{{t 'ui.projectIntakeAndAssessments'}}</option>
                {{#each intakes}}
                  <option value="intake:{{this.id}}">Intake {{this.ref_code}}</option>
                {{/each}}
                {{#each assessments}}
                  <option value="assessment:{{this.id}}">Assessment {{this.invite_code}}</option>
                {{/each}}
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="project_assignment_mode">{{t 'ui.user'}}</label>
              <select class="form-select form-select-sm assignment-mode" id="project_assignment_mode" name="assignment_mode" data-scope="project">
                <option value="existing">{{t 'ui.selectExistingUser'}}</option>
                <option value="invite">{{t 'ui.inviteNewUser'}}</option>
              </select>
            </div>
            <div class="assignment-existing-project mb-2">
              <select class="form-select form-select-sm" name="assignee_user_id">
                <option value="">{{t 'ui.chooseAUser'}}</option>
                {{#each users}}
                  <option value="{{this.id}}">{{this.name}} — {{this.email}} ({{this.role}})</option>
                {{/each}}
              </select>
            </div>
            <div class="assignment-invite-project d-none">
              <div class="row g-2">
                <div class="col-5">
                  <select class="form-select form-select-sm" name="assignee_role">
                    <option value="client">{{t 'ui.client'}}</option>
                    <option value="assessor">{{t 'ui.assessor'}}</option>
                  </select>
                </div>
                <div class="col-7"><input type="text" class="form-control form-control-sm" name="invite_name" placeholder="{{t 'ui.name'}}"></div>
                <div class="col-12"><input type="email" class="form-control form-control-sm" name="invite_email" placeholder="{{t 'ui.email'}}"></div>
                <div class="col-12"><input type="text" class="form-control form-control-sm" name="invite_organization" placeholder="{{t 'ui.organization'}}"></div>
              </div>
            </div>
            <textarea class="form-control form-control-sm mt-2" name="assignment_notes" rows="2" placeholder="{{t 'ui.optionalMessage'}}"></textarea>
            <button type="submit" class="btn btn-sm btn-primary w-100 mt-2">
              <i class="bi bi-person-plus me-1"></i>{{t 'ui.assign'}}
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Assessments -->
    <div class="col-lg-7">
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-inbox me-2"></i>{{t 'ui.projectIntake'}}</span>
          {{#unless intakes.length}}
            <form method="POST" action="/admin/projects/{{project.id}}/intake/create" class="mb-0">
              <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-plus-lg me-1"></i>{{t 'ui.create'}}</button>
            </form>
          {{/unless}}
        </div>
        <div class="card-body p-0">
          {{#if intakes.length}}
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>{{t 'ui.reference'}}</th>
                  <th>{{t 'ui.status'}}</th>
                  <th>{{t 'ui.updated'}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each intakes}}
                  <tr>
                    <td><code>{{this.ref_code}}</code></td>
                    <td>{{{statusBadge this.status}}}</td>
                    <td class="small text-muted">{{formatDate this.updated_at}}</td>
                    <td class="text-end">
                      <a href="/admin/intakes/{{this.id}}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          {{else}}
            <div class="p-4 text-center text-muted">
              <p class="mb-2">{{t 'ui.noIntakeRecordExistsFor'}}</p>
              <form method="POST" action="/admin/projects/{{project.id}}/intake/create">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>{{t 'ui.createIntake'}}</button>
              </form>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mb-3" id="documentation">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-files me-2"></i>{{t 'ui.documentation'}}</span>
          <span class="badge bg-light text-dark">{{documents.length}} document(s)</span>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/projects/{{project.id}}/documents" enctype="multipart/form-data" class="mb-3">
            <label class="form-label small fw-semibold" for="documents">{{t 'ui.uploadProjectDocuments'}}</label>
            <div class="input-group input-group-sm">
              <input type="file" class="form-control" id="documents" name="documents" multiple accept=".pdf,.doc,.docx,.txt,.md,.html,.htm,.png,.jpg,.jpeg,.csv,.xlsx,.pptx">
              <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>{{t 'ui.upload'}}</button>
            </div>
            <div class="form-text">{{t 'ui.documentsAreRetainedForAi'}}</div>
          </form>

          {{#if documents.length}}
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>{{t 'ui.document'}}</th>
                    <th>{{t 'ui.type'}}</th>
                    <th>{{t 'ui.uploaded'}}</th>
                    <th>{{t 'ui.uploadedBy'}}</th>
                    <th>{{t 'ui.size'}}</th>
                    <th>{{t 'ui.relatedProject'}}</th>
                    <th class="text-end">{{t 'ui.actions'}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each documents}}
                    <tr>
                      <td class="fw-semibold">{{this.original_name}}</td>
                      <td><span class="badge bg-light text-dark border">{{this.document_type}}</span></td>
                      <td class="small text-muted">{{formatDate this.created_at}}</td>
                      <td class="small">{{this.uploaded_by_name}}</td>
                      <td class="small">{{this.display_size}}</td>
                      <td class="small">{{this.project_name}}</td>
                      <td class="text-end text-nowrap">
                        <a href="/admin/projects/{{../project.id}}/documents/{{this.id}}/download" class="btn btn-sm btn-outline-primary" title="{{t 'ui.viewOrDownload'}}">
                          <i class="bi bi-download"></i>
                        </a>
                        <a href="/admin/projects/{{../project.id}}/assessments/new?documents={{this.id}}" class="btn btn-sm btn-outline-success" title="{{t 'ui.useForAiAssistedControl'}}">
                          <i class="bi bi-stars"></i>
                        </a>
                        <form method="POST" action="/admin/projects/{{../project.id}}/documents/{{this.id}}/delete" class="d-inline"
                          onsubmit="return confirm('Remove this document reference?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="{{t 'ui.deleteReference'}}"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <p class="text-muted small mb-0">{{t 'ui.noProjectDocumentsUploadedYet'}}</p>
          {{/if}}
        </div>
      </div>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-clipboard-check me-2"></i>{{t 'ui.assessments'}}</span>
          <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-sm btn-outline-light">
            <i class="bi bi-plus-lg me-1"></i>{{t 'ui.create'}}
          </a>
        </div>
        <div class="card-body p-0">
          {{#if assessments.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{t 'ui.type'}}</th>
                    <th>{{t 'ui.status'}}</th>
                    <th>{{t 'ui.score'}}</th>
                    <th>{{t 'ui.result'}}</th>
                    <th>{{t 'ui.inviteCode'}}</th>
                    <th>{{t 'ui.intake'}}</th>
                    <th>{{t 'ui.updated'}}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{#each assessments}}
                    <tr>
                      <td class="fw-semibold text-capitalize">{{this.type}}</td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td>
                        {{#if this.overall_score}}
                          <span class="fw-bold">{{this.overall_score}}%</span>
                        {{else}}
                          <span class="text-muted">—</span>
                        {{/if}}
                      </td>
                      <td>
                        {{#if this.result}}{{{statusBadge this.result}}}{{else}}<span class="text-muted">—</span>{{/if}}
                      </td>
                      <td><code class="small">{{this.invite_code}}</code></td>
                      <td class="small">{{#if this.intake_ref_code}}<code>{{this.intake_ref_code}}</code>{{else}}<span class="text-muted">—</span>{{/if}}</td>
                      <td class="small text-muted">{{formatDate this.updated_at}}</td>
                      <td class="text-end text-nowrap">
                        <a href="/admin/assessments/{{this.id}}" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-eye"></i>
                        </a>
                        {{#if (eq this.status 'draft')}}
                          <form action="/admin/assessments/{{this.id}}/delete" method="POST" class="d-inline ms-1"
                            onsubmit="return confirm('Delete this draft assessment? This cannot be undone.')">
                            <input type="hidden" name="return_to" value="/admin/projects/{{../project.id}}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{t 'ui.deleteDraft'}}">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-5 text-center text-muted">
              <i class="bi bi-clipboard-plus" style="font-size:3rem"></i>
              <p class="mt-3 mb-2">{{t 'ui.noAssessmentsYetForThis'}}</p>
              <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>{{t 'ui.startAssessment'}}
              </a>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-award me-2"></i>{{t 'dp.title'}}</span>
          <span class="badge bg-light text-dark border">{{decisionPackages.length}}</span>
        </div>
        <div class="card-body">
          <p class="small text-muted">{{t 'dp.blurb'}}</p>
          {{#if decisionFlow}}
            {{> process-flow flow=decisionFlow titleKey='pf.decisionProgress' idPrefix='pfdpproj'}}
          {{/if}}
          {{#if decisionPackages.length}}
            <div class="table-responsive">
              <table class="table table-sm align-middle">
                <thead><tr>
                  <th>{{t 'dp.reference'}}</th><th>{{t 'dp.type'}}</th><th>{{t 'dp.state'}}</th>
                  <th>{{t 'dp.pinnedVersion'}}</th><th></th>
                </tr></thead>
                <tbody>
                  {{#each decisionPackages}}
                    <tr>
                      <td><code>{{this.reference}}</code></td>
                      <td>{{#eq this.decision_type 'iato'}}{{t 'dp.typeIato'}}{{else}}{{#eq this.decision_type 'denied'}}{{t 'dp.typeDenied'}}{{else}}{{t 'dp.typeAto'}}{{/eq}}{{/eq}}</td>
                      <td><span class="badge bg-secondary">{{t (dpStateKey this.state)}}</span></td>
                      <td>{{#if this.assessment_version}}<span class="badge bg-success">v{{this.assessment_version}}</span>{{else}}<span class="text-muted">—</span>{{/if}}</td>
                      <td class="text-end">
                        <a href="/admin/decision-packages/{{this.id}}" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-box-arrow-up-right me-1"></i>{{t 'dp.openPackage'}}
                        </a>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <p class="text-muted small">{{t 'dp.none'}}</p>
          {{/if}}

          <form method="POST" action="/admin/projects/{{project.id}}/decision-packages" class="row g-2 align-items-end mt-2">
            <div class="col-md-5">
              <label class="form-label small">{{t 'dp.selectAssessment'}}</label>
              <select class="form-select form-select-sm" name="assessment_id">
                <option value="">—</option>
                {{#each assessments}}<option value="{{this.id}}">#{{this.id}} · {{this.status}}</option>{{/each}}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small">{{t 'dp.type'}}</label>
              <select class="form-select form-select-sm" name="decision_type">
                <option value="ato">{{t 'dp.typeAto'}}</option>
                <option value="iato">{{t 'dp.typeIato'}}</option>
                <option value="denied">{{t 'dp.typeDenied'}}</option>
              </select>
            </div>
            <div class="col-md-3">
              <button class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>{{t 'dp.create'}}</button>
            </div>
          </form>
        </div>
      </div>

      {{!-- Collaboration --}}
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-chat-dots me-2"></i>{{t 'co.title'}}</span>
          <form method="POST" action="/admin/projects/{{project.id}}/collaboration-toggle" class="d-inline">
            <button class="btn btn-sm btn-outline-secondary">
              {{#if collabEnabled}}{{t 'co.turnOff'}}{{else}}{{t 'co.turnOn'}}{{/if}}
            </button>
          </form>
        </div>
        <div class="card-body">
          {{#if collabEnabled}}
            <p class="small text-muted">{{t 'co.blurb'}}</p>
            {{#if collabMessages.length}}
              <ul class="list-group list-group-flush mb-2">
                {{#each collabMessages}}
                  <li class="list-group-item px-0">
                    <div class="small"><strong>{{this.user_name}}</strong>
                      <span class="text-muted ms-1">{{formatDateTime this.created_at}}</span></div>
                    <div class="small">{{this.body}}</div>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="text-muted small">{{t 'co.empty'}}</p>
            {{/if}}
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.Collab && window.Collab.open()">
              <i class="bi bi-chat-dots me-1"></i>{{t 'co.expand'}} ({{collabCount}})
            </button>
          {{else}}
            <p class="text-muted small mb-0">{{t 'co.disabled'}}</p>
          {{/if}}
        </div>
    </div>
  </div>
</div>

<!-- Delete Project — GitHub-style danger confirmation -->
<div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-labelledby="deleteProjectModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="deleteProjectModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>{{t 'ui.deleteProject2'}}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{t 'ui.close'}}"></button>
      </div>
      <div class="modal-body">
        {{#if hasNonDraftAssessments}}
          <div class="alert alert-warning">
            <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>This project has {{nonDraftAssessments.length}} active (non-draft) assessment(s).</div>
            <p class="mb-2 small">{{t 'ui.deletingTheProjectWill'}} <strong>{{t 'ui.permanentlyDestroy'}}</strong> {{t 'ui.theFollowingAssessmentSAnd'}}</p>
            <ul class="small mb-0">
              {{#each nonDraftAssessments}}
                <li><code>{{this.invite_code}}</code> — {{{statusBadge this.status}}}</li>
              {{/each}}
            </ul>
          </div>
          <div class="border rounded p-3 mb-3 bg-light">
            <div class="fw-semibold mb-1"><i class="bi bi-archive me-1"></i>{{t 'ui.archiveInstead'}} <span class="badge bg-success ms-1">{{t 'ui.recommended'}}</span></div>
            <p class="small text-muted mb-2">{{t 'ui.archivingKeepsTheProjectAnd'}}</p>
            <form action="/admin/projects/{{project.id}}/archive" method="POST">
              <button type="submit" class="btn btn-success"><i class="bi bi-archive me-1"></i>{{t 'ui.archiveThisProject'}}</button>
            </form>
          </div>
          <hr>
          <p class="fw-semibold text-danger mb-2"><i class="bi bi-fire me-1"></i>{{t 'ui.orPermanentlyDeleteEverything'}}</p>
        {{else}}
          <p class="mb-2">{{t 'ui.thisWillPermanentlyDeleteThe'}} <strong>{{t 'ui.thisCannotBeUndone'}}</strong></p>
          <p class="text-muted small mb-3">{{t 'ui.preferToKeepTheData'}} <strong>{{t 'ui.archive'}}</strong> {{t 'ui.insteadItHidesTheProject'}}</p>
        {{/if}}

        <form action="/admin/projects/{{project.id}}/delete" method="POST" id="deleteProjectForm">
          <label class="form-label small">{{t 'ui.toConfirmTypeTheProject'}} <code id="deleteProjectExpected">{{project.name}}</code> {{t 'ui.below'}}</label>
          <input type="text" name="confirm_name" id="deleteProjectConfirmInput" class="form-control"
                 autocomplete="off" data-expected="{{project.name}}" placeholder="{{t 'ui.typeTheProjectNameTo'}}">
          <button type="submit" id="deleteProjectSubmit" class="btn btn-danger w-100 mt-3" disabled>
            <i class="bi bi-trash me-1"></i>{{t 'ui.iUnderstandTheConsequencesDelete'}}
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var input = document.getElementById('deleteProjectConfirmInput');
  var submit = document.getElementById('deleteProjectSubmit');
  if (input && submit) {
    var expected = input.getAttribute('data-expected') || '';
    var evaluate = function () {
      submit.disabled = input.value.trim() !== expected.trim();
    };
    input.addEventListener('input', evaluate);
    var modal = document.getElementById('deleteProjectModal');
    if (modal) {
      modal.addEventListener('shown.bs.modal', function () { input.value = ''; evaluate(); input.focus(); });
      // Allow deep-linking to the danger zone (e.g. from the projects list).
      if (window.location.hash === '#delete' && window.bootstrap) {
        bootstrap.Modal.getOrCreateInstance(modal).show();
      }
    }
    evaluate();
  }
})();
</script>

<script>
document.querySelectorAll('.assignment-mode').forEach(select => {
  const sync = () => {
    const scope = select.dataset.scope;
    document.querySelectorAll('.assignment-existing-' + scope).forEach(el => el.classList.toggle('d-none', select.value !== 'existing'));
    document.querySelectorAll('.assignment-invite-' + scope).forEach(el => el.classList.toggle('d-none', select.value !== 'invite'));
  };
  select.addEventListener('change', sync);
  sync();
});
</script>

