<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{project.name}}</h1>
      <p class="text-muted mb-0">Project Details & Assessments</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/projects/{{project.id}}/guidance" class="btn btn-outline-success">
        <i class="bi bi-file-text me-1"></i>Web Guidance
      </a>
      <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Assessment
      </a>
      <form action="/admin/projects/{{project.id}}/delete" method="POST" class="d-inline"
        onsubmit="return confirm('Delete this project and all its draft assessments? This cannot be undone.')">
        <button type="submit" class="btn btn-outline-danger">
          <i class="bi bi-trash me-1"></i>Delete Project
        </button>
      </form>
    </div>
  </div>

  <div class="row g-4">
    <!-- Project Info -->
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header"><i class="bi bi-info-circle me-2"></i>Project Information</div>
        <div class="card-body">
          <table class="table table-borderless mb-0">
            <tr>
              <td class="fw-semibold text-muted" style="width:40%">Classification</td>
              <td><span class="badge bg-info">{{project.data_classification}}</span></td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">Framework</td>
              <td>
                <span class="badge bg-light text-dark border">{{project.security_framework}}</span>
                {{#if project.framework_baseline}}<div class="small text-muted mt-1">{{project.framework_baseline}}{{#if project.framework_category}} · {{project.framework_category}}{{/if}}</div>{{/if}}
              </td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">Hosting</td>
              <td>{{project.hosting_type}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">App Type</td>
              <td>{{project.app_type}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">PII</td>
              <td>
                {{#if project.has_pii}}
                  <span class="badge bg-warning"><i class="bi bi-person-badge me-1"></i>Yes</span>
                {{else}}
                  <span class="badge bg-secondary">No</span>
                {{/if}}
              </td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">Status</td>
              <td>{{{statusBadge project.status}}}</td>
            </tr>
            <tr>
              <td class="fw-semibold text-muted">Created</td>
              <td>{{formatDate project.created_at}}</td>
            </tr>
          </table>

          {{#if project.description}}
            <hr>
            <h6 class="fw-semibold text-muted mb-2">Description</h6>
            <p class="small mb-0">{{project.description}}</p>
          {{/if}}

          {{#if techNames.length}}
            <hr>
            <h6 class="fw-semibold text-muted mb-2">Technology Stack</h6>
            <div class="d-flex flex-wrap gap-1">
              {{#each techNames}}
                <span class="badge bg-light text-dark border">{{this}}</span>
              {{/each}}
            </div>
          {{/if}}
        </div>
      </div>

      <!-- Contacts -->
      <div class="card mt-3">
        <div class="card-header bg-light"><i class="bi bi-people me-2"></i>Key Contacts</div>
        <div class="card-body">
          {{#if project.project_owner_name}}
            <div class="mb-3">
              <div class="small text-muted text-uppercase fw-bold">Project Owner / Architect</div>
              <div class="fw-semibold">{{project.project_owner_name}}</div>
              {{#if project.project_owner_email}}<div class="small text-muted">{{project.project_owner_email}}</div>{{/if}}
            </div>
          {{/if}}
          {{#if project.project_authority_name}}
            <div class="mb-3">
              <div class="small text-muted text-uppercase fw-bold">Project Authority</div>
              <div class="fw-semibold">{{project.project_authority_name}}</div>
              {{#if project.project_authority_email}}<div class="small text-muted">{{project.project_authority_email}}</div>{{/if}}
            </div>
          {{/if}}
          {{#if project.cio_name}}
            <div>
              <div class="small text-muted text-uppercase fw-bold">CIO / Delegated Authority</div>
              <div class="fw-semibold">{{project.cio_name}}</div>
              {{#if project.cio_email}}<div class="small text-muted">{{project.cio_email}}</div>{{/if}}
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mt-3" id="reporting">
        <div class="card-header bg-light"><i class="bi bi-palette me-2"></i>Report Branding</div>
        <div class="card-body">
          <form method="POST" action="/admin/projects/{{project.id}}/branding" enctype="multipart/form-data">
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="organization_name">Organization Name</label>
              <input type="text" class="form-control form-control-sm" id="organization_name" name="organization_name" value="{{branding.organization_name}}" placeholder="Vanguard Cybersecurity">
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="logo">Organization Logo</label>
              <input type="file" class="form-control form-control-sm" id="logo" name="logo" accept=".png,.jpg,.jpeg">
              {{#if branding.logo_original_name}}<div class="form-text">Current logo: {{branding.logo_original_name}}</div>{{/if}}
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="report_subtitle">Report Subtitle</label>
              <input type="text" class="form-control form-control-sm" id="report_subtitle" name="report_subtitle" value="{{branding.report_subtitle}}">
            </div>
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label small fw-semibold" for="classification_label">Classification Label</label>
                <input type="text" class="form-control form-control-sm" id="classification_label" name="classification_label" value="{{branding.classification_label}}" placeholder="Protected B">
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold" for="assessor_company_name">Assessor / Company</label>
                <input type="text" class="form-control form-control-sm" id="assessor_company_name" name="assessor_company_name" value="{{branding.assessor_company_name}}" placeholder="VanguardCS.ca">
              </div>
            </div>
            <button type="submit" class="btn btn-sm btn-primary mt-3"><i class="bi bi-save me-1"></i>Save Branding</button>
          </form>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header bg-light"><i class="bi bi-person-check me-2"></i>Assignment</div>
        <div class="card-body">
          {{#if intakeAssignments.length}}
            <div class="small text-muted fw-semibold mb-1">Intake</div>
            {{#each intakeAssignments}}
              <div class="d-flex justify-content-between small mb-1">
                <span>{{#if this.assignee_name}}{{this.assignee_name}}{{else}}{{this.assignee_email}}{{/if}}</span>
                <span class="badge bg-light text-dark border">{{this.assignee_role}} {{#if (eq this.status 'pending')}}pending{{/if}}</span>
              </div>
            {{/each}}
          {{/if}}
          {{#if assessmentAssignments.length}}
            <div class="small text-muted fw-semibold mt-2 mb-1">Assessment</div>
            {{#each assessmentAssignments}}
              <div class="d-flex justify-content-between small mb-1">
                <span>{{#if this.assignee_name}}{{this.assignee_name}}{{else}}{{this.assignee_email}}{{/if}}</span>
                <span class="badge bg-light text-dark border">{{this.assignee_role}} {{#if (eq this.status 'pending')}}pending{{/if}}</span>
              </div>
            {{/each}}
          {{/if}}
          {{#unless intakeAssignments.length}}
            {{#unless assessmentAssignments.length}}
              <p class="text-muted small mb-3">No assignments yet.</p>
            {{/unless}}
          {{/unless}}

          <form method="POST" action="/admin/projects/{{project.id}}/assign" class="mt-3">
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="assign_target">Assign</label>
              <select class="form-select form-select-sm" id="assign_target" name="assign_target">
                <option value="all">Project intake and assessments</option>
                {{#each intakes}}
                  <option value="intake:{{this.id}}">Intake {{this.ref_code}}</option>
                {{/each}}
                {{#each assessments}}
                  <option value="assessment:{{this.id}}">Assessment {{this.invite_code}}</option>
                {{/each}}
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold" for="project_assignment_mode">User</label>
              <select class="form-select form-select-sm assignment-mode" id="project_assignment_mode" name="assignment_mode" data-scope="project">
                <option value="existing">Select existing user</option>
                <option value="invite">Invite new user</option>
              </select>
            </div>
            <div class="assignment-existing-project mb-2">
              <select class="form-select form-select-sm" name="assignee_user_id">
                <option value="">Choose a user...</option>
                {{#each users}}
                  <option value="{{this.id}}">{{this.name}} — {{this.email}} ({{this.role}})</option>
                {{/each}}
              </select>
            </div>
            <div class="assignment-invite-project d-none">
              <div class="row g-2">
                <div class="col-5">
                  <select class="form-select form-select-sm" name="assignee_role">
                    <option value="client">Client</option>
                    <option value="assessor">Assessor</option>
                  </select>
                </div>
                <div class="col-7"><input type="text" class="form-control form-control-sm" name="invite_name" placeholder="Name"></div>
                <div class="col-12"><input type="email" class="form-control form-control-sm" name="invite_email" placeholder="Email"></div>
                <div class="col-12"><input type="text" class="form-control form-control-sm" name="invite_organization" placeholder="Organization"></div>
              </div>
            </div>
            <textarea class="form-control form-control-sm mt-2" name="assignment_notes" rows="2" placeholder="Optional message"></textarea>
            <button type="submit" class="btn btn-sm btn-primary w-100 mt-2">
              <i class="bi bi-person-plus me-1"></i>Assign
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Assessments -->
    <div class="col-lg-7">
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-inbox me-2"></i>Project Intake</span>
          {{#unless intakes.length}}
            <form method="POST" action="/admin/projects/{{project.id}}/intake/create" class="mb-0">
              <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-plus-lg me-1"></i>Create</button>
            </form>
          {{/unless}}
        </div>
        <div class="card-body p-0">
          {{#if intakes.length}}
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>Reference</th>
                  <th>Status</th>
                  <th>Updated</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each intakes}}
                  <tr>
                    <td><code>{{this.ref_code}}</code></td>
                    <td>{{{statusBadge this.status}}}</td>
                    <td class="small text-muted">{{formatDate this.updated_at}}</td>
                    <td class="text-end">
                      <a href="/admin/intakes/{{this.id}}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          {{else}}
            <div class="p-4 text-center text-muted">
              <p class="mb-2">No intake record exists for this project.</p>
              <form method="POST" action="/admin/projects/{{project.id}}/intake/create">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create Intake</button>
              </form>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mb-3" id="documentation">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-files me-2"></i>Documentation</span>
          <span class="badge bg-light text-dark">{{documents.length}} document(s)</span>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/projects/{{project.id}}/documents" enctype="multipart/form-data" class="mb-3">
            <label class="form-label small fw-semibold" for="documents">Upload Project Documents</label>
            <div class="input-group input-group-sm">
              <input type="file" class="form-control" id="documents" name="documents" multiple accept=".pdf,.doc,.docx,.txt,.md,.html,.htm,.png,.jpg,.jpeg,.csv,.xlsx,.pptx">
              <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Upload</button>
            </div>
            <div class="form-text">Documents are retained for AI guidance, control tailoring, reporting references, and audit traceability.</div>
          </form>

          {{#if documents.length}}
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>Document</th>
                    <th>Type</th>
                    <th>Uploaded</th>
                    <th>Uploaded By</th>
                    <th>Size</th>
                    <th>Related Project</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each documents}}
                    <tr>
                      <td class="fw-semibold">{{this.original_name}}</td>
                      <td><span class="badge bg-light text-dark border">{{this.document_type}}</span></td>
                      <td class="small text-muted">{{formatDate this.created_at}}</td>
                      <td class="small">{{this.uploaded_by_name}}</td>
                      <td class="small">{{this.display_size}}</td>
                      <td class="small">{{this.project_name}}</td>
                      <td class="text-end text-nowrap">
                        <a href="/admin/projects/{{../project.id}}/documents/{{this.id}}/download" class="btn btn-sm btn-outline-primary" title="View or download">
                          <i class="bi bi-download"></i>
                        </a>
                        <a href="/admin/projects/{{../project.id}}/assessments/new?documents={{this.id}}" class="btn btn-sm btn-outline-success" title="Use for AI-assisted control selection">
                          <i class="bi bi-stars"></i>
                        </a>
                        <form method="POST" action="/admin/projects/{{../project.id}}/documents/{{this.id}}/delete" class="d-inline"
                          onsubmit="return confirm('Remove this document reference?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete reference"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <p class="text-muted small mb-0">No project documents uploaded yet.</p>
          {{/if}}
        </div>
      </div>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-clipboard-check me-2"></i>Assessments</span>
          <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-sm btn-outline-light">
            <i class="bi bi-plus-lg me-1"></i>Create
          </a>
        </div>
        <div class="card-body p-0">
          {{#if assessments.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Result</th>
                    <th>Invite Code</th>
                    <th>Intake</th>
                    <th>Updated</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{#each assessments}}
                    <tr>
                      <td class="fw-semibold text-capitalize">{{this.type}}</td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td>
                        {{#if this.overall_score}}
                          <span class="fw-bold">{{this.overall_score}}%</span>
                        {{else}}
                          <span class="text-muted">—</span>
                        {{/if}}
                      </td>
                      <td>
                        {{#if this.result}}{{{statusBadge this.result}}}{{else}}<span class="text-muted">—</span>{{/if}}
                      </td>
                      <td><code class="small">{{this.invite_code}}</code></td>
                      <td class="small">{{#if this.intake_ref_code}}<code>{{this.intake_ref_code}}</code>{{else}}<span class="text-muted">—</span>{{/if}}</td>
                      <td class="small text-muted">{{formatDate this.updated_at}}</td>
                      <td class="text-end text-nowrap">
                        <a href="/admin/assessments/{{this.id}}" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-eye"></i>
                        </a>
                        {{#if (eq this.status 'draft')}}
                          <form action="/admin/assessments/{{this.id}}/delete" method="POST" class="d-inline ms-1"
                            onsubmit="return confirm('Delete this draft assessment? This cannot be undone.')">
                            <input type="hidden" name="return_to" value="/admin/projects/{{../project.id}}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete draft">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-5 text-center text-muted">
              <i class="bi bi-clipboard-plus" style="font-size:3rem"></i>
              <p class="mt-3 mb-2">No assessments yet for this project.</p>
              <a href="/admin/projects/{{project.id}}/assessments/new" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Start Assessment
              </a>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reports & Authorization</div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="/admin/projects/{{project.id}}/controls.csv" class="btn btn-sm btn-outline-primary"><i class="bi bi-filetype-csv me-1"></i>Controls CSV</a>
            <a href="/admin/projects/{{project.id}}/controls.pdf" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-pdf me-1"></i>Controls PDF</a>
            <a href="/admin/projects/{{project.id}}/report.pdf" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-richtext me-1"></i>Full Project PDF</a>
            <a href="/admin/projects/{{project.id}}/ato/new?type=ato" class="btn btn-sm btn-success"><i class="bi bi-shield-check me-1"></i>New ATO</a>
            <a href="/admin/projects/{{project.id}}/ato/new?type=iato" class="btn btn-sm btn-warning"><i class="bi bi-shield-exclamation me-1"></i>New iATO</a>
          </div>

          {{#if atoRecords.length}}
            <h6 class="fw-semibold small text-muted text-uppercase">ATO / iATO Records</h6>
            <div class="table-responsive mb-3">
              <table class="table table-sm mb-0">
                <thead><tr><th>Type</th><th>Title</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                <tbody>
                  {{#each atoRecords}}
                    <tr>
                      <td class="text-uppercase">{{this.record_type}}</td>
                      <td>{{this.title}}</td>
                      <td>{{this.authorization_status}}</td>
                      <td class="small text-muted">{{formatDate this.updated_at}}</td>
                      <td class="text-end">
                        <a href="/admin/ato/{{this.id}}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <a href="/admin/ato/{{this.id}}/export-pdf" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i></a>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{/if}}

          {{#if projectPoamItems.length}}
            <h6 class="fw-semibold small text-muted text-uppercase">Project POA&M Items</h6>
            <div class="table-responsive">
              <table class="table table-sm mb-0">
                <thead><tr><th>Control</th><th>Finding</th><th>Owner</th><th>Due</th><th>Status</th></tr></thead>
                <tbody>
                  {{#each projectPoamItems}}
                    <tr>
                      <td><code>{{this.control_id}}</code></td>
                      <td>{{this.description}}</td>
                      <td>{{this.assigned_to}}</td>
                      <td class="small">{{formatDate this.deadline}}</td>
                      <td>{{this.status}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.querySelectorAll('.assignment-mode').forEach(select => {
  const sync = () => {
    const scope = select.dataset.scope;
    document.querySelectorAll('.assignment-existing-' + scope).forEach(el => el.classList.toggle('d-none', select.value !== 'existing'));
    document.querySelectorAll('.assignment-invite-' + scope).forEach(el => el.classList.toggle('d-none', select.value !== 'invite'));
  };
  select.addEventListener('change', sync);
  sync();
});
</script>
