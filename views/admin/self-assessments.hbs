<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">{{t 'ui.selfAssessments'}}</h1>
      <p class="text-muted mb-0">{{t 'ui.preIntakeSubmissionsAndAccess'}}</p>
    </div>
    <a class="btn btn-outline-primary" href="/self-assessment" target="_blank">
      <i class="bi bi-box-arrow-up-right me-1"></i>{{t 'ui.publicEntry'}}
    </a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="stat-card"><div class="stat-number">{{stats.total}}</div><div class="stat-label">{{t 'ui.total'}}</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><div class="stat-number text-primary">{{stats.submitted}}</div><div class="stat-label">{{t 'ui.pendingReview'}}</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><div class="stat-number text-warning">{{stats.reviewed}}</div><div class="stat-label">{{t 'ui.reviewed'}}</div></div></div>
    <div class="col-md-3 col-6"><div class="stat-card"><div class="stat-number text-success">{{stats.intakeCreated}}</div><div class="stat-label">{{t 'ui.intakeCreated'}}</div></div></div>
  </div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span><i class="bi bi-clipboard2-pulse me-2"></i>{{t 'ui.submittedSelfAssessments'}}</span>
      <span class="badge bg-light text-dark">{{assessments.length}}</span>
    </div>
    <div class="card-body p-0">
      {{#if assessments.length}}
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>{{t 'ui.reference'}}</th>
                <th>{{t 'ui.submitter'}}</th>
                <th>{{t 'ui.system'}}</th>
                <th>{{t 'ui.jurisdiction'}}</th>
                <th>{{t 'ui.score'}}</th>
                <th>{{t 'ui.status'}}</th>
                <th>{{t 'ui.submitted'}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each assessments}}
                <tr>
                  <td><code>{{this.ref_code}}</code></td>
                  <td>
                    <div class="fw-semibold">{{this.submitter_name}}</div>
                    <div class="small text-muted">{{this.submitter_email}}</div>
                  </td>
                  <td><span class="badge bg-light text-dark border">{{this.system_type}}</span></td>
                  <td class="small">{{this.country}} · {{this.gov_level}}</td>
                  <td>
                    <span class="fw-bold {{#if (gt this.score 69)}}text-success{{else}}{{#if (gt this.score 44)}}text-warning{{else}}text-danger{{/if}}{{/if}}">{{this.score}}%</span>
                    <div class="small text-muted">
                      <span class="text-danger">{{this.critical_count}} critical</span> ·
                      <span class="text-warning">{{this.warning_count}} warning</span>
                    </div>
                  </td>
                  <td>
                    {{#if (eq this.status 'submitted')}}<span class="badge bg-primary">{{t 'ui.pendingReview'}}</span>{{/if}}
                    {{#if (eq this.status 'reviewed')}}<span class="badge bg-warning text-dark">{{t 'ui.reviewed'}}</span>{{/if}}
                    {{#if (eq this.status 'intake-created')}}<span class="badge bg-success">{{t 'ui.intakeCreated'}}</span>{{/if}}
                  </td>
                  <td class="small text-muted">{{formatDate this.created_at}}</td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/admin/self-assessments/{{this.id}}"><i class="bi bi-eye me-1"></i>{{t 'ui.review'}}</a></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="p-5 text-center text-muted">
          <i class="bi bi-clipboard2-pulse" style="font-size:2.5rem;"></i>
          <p class="mt-2 mb-0">{{t 'ui.noSelfAssessmentsSubmittedYet'}}</p>
        </div>
      {{/if}}
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <i class="bi bi-envelope-open me-2"></i>Access Requests
      {{#if stats.pendingAccessRequests}}<span class="badge bg-warning text-dark ms-2">{{stats.pendingAccessRequests}} pending</span>{{/if}}
    </div>
    <div class="card-body p-0">
      {{#if accessRequests.length}}
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>{{t 'ui.name'}}</th>
                <th>{{t 'ui.email'}}</th>
                <th>{{t 'ui.organization'}}</th>
                <th>{{t 'ui.reason'}}</th>
                <th>{{t 'ui.status'}}</th>
                <th>{{t 'ui.requested'}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each accessRequests}}
                <tr>
                  <td class="fw-semibold">{{this.name}}</td>
                  <td class="small text-muted">{{this.email}}</td>
                  <td>{{this.organization}}</td>
                  <td class="small text-muted">{{truncate this.reason 80}}</td>
                  <td>
                    {{#if (eq this.status 'pending')}}<span class="badge bg-warning text-dark">{{t 'ui.pending'}}</span>{{/if}}
                    {{#if (eq this.status 'approved')}}<span class="badge bg-success">{{t 'ui.approved'}}</span><div class="small">{{t 'ui.code2'}} <code>{{this.access_code}}</code></div>{{/if}}
                    {{#if (eq this.status 'denied')}}<span class="badge bg-danger">{{t 'ui.denied'}}</span>{{/if}}
                  </td>
                  <td class="small text-muted">{{formatDate this.created_at}}</td>
                  <td>
                    {{#if (eq this.status 'pending')}}
                      <div class="d-flex gap-1">
                        <form method="POST" action="/admin/self-assessment-requests/{{this.id}}/approve">
                          <button class="btn btn-sm btn-success" title="{{t 'ui.approve'}}"><i class="bi bi-check-lg"></i></button>
                        </form>
                        <form method="POST" action="/admin/self-assessment-requests/{{this.id}}/deny">
                          <button class="btn btn-sm btn-outline-danger" title="{{t 'ui.deny'}}"><i class="bi bi-x-lg"></i></button>
                        </form>
                      </div>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="p-4 text-center text-muted">{{t 'ui.noAccessRequestsYet'}}</div>
      {{/if}}
    </div>
  </div>
</div>
