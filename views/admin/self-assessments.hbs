<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">{{t 'admin.self_assessments.h1.preintake_selfassessments'}}</h1>
      <p class="text-muted mb-0">{{t 'admin.self_assessments.p.clientsubmitted_security_selfassessments_awaiting_review'}}</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fs-3 fw-bold">{{stats.total}}</div>
        <div class="text-muted small">{{t 'admin.self_assessments.div.total'}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3 {{#if stats.submitted}}border-info{{/if}}">
        <div class="fs-3 fw-bold text-primary">{{stats.submitted}}</div>
        <div class="text-muted small">{{t 'admin.self_assessments.div.pending_review'}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fs-3 fw-bold text-warning">{{stats.reviewed}}</div>
        <div class="text-muted small">{{t 'admin.self_assessments.div.reviewed'}}</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center p-3">
        <div class="fs-3 fw-bold text-success">{{stats.intakeCreated}}</div>
        <div class="text-muted small">{{t 'admin.self_assessments.div.intake_created'}}</div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="card">
    <div class="card-body p-0">
      {{#if assessments.length}}
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>{{t 'admin.self_assessments.th.ref'}}</th>
              <th>{{t 'admin.self_assessments.th.submitter'}}</th>
              <th>{{t 'admin.self_assessments.th.system'}}</th>
              <th>{{t 'admin.self_assessments.th.jurisdiction'}}</th>
              <th>{{t 'admin.self_assessments.th.score'}}</th>
              <th>{{t 'admin.self_assessments.th.status'}}</th>
              <th>{{t 'admin.self_assessments.th.submitted'}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each assessments}}
            <tr>
              <td><code>{{this.ref_code}}</code></td>
              <td>
                <div class="fw-semibold" style="font-size:0.88rem;">{{this.submitter_name}}</div>
                <div class="text-muted small">{{this.submitter_email}}</div>
              </td>
              <td>
                <span class="badge bg-light text-dark border">{{this.system_type}}</span>
              </td>
              <td>
                <span style="font-size:0.82rem;">{{this.country}} · {{this.gov_level}}</span>
              </td>
              <td>
                {{#if this.score}}
                  <span class="fw-bold {{#if (gt this.score 70)}}text-success{{else}}{{#if (gt this.score 40)}}text-warning{{else}}text-danger{{/if}}{{/if}}">
                    {{this.score}}%
                  </span>
                  <div class="text-muted small">
                    <span class="text-danger">{{this.critical_count}}C</span>
                    <span class="text-warning ms-1">{{this.warning_count}}W</span>
                    <span class="text-success ms-1">{{this.secure_count}}S</span>
                  </div>
                {{else}}
                  <span class="text-muted">—</span>
                {{/if}}
              </td>
              <td>
                {{#if (eq this.status 'submitted')}}
                  <span class="badge bg-primary">{{t 'admin.self_assessments.span.pending_review'}}</span>
                {{else if (eq this.status 'reviewed')}}
                  <span class="badge bg-warning text-dark">{{t 'admin.self_assessments.span.reviewed'}}</span>
                {{else if (eq this.status 'intake-created')}}
                  <span class="badge bg-success">{{t 'admin.self_assessments.span.intake_created'}}</span>
                {{else}}
                  <span class="badge bg-secondary">{{this.status}}</span>
                {{/if}}
              </td>
              <td>
                <span class="text-muted small">{{this.created_at}}</span>
              </td>
              <td>
                <a href="/admin/self-assessments/{{this.id}}" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-eye me-1"></i>Review
                </a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-5 text-muted">
        <i class="bi bi-clipboard2-pulse" style="font-size:3rem;"></i>
        <p class="mt-3">{{t 'admin.self_assessments.p.no_selfassessments_submitted_yet'}}</p>
        <p class="small">When clients complete a self-assessment at <code>/self-assessment</code>, their submissions will appear here.</p>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Access Requests -->
  <h3 class="mt-4 mb-3">
    <i class="bi bi-envelope-open me-2"></i>Access Requests
    {{#if stats.pendingAccessRequests}}
      <span class="badge bg-info ms-2">{{stats.pendingAccessRequests}} pending</span>
    {{/if}}
  </h3>
  <div class="card">
    <div class="card-body p-0">
      {{#if accessRequests.length}}
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>{{t 'admin.self_assessments.th.name'}}</th>
              <th>{{t 'admin.self_assessments.th.email'}}</th>
              <th>{{t 'admin.self_assessments.th.organization'}}</th>
              <th>{{t 'admin.self_assessments.th.reason'}}</th>
              <th>{{t 'admin.self_assessments.th.status'}}</th>
              <th>{{t 'admin.self_assessments.th.requested'}}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each accessRequests}}
            <tr>
              <td class="fw-semibold" style="font-size:0.88rem;">{{this.name}}</td>
              <td><span class="text-muted small">{{this.email}}</span></td>
              <td><span class="small">{{this.organization}}</span></td>
              <td><span class="small text-muted">{{this.reason}}</span></td>
              <td>
                {{#if (eq this.status 'pending')}}
                  <span class="badge bg-warning text-dark">{{t 'admin.self_assessments.span.pending'}}</span>
                {{else if (eq this.status 'approved')}}
                  <span class="badge bg-success">{{t 'admin.self_assessments.span.approved'}}</span>
                  <div class="small text-muted mt-1">Code: <code>{{this.access_code}}</code></div>
                {{else if (eq this.status 'denied')}}
                  <span class="badge bg-danger">{{t 'admin.self_assessments.span.denied'}}</span>
                {{/if}}
              </td>
              <td><span class="text-muted small">{{this.created_at}}</span></td>
              <td>
                {{#if (eq this.status 'pending')}}
                  <div class="d-flex gap-1">
                    <form action="/admin/self-assessment-requests/{{this.id}}/approve" method="POST" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-success" title="{{t 'admin.self_assessments.tattr.approve_send_code'}}">
                        <i class="bi bi-check-lg"></i>
                      </button>
                    </form>
                    <form action="/admin/self-assessment-requests/{{this.id}}/deny" method="POST" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="{{t 'admin.self_assessments.tattr.deny'}}">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    </form>
                  </div>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-4 text-muted">
        <i class="bi bi-envelope-open" style="font-size:2rem;"></i>
        <p class="mt-2 small">{{t 'admin.self_assessments.p.no_access_requests_yet'}}</p>
      </div>
      {{/if}}
    </div>
  </div>
</div>
