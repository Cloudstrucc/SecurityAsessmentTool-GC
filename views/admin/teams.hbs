<div class="container" style="max-width:1120px">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">{{t 'ui.teams'}}</h1>
      <p class="text-muted mb-0">{{t 'ui.inviteClientsAndAssessorsAnd'}}</p>
    </div>
  </div>

  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#clients" type="button"><i class="bi bi-person-plus me-1"></i>{{t 'ui.clientInvites'}}</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#assessors" type="button"><i class="bi bi-shield-plus me-1"></i>{{t 'ui.assessorInvites'}}</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#users" type="button"><i class="bi bi-people me-1"></i>{{t 'ui.users'}}</button></li>
  </ul>

  <div class="tab-content pt-3">
    <div class="tab-pane fade show active" id="clients">
      <div class="form-section">
        <div class="section-header">
          <h3 class="section-title"><span class="section-number"><i class="bi bi-person-plus"></i></span>{{t 'ui.inviteAClient'}}</h3>
          <p class="section-description">{{t 'ui.clientsCanSubmitIntakesAnd'}}</p>
        </div>
        <form method="POST" action="/admin/teams/client" class="row g-3">
          <div class="col-md-4"><label class="form-label">{{t 'ui.email'}}</label><input class="form-control" type="email" name="email" required></div>
          <div class="col-md-4"><label class="form-label">{{t 'ui.name'}}</label><input class="form-control" name="name"></div>
          <div class="col-md-4"><label class="form-label">{{t 'ui.organization'}}</label><input class="form-control" name="organization"></div>
          <div class="col-12"><label class="form-label">{{t 'ui.message'}}</label><input class="form-control" name="message" placeholder="{{t 'ui.optionalNoteIncludedInThe'}}"></div>
          <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-send me-1"></i>{{t 'ui.sendClientInvite'}}</button></div>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-header"><i class="bi bi-list-check me-2"></i>{{t 'ui.clientInvitations'}}</div>
        <div class="card-body p-0">
          {{#if clientInvites.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead><tr><th>{{t 'ui.email'}}</th><th>{{t 'ui.name'}}</th><th>{{t 'ui.code'}}</th><th>{{t 'ui.status'}}</th><th>{{t 'ui.expires'}}</th><th></th></tr></thead>
                <tbody>
                  {{#each clientInvites}}
                    <tr>
                      <td><code>{{this.email}}</code></td>
                      <td>{{this.name}}</td>
                      <td><code>{{this.invite_code}}</code></td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td class="small text-muted">{{formatDate this.expires_at}}</td>
                      <td>
                        {{#if (eq this.status 'pending')}}
                          <div class="btn-group btn-group-sm">
                            <form method="POST" action="/admin/teams/{{this.id}}/resend"><button class="btn btn-outline-primary" title="{{t 'ui.resend'}}"><i class="bi bi-arrow-repeat"></i></button></form>
                            <form method="POST" action="/admin/teams/{{this.id}}/revoke"><button class="btn btn-outline-danger" title="{{t 'ui.revoke'}}"><i class="bi bi-x-lg"></i></button></form>
                          </div>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-4 text-center text-muted">{{t 'ui.noClientInvitationsYet'}}</div>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="assessors">
      <div class="form-section">
        <div class="section-header">
          <h3 class="section-title"><span class="section-number"><i class="bi bi-shield-plus"></i></span>{{t 'ui.inviteAnAssessor'}}</h3>
          <p class="section-description">{{t 'ui.assessorsCanCollaborateOnAssigned'}}</p>
        </div>
        <form method="POST" action="/admin/teams/assessor" class="row g-3">
          <div class="col-md-4"><label class="form-label">{{t 'ui.email'}}</label><input class="form-control" type="email" name="email" required></div>
          <div class="col-md-4"><label class="form-label">{{t 'ui.name'}}</label><input class="form-control" name="name"></div>
          <div class="col-md-4"><label class="form-label">{{t 'ui.organization'}}</label><input class="form-control" name="organization"></div>
          <div class="col-12"><label class="form-label">{{t 'ui.message'}}</label><input class="form-control" name="message" placeholder="{{t 'ui.optionalCollaborationNote'}}"></div>
          <div class="col-12"><button class="btn btn-dark" type="submit"><i class="bi bi-send me-1"></i>{{t 'ui.sendAssessorInvite'}}</button></div>
        </form>
      </div>

      <div class="card mt-4">
        <div class="card-header"><i class="bi bi-list-check me-2"></i>{{t 'ui.assessorInvitations'}}</div>
        <div class="card-body p-0">
          {{#if assessorInvites.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead><tr><th>{{t 'ui.email'}}</th><th>{{t 'ui.name'}}</th><th>{{t 'ui.code'}}</th><th>{{t 'ui.status'}}</th><th>{{t 'ui.acceptedBy'}}</th><th></th></tr></thead>
                <tbody>
                  {{#each assessorInvites}}
                    <tr>
                      <td><code>{{this.email}}</code></td>
                      <td>{{this.name}}</td>
                      <td><code>{{this.invite_code}}</code></td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td>{{this.accepted_name}}</td>
                      <td>
                        {{#if (eq this.status 'pending')}}
                          <div class="btn-group btn-group-sm">
                            <form method="POST" action="/admin/teams/{{this.id}}/resend"><button class="btn btn-outline-primary" title="{{t 'ui.resend'}}"><i class="bi bi-arrow-repeat"></i></button></form>
                            <form method="POST" action="/admin/teams/{{this.id}}/revoke"><button class="btn btn-outline-danger" title="{{t 'ui.revoke'}}"><i class="bi bi-x-lg"></i></button></form>
                          </div>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-4 text-center text-muted">{{t 'ui.noAssessorInvitationsYet'}}</div>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="users">
      <div class="card">
        <div class="card-header"><i class="bi bi-people me-2"></i>{{t 'ui.activeUsers'}}</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead><tr><th>{{t 'ui.name'}}</th><th>{{t 'ui.email'}}</th><th>{{t 'ui.role'}}</th><th>{{t 'ui.organization'}}</th><th>MFA</th><th>{{t 'ui.breakGlass2'}}</th><th>{{t 'ui.lastLogin'}}</th></tr></thead>
              <tbody>
                {{#each activeUsers}}
                  <tr>
                    <td class="fw-semibold">{{this.name}}</td>
                    <td><code>{{this.email}}</code></td>
                    <td><span class="badge bg-light text-dark border">{{this.role}}</span></td>
                    <td>{{this.organization}}</td>
                    <td>{{#if this.mfa_enabled}}<span class="badge bg-success">{{t 'ui.enabled'}}</span>{{else}}<span class="badge bg-warning text-dark">{{t 'ui.notEnabled'}}</span>{{/if}}</td>
                    <td>{{#if this.is_break_glass}}<span class="badge bg-danger">{{t 'ui.yes'}}</span>{{else}}<span class="text-muted">No</span>{{/if}}</td>
                    <td class="small text-muted">{{formatDate this.last_login}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
