<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{dp.project_id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{dp.reference}} — {{project.name}}</h1>
      <p class="text-muted mb-0">
        {{t 'dp.title'}}
        <span class="badge bg-dark ms-1">{{t (dpStateKey dp.state)}}</span>
      </p>
    </div>
  </div>

  {{> process-flow flow=decisionFlow titleKey='pf.decisionProgress' idPrefix='pfdp'}}

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-award me-2"></i>{{t 'dp.title'}}</div>
        <div class="card-body">
          <form method="POST" action="/admin/decision-packages/{{dp.id}}">
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label">{{t 'dp.reference'}} / {{t 'dp.executiveSummary'}}</label>
                <input class="form-control" name="title" value="{{dp.title}}">
              </div>
              <div class="col-md-4">
                <label class="form-label">{{t 'dp.type'}}</label>
                <select class="form-select" name="decision_type">
                  <option value="ato" {{#eq dp.decision_type 'ato'}}selected{{/eq}}>{{t 'dp.typeAto'}}</option>
                  <option value="iato" {{#eq dp.decision_type 'iato'}}selected{{/eq}}>{{t 'dp.typeIato'}}</option>
                  <option value="denied" {{#eq dp.decision_type 'denied'}}selected{{/eq}}>{{t 'dp.typeDenied'}}</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.authorizingOfficial'}}</label>
                <input class="form-control" name="authorizing_official" value="{{dp.authorizing_official}}">
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.assessor'}}</label>
                <input class="form-control" name="assessor" value="{{dp.assessor}}">
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.expires'}}</label>
                <input type="date" class="form-control" name="expires_at" value="{{dp.expires_at}}">
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.executiveSummary'}}</label>
                <textarea class="form-control" name="executive_summary" rows="3">{{dp.executive_summary}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.residualRisk'}}</label>
                <textarea class="form-control" name="residual_risk_statement" rows="3">{{dp.residual_risk_statement}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.conditions'}}</label>
                <textarea class="form-control" name="conditions" rows="3">{{dp.conditions}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.rationale'}}</label>
                <textarea class="form-control" name="decision_rationale" rows="3">{{dp.decision_rationale}}</textarea>
              </div>
            </div>
            <button class="btn btn-primary mt-3"><i class="bi bi-save me-1"></i>{{t 'dp.save'}}</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      {{!-- The immutable anchor: exactly what this decision authorized --}}
      <div class="card mb-4 border-success">
        <div class="card-header bg-success-subtle"><i class="bi bi-shield-lock me-2"></i>{{t 'dp.pinnedVersion'}}</div>
        <div class="card-body">
          {{#if dp.assessment_version}}
            <p class="mb-2">
              <span class="badge bg-success">v{{dp.assessment_version}}</span>
              <a href="/admin/assessments/{{dp.assessment_id}}?version={{dp.assessment_version}}" class="ms-2">
                <i class="bi bi-box-arrow-up-right me-1"></i>{{t 'dp.viewVersion'}}
              </a>
            </p>
          {{else}}
            <p class="text-muted mb-2">{{t 'dp.noAssessment'}}</p>
          {{/if}}
          <p class="small text-muted mb-0">{{t 'dp.pinnedNote'}}</p>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-arrow-right-circle me-2"></i>{{t 'dp.advance'}}</div>
        <div class="card-body d-flex flex-wrap gap-2">
          {{#each nextStates}}
            <form method="POST" action="/admin/decision-packages/{{../dp.id}}/transition" class="d-inline">
              <input type="hidden" name="state" value="{{this}}">
              <button class="btn btn-sm btn-outline-primary">{{t (dpStateKey this)}}</button>
            </form>
          {{else}}
            <span class="text-muted small">—</span>
          {{/each}}
        </div>
      </div>

      {{!-- Live POA&M (the conditions this authorization depends on) --}}
      <div class="card mb-4 border-warning">
        <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
          <span><i class="bi bi-clipboard2-check me-2"></i>{{t 'pm.title'}}</span>
          <span class="badge bg-dark">{{t 'pm.summaryMet' accepted=poamSummary.accepted total=poamSummary.total}}</span>
        </div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2 mb-2">
            {{#if poamSummary.overdue}}<span class="badge bg-danger"><i class="bi bi-flag-fill me-1"></i>{{poamSummary.overdue}} · {{t 'pm.overdue'}}</span>{{/if}}
            {{#if poamSummary.awaitingReview}}<span class="badge bg-primary">{{poamSummary.awaitingReview}} · {{t 'pm.awaitingReview'}}</span>{{/if}}
            {{#if poamSummary.deferred}}<span class="badge bg-secondary">{{poamSummary.deferred}} · {{t 'pm.stateDeferred'}}</span>{{/if}}
          </div>
          <a href="/admin/decision-packages/{{dp.id}}/poam" class="btn btn-sm btn-warning">
            <i class="bi bi-clipboard2-check me-1"></i>{{t 'pm.openPoam'}}
          </a>
          {{#unless poamPromotion.ok}}
            <p class="small text-muted mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>
              {{#eq poamPromotion.reason 'overdue'}}{{t 'pm.promoteBlockedOverdue'}}{{/eq}}
              {{#eq poamPromotion.reason 'deferred'}}{{t 'pm.promoteBlockedDeferred'}}{{/eq}}
              {{#eq poamPromotion.reason 'outstanding'}}{{t 'pm.promoteBlockedOutstanding'}}{{/eq}}
            </p>
          {{/unless}}
        </div>
      </div>

      {{!-- Version history (editorial fields only; POA&M verdicts are never rolled back) --}}
      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-clock-history me-2"></i>v{{dp.version}}</div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush small">
            {{#each dpVersions}}
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><span class="badge bg-secondary me-1">v{{this.version}}</span>{{this.label}}
                  <span class="text-muted">· {{formatDateTime this.created_at}}</span></span>
                {{#if ../canRevert}}
                  {{#neq this.version ../dp.version}}
                    <button class="btn btn-sm btn-outline-danger" onclick="dpRevert({{this.version}})">
                      <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                  {{/neq}}
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-list-task me-2"></i>{{t 'dp.poamTitle'}} <span class="badge bg-secondary ms-1">{{poam.length}}</span></div>
        <div class="card-body p-0">
          {{#if poam.length}}
            <ul class="list-group list-group-flush small">
              {{#each poam}}
                <li class="list-group-item">
                  <code>{{this.control_id}}</code> — {{this.description}}
                  <span class="badge bg-light text-dark border ms-1">{{this.risk_level}}</span>
                </li>
              {{/each}}
            </ul>
          {{else}}<p class="text-muted small p-3 mb-0">{{t 'dp.noPoam'}}</p>{{/if}}
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-paperclip me-2"></i>{{t 'dp.docsTitle'}} <span class="badge bg-secondary ms-1">{{documents.length}}</span></div>
        <div class="card-body p-0">
          {{#if documents.length}}
            <ul class="list-group list-group-flush small">
              {{#each documents}}
                <li class="list-group-item">
                  <div class="fw-semibold">{{this.name}}</div>
                  <div class="text-muted" style="font-size:.75rem">
                    {{t 'dp.docHash'}}: <code>{{#if this.sha256}}{{truncate this.sha256 16}}…{{else}}—{{/if}}</code>
                  </div>
                </li>
              {{/each}}
            </ul>
          {{else}}<p class="text-muted small p-3 mb-0">{{t 'dp.noDocs'}}</p>{{/if}}
        </div>
      </div>

      <a href="/admin/reports/decision-package/{{dp.id}}" class="btn btn-primary btn-sm mb-2 d-block">
        <i class="bi bi-box-arrow-up me-1"></i>{{t 'rf.export'}}
      </a>
      <a href="/admin/reports/poam/{{dp.id}}" class="btn btn-outline-primary btn-sm mb-2 d-block">
        <i class="bi bi-list-check me-1"></i>{{t 'rf.poamRegister'}}
      </a>

      {{#neq dp.state 'issued'}}
      <form method="POST" action="/admin/decision-packages/{{dp.id}}/delete"
            onsubmit="return confirm('{{t 'dp.deleteConfirm'}}');">
        <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>{{t 'dp.delete'}}</button>
      </form>
      {{/neq}}
    </div>
  </div>
</div>

{{#if collabEnabled}}
  {{> collab-panel }}
  <script>
    window.CollabConfig = { projectId: {{dp.project_id}}, entityType: 'decision_package', entityId: {{dp.id}} };
  </script>
{{/if}}

{{> ai-assess-helper }}
<script>
// Aegis SA Assistant — decision mode. Context is the authorization decision.
window.AIAssistConfig = {
  mode: 'review',
  projectId: {{dp.project_id}},
  assessmentId: {{#if dp.assessment_id}}{{dp.assessment_id}}{{else}}null{{/if}},
  frameworkLabel: 'ITSG-33',
  profileSummary: 'decision package {{dp.reference}}; type {{dp.decision_type}}; state {{dp.state}}',
  subtitle: {{tjs 'pf.decisionProgress'}},
  greeting: {{tjs 'dp.blurb'}},
  suggestionsLabel: {{tjs 'aq.tryThis'}},
  suggestions: [{{tjs 'aq.decision1'}}, {{tjs 'aq.decision2'}}, {{tjs 'aq.decision3'}}]
};
</script>

<script>
function dpRevert(version){
  fetch('/admin/decision-packages/{{dp.id}}/revert/' + version, {
    method:'POST', headers:{'Content-Type':'application/json'}
  }).then(function(r){ return r.json().then(function(d){ return {ok:r.ok, d:d}; }); })
    .then(function(res){ if(!res.ok||!res.d.success) throw new Error(res.d.error||'Revert failed'); window.location.reload(); })
    .catch(function(e){ alert(e.message); });
}
</script>
