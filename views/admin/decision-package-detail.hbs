<div class="container">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{dp.project_id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{dp.reference}} — {{project.name}}</h1>
      <p class="text-muted mb-0">
        {{t 'dp.title'}}
        <span class="badge bg-dark ms-1">{{t (dpStateKey dp.state)}}</span>
      </p>
    </div>
  </div>

  {{> process-flow flow=decisionFlow titleKey='pf.decisionProgress' idPrefix='pfdp'}}

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-award me-2"></i>{{t 'dp.title'}}</div>
        <div class="card-body">
          <form method="POST" action="/admin/decision-packages/{{dp.id}}">
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label">{{t 'dp.reference'}} / {{t 'dp.executiveSummary'}}</label>
                <input class="form-control" name="title" value="{{dp.title}}">
              </div>
              <div class="col-md-4">
                <label class="form-label">{{t 'dp.type'}}</label>
                <select class="form-select" name="decision_type">
                  <option value="ato" {{#eq dp.decision_type 'ato'}}selected{{/eq}}>{{t 'dp.typeAto'}}</option>
                  <option value="iato" {{#eq dp.decision_type 'iato'}}selected{{/eq}}>{{t 'dp.typeIato'}}</option>
                  <option value="denied" {{#eq dp.decision_type 'denied'}}selected{{/eq}}>{{t 'dp.typeDenied'}}</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.authorizingOfficial'}}</label>
                <input class="form-control" name="authorizing_official" value="{{dp.authorizing_official}}">
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.assessor'}}</label>
                <input class="form-control" name="assessor" value="{{dp.assessor}}">
              </div>
              <div class="col-md-6">
                <label class="form-label">{{t 'dp.expires'}}</label>
                <input type="date" class="form-control" name="expires_at" value="{{dp.expires_at}}">
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.executiveSummary'}}</label>
                <textarea class="form-control" name="executive_summary" rows="3">{{dp.executive_summary}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.residualRisk'}}</label>
                <textarea class="form-control" name="residual_risk_statement" rows="3">{{dp.residual_risk_statement}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.conditions'}}</label>
                <textarea class="form-control" name="conditions" rows="3">{{dp.conditions}}</textarea>
              </div>
              <div class="col-12">
                <label class="form-label">{{t 'dp.rationale'}}</label>
                <textarea class="form-control" name="decision_rationale" rows="3">{{dp.decision_rationale}}</textarea>
              </div>
            </div>
            <button class="btn btn-primary mt-3"><i class="bi bi-save me-1"></i>{{t 'dp.save'}}</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      {{!-- The immutable anchor: exactly what this decision authorized --}}
      <div class="card mb-4 border-success">
        <div class="card-header bg-success-subtle"><i class="bi bi-shield-lock me-2"></i>{{t 'dp.pinnedVersion'}}</div>
        <div class="card-body">
          {{#if dp.assessment_version}}
            <p class="mb-2">
              <span class="badge bg-success">v{{dp.assessment_version}}</span>
              <a href="/admin/assessments/{{dp.assessment_id}}?version={{dp.assessment_version}}" class="ms-2">
                <i class="bi bi-box-arrow-up-right me-1"></i>{{t 'dp.viewVersion'}}
              </a>
            </p>
          {{else}}
            <p class="text-muted mb-2">{{t 'dp.noAssessment'}}</p>
          {{/if}}
          <p class="small text-muted mb-0">{{t 'dp.pinnedNote'}}</p>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-arrow-right-circle me-2"></i>{{t 'dp.advance'}}</div>
        <div class="card-body d-flex flex-wrap gap-2">
          {{#each nextStates}}
            <form method="POST" action="/admin/decision-packages/{{../dp.id}}/transition" class="d-inline">
              <input type="hidden" name="state" value="{{this}}">
              <button class="btn btn-sm btn-outline-primary">{{t (dpStateKey this)}}</button>
            </form>
          {{else}}
            <span class="text-muted small">—</span>
          {{/each}}
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-list-task me-2"></i>{{t 'dp.poamTitle'}} <span class="badge bg-secondary ms-1">{{poam.length}}</span></div>
        <div class="card-body p-0">
          {{#if poam.length}}
            <ul class="list-group list-group-flush small">
              {{#each poam}}
                <li class="list-group-item">
                  <code>{{this.control_id}}</code> — {{this.description}}
                  <span class="badge bg-light text-dark border ms-1">{{this.risk_level}}</span>
                </li>
              {{/each}}
            </ul>
          {{else}}<p class="text-muted small p-3 mb-0">{{t 'dp.noPoam'}}</p>{{/if}}
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><i class="bi bi-paperclip me-2"></i>{{t 'dp.docsTitle'}} <span class="badge bg-secondary ms-1">{{documents.length}}</span></div>
        <div class="card-body p-0">
          {{#if documents.length}}
            <ul class="list-group list-group-flush small">
              {{#each documents}}
                <li class="list-group-item">
                  <div class="fw-semibold">{{this.name}}</div>
                  <div class="text-muted" style="font-size:.75rem">
                    {{t 'dp.docHash'}}: <code>{{#if this.sha256}}{{truncate this.sha256 16}}…{{else}}—{{/if}}</code>
                  </div>
                </li>
              {{/each}}
            </ul>
          {{else}}<p class="text-muted small p-3 mb-0">{{t 'dp.noDocs'}}</p>{{/if}}
        </div>
      </div>

      {{#neq dp.state 'issued'}}
      <form method="POST" action="/admin/decision-packages/{{dp.id}}/delete"
            onsubmit="return confirm('{{t 'dp.deleteConfirm'}}');">
        <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>{{t 'dp.delete'}}</button>
      </form>
      {{/neq}}
    </div>
  </div>
</div>

{{#if collabEnabled}}
  {{> collab-panel }}
  <script>
    window.CollabConfig = { projectId: {{dp.project_id}}, entityType: 'decision_package', entityId: {{dp.id}} };
  </script>
{{/if}}
