                <strong>{{this.label}}</strong>
                {{#if (eq this.version ../assessment.version)}}<span class="badge bg-success">Active</span>{{/if}}
              </div>
              {{#if this.summary}}<div class="small text-muted">{{this.summary}}</div>{{/if}}
              <div class="small text-muted">
                <i class="bi bi-person me-1"></i>{{#if this.created_by_name}}{{this.created_by_name}}{{else}}System{{/if}}
                · {{formatDateTime this.created_at}}
              </div>
            </div>
            <div class="flex-shrink-0 d-flex flex-column align-items-end gap-1">
              <button type="button" class="btn btn-sm btn-outline-primary"
                onclick="saaShowVersionSummary({{this.version}})">
                <i class="bi bi-list-check me-1"></i>Summary
              </button>
              {{#if (eq this.version ../assessment.version)}}
                <span class="text-muted small"><i class="bi bi-check2-circle me-1"></i>Current</span>
              {{else}}
                <button type="button" class="btn btn-sm btn-outline-danger"
                  onclick="saaConfirmRevert({{this.version}}, {{json this.label}})">
