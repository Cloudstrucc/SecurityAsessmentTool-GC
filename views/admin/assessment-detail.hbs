<div class="container{{#if viewingVersion}} assessment-readonly{{/if}}">
  {{#if viewingVersion}}
  <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 sticky-top shadow-sm" style="top:0;z-index:1020">
    <span><i class="bi bi-eye-fill me-2"></i>You are viewing a <strong>read-only snapshot of version {{viewingVersion}}</strong>. Edits are disabled here.</span>
    <a href="/admin/assessments/{{assessment.id}}" class="btn btn-sm btn-outline-dark"><i class="bi bi-arrow-return-left me-1"></i>Back to current version</a>
  </div>
  {{/if}}
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{assessment.project_id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{assessment.project_name}}</h1>
      <p class="text-muted mb-0">Assessment Package — {{{statusBadge assessment.status}}}
        {{#if viewingVersion}}<span class="badge bg-warning text-dark ms-1">Viewing v{{viewingVersion}}</span>{{else}}<span class="badge bg-dark ms-1" title="Current assessment version">v{{#if assessment.version}}{{assessment.version}}{{else}}1{{/if}}</span>{{/if}}
      </p>
    </div>
  </div>
  {{#if viewingVersion}}
  <style>
    /* Read-only version view: neutralize edit affordances inside the control set. */
    .assessment-readonly form button[type="submit"],
    .assessment-readonly .control-card button,
    .assessment-readonly .control-card input,
    .assessment-readonly .control-card select,
    .assessment-readonly .control-card textarea { pointer-events:none; opacity:.55; }
    .assessment-readonly .aia-launch { display:none !important; }
  </style>
  {{/if}}

  <!-- Status & Actions Bar -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row g-3 align-items-center">
        <div class="col-md-8">
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <div>
              <span class="small text-muted d-block">Invite Code</span>
              <code class="fs-5 fw-bold">{{assessment.invite_code}}</code>
            </div>
            {{#if assessment.intake_ref_code}}
              <div class="vr d-none d-md-block"></div>
              <div>
                <span class="small text-muted d-block">Intake</span>
                <a href="/admin/intakes/{{assessment.intake_id}}" class="text-decoration-none"><code>{{assessment.intake_ref_code}}</code></a>
              </div>
            {{/if}}
            <div class="vr d-none d-md-block"></div>
            <div>
              <span class="small text-muted d-block">Owner</span>
              <span class="fw-semibold">{{assessment.project_owner_name}}</span>
            </div>
            {{#if assessment.assigned_to_email}}
              <div class="vr d-none d-md-block"></div>
              <div>
                <span class="small text-muted d-block">Assigned To</span>
                <span class="fw-semibold">{{assessment.assigned_to_email}}</span>
              </div>
            {{/if}}
            <div class="vr d-none d-md-block"></div>
            <div>
              <span class="small text-muted d-block">Classification</span>
              <span class="badge bg-info">{{assessment.data_classification}}</span>
            </div>
            {{#if assessment.overall_score}}
              <div class="vr d-none d-md-block"></div>
              <div>
                <span class="small text-muted d-block">Score</span>
                <span class="fw-bold fs-5 {{#ifCond assessment.overall_score '>=' 80}}text-success{{else}}text-danger{{/ifCond}}">
                  {{assessment.overall_score}}%
                </span>
              </div>
            {{/if}}
            {{#if assessment.result}}
              <div class="vr d-none d-md-block"></div>
              <div>
                <span class="small text-muted d-block">Result</span>
                {{{statusBadge assessment.result}}}
              </div>
            {{/if}}
          </div>
        </div>
        <div class="col-md-4 text-md-end">
          <div class="d-flex flex-wrap gap-2 justify-content-md-end">
            {{#unless viewingVersion}}
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#versionHistoryModal">
              <i class="bi bi-clock-history me-1"></i>Version history
            </button>
            {{/unless}}
            {{!-- Action buttons based on status (hidden while viewing a past version) --}}
            {{#unless viewingVersion}}
            {{#eq assessment.status "draft"}}
              {{#if tailorMode}}
                <button type="submit" form="tailoringForm" class="btn btn-success">
                  <i class="bi bi-save me-1"></i>Save Tailoring
                </button>
                <a href="/admin/assessments/{{assessment.id}}" class="btn btn-outline-secondary">
                  <i class="bi bi-x-lg me-1"></i>Cancel
                </a>
              {{else}}
                <a href="/admin/assessments/{{assessment.id}}?tailor=1" class="btn btn-outline-primary">
                  <i class="bi bi-pencil-square me-1"></i>Tailor
                </a>
                <a href="/admin/assessments/{{assessment.id}}/manage-controls" class="btn btn-outline-primary">
                  <i class="bi bi-gear me-1"></i>Manage Controls
                </a>
              {{/if}}
              <form method="POST" action="/admin/assessments/{{assessment.id}}/send-invite" class="d-inline">
                <button class="btn btn-primary"><i class="bi bi-send me-1"></i>Send Invite</button>
              </form>
              <form method="POST" action="/admin/assessments/{{assessment.id}}/delete" class="d-inline"
                onsubmit="return confirm('Delete this draft assessment? This cannot be undone.')">
                <input type="hidden" name="return_to" value="/admin/projects/{{assessment.project_id}}">
                <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            {{/eq}}

            {{#eq assessment.status "evidence-gathering"}}
              <a href="/admin/assessments/{{assessment.id}}/manage-controls" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-gear me-1"></i>Manage Controls
              </a>
              <form method="POST" action="/admin/assessments/{{assessment.id}}/send-invite" class="d-inline">
                <button class="btn btn-outline-primary btn-sm"><i class="bi bi-send me-1"></i>Resend Invite</button>
              </form>
              <a href="/respond/{{assessment.invite_code}}" target="_blank" class="btn btn-outline-success btn-sm" title="Open the public evidence submission portal">
                <i class="bi bi-box-arrow-up-right me-1"></i>Open Portal
              </a>
            {{/eq}}

            {{#eq assessment.status "submitted"}}
              <form method="POST" action="/admin/assessments/{{assessment.id}}/start-audit" class="d-inline">
                <button class="btn btn-warning"><i class="bi bi-search me-1"></i>Start Audit</button>
              </form>
              <form method="POST" action="/admin/assessments/{{assessment.id}}/reactivate" class="d-inline">
                <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-unlock me-1"></i>Reactivate</button>
              </form>
            {{/eq}}

            {{#eq assessment.status "audit"}}
              <button class="btn btn-success" data-bs-toggle="collapse" data-bs-target="#completeAuditForm">
                <i class="bi bi-check-circle me-1"></i>Complete Audit
              </button>
            {{/eq}}

            {{#eq assessment.status "completed"}}
              <a href="/admin/assessments/{{assessment.id}}/generate-ato" class="btn btn-success">
                <i class="bi bi-file-earmark-pdf me-1"></i>Generate {{#if assessment.ato_type}}{{assessment.ato_type}}{{else}}ATO{{/if}}
              </a>
            {{/eq}}

            <a href="/admin/assessments/{{assessment.id}}/export-pdf" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-download me-1"></i>Export PDF
            </a>
            <a href="/admin/projects/{{assessment.project_id}}/controls.csv" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-filetype-csv me-1"></i>Controls CSV
            </a>
            <a href="/admin/projects/{{assessment.project_id}}/controls.pdf" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-file-earmark-pdf me-1"></i>Controls PDF
            </a>
            {{/unless}}
          </div>
        </div>
      </div>
    </div>
  </div>

  {{#unless viewingVersion}}
  {{> process-flow flow=assessmentFlow titleKey='pf.assessmentProgress' idPrefix='pfassess'}}
  {{/unless}}

  <div class="card mb-4">
    <div class="card-header bg-light"><i class="bi bi-person-check me-2"></i>Assignment</div>
    <div class="card-body">
      {{#if assignments.length}}
        <div class="row g-2 mb-3">
          {{#each assignments}}
            <div class="col-md-6">
              <div class="border rounded p-2 small">
                <div class="fw-semibold">{{#if this.assignee_name}}{{this.assignee_name}}{{else}}{{this.assignee_email}}{{/if}}</div>
                <div class="text-muted">{{#if this.user_email}}{{this.user_email}}{{else}}{{this.assignee_email}}{{/if}}</div>
                <span class="badge bg-light text-dark border">{{this.assignee_role}} {{#if (eq this.status 'pending')}}pending{{/if}}</span>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="text-muted small">No one has been assigned to this assessment yet.</p>
      {{/if}}
      <form method="POST" action="/admin/assessments/{{assessment.id}}/assign" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label small fw-semibold" for="assessment_assignment_mode">User</label>
          <select class="form-select form-select-sm assignment-mode" id="assessment_assignment_mode" name="assignment_mode" data-scope="assessment">
            <option value="existing">Existing user</option>
            <option value="invite">Invite new user</option>
          </select>
        </div>
        <div class="col-md-5 assignment-existing-assessment">
          <label class="form-label small fw-semibold" for="assignee_user_id">Existing User</label>
          <select class="form-select form-select-sm" id="assignee_user_id" name="assignee_user_id">
            <option value="">Choose a user...</option>
            {{#each users}}
              <option value="{{this.id}}">{{this.name}} — {{this.email}} ({{this.role}})</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-4 assignment-existing-assessment">
          <label class="form-label small fw-semibold" for="assignment_notes_existing">Notes</label>
          <input type="text" class="form-control form-control-sm" id="assignment_notes_existing" name="assignment_notes">
        </div>
        <div class="col-12 assignment-invite-assessment d-none">
          <div class="row g-2">
            <div class="col-md-2">
              <select class="form-select form-select-sm" name="assignee_role">
                <option value="client">Client</option>
                <option value="assessor">Assessor</option>
              </select>
            </div>
            <div class="col-md-3"><input type="text" class="form-control form-control-sm" name="invite_name" placeholder="Name"></div>
            <div class="col-md-3"><input type="email" class="form-control form-control-sm" name="invite_email" placeholder="Email"></div>
            <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="invite_organization" placeholder="Organization"></div>
            <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="invite_message" placeholder="Invite message"></div>
          </div>
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-person-plus me-1"></i>Assign Assessment & Intake</button>
        </div>
      </form>
    </div>
  </div>

  {{#if documents.length}}
  <div class="card mb-4" id="ai-doc-guidance">
    <div class="card-header bg-light"><i class="bi bi-stars me-2"></i>AI Guidance From Project Documentation</div>
    <div class="card-body">
      <p class="text-muted small mb-3">Select project documents and controls, preview Anthropic-generated evidence guidance, then save only the guidance you approve.</p>
      <div class="row g-3">
        <div class="col-md-5">
          <label class="form-label small fw-semibold">Project Documents</label>
          <div class="border rounded p-2" style="max-height:180px;overflow:auto;">
            {{#each documents}}
              <div class="form-check small">
                <input class="form-check-input ai-doc-checkbox" type="checkbox" value="{{this.id}}" id="ai-doc-{{this.id}}">
                <label class="form-check-label" for="ai-doc-{{this.id}}">{{this.original_name}} <span class="text-muted">({{this.display_size}})</span></label>
              </div>
            {{/each}}
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Control Scope</label>
          <select class="form-select form-select-sm" id="aiControlScope">
            <option value="visible">Visible controls on page</option>
            <option value="selected">Checked controls only</option>
          </select>
          <div class="form-text">Use tailoring checkboxes below to choose a smaller set.</div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <button type="button" class="btn btn-sm text-white w-100" style="background:#8b5cf6;" onclick="aiGenerateFromDocuments()">
            <i class="bi bi-stars me-1"></i>Preview Guidance
          </button>
        </div>
      </div>
      <div id="aiDocGuidanceStatus" class="small mt-3"></div>
      <div id="aiDocGuidancePreview" class="mt-3"></div>
    </div>
  </div>
  {{/if}}

  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number">{{stats.total}}</div>
        <div class="stat-label">Total Controls</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number">{{stats.inherited}}</div>
        <div class="stat-label">Inherited</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number">{{stats.evidenceProvided}}</div>
        <div class="stat-label">Evidence Provided</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number text-success">{{stats.met}}</div>
        <div class="stat-label">Met</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number" style="color:var(--gc-warning)">{{stats.partiallyMet}}</div>
        <div class="stat-label">Partially Met</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number text-danger">{{stats.notMet}}</div>
        <div class="stat-label">Not Met</div>
      </div>
    </div>
    <div class="col-6 col-lg">
      <div class="stat-card">
        <div class="stat-number" style="color:#dc3545">{{stats.highRisk}}</div>
        <div class="stat-label">High Risk (TBS)</div>
      </div>
    </div>
  </div>

  {{!-- Score Bar (when audit is done or in progress) --}}
  {{#or stats.met stats.partiallyMet stats.notMet}}
    <div class="card mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span class="fw-semibold">Audit Progress</span>
          <span class="fw-bold">{{stats.score}}%</span>
        </div>
        <div class="progress" style="height:12px">
          <div class="progress-bar bg-success" style="width:{{percentage stats.met stats.applicable}}%"
            title="Met: {{stats.met}}"></div>
          <div class="progress-bar" style="width:{{percentage stats.partiallyMet stats.applicable}}%;background:var(--gc-warning)"
            title="Partially Met: {{stats.partiallyMet}}"></div>
          <div class="progress-bar bg-danger" style="width:{{percentage stats.notMet stats.applicable}}%"
            title="Not Met: {{stats.notMet}}"></div>
        </div>
        <div class="d-flex gap-3 mt-2 small">
          <span><i class="bi bi-circle-fill text-success"></i> Met ({{stats.met}})</span>
          <span><i class="bi bi-circle-fill" style="color:var(--gc-warning)"></i> Partial ({{stats.partiallyMet}})</span>
          <span><i class="bi bi-circle-fill text-danger"></i> Not Met ({{stats.notMet}})</span>
          <span><i class="bi bi-circle-fill text-secondary"></i> Pending ({{stats.pending}})</span>
        </div>
      </div>
    </div>
  {{/or}}

  {{!-- Complete Audit Form (collapsible) --}}
  {{#eq assessment.status "audit"}}
  <div class="collapse mb-4" id="completeAuditForm">
    <div class="card border-warning">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-shield-check me-2"></i>Complete Audit — TBS Authorization Decision
      </div>
      <div class="card-body">
        <form method="POST" action="/admin/assessments/{{assessment.id}}/complete-audit"
          onsubmit="return confirm('Complete the audit and issue the authorization decision?')">
          <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
              <div class="p-2 rounded text-center" style="background:#fef2f2">
                <div class="fw-bold text-danger fs-5">{{stats.highRiskNotMet}}</div>
                <small class="text-muted">High-Risk Findings</small>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="p-2 rounded text-center" style="background:#f0fdf4">
                <div class="fw-bold text-success fs-5">{{stats.met}}</div>
                <small class="text-muted">Controls Met</small>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="p-2 rounded text-center" style="background:#fffbeb">
                <div class="fw-bold" style="color:var(--gc-warning)">{{stats.partiallyMet}}</div>
                <small class="text-muted">Partially Met</small>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="p-2 rounded text-center" style="background:#fef2f2">
                <div class="fw-bold text-danger">{{stats.notMet}}</div>
                <small class="text-muted">Not Met</small>
              </div>
            </div>
          </div>
          {{#if stats.highRiskNotMet}}
          <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>TBS Policy:</strong> {{stats.highRiskNotMet}} high-risk control(s) not met. Per TBS Directive on Security Management, full ATO cannot be granted with outstanding high-risk findings. Consider iATO with POA&M.
          </div>
          {{/if}}
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold">Override Result</label>
              <select class="form-select form-select-sm" name="overrideResult">
                <option value="">Auto-calculate (TBS rules)</option>
                <option value="ato">ATO — Full Authority</option>
                <option value="iato">iATO — Interim + POA&M</option>
                <option value="denied">Denied</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">iATO Expiry Date</label>
              <input type="date" class="form-control form-control-sm" name="atoExpiryDate">
              <small class="text-muted">Default: 90 days if iATO</small>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">POA&M Notes</label>
              <input type="text" class="form-control form-control-sm" name="poamNotes" placeholder="POA&M context notes...">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Risk Acceptance Statement <span class="text-muted fw-normal">(required for iATO per TBS)</span></label>
            <textarea class="form-control form-control-sm" name="riskAcceptance" rows="3"
              placeholder="Document residual risk acceptance rationale per TBS Directive on Security Management..."></textarea>
          </div>
          <button type="submit" class="btn btn-success"><i class="bi bi-shield-check me-1"></i>Complete Audit & Issue Decision</button>
        </form>
      </div>
    </div>
  </div>
  {{/eq}}

  <!-- POA&M Section -->
    <div class="card mb-4" id="poam-section">
      <div class="card-header d-flex justify-content-between align-items-center" style="background:var(--gc-warning)">
        <span><i class="bi bi-clipboard2-check me-2"></i><strong>Plan of Action & Milestones (POA&M)</strong></span>
        <div class="d-flex gap-2">
          <form method="POST" action="/admin/assessments/{{assessment.id}}/poam/auto-populate" class="d-inline">
            <button class="btn btn-sm btn-outline-dark" title="Auto-generate from findings">
              <i class="bi bi-lightning me-1"></i>Auto-Populate
            </button>
          </form>
          <span class="badge bg-dark">{{poamStats.total}} items</span>
        </div>
      </div>
      <div class="card-body">
        {{#if assessment.risk_acceptance_statement}}
          <div class="alert alert-info py-2 small mb-3">
            <i class="bi bi-shield-exclamation me-1"></i><strong>Risk Acceptance:</strong> {{assessment.risk_acceptance_statement}}
          </div>
        {{/if}}
        {{#if assessment.ato_expiry_date}}
          <div class="d-flex gap-3 small mb-3 flex-wrap">
            <span><i class="bi bi-calendar-event me-1"></i>Expires: <strong>{{formatDate assessment.ato_expiry_date}}</strong></span>
            <span class="badge bg-danger">{{poamStats.highCount}} High</span>
            <span class="badge bg-warning text-dark">{{poamStats.mediumCount}} Medium</span>
            <span class="badge bg-info">{{poamStats.lowCount}} Low</span>
            {{#if poamStats.overdue}}<span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>{{poamStats.overdue}} Overdue</span>{{/if}}
          </div>
        {{/if}}

        <!-- POA&M Progress -->
        {{#if poamStats.total}}
        <div class="progress mb-3" style="height:8px">
          <div class="progress-bar bg-success" style="width:{{percentage poamStats.verified poamStats.total}}%" title="Verified: {{poamStats.verified}}"></div>
          <div class="progress-bar" style="width:{{percentage poamStats.completed poamStats.total}}%;background:#17a2b8" title="Completed: {{poamStats.completed}}"></div>
          <div class="progress-bar" style="width:{{percentage poamStats.inProgress poamStats.total}}%;background:var(--gc-warning)" title="In Progress: {{poamStats.inProgress}}"></div>
        </div>
        <div class="d-flex gap-3 small mb-3">
          <span><i class="bi bi-circle-fill text-secondary"></i> Open ({{poamStats.open}})</span>
          <span><i class="bi bi-circle-fill" style="color:var(--gc-warning)"></i> In Progress ({{poamStats.inProgress}})</span>
          <span><i class="bi bi-circle-fill" style="color:#17a2b8"></i> Completed ({{poamStats.completed}})</span>
          <span><i class="bi bi-circle-fill text-success"></i> Verified ({{poamStats.verified}})</span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover table-sm mb-0" style="font-size:.85rem">
            <thead>
              <tr>
                <th style="width:30px">Risk</th>
                <th>Item</th>
                <th style="width:70px">Control</th>
                <th style="width:100px">Deadline</th>
                <th style="width:100px">Assigned</th>
                <th style="width:120px">Status</th>
                <th style="width:90px"></th>
              </tr>
            </thead>
            <tbody>
              {{#each checklistItems}}
                <tr class="{{#eq this.status 'verified'}}table-success{{/eq}} {{#eq this.status 'completed'}}table-info{{/eq}}">
                  <td>
                    {{#eq this.risk_level "high"}}<span class="badge bg-danger">H</span>{{/eq}}
                    {{#eq this.risk_level "medium"}}<span class="badge bg-warning text-dark">M</span>{{/eq}}
                    {{#eq this.risk_level "low"}}<span class="badge bg-info">L</span>{{/eq}}
                  </td>
                  <td>
                    <span class="fw-semibold">{{this.description}}</span>
                    {{#if this.original_finding}}<br><small class="text-muted">Finding: {{this.original_finding}}</small>{{/if}}
                    {{#if this.remediation_plan}}<br><small class="text-primary">Plan: {{this.remediation_plan}}</small>{{/if}}
                    {{#if this.milestone}}<br><small class="text-muted">Milestone: {{this.milestone}}</small>{{/if}}
                    {{#if this.residual_risk}}<br><small class="text-danger">Residual Risk: {{this.residual_risk}}</small>{{/if}}
                    {{#if this.assessor_notes}}<br><small class="text-muted">Assessor Notes: {{this.assessor_notes}}</small>{{/if}}
                  </td>
                  <td><code>{{this.control_id}}</code></td>
                  <td>
                    <small>{{formatDate this.deadline}}</small>
                    {{#if this.deadline}}
                      {{!-- Highlight overdue --}}
                    {{/if}}
                  </td>
                  <td><small>{{this.assigned_to}}</small></td>
                  <td>
                    <form method="POST" action="/admin/assessments/{{../assessment.id}}/poam/{{this.id}}/update" class="d-inline">
                      <select class="form-select form-select-sm" name="status" onchange="this.form.submit()" style="font-size:.78rem">
                        <option value="open" {{#eq this.status "open"}}selected{{/eq}}>Open</option>
                        <option value="in-progress" {{#eq this.status "in-progress"}}selected{{/eq}}>In Progress</option>
                        <option value="completed" {{#eq this.status "completed"}}selected{{/eq}}>Completed</option>
                        <option value="verified" {{#eq this.status "verified"}}selected{{/eq}}>Verified</option>
                      </select>
                    </form>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-outline-primary p-0 px-1 me-1" type="button"
                      data-bs-toggle="collapse" data-bs-target="#poam-edit-{{this.id}}" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form method="POST" action="/admin/assessments/{{../assessment.id}}/poam/{{this.id}}/delete"
                      onsubmit="return confirm('Remove this POA&M item?')" class="d-inline">
                      <button class="btn btn-sm btn-outline-danger p-0 px-1" title="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
                <tr class="collapse" id="poam-edit-{{this.id}}">
                  <td colspan="7" class="bg-light">
                    <form method="POST" action="/admin/assessments/{{../assessment.id}}/poam/{{this.id}}/update" class="p-2">
                      <div class="row g-2">
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Finding / Weakness</label>
                          <input type="text" class="form-control form-control-sm" name="description" value="{{this.description}}">
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Risk</label>
                          <select class="form-select form-select-sm" name="risk_level">
                            <option value="high" {{#eq this.risk_level "high"}}selected{{/eq}}>High</option>
                            <option value="medium" {{#eq this.risk_level "medium"}}selected{{/eq}}>Medium</option>
                            <option value="low" {{#eq this.risk_level "low"}}selected{{/eq}}>Low</option>
                          </select>
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Status</label>
                          <select class="form-select form-select-sm" name="status">
                            <option value="open" {{#eq this.status "open"}}selected{{/eq}}>Open</option>
                            <option value="in-progress" {{#eq this.status "in-progress"}}selected{{/eq}}>In Progress</option>
                            <option value="completed" {{#eq this.status "completed"}}selected{{/eq}}>Completed</option>
                            <option value="verified" {{#eq this.status "verified"}}selected{{/eq}}>Verified</option>
                          </select>
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Target Date</label>
                          <input type="date" class="form-control form-control-sm" name="deadline" value="{{this.deadline}}">
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Owner</label>
                          <input type="text" class="form-control form-control-sm" name="assigned_to" value="{{this.assigned_to}}">
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Related ATO/iATO</label>
                          <select class="form-select form-select-sm" name="ato_record_id">
                            <option value="">None</option>
                            {{#each ../atoRecords}}
                              <option value="{{this.id}}" {{#eq ../ato_record_id this.id}}selected{{/eq}}>{{this.record_type}} - {{this.title}}</option>
                            {{/each}}
                          </select>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Original Finding</label>
                          <input type="text" class="form-control form-control-sm" name="original_finding" value="{{this.original_finding}}">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Mitigation Plan</label>
                          <textarea class="form-control form-control-sm" name="remediation_plan" rows="2">{{this.remediation_plan}}</textarea>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Milestone Notes</label>
                          <textarea class="form-control form-control-sm" name="milestone" rows="2">{{this.milestone}}</textarea>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Residual Risk</label>
                          <textarea class="form-control form-control-sm" name="residual_risk" rows="2">{{this.residual_risk}}</textarea>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Assessor Notes</label>
                          <textarea class="form-control form-control-sm" name="assessor_notes" rows="2">{{this.assessor_notes}}</textarea>
                        </div>
                        <div class="col-12">
                          <button class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i>Save POA&M Item</button>
                        </div>
                      </div>
                    </form>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
          <p class="text-muted mb-3">No POA&M items yet. Use "Auto-Populate" to generate from audit findings, or add manually below.</p>
        {{/if}}

        <!-- Add POA&M Item -->
        <hr>
        <h6 class="fw-semibold mb-3"><i class="bi bi-plus-circle me-1"></i>Add POA&M Item</h6>
        <form method="POST" action="/admin/assessments/{{assessment.id}}/checklist/add">
          <div class="row g-2 mb-2">
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm" name="description" placeholder="Remediation item description" required>
            </div>
            <div class="col-md-2">
              <select class="form-select form-select-sm" name="control_id">
                <option value="">Control</option>
                {{#each controls}}
                  {{#or (eq this.audit_result "not-met") (eq this.audit_result "partially-met")}}
                    <option value="{{this.control_id}}">{{this.control_id}}</option>
                  {{/or}}
                {{/each}}
              </select>
            </div>
            <div class="col-md-1">
              <select class="form-select form-select-sm" name="risk_level">
                <option value="high">High</option>
                <option value="medium" selected>Medium</option>
                <option value="low">Low</option>
              </select>
            </div>
            <div class="col-md-2">
              <input type="date" class="form-control form-control-sm" name="deadline" required>
            </div>
            <div class="col-md-2">
              <input type="text" class="form-control form-control-sm" name="assigned_to" placeholder="Assigned to">
            </div>
            <div class="col-md-1">
              <button class="btn btn-sm btn-warning w-100"><i class="bi bi-plus-lg"></i></button>
            </div>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <input type="text" class="form-control form-control-sm" name="remediation_plan" placeholder="Remediation plan (optional)">
            </div>
            <div class="col-md-6">
              <input type="text" class="form-control form-control-sm" name="milestone" placeholder="Milestone (optional)">
            </div>
          </div>
          <div class="row g-2 mt-2">
            <div class="col-md-4">
              <select class="form-select form-select-sm" name="ato_record_id">
                <option value="">Related ATO/iATO (optional)</option>
                {{#each atoRecords}}
                  <option value="{{this.id}}">{{this.record_type}} - {{this.title}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm" name="residual_risk" placeholder="Residual risk notes (optional)">
            </div>
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm" name="assessor_notes" placeholder="Assessor notes (optional)">
            </div>
          </div>
        </form>
      </div>
    </div>

  {{#if tailorMode}}
  <form id="tailoringForm" method="POST" action="/admin/assessments/{{assessment.id}}/tailoring">
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
      <div><i class="bi bi-pencil-square me-2"></i><strong>Tailoring mode enabled.</strong> Edit fields, mark applicability, or remove controls, then save.</div>
      <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-save me-1"></i>Save Tailoring</button>
    </div>
  {{/if}}

  <!-- Layout: Controls + Family Nav -->
  <div class="row">
    <div class="col-lg-9">

  <!-- Mobile Family Nav -->
  <div class="d-lg-none family-nav-mobile">
    {{#each families}}
      <a href="#family-{{this.code}}" class="family-nav-item" data-family="{{this.code}}">
        <span class="family-nav-code">{{this.code}}</span>
        <span class="family-nav-count">{{this.controls.length}}</span>
      </a>
    {{/each}}
  </div>

  <!-- Control Families -->
  {{#each families}}
    <div class="form-section" id="family-{{this.code}}">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">{{this.code}}</span>
          {{this.name}}
        </h3>
        <p class="section-description">{{this.controls.length}} control(s)</p>
      </div>

      {{#each this.controls}}
        <div class="control-card {{#if this.is_inherited}}inherited{{/if}}" id="control-{{this.id}}">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                {{#if ../../tailorMode}}
                  <input type="checkbox" class="form-check-input ai-control-checkbox" value="{{this.id}}" checked>
                  <input type="hidden" name="control_db_ids" value="{{this.id}}">
                {{else}}
                  <input type="checkbox" class="form-check-input ai-control-checkbox" value="{{this.id}}" style="display:none;">
                {{/if}}
                {{{controlResultIcon this.audit_result}}}
                <span class="control-id">{{this.control_id}}</span>
                <span class="control-title">{{this.title}}</span>
              </div>
              {{#if this.is_inherited}}
                <span class="badge bg-info mb-1"><i class="bi bi-arrow-left-right me-1"></i>Inherited: {{this.inherited_from}}</span>
              {{/if}}
            </div>
            <div class="d-flex gap-1">
              <span class="badge bg-secondary">{{this.priority}}</span>
              {{#eq this.risk_level "high"}}<span class="badge bg-danger">High Risk</span>{{/eq}}
              {{#eq this.risk_level "medium"}}<span class="badge bg-warning text-dark">Med Risk</span>{{/eq}}
              {{#eq this.risk_level "low"}}<span class="badge bg-info">Low Risk</span>{{/eq}}
              {{#if this.audit_result}}{{{statusBadge this.audit_result}}}{{/if}}
            </div>
          </div>

          {{#if ../../tailorMode}}
            <div class="border rounded p-3 mt-3" style="background:#f8f9fa;">
              <div class="row g-2">
                <div class="col-md-8">
                  <label class="form-label small fw-semibold">Control Title</label>
                  <input type="text" class="form-control form-control-sm" name="title_{{this.id}}" value="{{this.title}}">
                </div>
                <div class="col-md-2">
                  <label class="form-label small fw-semibold">Priority</label>
                  <select class="form-select form-select-sm" name="priority_{{this.id}}">
                    <option value="P1" {{#eq this.priority "P1"}}selected{{/eq}}>P1</option>
                    <option value="P2" {{#eq this.priority "P2"}}selected{{/eq}}>P2</option>
                    <option value="P3" {{#eq this.priority "P3"}}selected{{/eq}}>P3</option>
                  </select>
                </div>
                <div class="col-md-2">
                  <label class="form-label small fw-semibold">Risk</label>
                  <select class="form-select form-select-sm" name="risk_level_{{this.id}}">
                    <option value="high" {{#eq this.risk_level "high"}}selected{{/eq}}>High</option>
                    <option value="medium" {{#eq this.risk_level "medium"}}selected{{/eq}}>Medium</option>
                    <option value="low" {{#eq this.risk_level "low"}}selected{{/eq}}>Low</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label small fw-semibold">Control Description</label>
                  <textarea class="form-control form-control-sm" name="description_{{this.id}}" rows="2">{{this.description}}</textarea>
                </div>
                <div class="col-12">
                  <label class="form-label small fw-semibold">Control Guidance</label>
                  <textarea class="form-control form-control-sm" name="control_guidance_{{this.id}}" rows="2">{{this.control_guidance}}</textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Tailored Description</label>
                  <textarea class="form-control form-control-sm" name="tailored_description_{{this.id}}" rows="3">{{this.tailored_description}}</textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Evidence Guidance</label>
                  <textarea class="form-control form-control-sm" name="evidence_guidance_{{this.id}}" rows="3">{{this.evidence_guidance}}</textarea>
                  <input type="hidden" name="guidance_source_{{this.id}}" value="{{this.guidance_source}}">
                  {{#if this.guidance_source}}<div class="form-text">Source: {{this.guidance_source}}{{#if this.ai_generated_at}} on {{formatDate this.ai_generated_at}}{{/if}}</div>{{/if}}
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Evidence Collected</label>
                  <textarea class="form-control form-control-sm" name="evidence_text_{{this.id}}" rows="3">{{this.evidence_text}}</textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Assessor Notes</label>
                  <textarea class="form-control form-control-sm" name="assessor_notes_{{this.id}}" rows="3">{{this.assessor_notes}}</textarea>
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold">Evidence Status</label>
                  <select class="form-select form-select-sm" name="evidence_status_{{this.id}}">
                    <option value="pending" {{#eq this.evidence_status "pending"}}selected{{/eq}}>Pending</option>
                    <option value="provided" {{#eq this.evidence_status "provided"}}selected{{/eq}}>Provided</option>
                    <option value="reviewed" {{#eq this.evidence_status "reviewed"}}selected{{/eq}}>Reviewed</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold">Assessment Status</label>
                  <select class="form-select form-select-sm" name="audit_result_{{this.id}}">
                    <option value="" {{#unless this.audit_result}}selected{{/unless}}>Pending</option>
                    <option value="met" {{#eq this.audit_result "met"}}selected{{/eq}}>Met</option>
                    <option value="partially-met" {{#eq this.audit_result "partially-met"}}selected{{/eq}}>Partially Met</option>
                    <option value="not-met" {{#eq this.audit_result "not-met"}}selected{{/eq}}>Not Met</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold">Applicability</label>
                  <select class="form-select form-select-sm" name="is_applicable_{{this.id}}">
                    <option value="1" {{#if this.is_applicable}}selected{{/if}}>Applicable</option>
                    <option value="0" {{#unless this.is_applicable}}selected{{/unless}}>Not Applicable</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold">Remove</label>
                  <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" name="remove_control_ids" value="{{this.id}}" id="remove-{{this.id}}">
                    <label class="form-check-label small" for="remove-{{this.id}}">Remove from assessment</label>
                  </div>
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold">Inherited</label>
                  <select class="form-select form-select-sm" name="is_inherited_{{this.id}}">
                    <option value="0" {{#unless this.is_inherited}}selected{{/unless}}>No</option>
                    <option value="1" {{#if this.is_inherited}}selected{{/if}}>Yes</option>
                  </select>
                </div>
                <div class="col-md-9">
                  <label class="form-label small fw-semibold">Inherited From</label>
                  <input type="text" class="form-control form-control-sm" name="inherited_from_{{this.id}}" value="{{this.inherited_from}}">
                </div>
              </div>
            </div>
          {{else}}
            {{#if this.description}}
              <div class="mt-2 p-2 rounded" style="background:#f8f9fa">
                <small class="text-muted fw-semibold d-block mb-1">Control Description</small>
                <small>{{this.description}}</small>
              </div>
            {{/if}}
            {{#if this.control_guidance}}
              <div class="mt-2 p-2 rounded" style="background:#eef5ff">
                <small class="text-muted fw-semibold d-block mb-1">Control Guidance</small>
                <small>{{this.control_guidance}}</small>
              </div>
            {{/if}}
          {{/if}}

          {{#if this.tailored_description}}
            <div class="mt-2 p-2 rounded" style="background:#f8f9fa">
              <small class="text-muted fw-semibold d-block mb-1">Tailored Description</small>
              <small>{{this.tailored_description}}</small>
            </div>
          {{/if}}

          {{#if this.evidence_guidance}}
            <div class="mt-2 p-2 rounded" style="background:#fff8e1">
              <small class="text-muted fw-semibold d-block mb-1"><i class="bi bi-info-circle me-1"></i>Evidence Guidance</small>
              <small>{{this.evidence_guidance}}</small>
              {{#if this.guidance_source}}<small class="d-block text-muted mt-1">Source: {{this.guidance_source}}</small>{{/if}}
            </div>
          {{/if}}

          <!-- AI Evidence Guidance (assessor generates guidance for client) -->
          <div class="mt-2 d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm text-white" style="background:#8b5cf6; font-size:.78rem;"
              onclick="aiGenerateGuidance({{this.id}}, '{{this.control_id}}', '{{this.title}}')"
              id="ai-ev-btn-{{this.id}}">
              <i class="bi bi-stars me-1"></i>AI Evidence Guidance
            </button>
            <div id="ai-ev-status-{{this.id}}" class="small text-muted" style="display:none;"></div>
          </div>
          <div id="ai-ev-result-{{this.id}}" style="display:none;" class="mt-2 p-2 rounded border" style="background:#f5f3ff;">
          </div>

          <!-- Evidence (if provided) -->
          {{#eq this.evidence_status "provided"}}
            <div class="mt-2 p-2 rounded border" style="background:#f0fff0">
              <small class="text-success fw-semibold d-block mb-1"><i class="bi bi-check-circle me-1"></i>Evidence Submitted</small>
              <div class="small">{{{this.evidence_html}}}</div>
              {{#if this.evidence_text}}
                {{#unless this.evidence_html}}
                  <div class="small">{{this.evidence_text}}</div>
                {{/unless}}
              {{/if}}
            </div>
          {{/eq}}
          {{#unless this.evidence_text}}
            <div class="mt-2 p-2 rounded border" style="background:#fff">
              <small class="text-muted fw-semibold d-block mb-1">Evidence Collected</small>
              <small class="text-muted">No evidence collected yet.</small>
            </div>
          {{/unless}}

          <div class="mt-2 d-flex flex-wrap gap-2 small">
            <span class="badge {{#if this.is_applicable}}bg-success{{else}}bg-secondary{{/if}}">Applicability: {{#if this.is_applicable}}Applicable{{else}}Not Applicable{{/if}}</span>
            <span class="badge bg-light text-dark border">Evidence: {{this.evidence_status}}</span>
            <span class="badge bg-light text-dark border">Assessment: {{#if this.audit_result}}{{this.audit_result}}{{else}}pending{{/if}}</span>
          </div>

          {{#if this.assessor_notes}}
            <div class="mt-2 p-2 rounded" style="background:#f5f3ff">
              <small class="fw-semibold d-block mb-1"><i class="bi bi-journal-text me-1"></i>Assessor Notes</small>
              <small>{{this.assessor_notes}}</small>
            </div>
          {{/if}}

          {{!-- Audit controls (only in audit status) --}}
          {{#eq ../../assessment.status "audit"}}
            <div class="audit-row mt-3 p-2 rounded" style="background:#f5f7fa">
              <div class="d-flex gap-2 align-items-center flex-wrap">
                <span class="small fw-semibold text-muted me-2">Audit:</span>
                <button type="button" class="audit-btn met {{#eq this.audit_result 'met'}}active{{/eq}}"
                  onclick="auditControl({{this.id}}, '{{../../assessment.id}}', 'met', this)" title="Met">
                  <i class="bi bi-check-lg"></i>
                </button>
                <button type="button" class="audit-btn partial {{#eq this.audit_result 'partially-met'}}active{{/eq}}"
                  onclick="auditControl({{this.id}}, '{{../../assessment.id}}', 'partially-met', this)" title="Partially Met">
                  <i class="bi bi-dash-lg"></i>
                </button>
                <button type="button" class="audit-btn not-met {{#eq this.audit_result 'not-met'}}active{{/eq}}"
                  onclick="auditControl({{this.id}}, '{{../../assessment.id}}', 'not-met', this)" title="Not Met">
                  <i class="bi bi-x-lg"></i>
                </button>
                <input type="text" class="form-control form-control-sm flex-grow-1"
                  id="audit-comment-{{this.id}}" placeholder="Auditor comments..."
                  value="{{this.audit_comments}}"
                  onchange="auditControl({{this.id}}, '{{../../assessment.id}}', null, null, this.value)">
              </div>
            </div>
          {{/eq}}

          {{!-- Audit comments (after audit) --}}
          {{#if this.audit_comments}}
            {{#neq ../../assessment.status "audit"}}
              <div class="mt-2 p-2 rounded" style="background:#fdf2f8">
                <small class="fw-semibold d-block mb-1"><i class="bi bi-chat-left-text me-1"></i>Auditor Comments</small>
                <small>{{this.audit_comments}}</small>
              </div>
            {{/neq}}
          {{/if}}

          <!-- Comment thread toggle -->
          <div class="mt-2">
            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0"
              data-bs-toggle="collapse" data-bs-target="#comments-{{this.id}}">
              <i class="bi bi-chat-dots me-1"></i>Comments
            </button>
          </div>
          <div class="collapse mt-2" id="comments-{{this.id}}">
            <div class="comment-thread border rounded p-2" id="thread-{{this.id}}">
              <div class="text-muted small text-center py-2">Loading comments...</div>
            </div>
            <div class="input-group mt-2">
              <input type="text" class="form-control form-control-sm" id="commentInput-{{this.id}}"
                placeholder="Add a comment...">
              <button class="btn btn-sm btn-outline-primary" onclick="addComment({{this.id}}, '{{../../assessment.id}}')">
                <i class="bi bi-send"></i>
              </button>
            </div>
          </div>
        </div>
