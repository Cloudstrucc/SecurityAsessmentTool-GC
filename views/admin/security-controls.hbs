<div class="container-fluid">
  <div class="d-flex align-items-center justify-content-between mb-4 gap-3 flex-wrap">
    <div>
      <h1 class="mb-0">{{t 'ui.securityControlCatalog'}}</h1>
      <p class="text-muted mb-0">{{t 'ui.browseSupportedFrameworkControlsGuidance'}}</p>
    </div>
    <a class="btn btn-outline-success" href="/admin/security-controls.csv?framework={{filters.framework}}&family={{filters.family}}&q={{filters.q}}&baseline={{filters.baseline}}&category={{filters.category}}&applicability={{filters.applicability}}&status={{filters.status}}">
      <i class="bi bi-file-earmark-spreadsheet me-1"></i>{{t 'ui.exportCsv'}}
    </a>
  </div>

  <form method="GET" action="/admin/security-controls" class="form-section mb-4">
    <div class="section-header">
      <h3 class="section-title"><span class="section-number">1</span>{{t 'ui.filters'}}</h3>
    </div>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label" for="q">{{t 'ui.keyword'}}</label>
        <input type="search" class="form-control" id="q" name="q" value="{{filters.q}}" placeholder="{{t 'ui.controlIdTitleGuidance'}}">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="framework">{{t 'ui.framework'}}</label>
        <select class="form-select" id="framework" name="framework">
          <option value="">{{t 'ui.all'}}</option>
          {{#each frameworks}}
            <option value="{{this.framework}}" {{#eq ../filters.framework this.framework}}selected{{/eq}}>{{this.framework}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="family">{{t 'ui.family'}}</label>
        <select class="form-select" id="family" name="family">
          <option value="">{{t 'ui.all'}}</option>
          {{#each families}}
            <option value="{{this.family}}" {{#eq ../filters.family this.family}}selected{{/eq}}>{{this.family}} - {{this.category}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="category">{{t 'ui.category'}}</label>
        <select class="form-select" id="category" name="category">
          <option value="">{{t 'ui.all'}}</option>
          {{#each categories}}
            <option value="{{this.category}}" {{#eq ../filters.category this.category}}selected{{/eq}}>{{this.category}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-1">
        <label class="form-label" for="status">{{t 'ui.status'}}</label>
        <select class="form-select" id="status" name="status">
          <option value="">{{t 'ui.all'}}</option>
          {{#each statuses}}
            <option value="{{this.status}}" {{#eq ../filters.status this.status}}selected{{/eq}}>{{this.status}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="baseline">{{t 'ui.baseline'}}</label>
        <input type="text" class="form-control" id="baseline" name="baseline" value="{{filters.baseline}}" placeholder="{{t 'ui.pbmmLow'}}">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="applicability">{{t 'ui.applicability'}}</label>
        <input type="text" class="form-control" id="applicability" name="applicability" value="{{filters.applicability}}" placeholder="{{t 'ui.sharedServiceCloud'}}">
      </div>
      <div class="col-md-9 d-flex align-items-end gap-2 flex-wrap">
        <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>{{t 'ui.apply'}}</button>
        <a class="btn btn-outline-secondary" href="/admin/security-controls">{{t 'ui.reset'}}</a>
        <span class="badge bg-primary fs-6">{{controls.length}} controls</span>
      </div>
    </div>
  </form>

  <div class="form-section">
    <div class="section-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
      <h3 class="section-title mb-0"><span class="section-number">2</span>{{t 'ui.catalog'}}</h3>
      <input type="search" class="form-control form-control-sm" id="catalogQuickFilter" placeholder="{{t 'ui.quickFilterVisibleRows'}}" style="max-width:320px;">
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle" id="catalogTable">
        <thead>
          <tr>
            <th data-sort="framework">{{t 'ui.framework'}}</th>
            <th data-sort="control">{{t 'ui.controlId'}}</th>
            <th data-sort="title">{{t 'ui.title'}}</th>
            <th data-sort="family">{{t 'ui.family'}}</th>
            <th>{{t 'ui.description'}}</th>
            <th>{{t 'ui.guidance2'}}</th>
            <th>{{t 'ui.baseline'}}</th>
            <th>{{t 'ui.applicability'}}</th>
            <th>{{t 'ui.status'}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each controls}}
            <tr data-search="{{this.framework}} {{this.control_id}} {{this.title}} {{this.family}} {{this.description}} {{this.guidance}} {{this.baseline}} {{this.category}} {{this.applicability_notes}} {{this.status}}">
              <td><span class="badge bg-light text-dark border">{{this.framework}}</span></td>
              <td><code>{{this.control_id}}</code></td>
              <td>
                <strong>{{this.title}}</strong>
                {{#if this.related_controls}}<br><small class="text-muted">Related: {{this.related_controls}}</small>{{/if}}
                {{#if this.definitions}}<br><small class="text-muted">Definitions: {{this.definitions}}</small>{{/if}}
              </td>
              <td>
                <span class="fw-semibold">{{this.family}}</span>
                {{#if this.category}}<br><small class="text-muted">{{this.category}}</small>{{/if}}
              </td>
              <td style="min-width:260px;"><small>{{this.description}}</small></td>
              <td style="min-width:260px;"><small>{{this.guidance}}</small></td>
              <td><small>{{this.baseline}}</small></td>
              <td><small>{{this.applicability_notes}}</small></td>
              <td><span class="badge bg-success">{{this.status}}</span></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{#unless controls.length}}
      <div class="text-center text-muted py-5">
        <i class="bi bi-search" style="font-size:2.5rem;"></i>
        <p class="mb-0 mt-2">{{t 'ui.noControlsMatchedTheCurrent'}}</p>
      </div>
    {{/unless}}
  </div>
</div>

<script>
const table = document.getElementById('catalogTable');
const quickFilter = document.getElementById('catalogQuickFilter');

if (quickFilter) {
  quickFilter.addEventListener('input', () => {
    const query = quickFilter.value.toLowerCase();
    table.querySelectorAll('tbody tr').forEach(row => {
      row.style.display = row.dataset.search.toLowerCase().includes(query) ? '' : 'none';
    });
  });
}

table.querySelectorAll('th[data-sort]').forEach((header, index) => {
  header.style.cursor = 'pointer';
  header.title = 'Sort';
  header.addEventListener('click', () => {
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const direction = header.dataset.direction === 'asc' ? 'desc' : 'asc';
    header.dataset.direction = direction;
    rows.sort((a, b) => {
      const av = (a.children[index]?.innerText || '').trim().toLowerCase();
      const bv = (b.children[index]?.innerText || '').trim().toLowerCase();
      return direction === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
    });
    rows.forEach(row => tbody.appendChild(row));
  });
});
</script>
