<div class="container py-5" style="max-width:540px;">
  <div class="text-center mb-4">
    <i class="bi bi-person-plus" style="font-size:3rem;color:var(--gc-nav)"></i>
    <h2 class="mt-2" style="color:var(--gc-nav)">Create Assessor Account</h2>
    <p class="text-muted">Use your invitation code to join the assessment workspace.</p>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <form method="POST" action="/admin/register">
        {{#if inviteCode}}<input type="hidden" name="invite_code" value="{{inviteCode}}">{{/if}}
        <div class="mb-3">
          <label class="form-label" for="name">Full Name</label>
          <input type="text" class="form-control" id="name" name="name" required value="{{formData.name}}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <input type="email" class="form-control" id="email" name="email" required value="{{formData.email}}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="organization">Organization</label>
          <input type="text" class="form-control" id="organization" name="organization" value="{{formData.organization}}">
        </div>
        {{#unless inviteCode}}
          <div class="mb-3">
            <label class="form-label" for="invite_code_visible">Invitation Code</label>
            <input type="text" class="form-control text-uppercase" id="invite_code_visible" name="invite_code" required>
          </div>
        {{/unless}}
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <input type="password" class="form-control" id="password" name="password" required minlength="10">
        </div>
        <div class="mb-4">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="10">
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-arrow-right me-2"></i>Create Account
        </button>
      </form>
    </div>
  </div>

  <div class="text-center mt-3">
    <a href="/admin/login" class="text-muted small">Back to assessor login</a>
  </div>
</div>
