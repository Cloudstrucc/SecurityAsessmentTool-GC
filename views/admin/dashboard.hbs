<div class="container">
  <div class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">{{t 'ui.dashboard'}}</h1>
      <p class="text-muted mb-0">Welcome back, {{admin.name}}</p>
      <div class="rule"></div>
    </div>
    <a href="/admin/projects/new" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i>{{t 'ui.newProject'}}
    </a>
  </div>

  <!-- Stats Cards (each navigates to its list) -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg">
      <a href="/admin/projects" class="text-decoration-none">
        <div class="stat-card">
          <div class="stat-icon" style="background:#e7f1fb;color:var(--gc-accent)"><i class="bi bi-folder2-open"></i></div>
          <div class="stat-number">{{stats.totalProjects}}</div>
          <div class="stat-label">{{t 'ui.totalProjects'}}</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg">
      <a href="/admin/assessments" class="text-decoration-none">
        <div class="stat-card">
          <div class="stat-icon" style="background:#fff3cd;color:var(--gc-warning)"><i class="bi bi-clipboard-check"></i></div>
          <div class="stat-number">{{stats.activeAssessments}}</div>
          <div class="stat-label">{{t 'ui.activeAssessments'}}</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg">
      <a href="/admin/assessments?filter=audit" class="text-decoration-none">
        <div class="stat-card">
          <div class="stat-icon" style="background:#f8d7da;color:var(--gc-danger)"><i class="bi bi-search"></i></div>
          <div class="stat-number">{{stats.pendingAudits}}</div>
          <div class="stat-label">{{t 'ui.pendingAudits'}}</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg">
      <a href="/admin/assessments?filter=ato" class="text-decoration-none">
        <div class="stat-card">
          <div class="stat-icon" style="background:#d8eeca;color:var(--gc-success)"><i class="bi bi-patch-check"></i></div>
          <div class="stat-number">{{stats.activeATOs}}</div>
          <div class="stat-label">{{t 'ui.activeAtos'}}</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg">
      <a href="/admin/intakes" class="text-decoration-none">
        <div class="stat-card {{#if stats.pendingIntakes}}border-warning{{/if}}">
          <div class="stat-icon" style="background:#e2d9f3;color:#6f42c1"><i class="bi bi-inbox"></i></div>
          <div class="stat-number">{{stats.pendingIntakes}}</div>
          <div class="stat-label">{{t 'ui.pendingIntakes'}}</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg">
      <a href="/admin/self-assessments" class="text-decoration-none">
        <div class="stat-card {{#if stats.pendingSelfAssessments}}border-warning{{/if}}">
          <div class="stat-icon" style="background:#f0f4ff;color:var(--gc-accent)"><i class="bi bi-clipboard2-pulse"></i></div>
          <div class="stat-number">{{stats.pendingSelfAssessments}}</div>
          <div class="stat-label">{{t 'ui.selfAssessments'}}</div>
        </div>
      </a>
    </div>
  </div>

  <!-- AI token usage (built-in Anthropic allowance) -->
  {{#if (eq aiProvider 'oob')}}
    {{#unless tokenStatus.unlimited}}
      <div class="card mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div><i class="bi bi-robot me-2" style="color:var(--cs-accent)"></i><strong>{{t 'ui.builtInAiUsage'}}</strong> <span class="text-muted small">{{t 'ui.thisMonth'}}</span></div>
            <div class="d-flex align-items-center gap-2">
              <span class="small text-muted">{{tokenStatus.used}} / {{tokenStatus.limit}} tokens ({{tokenStatus.pct}}%)</span>
              {{#if isRootAdmin}}<a href="/billing/tokens" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle me-1"></i>{{t 'ui.addTokens'}}</a>{{/if}}
            </div>
          </div>
          <div class="progress" style="height:10px">
            <div class="progress-bar{{#ifCond tokenStatus.pct '>=' 90}} bg-danger{{else}}{{#ifCond tokenStatus.pct '>=' 75}} bg-warning{{/ifCond}}{{/ifCond}}" role="progressbar" style="width:{{tokenStatus.pct}}%"></div>
          </div>
          <div class="small text-muted mt-1">
            {{tokenStatus.remaining}} tokens remaining.
            {{#ifCond tokenStatus.pct '>=' 90}}You're nearly out — <a href="/billing/tokens">{{t 'ui.topUp'}}</a> or <a href="/admin/organization#ai">{{t 'ui.useYourOwnAiProvider'}}</a>.{{else}}Prefer uncapped AI? <a href="/admin/organization#ai">{{t 'ui.bringYourOwnProvider'}}</a>.{{/ifCond}}
          </div>
        </div>
      </div>
    {{/unless}}
  {{else}}
    <div class="alert alert-info d-flex align-items-center mb-4" style="border-left:4px solid var(--cs-accent)">
      <i class="bi bi-robot me-2"></i><div>{{t 'ui.aiIsRunningOnYour'}} <strong>own {{aiProvider}}</strong> {{t 'ui.providerNoPlatformTokenLimit'}} <a href="/admin/organization#ai">{{t 'ui.organizationSettings'}}</a>.</div>
    </div>
  {{/if}}

  <div class="row g-4">
    <!-- Recent Projects -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-folder2-open me-2"></i>{{t 'ui.recentProjects'}}</span>
          <a href="/admin/projects" class="btn btn-sm btn-outline-light">{{t 'ui.viewAll'}}</a>
        </div>
        <div class="card-body p-0">
          {{#if projects.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{t 'ui.name'}}</th>
                    <th>{{t 'ui.classification'}}</th>
                    <th>{{t 'ui.status'}}</th>
                    <th>{{t 'ui.updated'}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each projects}}
                    <tr style="cursor:pointer" onclick="window.location='/admin/projects/{{this.id}}'">
                      <td class="fw-semibold">{{this.name}}</td>
                      <td><span class="badge bg-info">{{this.data_classification}}</span></td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td class="text-muted small">{{formatDate this.updated_at}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-4 text-center text-muted">
              <i class="bi bi-folder-plus" style="font-size:2rem"></i>
              <p class="mt-2 mb-0">{{t 'ui.noProjectsYet'}} <a href="/admin/projects/new">{{t 'ui.createYourFirstProject'}}</a></p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Recent Assessments -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-clipboard-check me-2"></i>{{t 'ui.recentAssessments'}}</span>
          <a href="/admin/assessments" class="btn btn-sm btn-outline-light">{{t 'ui.viewAll'}}</a>
        </div>
        <div class="card-body p-0">
          {{#if assessments.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{t 'ui.project'}}</th>
                    <th>{{t 'ui.status'}}</th>
                    <th>{{t 'ui.result'}}</th>
                    <th>{{t 'ui.updated'}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each assessments}}
                    <tr style="cursor:pointer" onclick="window.location='/admin/assessments/{{this.id}}'">
                      <td class="fw-semibold">{{this.project_name}}</td>
                      <td>{{{statusBadge this.status}}}</td>
                      <td>
                        {{#if this.result}}{{{statusBadge this.result}}}{{else}}<span class="text-muted">—</span>{{/if}}
                      </td>
                      <td class="text-muted small">{{formatDate this.updated_at}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-4 text-center text-muted">
              <i class="bi bi-clipboard-plus" style="font-size:2rem"></i>
              <p class="mt-2 mb-0">{{t 'ui.noAssessmentsYet'}}</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  {{#if stats.activeIATOs}}
    <div class="row mt-4">
      <div class="col-12">
        <div class="alert alert-warning">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>{{stats.activeIATOs}} active iATO(s)</strong> {{t 'ui.requireRemediationTrackingReviewThe'}}
        </div>
      </div>
    </div>
  {{/if}}

  <!-- Recent Intakes -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-inbox me-2"></i>{{t 'ui.recentIntakes'}}</span>
          <a href="/admin/intakes" class="btn btn-sm btn-outline-light">{{t 'ui.viewAll'}}</a>
        </div>
        <div class="card-body p-0">
          {{#if recentIntakes.length}}
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>{{t 'ui.ref'}}</th>
                    <th>{{t 'ui.project'}}</th>
                    <th>{{t 'ui.department'}}</th>
                    <th>{{t 'ui.classification'}}</th>
                    <th>{{t 'ui.status'}}</th>
                    <th>{{t 'ui.submitted'}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each recentIntakes}}
                    <tr style="cursor:pointer" onclick="window.location='/admin/intakes/{{this.id}}'">
                      <td><code class="small">{{this.ref_code}}</code></td>
                      <td class="fw-semibold">{{this.project_name}}</td>
                      <td class="text-muted small">{{this.department}}</td>
                      <td><span class="badge bg-info">{{this.data_classification}}</span></td>
                      <td>
                        {{#ifCond this.status '==' 'pending'}}<span class="badge bg-warning text-dark">{{t 'ui.pending'}}</span>{{/ifCond}}
                        {{#ifCond this.status '==' 'in-review'}}<span class="badge bg-info">{{t 'ui.inReview'}}</span>{{/ifCond}}
                        {{#ifCond this.status '==' 'accepted'}}<span class="badge bg-success">{{t 'ui.accepted'}}</span>{{/ifCond}}
                        {{#ifCond this.status '==' 'declined'}}<span class="badge bg-danger">{{t 'ui.declined'}}</span>{{/ifCond}}
                      </td>
                      <td class="text-muted small">{{formatDate this.created_at}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="p-4 text-center text-muted">
              <i class="bi bi-inbox" style="font-size:2rem"></i>
              <p class="mt-2 mb-0">{{t 'ui.noIntakesSubmittedYetShare'}} <a href="/intake" target="_blank">{{t 'ui.intakeForm'}}</a> {{t 'ui.withProjectTeams'}}</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
