<div class="container">
  <div class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">{{#if showArchived}}Archived Projects{{else}}Projects{{/if}}</h1>
      <p class="text-muted mb-0">{{#if showArchived}}Projects hidden from the dashboard. Restore or permanently delete them.{{else}}Manage your security assessment projects{{/if}}</p>
      <div class="rule"></div>
    </div>
    <div class="d-flex gap-2">
      {{#if showArchived}}
        <a href="/admin/projects" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i>Active Projects
        </a>
      {{else}}
        {{#if archivedCount}}
          <a href="/admin/projects?archived=1" class="btn btn-outline-secondary">
            <i class="bi bi-archive me-1"></i>Archived <span class="badge bg-secondary ms-1">{{archivedCount}}</span>
          </a>
        {{/if}}
        <a href="/admin/projects/new" class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i>New Project
        </a>
      {{/if}}
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      {{#if projects.length}}
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Project Name</th>
                <th>Classification</th>
                <th>Hosting</th>
                <th>Owner</th>
                <th>Status</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each projects}}
                <tr>
                  <td>
                    <a href="/admin/projects/{{this.id}}" class="fw-semibold text-decoration-none">{{this.name}}</a>
                    {{#if this.has_pii}}<span class="badge bg-danger ms-1" title="Contains PII">PII</span>{{/if}}
                  </td>
                  <td><span class="badge bg-info">{{this.data_classification}}</span></td>
                  <td class="text-muted">{{this.hosting_type}}</td>
                  <td class="text-muted">{{this.project_owner_name}}</td>
                  <td>{{{statusBadge this.status}}}</td>
                  <td class="text-muted small">{{formatDate this.created_at}}</td>
                  <td class="text-end text-nowrap">
                    <a href="/admin/projects/{{this.id}}" class="btn btn-sm btn-outline-primary" title="View project">
                      <i class="bi bi-eye"></i>
                    </a>
                    {{#if ../showArchived}}
                      <form action="/admin/projects/{{this.id}}/unarchive" method="POST" class="d-inline ms-1">
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Restore project">
                          <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                      </form>
                    {{else}}
                      <form action="/admin/projects/{{this.id}}/archive" method="POST" class="d-inline ms-1">
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Archive project">
                          <i class="bi bi-archive"></i>
                        </button>
                      </form>
                    {{/if}}
                    <a href="/admin/projects/{{this.id}}#delete" class="btn btn-sm btn-outline-danger ms-1" title="Delete project">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="p-5 text-center text-muted">
          <i class="bi bi-folder-plus" style="font-size:3rem"></i>
          <h4 class="mt-3">No projects yet</h4>
          <p>Create your first project to start a security assessment.</p>
          <a href="/admin/projects/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create Project</a>
        </div>
      {{/if}}
    </div>
  </div>
</div>
