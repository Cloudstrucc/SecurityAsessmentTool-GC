<div class="container" style="max-width:1100px;">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects/{{project.id}}" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div class="flex-grow-1">
      <h1 class="mb-0">{{#if ato.id}}Edit{{else}}New{{/if}} ATO / iATO</h1>
      <p class="text-muted mb-0">{{project.name}} authorization record</p>
    </div>
    {{#if ato.id}}
      <a href="/admin/ato/{{ato.id}}/export-pdf" class="btn btn-outline-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
      </a>
    {{/if}}
  </div>

  <form method="POST" action="{{#if ato.id}}/admin/ato/{{ato.id}}{{else}}/admin/projects/{{project.id}}/ato/new{{/if}}">
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="form-section">
          <div class="section-header">
            <h3 class="section-title"><span class="section-number">1</span>Authorization Details</h3>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label" for="record_type">Type</label>
              <select class="form-select" id="record_type" name="record_type">
                <option value="ato" {{#eq ato.record_type "ato"}}selected{{/eq}}>ATO</option>
                <option value="iato" {{#eq ato.record_type "iato"}}selected{{/eq}}>iATO</option>
              </select>
            </div>
            <div class="col-md-9">
              <label class="form-label" for="title">Title</label>
              <input type="text" class="form-control" id="title" name="title" value="{{ato.title}}" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="system_name">System Name</label>
              <input type="text" class="form-control" id="system_name" name="system_name" value="{{ato.system_name}}">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="organization_name">Organization Name</label>
              <input type="text" class="form-control" id="organization_name" name="organization_name" value="{{ato.organization_name}}">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="authorizing_official">Authorizing Official</label>
              <input type="text" class="form-control" id="authorizing_official" name="authorizing_official" value="{{ato.authorizing_official}}">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="assessor">Assessor</label>
              <input type="text" class="form-control" id="assessor" name="assessor" value="{{ato.assessor}}">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="authorization_status">Status</label>
              <select class="form-select" id="authorization_status" name="authorization_status">
                <option value="draft" {{#eq ato.authorization_status "draft"}}selected{{/eq}}>Draft</option>
                <option value="review" {{#eq ato.authorization_status "review"}}selected{{/eq}}>In Review</option>
                <option value="approved" {{#eq ato.authorization_status "approved"}}selected{{/eq}}>Approved</option>
                <option value="expired" {{#eq ato.authorization_status "expired"}}selected{{/eq}}>Expired</option>
                <option value="revoked" {{#eq ato.authorization_status "revoked"}}selected{{/eq}}>Revoked</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="authorization_date">Authorization Date</label>
              <input type="date" class="form-control" id="authorization_date" name="authorization_date" value="{{ato.authorization_date}}">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="expiry_date">Expiry Date</label>
              <input type="date" class="form-control" id="expiry_date" name="expiry_date" value="{{ato.expiry_date}}">
            </div>
            <div class="col-12">
              <label class="form-label" for="assessment_id">Linked Assessment</label>
              <select class="form-select" id="assessment_id" name="assessment_id">
                <option value="">Project-level authorization</option>
                {{#each assessments}}
                  <option value="{{this.id}}" {{#eq ../ato.assessment_id this.id}}selected{{/eq}}>Assessment {{this.id}} - {{this.status}} {{#if this.invite_code}}({{this.invite_code}}){{/if}}</option>
                {{/each}}
              </select>
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3 class="section-title"><span class="section-number">2</span>Editable Report Content</h3>
            <p class="section-description">All generated/static content remains editable before export.</p>
          </div>
          <label class="form-label" for="executive_summary">Executive Summary</label>
          <textarea class="form-control mb-3" id="executive_summary" name="executive_summary" rows="4">{{ato.executive_summary}}</textarea>

          <label class="form-label" for="system_description">System Description</label>
          <textarea class="form-control mb-3" id="system_description" name="system_description" rows="4">{{ato.system_description}}</textarea>

          <label class="form-label" for="assessment_scope">Assessment Scope</label>
          <textarea class="form-control mb-3" id="assessment_scope" name="assessment_scope" rows="3">{{ato.assessment_scope}}</textarea>

          <label class="form-label" for="risk_summary">Risk Summary</label>
          <textarea class="form-control mb-3" id="risk_summary" name="risk_summary" rows="3">{{ato.risk_summary}}</textarea>

          <label class="form-label" for="residual_risk_statement">Residual Risk Statement</label>
          <textarea class="form-control mb-3" id="residual_risk_statement" name="residual_risk_statement" rows="3">{{ato.residual_risk_statement}}</textarea>

          <label class="form-label" for="conditions_of_authorization">Conditions Of Authorization</label>
          <textarea class="form-control mb-3" id="conditions_of_authorization" name="conditions_of_authorization" rows="4">{{ato.conditions_of_authorization}}</textarea>

          <label class="form-label" for="security_control_summary">Security Control Summary</label>
          <textarea class="form-control mb-3" id="security_control_summary" name="security_control_summary" rows="3">{{ato.security_control_summary}}</textarea>

          <label class="form-label" for="poam_summary">POA&M Summary</label>
          <textarea class="form-control mb-3" id="poam_summary" name="poam_summary" rows="3">{{ato.poam_summary}}</textarea>

          <label class="form-label" for="assessor_notes">Assessor Notes</label>
          <textarea class="form-control mb-3" id="assessor_notes" name="assessor_notes" rows="3">{{ato.assessor_notes}}</textarea>

          <label class="form-label" for="static_sections">Static Text Sections</label>
          <textarea class="form-control mb-3" id="static_sections" name="static_sections" rows="4">{{ato.static_sections}}</textarea>

          <label class="form-label" for="custom_sections">Custom Sections</label>
          <textarea class="form-control" id="custom_sections" name="custom_sections" rows="4">{{ato.custom_sections}}</textarea>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card mb-3">
          <div class="card-header bg-light"><i class="bi bi-palette me-2"></i>Report Branding</div>
          <div class="card-body small">
            <div><strong>Organization:</strong> {{#if branding.organization_name}}{{branding.organization_name}}{{else}}Not configured{{/if}}</div>
            <div><strong>Logo:</strong> {{#if branding.logo_original_name}}{{branding.logo_original_name}}{{else}}None{{/if}}</div>
            <div><strong>Classification:</strong> {{branding.classification_label}}</div>
            <a href="/admin/projects/{{project.id}}#reporting" class="btn btn-sm btn-outline-primary mt-3">Edit Branding</a>
          </div>
        </div>

        <div class="card">
          <div class="card-header bg-light"><i class="bi bi-list-check me-2"></i>Risk Remediation</div>
          <div class="card-body small">
            {{#if ato.id}}
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span>Linked POA&M items</span>
                <span class="badge bg-dark">{{poamItems.length}}</span>
              </div>
              <a href="#poam-section" class="btn btn-sm btn-outline-primary w-100">Manage Items</a>
            {{else}}
              <p class="text-muted mb-0">Save the ATO/iATO record before adding remediation items.</p>
            {{/if}}
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-center my-4">
      <a href="/admin/projects/{{project.id}}" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save me-2"></i>Save ATO/iATO</button>
    </div>
  </form>

  {{#if ato.id}}
  <div class="card mb-4" id="poam-section">
    <div class="card-header d-flex justify-content-between align-items-center" style="background:var(--gc-warning)">
      <span><i class="bi bi-clipboard2-check me-2"></i><strong>Risk Remediation Items / POA&M</strong></span>
      <span class="badge bg-dark">{{poamItems.length}} item(s)</span>
    </div>
    <div class="card-body">
      {{#if poamItems.length}}
        <div class="table-responsive mb-4">
          <table class="table table-hover table-sm align-middle mb-0" style="font-size:.85rem">
            <thead>
              <tr>
                <th style="width:65px">Risk</th>
                <th>Finding / Weakness</th>
                <th style="width:100px">Control</th>
                <th style="width:115px">Due</th>
                <th style="width:130px">Owner</th>
                <th style="width:125px">Status</th>
                <th style="width:90px"></th>
              </tr>
            </thead>
            <tbody>
              {{#each poamItems}}
                <tr>
                  <td>
                    {{#eq this.risk_level "high"}}<span class="badge bg-danger">High</span>{{/eq}}
                    {{#eq this.risk_level "medium"}}<span class="badge bg-warning text-dark">Medium</span>{{/eq}}
                    {{#eq this.risk_level "low"}}<span class="badge bg-info">Low</span>{{/eq}}
                  </td>
                  <td>
                    <div class="fw-semibold">{{this.description}}</div>
                    {{#if this.original_finding}}<small class="text-muted d-block">Finding: {{this.original_finding}}</small>{{/if}}
                    {{#if this.remediation_plan}}<small class="text-primary d-block">Plan: {{this.remediation_plan}}</small>{{/if}}
                    {{#if this.milestone}}<small class="text-muted d-block">Milestone: {{this.milestone}}</small>{{/if}}
                    {{#if this.residual_risk}}<small class="text-danger d-block">Residual Risk: {{this.residual_risk}}</small>{{/if}}
                    {{#if this.assessor_notes}}<small class="text-muted d-block">Assessor Notes: {{this.assessor_notes}}</small>{{/if}}
                  </td>
                  <td>
                    {{#if this.control_id}}<code>{{this.control_id}}</code>{{else}}<span class="text-muted">Project</span>{{/if}}
                    {{#if this.assessment_invite_code}}<small class="text-muted d-block">{{this.assessment_invite_code}}</small>{{/if}}
                  </td>
                  <td class="small">{{formatDate this.deadline}}</td>
                  <td class="small">{{this.assigned_to}}</td>
                  <td>
                    <form method="POST" action="/admin/ato/{{../ato.id}}/poam/{{this.id}}/update">
                      <input type="hidden" name="assessment_id" value="{{this.assessment_id}}">
                      <input type="hidden" name="control_id" value="{{this.control_id}}">
                      <input type="hidden" name="description" value="{{this.description}}">
                      <input type="hidden" name="risk_level" value="{{this.risk_level}}">
                      <input type="hidden" name="original_finding" value="{{this.original_finding}}">
                      <input type="hidden" name="remediation_plan" value="{{this.remediation_plan}}">
                      <input type="hidden" name="milestone" value="{{this.milestone}}">
                      <input type="hidden" name="deadline" value="{{this.deadline}}">
                      <input type="hidden" name="assigned_to" value="{{this.assigned_to}}">
                      <input type="hidden" name="residual_risk" value="{{this.residual_risk}}">
                      <input type="hidden" name="assessor_notes" value="{{this.assessor_notes}}">
                      <select class="form-select form-select-sm" name="status" onchange="this.form.submit()" style="font-size:.78rem">
                        <option value="open" {{#eq this.status "open"}}selected{{/eq}}>Open</option>
                        <option value="in-progress" {{#eq this.status "in-progress"}}selected{{/eq}}>In Progress</option>
                        <option value="completed" {{#eq this.status "completed"}}selected{{/eq}}>Completed</option>
                        <option value="verified" {{#eq this.status "verified"}}selected{{/eq}}>Verified</option>
                      </select>
                    </form>
                  </td>
                  <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary p-0 px-1 me-1" type="button"
                      data-bs-toggle="collapse" data-bs-target="#ato-poam-edit-{{this.id}}" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form method="POST" action="/admin/ato/{{../ato.id}}/poam/{{this.id}}/delete"
                      onsubmit="return confirm('Remove this remediation item?')" class="d-inline">
                      <button class="btn btn-sm btn-outline-danger p-0 px-1" title="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
                <tr class="collapse" id="ato-poam-edit-{{this.id}}">
                  <td colspan="7" class="bg-light">
                    <form method="POST" action="/admin/ato/{{../ato.id}}/poam/{{this.id}}/update" class="p-2">
                      <div class="row g-2">
                        <div class="col-md-7">
                          <label class="form-label small fw-semibold">Finding / Weakness</label>
                          <input type="text" class="form-control form-control-sm" name="description" value="{{this.description}}" required>
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Risk</label>
                          <select class="form-select form-select-sm" name="risk_level">
                            <option value="high" {{#eq this.risk_level "high"}}selected{{/eq}}>High</option>
                            <option value="medium" {{#eq this.risk_level "medium"}}selected{{/eq}}>Medium</option>
                            <option value="low" {{#eq this.risk_level "low"}}selected{{/eq}}>Low</option>
                          </select>
                        </div>
                        <div class="col-md-3">
                          <label class="form-label small fw-semibold">Status</label>
                          <select class="form-select form-select-sm" name="status">
                            <option value="open" {{#eq this.status "open"}}selected{{/eq}}>Open</option>
                            <option value="in-progress" {{#eq this.status "in-progress"}}selected{{/eq}}>In Progress</option>
                            <option value="completed" {{#eq this.status "completed"}}selected{{/eq}}>Completed</option>
                            <option value="verified" {{#eq this.status "verified"}}selected{{/eq}}>Verified</option>
                          </select>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Assessment</label>
                          <select class="form-select form-select-sm" name="assessment_id">
                            <option value="">Project-level item</option>
                            {{#each ../assessments}}
                              <option value="{{this.id}}" {{#eq ../assessment_id this.id}}selected{{/eq}}>Assessment {{this.id}} {{#if this.invite_code}}({{this.invite_code}}){{/if}}</option>
                            {{/each}}
                          </select>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Related Control</label>
                          <select class="form-select form-select-sm" name="control_id">
                            <option value="">Project-level finding</option>
                            {{#each ../controlOptions}}
                              <option value="{{this.control_id}}" {{#eq ../control_id this.control_id}}selected{{/eq}}>{{this.control_id}} - {{this.title}}</option>
                            {{/each}}
                          </select>
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Target Date</label>
                          <input type="date" class="form-control form-control-sm" name="deadline" value="{{this.deadline}}">
                        </div>
                        <div class="col-md-2">
                          <label class="form-label small fw-semibold">Owner</label>
                          <input type="text" class="form-control form-control-sm" name="assigned_to" value="{{this.assigned_to}}">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Original Finding</label>
                          <textarea class="form-control form-control-sm" name="original_finding" rows="2">{{this.original_finding}}</textarea>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label small fw-semibold">Mitigation Plan</label>
                          <textarea class="form-control form-control-sm" name="remediation_plan" rows="2">{{this.remediation_plan}}</textarea>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Milestone Notes</label>
                          <textarea class="form-control form-control-sm" name="milestone" rows="2">{{this.milestone}}</textarea>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Residual Risk</label>
                          <textarea class="form-control form-control-sm" name="residual_risk" rows="2">{{this.residual_risk}}</textarea>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label small fw-semibold">Assessor Notes</label>
                          <textarea class="form-control form-control-sm" name="assessor_notes" rows="2">{{this.assessor_notes}}</textarea>
                        </div>
                        <div class="col-12">
                          <button class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i>Save Remediation Item</button>
                        </div>
                      </div>
                    </form>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="text-muted">No remediation items are linked to this ATO/iATO yet.</p>
      {{/if}}

      <hr>
      <h6 class="fw-semibold mb-3"><i class="bi bi-plus-circle me-1"></i>Add Risk Remediation Item</h6>
      <form method="POST" action="/admin/ato/{{ato.id}}/poam/add">
        <div class="row g-2">
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Finding / Weakness</label>
            <input type="text" class="form-control form-control-sm" name="description" placeholder="Describe the finding or weakness" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Risk</label>
            <select class="form-select form-select-sm" name="risk_level">
              <option value="high">High</option>
              <option value="medium" selected>Medium</option>
              <option value="low">Low</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Status</label>
            <select class="form-select form-select-sm" name="status">
              <option value="open" selected>Open</option>
              <option value="in-progress">In Progress</option>
              <option value="completed">Completed</option>
              <option value="verified">Verified</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Target Date</label>
            <input type="date" class="form-control form-control-sm" name="deadline">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Owner</label>
            <input type="text" class="form-control form-control-sm" name="assigned_to" placeholder="Owner">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Assessment</label>
            <select class="form-select form-select-sm" name="assessment_id">
              <option value="">Project-level item</option>
              {{#each assessments}}
                <option value="{{this.id}}" {{#eq ../ato.assessment_id this.id}}selected{{/eq}}>Assessment {{this.id}} {{#if this.invite_code}}({{this.invite_code}}){{/if}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Related Control</label>
            <select class="form-select form-select-sm" name="control_id">
              <option value="">Project-level finding</option>
              {{#each controlOptions}}
                <option value="{{this.control_id}}">{{this.control_id}} - {{this.title}}</option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Original Finding</label>
            <input type="text" class="form-control form-control-sm" name="original_finding" placeholder="Finding source or summary">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Mitigation Plan</label>
            <textarea class="form-control form-control-sm" name="remediation_plan" rows="2"></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Milestone Notes</label>
            <textarea class="form-control form-control-sm" name="milestone" rows="2"></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Residual Risk</label>
            <textarea class="form-control form-control-sm" name="residual_risk" rows="2"></textarea>
          </div>
          <div class="col-md-8">
            <label class="form-label small fw-semibold">Assessor Notes</label>
            <textarea class="form-control form-control-sm" name="assessor_notes" rows="2"></textarea>
          </div>
          <div class="col-md-4 d-flex align-items-end">
            <button class="btn btn-warning w-100"><i class="bi bi-plus-lg me-1"></i>Add Remediation Item</button>
          </div>
        </div>
      </form>
    </div>
  </div>
  {{/if}}
</div>
