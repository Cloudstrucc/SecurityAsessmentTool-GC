<div class="container" style="max-width: 960px;">
  <div class="d-flex align-items-center mb-4">
    <a href="/admin/projects" class="btn btn-outline-primary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
      <h1 class="mb-0">{{t 'ui.newProject'}}</h1>
      <p class="text-muted mb-0">{{t 'ui.defineTheImItProject'}}</p>
    </div>
  </div>

  <form method="POST" action="/admin/projects/new" id="projectForm" enctype="multipart/form-data">
    <!-- Holds the AI reference document (if one was used to pre-fill the project) so
         it is saved as the project's first document on creation. Set via JS. -->
    <input type="file" name="reference_document" id="referenceDocInput" class="d-none" tabindex="-1" aria-hidden="true">

    <!-- AI Quick Start -->
    <div class="form-section" style="border-left:3px solid #8b5cf6; background:linear-gradient(135deg,#faf5ff 0%,#f5f3ff 100%);">
      <div class="section-header" style="border-bottom-color:#e9d5ff;">
        <h3 class="section-title" style="color:#6d28d9;">
          <i class="bi bi-stars me-2"></i>{{t 'ui.aiAssistedProjectIntake'}}
          <span class="badge text-white" style="font-size:0.65rem;background:#8b5cf6;vertical-align:middle;">BETA</span>
        </h3>
        <p class="section-description">{{t 'ui.uploadAProjectDocumentOr'}}</p>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="card h-100" style="border-color:#e9d5ff;">
            <div class="card-body">
              <h6 class="fw-bold mb-2"><i class="bi bi-file-earmark-arrow-up me-1" style="color:#8b5cf6;"></i>{{t 'ui.uploadADocument'}}</h6>
              <p class="text-muted small mb-2">{{t 'ui.useADesignDocPia'}}</p>
              <input type="file" class="form-control form-control-sm" id="aiDocUpload" accept=".pdf,.txt,.md,.doc,.docx,.png,.jpg,.jpeg">
              <button type="button" class="btn btn-sm w-100 mt-2 text-white" style="background:#8b5cf6;" id="aiDocParseBtn" disabled onclick="aiParseDocument()">
                <i class="bi bi-stars me-1"></i>{{t 'ui.analyzePreFill'}}
              </button>
              <div id="refDocNote" class="small text-success mt-2" style="display:none;"><i class="bi bi-paperclip me-1"></i><span id="refDocNoteText"></span></div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card h-100" style="border-color:#e9d5ff;">
            <div class="card-body">
              <h6 class="fw-bold mb-2"><i class="bi bi-chat-text me-1" style="color:#8b5cf6;"></i>{{t 'ui.describeTheProject'}}</h6>
              <p class="text-muted small mb-2">{{t 'ui.describeThePurposeUsersData'}}</p>
              <textarea class="form-control form-control-sm" id="aiPlainDesc" rows="3" placeholder="{{t 'ui.eGACloudHosted'}}"></textarea>
              <button type="button" class="btn btn-sm w-100 mt-2 text-white" style="background:#8b5cf6;" id="aiSuggestBtn" disabled onclick="aiSuggestFromDescription()">
                <i class="bi bi-stars me-1"></i>{{t 'ui.getSuggestions'}}
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="aiProjectStatus" class="mt-2" style="display:none;"></div>
    </div>

    <!-- Section 1: Project Information -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">1</span>
          {{t 'ui.projectInformation'}}
        </h3>
        <p class="section-description">{{t 'ui.basicDetailsAboutTheIm'}}</p>
      </div>
      <div class="mb-3">
        <label class="form-label" for="name">{{t 'ui.projectName'}} <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="name" name="name" required placeholder="{{t 'ui.eGHrCaseManagement'}}">
      </div>
      <div class="mb-3">
        <label class="form-label" for="description">{{t 'ui.projectDescription'}} <span class="text-danger">*</span></label>
        <textarea class="form-control" id="description" name="description" rows="4" required
          placeholder="{{t 'ui.describeTheSystemSPurpose'}}"></textarea>
        <div class="form-text">{{t 'ui.provideEnoughDetailForThe'}}</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="specifications">{{t 'ui.technicalSpecificationsOptional'}}</label>
        <textarea class="form-control" id="specifications" name="specifications" rows="3"
          placeholder="{{t 'ui.architectureDetailsIntegrationPointsApis'}}"></textarea>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="department">{{t 'ui.departmentAgency'}}</label>
          <input type="text" class="form-control" id="department" name="department" placeholder="{{t 'ui.eGTreasuryBoardSecretariat'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="branch">{{t 'ui.branchDirectorate'}}</label>
          <input type="text" class="form-control" id="branch" name="branch" placeholder="{{t 'ui.eGDigitalServices'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="user_count">{{t 'ui.estimatedUserCount'}}</label>
          <select class="form-select" id="user_count" name="user_count">
            <option value="">{{t 'ui.select'}}</option>
            <option value="1-50">1 - 50</option>
            <option value="51-500">51 - 500</option>
            <option value="501-5000">501 - 5,000</option>
            <option value="5001+">5,000+</option>
          </select>
        </div>
      </div>
      <div class="mt-3">
        <label class="form-label" for="attachments">{{t 'ui.projectDocuments'}}</label>
        <input type="file" class="form-control" id="attachments" name="attachments" multiple>
        <div class="form-text">{{t 'ui.uploadArchitectureNotesDiagramsRequirements'}}</div>
      </div>
    </div>

    <!-- Section 2: Classification & Data -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">2</span>
          {{t 'ui.classificationDataSensitivity'}}
        </h3>
        <p class="section-description">{{t 'ui.selectTheFrameworkFirstItsg'}}</p>
      </div>
      <div class="card mb-3 border-0 bg-light">
        <div class="card-body">
          <label class="form-label fw-semibold" for="security_framework">{{t 'ui.securityFramework'}}</label>
          <select class="form-select" id="security_framework" name="security_framework" required>
            {{#each frameworkOptions}}
              <option value="{{this.id}}">{{this.label}}</option>
            {{/each}}
          </select>
          <div class="form-text" id="projectFrameworkDescription"></div>
        </div>
      </div>
      <div id="projectFrameworkCategorization" class="card mb-3 border-0 bg-light" style="display:none;">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="framework_baseline">{{t 'ui.baselineImplementationGroup'}}</label>
              <select class="form-select" id="framework_baseline" name="framework_baseline"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="framework_category">{{t 'ui.categoryApplicability'}}</label>
              <select class="form-select" id="framework_category" name="framework_category"></select>
            </div>
            <div class="col-12">
              <label class="form-label" for="framework_applicability">{{t 'ui.frameworkTailoringNotes'}}</label>
              <textarea class="form-control" id="framework_applicability" name="framework_applicability" rows="2" placeholder="{{t 'ui.frameworkScopingBaselineOverrideRegulatory'}}"></textarea>
            </div>
          </div>
        </div>
      </div>
      <div id="projectItsgCategorization">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="data_classification">{{t 'ui.dataClassification'}} <span class="text-danger">*</span></label>
          <select class="form-select" id="data_classification" name="data_classification" required>
            <option value="unclassified">{{t 'ui.unclassified'}}</option>
            <option value="protected-a">{{t 'ui.protectedA'}}</option>
            <option value="protected-b" selected>{{t 'ui.protectedB'}}</option>
            <option value="protected-c">{{t 'ui.protectedC'}}</option>
            <option value="confidential">{{t 'ui.confidential'}}</option>
            <option value="secret">{{t 'ui.secret'}}</option>
            <option value="top-secret">{{t 'ui.topSecret'}}</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="app_type">{{t 'ui.applicationType'}} <span class="text-danger">*</span></label>
          <select class="form-select" id="app_type" name="app_type" required>
            <option value="internal">{{t 'ui.internalFacing'}}</option>
            <option value="external">{{t 'ui.externalFacingPublic'}}</option>
            <option value="hybrid">{{t 'ui.bothInternalExternal'}}</option>
          </select>
        </div>
      </div>
      <div class="row g-3 mt-1">
        <div class="col-md-4">
          <label class="form-label" for="confidentiality_level">{{t 'ui.confidentiality'}}</label>
          <select class="form-select" id="confidentiality_level" name="confidentiality_level">
            <option value="unclassified">{{t 'ui.unclassified'}}</option>
            <option value="protected-a">{{t 'ui.protectedA'}}</option>
            <option value="protected-b" selected>{{t 'ui.protectedB'}}</option>
            <option value="protected-c">{{t 'ui.protectedC'}}</option>
            <option value="confidential">{{t 'ui.confidential'}}</option>
            <option value="secret">{{t 'ui.secret'}}</option>
            <option value="top-secret">{{t 'ui.topSecret'}}</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="integrity_level">{{t 'ui.integrity2'}}</label>
          <select class="form-select" id="integrity_level" name="integrity_level">
            <option value="low">{{t 'ui.low'}}</option>
            <option value="medium" selected>{{t 'ui.medium'}}</option>
            <option value="high">{{t 'ui.high'}}</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="availability_level">{{t 'ui.availability2'}}</label>
          <select class="form-select" id="availability_level" name="availability_level">
            <option value="low">{{t 'ui.low'}}</option>
            <option value="medium" selected>{{t 'ui.medium'}}</option>
            <option value="high">{{t 'ui.high'}}</option>
          </select>
        </div>
      </div>
      <div class="mt-3">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="has_pii" name="has_pii" value="1" checked>
          <label class="form-check-label fw-semibold" for="has_pii">
            <i class="bi bi-person-badge me-1"></i>{{t 'ui.systemProcessesPersonallyIdentifiableInformation'}}
          </label>
          <div class="form-text ms-4">{{t 'ui.enablingThisAddsPrivacySpecific'}}</div>
        </div>
      </div>
      <div class="mt-2">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="is_hva" name="is_hva" value="1">
          <label class="form-check-label fw-semibold" for="is_hva">
            {{t 'ui.highValueAssetHva'}}
          </label>
        </div>
      </div>
      </div>
      <div class="mt-3">
        <label class="form-label fw-semibold">{{t 'ui.piiTypes'}}</label>
        <div class="row g-2">
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="name-address" id="pii-name"><label class="form-check-label" for="pii-name">{{t 'ui.nameOrContactInfo'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="sin" id="pii-sin"><label class="form-check-label" for="pii-sin">SIN</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="financial" id="pii-financial"><label class="form-check-label" for="pii-financial">{{t 'ui.financial'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="health" id="pii-health"><label class="form-check-label" for="pii-health">{{t 'ui.health'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="biometric" id="pii-biometric"><label class="form-check-label" for="pii-biometric">{{t 'ui.biometric'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="employment" id="pii-employment"><label class="form-check-label" for="pii-employment">{{t 'ui.employmentHr'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="immigration" id="pii-immigration"><label class="form-check-label" for="pii-immigration">{{t 'ui.immigration'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="law-enforcement" id="pii-law"><label class="form-check-label" for="pii-law">{{t 'ui.lawEnforcement'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="indigenous" id="pii-indigenous"><label class="form-check-label" for="pii-indigenous">{{t 'ui.indigenousTreaty'}}</label></div></div>
          <div class="col-md-4"><div class="form-check"><input class="form-check-input pii-type" type="checkbox" name="piiTypes" value="none" id="pii-none"><label class="form-check-label" for="pii-none">{{t 'ui.none'}}</label></div></div>
        </div>
      </div>
      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <label class="form-label" for="atip_subject">{{t 'ui.atipSubject'}}</label>
          <select class="form-select" id="atip_subject" name="atip_subject">
            <option value="">{{t 'ui.select'}}</option>
            <option value="yes">{{t 'ui.yes'}}</option>
            <option value="no">No</option>
            <option value="unsure">{{t 'ui.unsure'}}</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="pia_completed">{{t 'ui.piaStatus'}}</label>
          <select class="form-select" id="pia_completed" name="pia_completed">
            <option value="">{{t 'ui.select'}}</option>
            <option value="yes">{{t 'ui.yesCompleted'}}</option>
            <option value="in-progress">{{t 'ui.inProgress2'}}</option>
            <option value="no">{{t 'ui.noNotStarted'}}</option>
            <option value="not-required">{{t 'ui.notRequired'}}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Section 3: Hosting Environment -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">3</span>
          {{t 'ui.hostingEnvironment'}}
        </h3>
        <p class="section-description">{{t 'ui.whereTheSystemIsDeployed'}}</p>
      </div>
      <div class="mb-3">
        <label class="form-label" for="hosting_type">{{t 'ui.primaryHosting'}} <span class="text-danger">*</span></label>
        <select class="form-select" id="hosting_type" name="hosting_type" required>
          <option value="azure">{{t 'ui.microsoftAzureGcCloud'}}</option>
          <option value="aws">{{t 'ui.amazonWebServicesGcCloud'}}</option>
          <option value="gcp">{{t 'ui.googleCloudPlatform'}}</option>
          <option value="ibm">{{t 'ui.ibmCloud'}}</option>
          <option value="ssc">{{t 'ui.sscDataCentre'}}</option>
          <option value="on-premises">{{t 'ui.onPremises'}}</option>
          <option value="hybrid">{{t 'ui.hybridCloudOnPremises'}}</option>
          <option value="saas">{{t 'ui.saasThirdPartyHosted'}}</option>
          <option value="other">{{t 'ui.other'}}</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label" for="hosting_region">{{t 'ui.dataResidency'}}</label>
        <select class="form-select" id="hosting_region" name="hosting_region">
          <option value="">{{t 'ui.select'}}</option>
          <option value="canada-only" selected>{{t 'ui.canadaOnly'}}</option>
          <option value="canada-primary">{{t 'ui.canadaPrimaryWithLimitedFailover'}}</option>
          <option value="north-america">{{t 'ui.northAmerica'}}</option>
          <option value="global">{{t 'ui.global'}}</option>
          <option value="unsure">{{t 'ui.unsure'}}</option>
        </select>
      </div>
    </div>

    <!-- Section 4: Architecture & Integrations -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">4</span>
          {{t 'ui.architectureIntegrations'}}
        </h3>
        <p class="section-description">{{t 'ui.captureTheSameIntakeContext'}}</p>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="has_apis">APIs</label>
          <select class="form-select" id="has_apis" name="has_apis">
            <option value="">{{t 'ui.select'}}</option>
            <option value="exposes">{{t 'ui.exposesApis'}}</option>
            <option value="consumes">{{t 'ui.consumesApis'}}</option>
            <option value="both">{{t 'ui.bothExposesAndConsumesApis'}}</option>
            <option value="no">No APIs</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="gc_interconnections">{{t 'ui.gcInterconnections'}}</label>
          <select class="form-select" id="gc_interconnections" name="gc_interconnections">
            <option value="">{{t 'ui.select'}}</option>
            <option value="yes">{{t 'ui.yes'}}</option>
            <option value="no">No</option>
            <option value="planned">{{t 'ui.planned'}}</option>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label" for="interconnections">{{t 'ui.knownInterconnections'}}</label>
          <textarea class="form-control" id="interconnections" name="interconnections" rows="3" placeholder="{{t 'ui.apisFileTransfersGcSystems'}}"></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="mobile_access">{{t 'ui.mobileByodAccess'}}</label>
          <select class="form-select" id="mobile_access" name="mobile_access">
            <option value="">{{t 'ui.select'}}</option>
            <option value="yes">{{t 'ui.yes'}}</option>
            <option value="no">No</option>
            <option value="planned">{{t 'ui.planned'}}</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="external_users">{{t 'ui.externalUsers'}}</label>
          <select class="form-select" id="external_users" name="external_users">
            <option value="">{{t 'ui.select'}}</option>
            <option value="yes">{{t 'ui.publicOrPartnerUsers'}}</option>
            <option value="no">{{t 'ui.gcEmployeesOnly'}}</option>
            <option value="contractors">{{t 'ui.contractorsConsultantsOnly'}}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Section 5: Assignment -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">5</span>
          {{t 'ui.initialAssignment'}}
        </h3>
        <p class="section-description">{{t 'ui.optionallyAssignTheNewIntake'}}</p>
      </div>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="assignment_mode">{{t 'ui.assignment'}}</label>
          <select class="form-select" id="assignment_mode" name="assignment_mode">
            <option value="">{{t 'ui.doNotAssignYet'}}</option>
            <option value="existing">{{t 'ui.selectExistingUser'}}</option>
            <option value="invite">{{t 'ui.inviteNewUser'}}</option>
          </select>
        </div>
        <div class="col-md-8 assignment-existing d-none">
          <label class="form-label" for="assignee_user_id">{{t 'ui.existingUser2'}}</label>
          <select class="form-select" id="assignee_user_id" name="assignee_user_id">
            <option value="">{{t 'ui.chooseAUser'}}</option>
            {{#each users}}
              <option value="{{this.id}}">{{this.name}} — {{this.email}} ({{this.role}})</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="assignment-invite d-none mt-3">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="assignee_role">{{t 'ui.inviteAs'}}</label>
            <select class="form-select" id="assignee_role" name="assignee_role">
              <option value="client">{{t 'ui.clientUser'}}</option>
              <option value="assessor">{{t 'ui.assessor'}}</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="invite_name">{{t 'ui.name'}}</label>
            <input type="text" class="form-control" id="invite_name" name="invite_name">
          </div>
          <div class="col-md-4">
            <label class="form-label" for="invite_email">{{t 'ui.email'}}</label>
            <input type="email" class="form-control" id="invite_email" name="invite_email">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="invite_organization">{{t 'ui.organization'}}</label>
            <input type="text" class="form-control" id="invite_organization" name="invite_organization">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="invite_message">{{t 'ui.message'}}</label>
            <input type="text" class="form-control" id="invite_message" name="invite_message">
          </div>
        </div>
      </div>
    </div>

    <!-- Section 6: Technology Stack -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">6</span>
          {{t 'ui.technologyStack'}}
        </h3>
        <p class="section-description">{{t 'ui.selectAllTechnologiesCurrentlyIn'}}</p>
      </div>

      <div class="row g-2" id="techGrid">
        {{#each technologies}}
          <div class="col-md-4 col-6">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="technologies" value="{{@key}}" id="tech-{{@key}}">
              <label class="form-check-label" for="tech-{{@key}}">
                {{this.name}}
                <span class="badge bg-light text-muted ms-1" style="font-size:0.65rem">{{this.type}}</span>
              </label>
            </div>
          </div>
        {{/each}}
      </div>
      <div class="mt-3">
        <label class="form-label" for="other_tech">{{t 'ui.otherTechnologiesNotes'}}</label>
        <textarea class="form-control" id="other_tech" name="other_tech" rows="2" placeholder="{{t 'ui.listTechnologiesNotCoveredAbove'}}"></textarea>
      </div>
    </div>

    <!-- Section 7: Existing Security Posture -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">7</span>
          {{t 'ui.existingSecurityPosture'}}
        </h3>
        <p class="section-description">{{t 'ui.recordSecurityActivitiesAlreadyCompleted'}}</p>
      </div>
      <div class="row g-2">
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="tra" id="act-tra"><label class="form-check-label" for="act-tra">{{t 'ui.threatRiskAssessmentTra'}}</label></div></div>
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="pia" id="act-pia"><label class="form-check-label" for="act-pia">{{t 'ui.privacyImpactAssessmentPia'}}</label></div></div>
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="ssp" id="act-ssp"><label class="form-check-label" for="act-ssp">{{t 'ui.systemSecurityPlanSsp'}}</label></div></div>
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="vapt" id="act-vapt"><label class="form-check-label" for="act-vapt">{{t 'ui.vulnerabilityAssessmentPenTest'}}</label></div></div>
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="network-diagram" id="act-network-diagram"><label class="form-check-label" for="act-network-diagram">{{t 'ui.networkArchitectureDiagram'}}</label></div></div>
        <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="completedActivities" value="previous-sa" id="act-previous-sa"><label class="form-check-label" for="act-previous-sa">{{t 'ui.previousSaAAto'}}</label></div></div>
      </div>
    </div>

    <!-- Section 8: Contacts -->
    <div class="form-section">
      <div class="section-header">
        <h3 class="section-title">
          <span class="section-number">8</span>
          {{t 'ui.keyContacts'}}
        </h3>
        <p class="section-description">{{t 'ui.individualsInvolvedInTheAssessment'}}</p>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.projectOwnerArchitectName'}} <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="project_owner_name" required placeholder="{{t 'ui.fullName'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.projectOwnerArchitectEmail'}} <span class="text-danger">*</span></label>
          <input type="email" class="form-control" name="project_owner_email" required placeholder="{{t 'ui.nameAgencyGcCa'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.projectAuthorityName'}}</label>
          <input type="text" class="form-control" name="project_authority_name" placeholder="{{t 'ui.fullName'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.projectAuthorityEmail'}}</label>
          <input type="email" class="form-control" name="project_authority_email" placeholder="{{t 'ui.nameAgencyGcCa'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.cioDelegatedAuthorityName'}}</label>
          <input type="text" class="form-control" name="cio_name" placeholder="{{t 'ui.fullName'}}">
        </div>
        <div class="col-md-6">
          <label class="form-label">{{t 'ui.cioDelegatedAuthorityEmail'}}</label>
          <input type="email" class="form-control" name="cio_email" placeholder="{{t 'ui.nameAgencyGcCa'}}">
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 mb-5">
      <a href="/admin/projects" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>{{t 'ui.cancel'}}</a>
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-folder-plus me-2"></i>{{t 'ui.createProject'}}
      </button>
    </div>
  </form>
</div>

{{> ai-panel }}

<script>
const PROJECT_FRAMEWORK_OPTIONS = {{{frameworkOptionsJSON}}};
function projectCurrentFrameworkMeta() {
  const id = document.getElementById('security_framework')?.value || 'ITSG-33';
  return PROJECT_FRAMEWORK_OPTIONS.find(f => f.id === id) || PROJECT_FRAMEWORK_OPTIONS[0];
}
function projectPopulateSelect(select, options) {
  if (!select) return;
  select.innerHTML = (options || []).map(opt => '<option value="' + opt.value + '">' + opt.label + '</option>').join('');
}
function syncProjectFrameworkCategorization() {
  const meta = projectCurrentFrameworkMeta();
  const isItsg = meta.id === 'ITSG-33';
  document.getElementById('projectFrameworkDescription').textContent = meta.description || '';
  document.getElementById('projectItsgCategorization').style.display = isItsg ? '' : 'none';
  document.getElementById('projectFrameworkCategorization').style.display = isItsg ? 'none' : '';
  projectPopulateSelect(document.getElementById('framework_baseline'), meta.baselineOptions || []);
  projectPopulateSelect(document.getElementById('framework_category'), meta.categoryOptions || []);
  ['data_classification', 'confidentiality_level', 'integrity_level', 'availability_level'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.required = isItsg && id === 'data_classification';
  });
  document.getElementById('framework_baseline').required = !isItsg;
  document.getElementById('framework_category').required = !isItsg;
}
document.getElementById('security_framework').addEventListener('change', syncProjectFrameworkCategorization);
syncProjectFrameworkCategorization();

const assignmentMode = document.getElementById('assignment_mode');
function syncAssignmentFields() {
  const mode = assignmentMode.value;
  document.querySelectorAll('.assignment-existing').forEach(el => el.classList.toggle('d-none', mode !== 'existing'));
  document.querySelectorAll('.assignment-invite').forEach(el => el.classList.toggle('d-none', mode !== 'invite'));
}
assignmentMode.addEventListener('change', syncAssignmentFields);
syncAssignmentFields();

document.querySelectorAll('input[name="piiTypes"]').forEach(cb => {
  cb.addEventListener('change', function() {
    const none = document.getElementById('pii-none');
    if (this.value === 'none' && this.checked) {
      document.querySelectorAll('input[name="piiTypes"]:not(#pii-none)').forEach(other => { other.checked = false; });
      document.getElementById('has_pii').checked = false;
      return;
    }
    if (this.checked && none) none.checked = false;
    document.getElementById('has_pii').checked = document.querySelectorAll('input[name="piiTypes"]:checked:not(#pii-none)').length > 0;
  });
});

document.getElementById('confidentiality_level').addEventListener('change', function() {
  const dataClassification = document.getElementById('data_classification');
  if (dataClassification.querySelector(`option[value="${this.value}"]`)) dataClassification.value = this.value;
});

document.getElementById('data_classification').addEventListener('change', function() {
  const confidentiality = document.getElementById('confidentiality_level');
  if (confidentiality.querySelector(`option[value="${this.value}"]`)) confidentiality.value = this.value;
});

document.addEventListener('DOMContentLoaded', function() {
  const docUpload = document.getElementById('aiDocUpload');
  const parseBtn = document.getElementById('aiDocParseBtn');
  const descBox = document.getElementById('aiPlainDesc');
  const suggestBtn = document.getElementById('aiSuggestBtn');
  if (docUpload && parseBtn) {
    docUpload.addEventListener('change', function() {
      parseBtn.disabled = !this.files.length;
    });
  }
  if (descBox && suggestBtn) {
    descBox.addEventListener('input', function() {
      suggestBtn.disabled = this.value.trim().length < 20;
    });
  }

  const fab = document.getElementById('aiTriggerBtn');
  if (fab) {
    fab.title = 'AI: Pre-fill Project Intake';
    fab.onclick = function() {
      document.getElementById('aiPlainDesc')?.focus();
      AIPanel.open({
        title: 'AI-Assisted Project Intake',
        subtitle: 'Use the upload or description controls at the top of the form',
        body: '<div class="text-muted small">Upload a project document or describe the project to generate suggested field values. You can accept fields one by one or apply all suggestions.</div>',
        footer: '<button class="btn btn-sm btn-outline-secondary w-100" onclick="AIPanel.close()">Close</button>'
      });
    };
  }
});

function aiShowStatus(msg, type = 'info') {
  const el = document.getElementById('aiProjectStatus');
  el.style.display = 'block';
  el.className = 'mt-2 alert alert-' + type + ' small py-2';
  el.innerHTML = msg;
}

function aiHideStatus() {
  document.getElementById('aiProjectStatus').style.display = 'none';
}

const PROJECT_AI_FIELD_MAP = {
  projectName: { type: 'input', id: 'name' },
  projectDescription: { type: 'textarea', id: 'description' },
  department: { type: 'input', id: 'department' },
  branch: { type: 'input', id: 'branch' },
  userCount: { type: 'select', id: 'user_count' },
  appType: { type: 'select', id: 'app_type' },
  confidentialityLevel: { type: 'select', id: 'confidentiality_level', mirrorId: 'data_classification' },
  integrityLevel: { type: 'select', id: 'integrity_level' },
  availabilityLevel: { type: 'select', id: 'availability_level' },
  isHVA: { type: 'checkbox', id: 'is_hva' },
  securityFramework: { type: 'select', id: 'security_framework' },
  frameworkBaseline: { type: 'select', id: 'framework_baseline' },
  frameworkCategory: { type: 'select', id: 'framework_category' },
  frameworkApplicability: { type: 'textarea', id: 'framework_applicability' },
  atipSubject: { type: 'select', id: 'atip_subject' },
  piaCompleted: { type: 'select', id: 'pia_completed' },
  hostingType: { type: 'select', id: 'hosting_type' },
  hostingRegion: { type: 'select', id: 'hosting_region' },
  otherTech: { type: 'textarea', id: 'other_tech' },
  hasAPIs: { type: 'select', id: 'has_apis' },
  gcInterconnections: { type: 'select', id: 'gc_interconnections' },
  interconnections: { type: 'textarea', id: 'interconnections' },
  mobileAccess: { type: 'select', id: 'mobile_access' },
  externalUsers: { type: 'select', id: 'external_users' }
};

function aiSetValue(el, value) {
  if (!el || value === null || value === undefined) return false;
  if (el.tagName === 'SELECT') {
    const normalized = value === 'both' && el.id === 'app_type' ? 'hybrid' : value;
    if (!el.querySelector(`option[value="${normalized}"]`)) return false;
    el.value = normalized;
  } else {
    el.value = value;
  }
  el.classList.add('ai-highlighted');
  el.dispatchEvent(new Event('change', { bubbles: true }));
  return true;
}

function aiApplyField(key, value) {
  if (value === null || value === undefined) return false;
  const map = PROJECT_AI_FIELD_MAP[key];
  if (!map) return false;

  if (map.type === 'checkbox') {
    const el = document.getElementById(map.id);
    if (!el) return false;
    el.checked = !!value;
    el.classList.add('ai-highlighted');
    el.dispatchEvent(new Event('change', { bubbles: true }));
    return true;
  }

  const applied = aiSetValue(document.getElementById(map.id), value);
  if (applied && map.mirrorId) aiSetValue(document.getElementById(map.mirrorId), value);
  return applied;
}

function aiApplyPiiTypes(types) {
  if (!types || !types.length) return false;
  document.querySelectorAll('input[name="piiTypes"]').forEach(cb => { cb.checked = false; });
  const hasSensitivePii = types.some(t => t !== 'none');
  document.getElementById('has_pii').checked = hasSensitivePii;
  types.forEach(t => {
    const el = document.querySelector('input[name="piiTypes"][value="' + t + '"]');
    if (el) {
      el.checked = true;
      el.classList.add('ai-highlighted');
    }
  });
  return true;
}

function aiApplyTechnologies(techs) {
  if (!techs || !techs.length) return false;
  let applied = false;
  techs.forEach(t => {
    const el = document.querySelector('input[name="technologies"][value="' + t + '"]');
    if (el) {
      el.checked = true;
      el.classList.add('ai-highlighted');
      applied = true;
    }
  });
  return applied;
}

function aiApplyCompletedActivities(activities) {
  if (!activities || !activities.length) return false;
  let applied = false;
  activities.forEach(a => {
    const el = document.querySelector('input[name="completedActivities"][value="' + a + '"]');
    if (el) {
      el.checked = true;
      el.classList.add('ai-highlighted');
      applied = true;
    }
  });
  return applied;
}

function aiApplyAllFields(fields) {
  let applied = 0;
  Object.keys(PROJECT_AI_FIELD_MAP).forEach(key => {
    if (aiApplyField(key, fields[key])) applied++;
  });
  if (aiApplyPiiTypes(fields.piiTypes)) applied++;
  if (aiApplyTechnologies(fields.technologies)) applied++;
  if (aiApplyCompletedActivities(fields.completedActivities)) applied++;
  return applied;
}

function aiShowResults(fields, reasoning) {
  const labelMap = {
    projectName: 'Project Name', projectDescription: 'Description', department: 'Department',
    branch: 'Branch', userCount: 'User Count', appType: 'Application Type',
    confidentialityLevel: 'Confidentiality', integrityLevel: 'Integrity',
    availabilityLevel: 'Availability', isHVA: 'High Value Asset',
    securityFramework: 'Security Framework', frameworkBaseline: 'Framework Baseline',
    frameworkCategory: 'Framework Category', frameworkApplicability: 'Framework Applicability',
    piiTypes: 'PII Types', atipSubject: 'ATIP Subject', piaCompleted: 'PIA Status',
    hostingType: 'Hosting', hostingRegion: 'Data Residency',
    technologies: 'Technologies', otherTech: 'Other Technologies',
    hasAPIs: 'APIs', gcInterconnections: 'GC Interconnections',
    interconnections: 'Interconnections', mobileAccess: 'Mobile/BYOD',
    externalUsers: 'External Users', completedActivities: 'Completed Security Activities'
  };

  const sectionGroups = [
    { title: '1 - Project Information', keys: ['projectName','projectDescription','department','branch','userCount','appType'] },
    { title: '2 - Classification & Data', keys: ['securityFramework','frameworkBaseline','frameworkCategory','frameworkApplicability','confidentialityLevel','integrityLevel','availabilityLevel','isHVA','piiTypes','atipSubject','piaCompleted'] },
    { title: '3 - Hosting & Technology', keys: ['hostingType','hostingRegion','technologies','otherTech'] },
    { title: '4 - Architecture & Integrations', keys: ['hasAPIs','gcInterconnections','interconnections','mobileAccess','externalUsers'] },
    { title: '5 - Security Posture', keys: ['completedActivities'] }
  ];

  const allFieldKeys = Object.keys(fields).filter(k => k !== 'reasoning' && fields[k] !== null && fields[k] !== undefined);
  let cardsHtml = '';
  let cardIndex = 0;

  sectionGroups.forEach(section => {
    const keys = section.keys.filter(k => allFieldKeys.includes(k));
    if (!keys.length) return;
    cardsHtml += `<div class="ai-section-title mt-3">${section.title}</div>`;
    keys.forEach(key => {
      const val = fields[key];
      const displayVal = Array.isArray(val) ? val.join(', ') : (typeof val === 'boolean' ? (val ? 'Yes' : 'No') : String(val));
      const i = cardIndex++;
      cardsHtml += `
        <div class="ai-card" id="ai-project-card-${i}">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="fw-bold small">${labelMap[key] || key}</div>
              <div class="small text-muted" style="word-break:break-word;">${displayVal.substring(0, 200)}${displayVal.length > 200 ? '...' : ''}</div>
            </div>
            <div class="d-flex gap-1 flex-shrink-0 ms-2">
              <button type="button" class="ai-accept-btn" onclick="aiAcceptSingle('${key}', window._projectAiFields); this.closest('.ai-card').classList.add('accepted');">
                <i class="bi bi-check2"></i>
              </button>
              <button type="button" class="ai-reject-btn" onclick="this.closest('.ai-card').classList.add('rejected');">
                <i class="bi bi-x"></i>
              </button>
            </div>
          </div>
        </div>`;
    });
  });

  AIPanel.open({
    title: 'AI Project Suggestions',
    subtitle: 'Review and accept individual fields',
    body: `
      ${reasoning ? `<div class="ai-section"><div class="ai-section-title">AI Reasoning</div><div class="small text-muted p-2 rounded" style="background:#f5f3ff;">${reasoning}</div></div>` : ''}
      <div class="ai-section">
        <div class="ai-section-title">Suggested Fields (${allFieldKeys.length})</div>
        ${cardsHtml}
      </div>`,
    footer: `
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm flex-fill text-white" style="background:#8b5cf6;" onclick="aiAcceptAll()"><i class="bi bi-check-all me-1"></i>Accept All</button>
        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="AIPanel.close()">Close</button>
      </div>`
  });
}

function aiAcceptSingle(key, fields) {
  if (!fields) return;
  if (key === 'piiTypes') aiApplyPiiTypes(fields[key]);
  else if (key === 'technologies') aiApplyTechnologies(fields[key]);
  else if (key === 'completedActivities') aiApplyCompletedActivities(fields[key]);
  else aiApplyField(key, fields[key]);
}

function aiAcceptAll() {
  if (!window._projectAiFields) return;
  const n = aiApplyAllFields(window._projectAiFields);
  aiShowStatus('<i class="bi bi-check-circle me-1"></i>Applied ' + n + ' AI suggestions. Review the project intake before saving.', 'success');
  AIPanel.close();
}

async function aiParseDocument() {
  const file = document.getElementById('aiDocUpload').files[0];
  if (!file) return;

  aiShowStatus('<i class="bi bi-hourglass-split me-1"></i>Uploading and analyzing document...', 'info');
  AIPanel.open({ title: 'Analyzing Document', subtitle: file.name });
  AIPanel.showLoading('Reading and analyzing the project document...');

  try {
    const formData = new FormData();
    formData.append('document', file);
    formData.append('securityFramework', document.getElementById('security_framework')?.value || 'ITSG-33');
    const resp = await fetch('/api/ai/parse-document', { method: 'POST', body: formData });
    const data = await resp.json();
    if (!data.success) throw new Error(data.error || 'Analysis failed');
    window._projectAiFields = data.fields;
    // Attach the analyzed document so it becomes the project's first saved document.
    try {
      const dt = new DataTransfer();
      dt.items.add(file);
      const refInput = document.getElementById('referenceDocInput');
      if (refInput) refInput.files = dt.files;
      const note = document.getElementById('refDocNote');
      const noteText = document.getElementById('refDocNoteText');
      if (note && noteText) { noteText.textContent = file.name + ' will be saved to this project’s documents.'; note.style.display = 'block'; }
    } catch (e) { /* DataTransfer unsupported — the reference doc simply won't be auto-saved */ }
    aiHideStatus();
    aiShowResults(data.fields, data.fields.reasoning);
  } catch (err) {
    aiShowStatus('<i class="bi bi-exclamation-triangle me-1"></i>' + err.message, 'danger');
    AIPanel.showError(err.message);
  }
}

async function aiSuggestFromDescription() {
  const desc = document.getElementById('aiPlainDesc').value.trim();
  if (desc.length < 20) return;

  aiShowStatus('<i class="bi bi-hourglass-split me-1"></i>Analyzing description...', 'info');
  AIPanel.open({ title: 'Analyzing Description', subtitle: 'Project intake' });
  AIPanel.showLoading('Determining likely categorization and project fields...');

  try {
    const resp = await fetch('/api/ai/suggest-from-description', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ description: desc, securityFramework: document.getElementById('security_framework')?.value || 'ITSG-33' })
    });
    const data = await resp.json();
    if (!data.success) throw new Error(data.error || 'Suggestion failed');
    window._projectAiFields = data.suggestions;
    aiHideStatus();
    aiShowResults(data.suggestions, data.suggestions.reasoning);
  } catch (err) {
    aiShowStatus('<i class="bi bi-exclamation-triangle me-1"></i>' + err.message, 'danger');
    AIPanel.showError(err.message);
  }
}
</script>

