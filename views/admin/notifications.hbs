<div class="container" style="max-width:820px">
  <div class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">{{t 'ui.notifications'}}</h1>
      <p class="text-muted mb-0">{{t 'ui.assignmentsInvitationsAndMessagesFor'}}</p>
      <div class="rule"></div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      {{#if notifications.length}}
        <ul class="list-group list-group-flush">
          {{#each notifications}}
            <li class="list-group-item d-flex align-items-start gap-3 {{#unless this.read_at}}bg-light{{/unless}}">
              <span class="stat-icon" style="width:38px;height:38px;border-radius:10px;flex:none;background:#e7f1fb;color:var(--cs-accent);display:flex;align-items:center;justify-content:center">
                <i class="bi bi-{{#if (eq this.type 'assignment')}}clipboard-check{{else}}bell{{/if}}"></i>
              </span>
              <div class="flex-grow-1">
                <div class="fw-semibold">{{this.title}}</div>
                {{#if this.body}}<div class="text-muted small">{{this.body}}</div>{{/if}}
                <div class="text-muted" style="font-size:.78rem">{{formatDateTime this.created_at}}</div>
              </div>
              {{#if this.link}}<a href="{{this.link}}" class="btn btn-sm btn-outline-primary align-self-center">{{t 'ui.open'}}</a>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <div class="p-5 text-center text-muted">
          <i class="bi bi-bell-slash" style="font-size:3rem"></i>
          <p class="mt-3 mb-0">{{t 'ui.noNotificationsYetWhenYou'}}</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>
