<div class="container">
  <div class="page-head mb-4">
    <h1 class="h3 mb-1">{{t 'rf.reportsHubTitle'}}</h1>
    <div class="rule"></div>
    <p class="text-muted mb-0">{{t 'rf.reportsHubIntro'}}</p>
  </div>

  {{#if canPortfolio}}
  <div class="card mb-4">
    <div class="card-body d-flex align-items-center flex-wrap gap-3">
      <div class="flex-grow-1">
        <h2 class="h5 mb-1"><i class="bi bi-buildings me-2"></i>{{t 'rf.portfolioTitle'}}</h2>
        <p class="text-muted small mb-0">{{t 'rf.portfolioIntro'}}</p>
      </div>
      <a class="btn btn-primary" href="/admin/reports/portfolio/all"><i class="bi bi-eye me-1"></i>{{t 'rf.openReport'}}</a>
    </div>
  </div>
  {{/if}}

  {{#if rows.length}}
    {{#each rows}}
    <div class="card mb-3">
      <div class="card-header bg-light d-flex align-items-center flex-wrap gap-2">
        <span class="fw-semibold">{{this.project.name}}</span>
        <span class="badge bg-secondary">{{this.project.security_profile}}</span>
        <a class="btn btn-sm btn-outline-primary ms-auto" href="/admin/reports/project/{{this.project.id}}">
          <i class="bi bi-clipboard-data me-1"></i>{{t 'rf.projectRollup'}}</a>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="small text-uppercase text-muted fw-bold mb-2">{{t 'rf.assessments'}}</div>
            {{#if this.assessments.length}}
              <ul class="list-unstyled mb-0">
                {{#each this.assessments}}
                <li class="mb-1 d-flex align-items-center">
                  <a href="/admin/reports/assessment/{{this.id}}">#{{this.id}} · v{{this.version}} · {{this.type}}</a>
                  {{#if this.overall_score}}<span class="badge bg-light text-dark ms-2">{{this.overall_score}}%</span>{{/if}}
                </li>
                {{/each}}
              </ul>
            {{else}}<span class="text-muted small">—</span>{{/if}}
          </div>
          <div class="col-md-6">
            <div class="small text-uppercase text-muted fw-bold mb-2">{{t 'rf.decisionPackages'}}</div>
            {{#if this.decisions.length}}
              <ul class="list-unstyled mb-0">
                {{#each this.decisions}}
                <li class="mb-1 d-flex align-items-center flex-wrap gap-2">
                  <a href="/admin/reports/decision-package/{{this.id}}">{{this.reference}}</a>
                  <span class="badge bg-secondary text-uppercase">{{this.decision_type}}</span>
                  <a class="small" href="/admin/reports/poam/{{this.id}}">{{t 'rf.poamRegister'}}</a>
                </li>
                {{/each}}
              </ul>
            {{else}}<span class="text-muted small">—</span>{{/if}}
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  {{else}}
    <div class="alert alert-info">{{t 'rf.reportsHubEmpty'}}</div>
  {{/if}}
</div>
