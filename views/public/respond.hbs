<style>
  /* Colour-coded placeholders in AI-drafted evidence, so the provider can see
     exactly where their input / an attachment is needed. Rendered by suggestToHtml
     (server) and evDecorate (client) inside the rich editor and the assistant. */
  .ev-ph { border-radius:5px; padding:0 5px; font-weight:600; font-size:.93em; box-decoration-break:clone; -webkit-box-decoration-break:clone; }
  .ev-ph-value  { background:#fff3cd; color:#7a5a08; border:1px solid #f2d692; }
  .ev-ph-attach { background:#e0f2fe; color:#075985; border:1px solid #bae6fd; }
  .ev-ph-value::before  { content:"\270E\FE0E"; margin-right:4px; opacity:.75; }   /* ✎ fill in */
  .ev-ph-attach::before { content:"\1F4CE\FE0E"; margin-right:4px; opacity:.85; }  /* 📎 attach */
  .evidence-editor strong { font-weight:700; }
</style>
<div class="container">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="mb-1">{{assessment.project_name}}</h1>
      <p class="text-muted mb-0">Security Assessment Evidence Submission — ITSG-33 / {{assessment.data_classification}}</p>
    </div>
    {{#if isReadOnly}}
      <span class="badge bg-success fs-6 py-2 px-3"><i class="bi bi-lock me-1"></i>Submitted</span>
    {{/if}}
  </div>

  {{#if isReadOnly}}
    {{#if readOnlyReason}}
      <div class="alert alert-warning">
        <i class="bi bi-lock me-2"></i>{{readOnlyReason}}
      </div>
    {{else}}
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        This assessment has been submitted and is now <strong>read-only</strong>. Your assessor will review the evidence and
        may reactivate it if updates are needed.
      </div>
    {{/if}}
  {{/if}}

  {{#if resubmitMode}}
    <div class="alert alert-warning">
      <i class="bi bi-arrow-repeat me-2"></i>
      <strong>{{t 'ru.bannerTitle'}}</strong> {{t 'ru.bannerBody'}}
    </div>
  {{/if}}

  <!-- Progress bar (sticky) -->
  <div class="progress-sticky">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="fw-semibold">Progress: <span id="progressCount">{{provided}}</span> of {{total}} controls addressed</span>
      <span class="fw-bold" id="progressPct">{{progress}}%</span>
    </div>
    <div class="progress">
      <div class="progress-bar" id="progressBar" style="width:{{progress}}%" role="progressbar"></div>
    </div>
    {{#unless isReadOnly}}
      <div class="text-end mt-2">
        <form method="POST" action="/respond/{{inviteCode}}/submit" class="d-inline"
          onsubmit="return evConfirmSubmit('Submit all evidence? This will lock the form and notify your assessor. You will not be able to make changes unless the assessor reactivates your submission.')">
          <button class="btn btn-primary" id="submitBtn" {{#ifCond progress '<' 1}}disabled{{/ifCond}}>
            <i class="bi bi-send me-1"></i>Submit All Evidence
          </button>
        </form>
      </div>
    {{/unless}}
  </div>

  {{!-- FEATURE 2: bulk "suggest drafts" background job --}}
  {{#unless isReadOnly}}
  <div class="card mb-3" style="border-color:#ddd6fe;background:linear-gradient(90deg,#f7f5ff,#f0f7ff)">
    <div class="card-body d-flex align-items-center gap-2 flex-wrap py-2">
      <i class="bi bi-magic" style="font-size:20px;color:#6d28d9"></i>
      <div class="flex-grow-1" style="min-width:200px">
        <div class="fw-bold" style="color:#26374a">{{t 'ev.bulkTitle'}}
          <span tabindex="0" role="button" data-bs-toggle="tooltip" title="{{t 'ev.bulkTip'}}"><i class="bi bi-question-circle text-primary"></i></span>
        </div>
        <div class="small text-muted">{{t 'ev.bulkSub'}}</div>
      </div>
      <button type="button" class="btn btn-sm" style="background:#f3efff;border:1px solid #ddd6fe;color:#6d28d9" id="bulkStartBtn" onclick="startBulkSuggest()">
        <i class="bi bi-magic me-1"></i>{{t 'ev.bulkStart'}}
      </button>
    </div>
    <div class="card-body py-2 border-top" id="bulkStatusBar" hidden>
      <div class="d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm text-primary" id="bulkSpin"></span>
        <div class="flex-grow-1">
          <div class="small fw-semibold" id="bulkStatusLabel"></div>
          <div class="progress mt-1" style="height:5px"><div class="progress-bar bg-primary" id="bulkStatusBarInner" style="width:0%"></div></div>
        </div>
      </div>
    </div>
  </div>
  {{/unless}}

  {{!-- FEATURE 4: status filter + bulk selection --}}
  {{#unless isReadOnly}}
  <div class="card mb-3">
    <div class="card-body py-2 d-flex align-items-center gap-2 flex-wrap">
      <span class="small fw-semibold text-muted"><i class="bi bi-funnel me-1"></i>{{t 'ev.filterBy'}}</span>
      <span class="ev-fchip badge rounded-pill text-bg-primary" data-f="pending" onclick="toggleFilter(this)">{{t 'ev.stPending'}}</span>
      <span class="ev-fchip badge rounded-pill text-bg-warning" data-f="draft" onclick="toggleFilter(this)">{{t 'ev.stDraft'}}</span>
      <span class="ev-fchip badge rounded-pill text-bg-success" data-f="provided" onclick="toggleFilter(this)">{{t 'ev.stProvided'}}</span>
      <span class="ev-fchip badge rounded-pill text-bg-secondary" data-f="ready" onclick="toggleFilter(this)"><i class="bi bi-lock me-1"></i>{{t 'ev.readyBadge'}}</span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <label class="small text-muted mb-0"><input type="checkbox" class="form-check-input me-1" id="evSelectAll" onchange="toggleSelectAll(this)">{{t 'ev.selectAll'}}</label>
      </div>
    </div>
  </div>
  {{/unless}}

  <!-- Family navigation -->
  <div class="mb-4">
    <div class="d-flex flex-wrap gap-2">
      {{#each families}}
        <a href="#family-{{this.code}}" class="btn btn-sm btn-outline-primary">
          {{this.code}} — {{this.name}}
          <span class="badge bg-light text-dark ms-1">{{this.controls.length}}</span>
        </a>
      {{/each}}
    </div>
  </div>

  <!-- Control Families -->
  {{#each families}}
    <div class="form-section" id="family-{{this.code}}">
      <div class="family-header">
        <span class="family-code badge rounded-pill text-bg-primary">{{this.code}}</span>
        <h3 class="family-name">{{this.name}}</h3>
        <p class="family-meta">{{t 'cf.familyCount' n=this.controls.length}}</p>
      </div>

      {{#each this.controls}}
        <div class="control-card ev-ctrl {{#if this.is_inherited}}inherited{{/if}} {{#if this.resubmit_active}}border-warning{{else}}{{#eq this.evidence_status 'provided'}}border-success{{/eq}}{{/if}}"
          id="control-{{this.id}}"
          data-evstatus="{{#if this.evidence_ready}}ready{{else}}{{#if (eq this.evidence_status 'provided')}}provided{{else}}{{#if (eq this.evidence_source 'ai-suggested')}}draft{{else}}pending{{/if}}{{/if}}{{/if}}">

          {{#if this.resubmit_active}}
            <div class="alert alert-warning py-2 px-3 mb-2 small">
              <i class="bi bi-arrow-repeat me-1"></i><strong>{{t 'ru.controlFlag'}}</strong>{{#if this.resubmit_note}} — {{this.resubmit_note}}{{/if}}
            </div>
          {{/if}}
          {{#if this.locked}}
            <div class="small text-muted mb-2"><i class="bi bi-lock me-1"></i>{{t 'ru.referenceOnly'}}</div>
          {{/if}}

          <div class="d-flex justify-content-between align-items-start mb-2">
            <div class="d-flex align-items-start gap-2">
              {{#unless this.readonly}}<input type="checkbox" class="form-check-input ev-select mt-1" data-cid="{{this.id}}" onchange="updateBulkBar()">{{/unless}}
              <div>
                <span class="control-id">{{this.control_id}}</span>
                <span class="control-title ms-2">{{this.title}}</span>
              </div>
            </div>
            <div class="d-flex gap-1">
              {{#if this.is_inherited}}
                <span class="badge bg-info"><i class="bi bi-arrow-left-right me-1"></i>Inherited: {{this.inherited_from}}</span>
              {{/if}}
              {{#eq this.evidence_status "provided"}}
                <span class="badge bg-success"><i class="bi bi-check me-1"></i>Done</span>
              {{/eq}}
            </div>
          </div>

          {{#if this.tailored_description}}
            <p class="control-desc mb-2">{{this.tailored_description}}</p>
          {{else}}
            <p class="control-desc mb-2">{{this.description}}</p>
          {{/if}}

          {{#if this.tailoring_rationale}}
            <div class="tailor-why mb-2">
              <span class="tailor-why-k"><i class="bi bi-info-circle me-1"></i>{{t 'tl.whyAsked'}}</span>
              <span class="tailor-why-v">{{this.tailoring_rationale}}</span>
            </div>
          {{/if}}

          {{#if this.evidence_guidance}}
            <div class="p-2 rounded mb-3" style="background:#fff8e1">
              <small class="fw-semibold"><i class="bi bi-lightbulb me-1"></i>Evidence Guidance:</small>
              <small class="d-block mt-1">{{this.evidence_guidance}}</small>
            </div>
          {{/if}}

          <!-- Evidence Editor -->
          <div class="mb-2">
            <label class="form-label small fw-semibold d-flex align-items-center flex-wrap gap-1">Your Evidence
              {{#if (eq this.evidence_source 'ai-suggested')}}<span class="badge text-bg-warning ms-1" id="draftBadge-{{this.id}}"><i class="bi bi-magic me-1"></i>{{t 'ev.draftBadge'}}</span>{{/if}}
              <span class="badge text-bg-success ms-1 ev-ready-badge" id="readyBadge-{{this.id}}" {{#unless this.evidence_ready}}hidden{{/unless}}><i class="bi bi-lock me-1"></i>{{t 'ev.readyBadge'}}</span>
            </label>
            {{!-- FEATURE 3: who last edited this evidence (incl. AI) --}}
            <div class="small mb-1 ev-edited-by" id="editedBy-{{this.id}}" {{#unless this.evidence_edited_by}}hidden{{/unless}}>
              <span class="badge rounded-pill {{#if (eq this.evidence_source 'ai-suggested')}}text-bg-warning{{else}}text-bg-light border{{/if}}">
                <i class="bi {{#if (eq this.evidence_source 'ai-suggested')}}bi-magic{{else}}bi-person-check{{/if}} me-1"></i>{{t 'ev.editedBy'}} {{this.evidence_edited_by}}</span>
            </div>
            {{#if this.hasSlots}}
              {{!-- Real completeness. Before slots this was a boolean, which is
                    why a control holding 14 unfilled placeholders read as done. --}}
              <div class="ev-slotbar mb-2" id="slotbar-{{this.id}}" data-cid="{{this.id}}">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <div class="progress flex-grow-1" style="height:8px;min-width:120px">
                    <div class="progress-bar bg-success ev-sb-fill" style="width:{{this.slotProgress.percent}}%"></div>
                  </div>
                  <small class="text-muted ev-sb-text">
                    <span class="ev-sb-v">{{this.slotProgress.values.filled}}</span>/<span>{{this.slotProgress.values.total}}</span> {{t 'esl.values'}}
                    · <span class="ev-sb-a">{{this.slotProgress.attachments.filled}}</span>/<span>{{this.slotProgress.attachments.total}}</span> {{t 'esl.files'}}
                  </small>
                  <small class="ev-sb-left fw-semibold"></small>
                  <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none ms-auto"
                    onclick="eslJumpNext({{this.id}})">{{t 'esl.jumpNext'}}</button>
                  <div class="btn-group btn-group-sm" role="group" aria-label="{{t 'esl.viewToggle'}}">
                    <button type="button" class="btn btn-outline-secondary active" data-evview="edit" data-cid="{{this.id}}"
                      onclick="eslSetView({{this.id}},'edit',this)">{{t 'esl.fillIn'}}</button>
                    <button type="button" class="btn btn-outline-secondary" data-evview="read" data-cid="{{this.id}}"
                      onclick="eslSetView({{this.id}},'read',this)">{{t 'esl.evidenceView'}}</button>
                  </div>
                </div>
              </div>
              {{!-- The finished narrative, values inline and holes in red. --}}
              <div class="evidence-readview" id="readview-{{this.id}}" hidden>{{{this.evidence_read_html}}}</div>
            {{/if}}
            {{#if this.readonly}}
              <div class="evidence-editor" style="background:#f8f9fa;min-height:80px">
                {{{this.evidence_html}}}
                {{#unless this.evidence_html}}{{this.evidence_text}}{{/unless}}
              </div>
            {{else}}
              <div class="evidence-editor" contenteditable="{{#if this.evidence_ready}}false{{else}}true{{/if}}" id="editor-{{this.id}}"
                data-control-id="{{this.id}}" data-ready="{{#if this.evidence_ready}}1{{else}}0{{/if}}"
                oninput="markDirty({{this.id}})" onblur="saveEvidence({{this.id}})"
                placeholder="Enter your evidence here...">{{{this.evidence_html}}}</div>
              <div class="d-flex justify-content-between align-items-center mt-1 flex-wrap gap-2">
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary" onclick="execCmd('bold')" title="Bold"><i class="bi bi-type-bold"></i></button>
                  <button type="button" class="btn btn-outline-secondary" onclick="execCmd('italic')" title="Italic"><i class="bi bi-type-italic"></i></button>
                  <button type="button" class="btn btn-outline-secondary" onclick="execCmd('insertUnorderedList')" title="Bullet List"><i class="bi bi-list-ul"></i></button>
                  <button type="button" class="btn btn-outline-secondary" onclick="execCmd('insertOrderedList')" title="Numbered List"><i class="bi bi-list-ol"></i></button>
                </div>
                {{!-- Select text and press one of these to turn it into a slot. --}}
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary" onclick="eslAddSlot({{this.id}},'value')"
                    title="{{t 'esl.addValueHelp'}}">+ {{t 'esl.valueSlot'}}</button>
                  <button type="button" class="btn btn-outline-secondary" onclick="eslAddSlot({{this.id}},'attach')"
                    title="{{t 'esl.addAttachHelp'}}">+ {{t 'esl.attachSlot'}}</button>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                  <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:12px;color:#0d6efd"
                    data-cid="{{this.id}}" onclick="aiSuggestEvidence(this)" title="{{t 'ev.suggestHelp'}}"><i class="bi bi-magic me-1"></i>{{t 'ev.suggestBtn'}}</button>
                  <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:12px;color:#5f7185"
                    data-cid="{{this.id}}" onclick="toggleHistory(this)"><i class="bi bi-clock-history me-1"></i>{{t 'ev.history'}}</button>
                  <small class="evidence-save-status" id="saveStatus-{{this.id}}"></small>
                  <button type="button" class="btn btn-sm btn-outline-success ev-ready-toggle" id="readyBtn-{{this.id}}"
                    data-cid="{{this.id}}" data-ready="{{#if this.evidence_ready}}1{{else}}0{{/if}}" onclick="toggleReady(this)">
                    {{#if this.evidence_ready}}<i class="bi bi-unlock me-1"></i>{{t 'ev.reactivate'}}{{else}}<i class="bi bi-check2-circle me-1"></i>{{t 'ev.markReady'}}{{/if}}
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-secondary ev-save-btn" onclick="saveEvidence({{this.id}}, true)" {{#if this.evidence_ready}}hidden{{/if}}>
                    <i class="bi bi-save me-1"></i>{{t 'ev.save'}}
                  </button>
                </div>
              </div>
              <div class="small text-warning-emphasis mt-1 ev-ph-hint" id="phHint-{{this.id}}" hidden></div>
              <div class="border rounded mt-2 p-2 bg-light ev-history" id="history-{{this.id}}" hidden>
                <div class="small fw-bold text-muted mb-1"><i class="bi bi-clock-history me-1"></i>{{t 'ev.editHistory'}}</div>
                <div class="ev-history-body" id="historyBody-{{this.id}}"><div class="small text-muted">…</div></div>
              </div>
            {{/if}}
          </div>

          <!-- File Upload -->
          {{#unless this.readonly}}
            <div class="mb-2">
              <label class="form-label small fw-semibold">Attachments</label>
              <div class="input-group input-group-sm">
                <input type="file" class="form-control form-control-sm" id="fileInput-{{this.id}}"
                  onchange="uploadFile({{this.id}})">
                <button class="btn btn-outline-primary" type="button" onclick="uploadFile({{this.id}})">
                  <i class="bi bi-upload me-1"></i>Upload
                </button>
              </div>
            </div>
          {{/unless}}
          {{!-- Files already on record, rendered server-side so they survive a
                reload; uploadFile() appends new ones in the same shape. --}}
          <div id="attachments-{{this.id}}" class="d-flex flex-wrap gap-1 mb-2">
            {{#each this.attachmentList}}
              <a class="badge bg-light text-dark border text-decoration-none"
                href="/respond/{{@root.inviteCode}}/attachment/{{this.id}}"
                title="{{t 'ea.download'}}">
                <i class="bi bi-paperclip me-1"></i>{{this.original_name}}
              </a>
            {{/each}}
          </div>

          <!-- Comments -->
          <div class="mt-2">
            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0"
              data-bs-toggle="collapse" data-bs-target="#comments-{{this.id}}" onclick="loadComments({{this.id}})">
              <i class="bi bi-chat-dots me-1"></i>Comments
            </button>
          </div>
          <div class="collapse mt-2" id="comments-{{this.id}}">
            <div class="comment-thread border rounded p-2" id="thread-{{this.id}}">
              <div class="text-muted small text-center py-1">Loading...</div>
            </div>
            {{#unless ../../isReadOnly}}
              <div class="input-group input-group-sm mt-2">
                <input type="text" class="form-control" id="commentInput-{{this.id}}" placeholder="Add a comment...">
                <button class="btn btn-outline-primary" onclick="addComment({{this.id}})">
                  <i class="bi bi-send"></i>
                </button>
              </div>
            {{/unless}}
          </div>
        </div>
      {{/each}}
    </div>
  {{/each}}

  {{#unless isReadOnly}}
    <div class="text-center mb-5 mt-4">
      <form method="POST" action="/respond/{{inviteCode}}/submit"
        onsubmit="return evConfirmSubmit('Submit all evidence? This will lock the form and notify your assessor.')">
        <button class="btn btn-primary btn-lg"><i class="bi bi-send me-2"></i>Submit All Evidence</button>
      </form>
    </div>
  {{/unless}}
</div>

<script>
const INVITE_CODE = '{{inviteCode}}';
const EV_I18N = {
  saving: {{{tjs 'ev.saving'}}},
  saved: {{{tjs 'ev.saved'}}},
  unsaved: {{{tjs 'ev.unsaved'}}},
  error: {{{tjs 'ev.saveError'}}},
  suggestFail: {{{tjs 'ev.suggestFail'}}},
  download: {{{tjs 'ea.download'}}},
  phRemain: {{{tjs 'ev.phRemain'}}},
  submitPh: {{{tjs 'ev.submitPlaceholders'}}}
};
// Placeholder tokens the provider must replace: [[VALUE: …]] and [[ATTACH: …]].
const EV_PH_RE = /\[\[(?:VALUE|ATTACH):/gi;
function evCountPlaceholders(s) { const m = String(s || '').match(EV_PH_RE); return m ? m.length : 0; }
function updatePhHint(controlId) {
  const editor = document.getElementById('editor-' + controlId);
  const hint = document.getElementById('phHint-' + controlId);
  if (!editor || !hint) return;
  const n = evCountPlaceholders(editor.innerText);
  if (n > 0) { hint.hidden = false; hint.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' + EV_I18N.phRemain.replace('{n}', n); }
  else { hint.hidden = true; hint.textContent = ''; }
}
const DRAFT_BADGE_LABEL = {{{tjs 'ev.draftBadge'}}};
const EV_LBL = {
  approve: {{{tjs 'ev.approve'}}},
  decline: {{{tjs 'ev.decline'}}},
  approveAll: {{{tjs 'ev.approveAll'}}},
  propose: {{{tjs 'ev.proposeHeading'}}}
};
const READY_LBL = { markReady: {{{tjs 'ev.markReady'}}}, reactivate: {{{tjs 'ev.reactivate'}}} };
const HIST_LBL = {
  current: {{{tjs 'ev.current'}}}, revert: {{{tjs 'ev.revert'}}}, none: {{{tjs 'ev.histNone'}}},
  err: {{{tjs 'ev.histErr'}}}, confirm: {{{tjs 'ev.revertConfirm'}}},
  actions: { 'save': {{{tjs 'ev.actSave'}}}, 'ai-draft': {{{tjs 'ev.actAiDraft'}}}, 'ready': {{{tjs 'ev.actReady'}}}, 'reactivate': {{{tjs 'ev.actReactivate'}}}, 'revert': {{{tjs 'ev.actRevert'}}}, 'review': {{{tjs 'ev.actReview'}}} }
};
function hEsc(s){return String(s==null?'':s).replace(/[&<>]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[m];});}
// Mirror of the server's suggestToHtml: escape, render **bold**, and colour-code
// the [[VALUE:]] / [[ATTACH:]] placeholders (used for previews shown before save).
function evDecorate(text){
  return hEsc(text)
    .replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>')
    .replace(/\[\[\s*VALUE\s*:([^\]]*)\]\]/gi,function(_m,h){return '<span class="ev-ph ev-ph-value">[[VALUE:'+h+']]</span>';})
    .replace(/\[\[\s*ATTACH\s*:([^\]]*)\]\]/gi,function(_m,h){return '<span class="ev-ph ev-ph-attach">[[ATTACH:'+h+']]</span>';})
    .replace(/\n/g,'<br>');
}
function hWhen(s){try{return new Date(String(s).replace(' ','T')+'Z').toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}catch(e){return s||'';}}

// FEATURE 3: mark Ready / reactivate a control.
async function toggleReady(btn){
  const cid=btn.getAttribute('data-cid');
  const isReady=btn.getAttribute('data-ready')==='1';
  if(!isReady && dirty[cid]){ await saveEvidence(cid,true); }
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/ready/'+cid,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ready:!isReady})});
    const d=await r.json();
    if(!d.success){ alert(d.message||EV_I18N.suggestFail); return; }
    setReadyUI(cid,d.ready);
  }catch(e){ alert(EV_I18N.suggestFail); }
}
function setReadyUI(cid,ready){
  const editor=document.getElementById('editor-'+cid),btn=document.getElementById('readyBtn-'+cid),badge=document.getElementById('readyBadge-'+cid);
  if(editor){ editor.setAttribute('contenteditable',ready?'false':'true'); editor.setAttribute('data-ready',ready?'1':'0'); }
  if(btn){ btn.setAttribute('data-ready',ready?'1':'0'); btn.innerHTML=ready?'<i class="bi bi-unlock me-1"></i>'+READY_LBL.reactivate:'<i class="bi bi-check2-circle me-1"></i>'+READY_LBL.markReady;
    const saveBtn=btn.parentNode.querySelector('.ev-save-btn'); if(saveBtn) saveBtn.hidden=ready; }
  if(badge) badge.hidden=!ready;
}
// FEATURE 3: per-control edit history + revert.
function toggleHistory(btn){
  const cid=btn.getAttribute('data-cid');const panel=document.getElementById('history-'+cid);
  if(!panel) return;
  if(!panel.hidden){ panel.hidden=true; return; }
  panel.hidden=false; loadCtrlHistory(cid);
}
async function loadCtrlHistory(cid){
  const body=document.getElementById('historyBody-'+cid); if(!body) return;
  body.innerHTML='<div class="small text-muted">…</div>';
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/history/'+cid); const d=await r.json();
    if(!d.entries||!d.entries.length){ body.innerHTML='<div class="small text-muted">'+HIST_LBL.none+'</div>'; return; }
    body.innerHTML=d.entries.map(function(e,i){
      const icon=e.actor_type==='ai'?'bi-magic':(e.actor_type==='assessor'?'bi-shield-check':'bi-person');
      const canRevert=i>0 && ['save','ai-draft','revert'].indexOf(e.action)>=0;
      return '<div class="d-flex align-items-center gap-2 small py-1 border-bottom">'+
        '<i class="bi '+icon+'"></i><span class="fw-semibold">'+hEsc(e.actor_name)+'</span>'+
        '<span class="text-muted">'+(HIST_LBL.actions[e.action]||e.action)+'</span>'+
        '<span class="text-muted ms-auto">'+hWhen(e.created_at)+'</span>'+
        (i===0?'<span class="badge text-bg-light border">'+HIST_LBL.current+'</span>':
          (canRevert?'<button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" onclick="revertTo('+cid+','+e.id+')"><i class="bi bi-arrow-counterclockwise me-1"></i>'+HIST_LBL.revert+'</button>':''))+
      '</div>';
    }).join('');
  }catch(e){ body.innerHTML='<div class="small text-danger">'+HIST_LBL.err+'</div>'; }
}
async function revertTo(cid,historyId){
  if(!confirm(HIST_LBL.confirm)) return;
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/revert/'+cid,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({historyId:historyId})});
    const d=await r.json();
    if(!d.success){ alert(d.message||HIST_LBL.err); return; }
    const editor=document.getElementById('editor-'+cid); if(editor){ editor.innerHTML=d.html||''; dirty[cid]=false; updatePhHint(cid); setStatus(cid,'saved'); }
    loadCtrlHistory(cid); updateProgress();
  }catch(e){ alert(HIST_LBL.err); }
}

// FEATURE 2: bulk background "suggest drafts" — start, poll, resume across reloads.
const BULK_LBL = {
  running: {{{tjs 'ev.bulkRunning'}}}, background: {{{tjs 'ev.bulkBackground'}}},
  done: {{{tjs 'ev.bulkDoneN'}}}, errors: {{{tjs 'ev.bulkErrorsN'}}},
  failed: {{{tjs 'ev.bulkFailed'}}}, reload: {{{tjs 'ev.bulkReload'}}}
};
let bulkPollTimer=null;
async function startBulkSuggest(){
  const btn=document.getElementById('bulkStartBtn'); if(btn) btn.disabled=true;
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/suggest-bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
    const d=await r.json();
    if(!d.success){ alert(d.message||EV_I18N.suggestFail); if(btn) btn.disabled=false; return; }
    renderBulk(d.job); pollBulk();
  }catch(e){ alert(EV_I18N.suggestFail); if(btn) btn.disabled=false; }
}
function renderBulk(job){
  const bar=document.getElementById('bulkStatusBar'),lbl=document.getElementById('bulkStatusLabel'),inner=document.getElementById('bulkStatusBarInner'),spin=document.getElementById('bulkSpin'),btn=document.getElementById('bulkStartBtn');
  if(!bar) return;
  if(!job){ bar.hidden=true; if(btn) btn.disabled=false; return; }
  bar.hidden=false;
  const pct=job.total>0?Math.round(job.done/job.total*100):100;
  inner.style.width=pct+'%';
  if(job.status==='running'||job.status==='queued'){
    if(spin) spin.style.display=''; if(btn) btn.disabled=true;
    lbl.innerHTML=BULK_LBL.running.replace('{done}',job.done).replace('{total}',job.total)+' · <span class="text-muted">'+BULK_LBL.background+'</span>';
  } else if(job.status==='done'){
    if(spin) spin.style.display='none'; if(btn) btn.disabled=false;
    const errs=job.errors>0?(' · <span class="text-danger">'+BULK_LBL.errors.replace('{n}',job.errors)+'</span>'):'';
    lbl.innerHTML='<i class="bi bi-check-circle-fill text-success me-1"></i>'+BULK_LBL.done.replace('{n}',(job.done-job.errors))+errs+' <button type="button" class="btn btn-sm btn-link p-0 ms-2" onclick="location.reload()">'+BULK_LBL.reload+'</button>';
  } else {
    if(spin) spin.style.display='none'; if(btn) btn.disabled=false;
    lbl.innerHTML='<i class="bi bi-exclamation-triangle text-danger me-1"></i>'+BULK_LBL.failed;
  }
}
async function pollBulk(){
  clearTimeout(bulkPollTimer);
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/suggest-status');const d=await r.json();
    renderBulk(d.job);
    if(d.job&&(d.job.status==='running'||d.job.status==='queued')) bulkPollTimer=setTimeout(pollBulk,2500);
  }catch(e){ bulkPollTimer=setTimeout(pollBulk,5000); }
}
// Approve one or more assistant evidence proposals: persist as drafts, reflect in
// the editors, and remove the card(s) once applied.
async function aiApplyProposals(items, node) {
  if (!items || !items.length) return;
  try {
    const r = await fetch('/respond/' + INVITE_CODE + '/apply-suggestions', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items })
    });
    const data = await r.json();
    if (!data.success) { alert(data.message || EV_I18N.suggestFail); return; }
    (data.applied || []).forEach(function (a) { applyDraftToEditor(a.controlDbId, a.html); });
    if (node) node.remove();
  } catch (e) { alert(EV_I18N.suggestFail); }
}
// Reflect a server-saved AI draft into a control's editor (shared by the per-control
// "Suggest a draft" button and the assistant's Approve / Approve all). The server
// has already persisted it as an 'ai-suggested' draft, so we do NOT mark it dirty.
function applyDraftToEditor(cid, html) {
  const editor = document.getElementById('editor-' + cid);
  if (!editor) return;
  editor.innerHTML = html || '';
  dirty[cid] = false;
  updatePhHint(cid);
  setStatus(cid, 'saved'); lastSaved[cid] = new Date();
  const wrap = editor.closest('.mb-2');
  const label = wrap && wrap.querySelector('label');
  if (label && !document.getElementById('draftBadge-' + cid)) {
    const b = document.createElement('span');
    b.id = 'draftBadge-' + cid; b.className = 'badge text-bg-warning ms-1';
    b.innerHTML = '<i class="bi bi-magic me-1"></i>' + DRAFT_BADGE_LABEL;
    label.appendChild(b);
  }
  updateProgress();
}

// Soft warning at submit: if any evidence still contains unfilled placeholders,
// warn (but allow) before the normal submit confirmation.
function evConfirmSubmit(msg) {
  let ph = 0;
  document.querySelectorAll('[id^="editor-"]').forEach(function (ed) { ph += evCountPlaceholders(ed.innerText); });
  if (ph > 0 && !confirm(EV_I18N.submitPh.replace('{n}', ph))) return false;
  return confirm(msg);
}
let saveTimers = {};
let dirty = {};      // controlId -> unsaved edits pending
let lastSaved = {};  // controlId -> Date of last successful save

function execCmd(command) {
  document.execCommand(command, false, null);
}

function fmtTime(d) {
  try { return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; }
}

// Render the per-control save indicator so the provider always knows the state:
// unsaved edits, saving, saved (with time), or a save error.
function setStatus(controlId, kind) {
  const el = document.getElementById('saveStatus-' + controlId);
  if (!el) return;
  el.classList.remove('text-muted', 'text-success', 'text-danger', 'text-warning');
  if (kind === 'saving') { el.textContent = EV_I18N.saving; el.classList.add('text-muted'); }
  else if (kind === 'saved') { el.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>' + EV_I18N.saved + (lastSaved[controlId] ? (' · ' + fmtTime(lastSaved[controlId])) : ''); el.classList.add('text-success'); }
  else if (kind === 'unsaved') { el.innerHTML = '<i class="bi bi-pencil-fill me-1"></i>' + EV_I18N.unsaved; el.classList.add('text-warning'); }
  else if (kind === 'error') { el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>' + EV_I18N.error; el.classList.add('text-danger'); }
  else { el.textContent = ''; }
}

// Typing marks the control dirty and schedules a debounced save shortly after the
// user pauses. A separate 10s timer is the safety net for continuous typing.
function markDirty(controlId) {
  dirty[controlId] = true;
  setStatus(controlId, 'unsaved');
  // Editing turns a suggested draft into real evidence — drop the draft badge.
  const badge = document.getElementById('draftBadge-' + controlId);
  if (badge) badge.remove();
  updatePhHint(controlId);
  clearTimeout(saveTimers[controlId]);
  saveTimers[controlId] = setTimeout(() => saveEvidence(controlId), 1200);
}

async function saveEvidence(controlId, manual) {
  const editor = document.getElementById('editor-' + controlId);
  if (!editor) return;
  if (!manual && !dirty[controlId]) return; // nothing new to save
  clearTimeout(saveTimers[controlId]);
  setStatus(controlId, 'saving');
  try {
    const res = await fetch('/respond/' + INVITE_CODE + '/save/' + controlId, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ evidence_text: editor.innerText, evidence_html: editor.innerHTML })
    });
    const data = await res.json();
    if (data.success) { dirty[controlId] = false; lastSaved[controlId] = new Date(); setStatus(controlId, 'saved'); updateProgress(); }
    else { setStatus(controlId, 'error'); }
  } catch (e) {
    setStatus(controlId, 'error');
  }
}

// Generate an AI-suggested placeholder draft into a control's evidence editor.
// The server persists it as an 'ai-suggested' draft; we reflect it in the editor
// WITHOUT marking it dirty (setting innerHTML doesn't fire input), so it isn't
// re-saved as user evidence until the provider actually edits it.
async function aiSuggestEvidence(btn) {
  const cid = btn.getAttribute('data-cid');
  const editor = document.getElementById('editor-' + cid);
  if (!editor) return;
  const existing = editor.innerText.trim();
  if (existing.length > 0 && !confirm({{{tjs 'ev.suggestReplace'}}})) return;
  const original = btn.innerHTML; btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
  try {
    const res = await fetch('/respond/' + INVITE_CODE + '/suggest/' + cid, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
    });
    const data = await res.json();
    if (data && data.success) {
      applyDraftToEditor(cid, data.html);
    } else {
      alert((data && data.message) || EV_I18N.suggestFail);
    }
  } catch (e) { alert(EV_I18N.suggestFail); }
  finally { btn.disabled = false; btn.innerHTML = original; }
}

// Periodic autosave: every 10s, flush any control with unsaved edits.
setInterval(function () {
  Object.keys(dirty).forEach(function (cid) { if (dirty[cid]) saveEvidence(cid); });
}, 10000);

// Best-effort flush of pending edits when leaving the page.
window.addEventListener('beforeunload', function () {
  Object.keys(dirty).forEach(function (cid) {
    if (!dirty[cid]) return;
    const editor = document.getElementById('editor-' + cid);
    if (editor && navigator.sendBeacon) {
      navigator.sendBeacon('/respond/' + INVITE_CODE + '/save/' + cid,
        new Blob([JSON.stringify({ evidence_text: editor.innerText, evidence_html: editor.innerHTML })], { type: 'application/json' }));
    }
  });
});

// On load, controls that already have evidence show as saved (editable until submit).
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[id^="editor-"]').forEach(function (ed) {
    const cid = ed.getAttribute('data-control-id');
    if (ed.innerText.trim().length > 0 && cid) setStatus(cid, 'saved');
    if (cid) updatePhHint(cid);
  });
  // Resume any in-progress bulk-suggest job (survives navigation/reload).
  if (typeof pollBulk === 'function' && document.getElementById('bulkStatusBar')) pollBulk();
  // Init Bootstrap tooltips (the bulk "?" help icon).
  try { if (window.bootstrap && bootstrap.Tooltip) document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) { new bootstrap.Tooltip(el); }); } catch (e) {}
});

function updateProgress() {
  const editors = document.querySelectorAll('[id^="editor-"]');
  let filled = 0;
  editors.forEach(ed => { if (ed.innerText.trim().length > 0) filled++; });
  const total = {{total}};
  const pct = total > 0 ? Math.round(filled / total * 100) : 0;
  const countEl = document.getElementById('progressCount');
  const pctEl = document.getElementById('progressPct');
  const barEl = document.getElementById('progressBar');
  const btnEl = document.getElementById('submitBtn');
  if (countEl) countEl.textContent = filled;
  if (pctEl) pctEl.textContent = pct + '%';
  if (barEl) barEl.style.width = pct + '%';
  if (btnEl) btnEl.disabled = filled < 1;
}

async function uploadFile(controlId) {
  const input = document.getElementById('fileInput-' + controlId);
  if (!input.files.length) return;
  const formData = new FormData();
  formData.append('file', input.files[0]);
  try {
    const res = await fetch('/respond/' + INVITE_CODE + '/upload/' + controlId, {
      method: 'POST', body: formData
    });
    const data = await res.json();
    if (data.success) {
      const container = document.getElementById('attachments-' + controlId);
      // Same shape as the server-rendered badge, so a just-uploaded file is
      // downloadable immediately rather than only after the next page load.
      const badge = document.createElement('a');
      badge.className = 'badge bg-light text-dark border text-decoration-none';
      badge.href = '/respond/' + INVITE_CODE + '/attachment/' + data.file.attachmentId;
      badge.title = EV_I18N.download;
      badge.innerHTML = '<i class="bi bi-paperclip me-1"></i>' + hEsc(data.file.name);
      container.appendChild(badge);
      input.value = '';
    }
  } catch(e) { console.error(e); }
}

async function loadComments(controlId) {
  try {
    const res = await fetch('/api/comments/' + controlId);
    const data = await res.json();
    const thread = document.getElementById('thread-' + controlId);
    if (data.comments && data.comments.length) {
      thread.innerHTML = data.comments.map(c =>
        '<div class="comment-item">' +
        '<span class="comment-author">' + c.user_name + '</span> ' +
        '<span class="comment-time">' + new Date(c.created_at).toLocaleString() + '</span>' +
        '<div>' + c.content + '</div></div>'
      ).join('');
    } else {
      thread.innerHTML = '<div class="text-muted small text-center py-1">No comments yet</div>';
    }
  } catch(e) { console.error(e); }
}

async function addComment(controlId) {
  const input = document.getElementById('commentInput-' + controlId);
  if (!input.value.trim()) return;
  try {
    await fetch('/respond/' + INVITE_CODE + '/comment/' + controlId, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: input.value })
    });
    input.value = '';
    loadComments(controlId);
  } catch(e) { console.error(e); }
}
</script>

