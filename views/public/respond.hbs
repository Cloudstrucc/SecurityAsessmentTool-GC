{{!-- FEATURE 4: floating bulk-actions bar + right-click menu --}}
<div id="evBulkBar" class="shadow" style="display:none;position:fixed;left:50%;transform:translateX(-50%);bottom:18px;z-index:1050;background:#0a1626;color:#fff;border-radius:12px;padding:8px 12px;align-items:center;gap:10px">
  <span class="fw-semibold"><span id="evSelCount">0</span> {{t 'ev.selected'}}</span>
  <button type="button" class="btn btn-sm btn-outline-light" onclick="doBulk('ready')"><i class="bi bi-check2-circle me-1"></i>{{t 'ev.markReady'}}</button>
  <button type="button" class="btn btn-sm btn-outline-light" onclick="doBulk('reactivate')"><i class="bi bi-unlock me-1"></i>{{t 'ev.reactivate'}}</button>
  <button type="button" class="btn btn-sm btn-outline-light" onclick="doBulk('suggest')"><i class="bi bi-magic me-1"></i>{{t 'ev.suggestBtn'}}</button>
  <button type="button" class="btn btn-sm btn-link text-light text-decoration-none" onclick="clearSelection()">{{t 'ev.clear'}}</button>
</div>
<div id="evCtxMenu" class="shadow-sm border bg-white rounded" style="display:none;position:fixed;z-index:1060;min-width:190px;font-size:13px;padding:4px 0">
  <button type="button" class="dropdown-item py-1" onclick="ctxBulk('ready')"><i class="bi bi-check2-circle me-2"></i>{{t 'ev.markReady'}}</button>
  <button type="button" class="dropdown-item py-1" onclick="ctxBulk('reactivate')"><i class="bi bi-unlock me-2"></i>{{t 'ev.reactivate'}}</button>
  <button type="button" class="dropdown-item py-1" onclick="ctxBulk('suggest')"><i class="bi bi-magic me-2"></i>{{t 'ev.suggestBtn'}}</button>
</div>
<script>
// FEATURE 4: multi-select, status filter, bulk actions, right-click menu.
const EV_FILTERS = new Set();
function toggleFilter(el){ const f=el.getAttribute('data-f'); if(EV_FILTERS.has(f)){EV_FILTERS.delete(f);el.style.opacity='';el.style.outline='';}else{EV_FILTERS.add(f);el.style.opacity='1';el.style.outline='2px solid rgba(0,0,0,.25)';} applyEvFilter(); }
function applyEvFilter(){
  document.querySelectorAll('.ev-ctrl').forEach(function(c){
    const show = EV_FILTERS.size===0 || EV_FILTERS.has(c.getAttribute('data-evstatus'));
    c.style.display = show ? '' : 'none';
    if(!show){ const cb=c.querySelector('.ev-select'); if(cb) cb.checked=false; }
  });
  updateBulkBar();
}
function toggleSelectAll(cb){ document.querySelectorAll('.ev-ctrl').forEach(function(c){ if(c.style.display!=='none'){ const b=c.querySelector('.ev-select'); if(b) b.checked=cb.checked; } }); updateBulkBar(); }
function selectedIds(){ return [].slice.call(document.querySelectorAll('.ev-select:checked')).map(function(b){return Number(b.getAttribute('data-cid'));}); }
function updateBulkBar(){ const ids=selectedIds(); const bar=document.getElementById('evBulkBar'); document.getElementById('evSelCount').textContent=ids.length; bar.style.display=ids.length?'flex':'none'; }
function clearSelection(){ document.querySelectorAll('.ev-select:checked').forEach(function(b){b.checked=false;}); const sa=document.getElementById('evSelectAll'); if(sa) sa.checked=false; updateBulkBar(); }
const EV_PROG = { ready: {{{tjs 'ev.pReady'}}}, reactivate: {{{tjs 'ev.pReactivate'}}}, suggest: {{{tjs 'ev.pSuggest'}}} };
async function doBulk(action){
  const ids=selectedIds(); if(!ids.length) return;
  showBulkProgress(EV_PROG[action] || '');
  try{
    const r=await fetch('/respond/'+INVITE_CODE+'/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:action,controlIds:ids})});
    const d=await r.json();
    hideBulkProgress();
    if(!d.success){ showBulkFlash(d.message||BF_I18N.error, true); return; }
    (d.results||[]).forEach(function(res){
      if(res.html!=null) applyDraftToEditor(res.id, res.html);
      else if(res.ready!=null) setReadyUI(res.id, res.ready);
    });
    clearSelection();
    showBulkFlash(BF_I18N.updated.replace('{n}', d.updated));
  }catch(e){ hideBulkProgress(); showBulkFlash(BF_I18N.error, true); }
}
// Right-click a control to act on the current selection (or just that control).
let ctxTargetId=null;
document.addEventListener('contextmenu',function(e){
  const card=e.target.closest && e.target.closest('.ev-ctrl'); if(!card) return;
  e.preventDefault();
  const cb=card.querySelector('.ev-select'); if(cb && !cb.checked && selectedIds().length===0){ cb.checked=true; updateBulkBar(); }
  ctxTargetId=Number(card.querySelector('.ev-select')&&card.querySelector('.ev-select').getAttribute('data-cid'));
  const m=document.getElementById('evCtxMenu'); m.style.left=Math.min(e.clientX,window.innerWidth-200)+'px'; m.style.top=e.clientY+'px'; m.style.display='block';
});
document.addEventListener('click',function(){ const m=document.getElementById('evCtxMenu'); if(m) m.style.display='none'; });
function ctxBulk(action){ document.getElementById('evCtxMenu').style.display='none'; if(selectedIds().length===0 && ctxTargetId){ const b=document.querySelector('.ev-select[data-cid="'+ctxTargetId+'"]'); if(b) b.checked=true; updateBulkBar(); } doBulk(action); }
</script>
{{/unless}}

