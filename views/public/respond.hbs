{{> ai-assess-helper }}
<script>
window.AIAssistConfig = {
  mode: 'evidence',
  chatEndpoint: '/respond/' + INVITE_CODE + '/ai-chat',
  frameworkLabel: '{{assessment.security_framework}}',
  subtitle: 'Evidence help · ask anything',
  placeholder: {{{tjs 'ev.placeholderEvidence'}}},
  greeting: 'Hi — I can explain what each control is asking for and help you write clear evidence. Ask me anything, or use “Refine with AI” on a control to expand a quick note.',
  getSelected: function(){ return []; },   // the server loads the control set for context
  applyActions: function(){},               // evidence mode exposes no scope CRUD
  // Render the assistant's evidence proposals as Approve / Approve all cards.
  onResponse: function(data, tools){
    var props = (data && data.proposals) || [];
    if(!props.length) return;
    var esc = tools.escapeHtml;
    var head = props.length > 1
      ? '<div class="mb-2"><button type="button" class="btn btn-sm btn-success py-0" data-role="approve-all">'+esc(EV_LBL.approveAll)+'</button></div>'
      : '';
    var rows = props.map(function(p){
      var t = p.text || '';
      var preview = esc(t.slice(0,220)) + (t.length>220 ? '…' : '');
      return '<div class="ai-prop border rounded p-2 mb-2">' +
        '<div class="fw-semibold small mb-1">'+esc(p.controlId||'')+'</div>' +
        '<div class="small text-muted" style="white-space:pre-wrap;max-height:120px;overflow:auto">'+preview+'</div>' +
        '<div class="d-flex gap-2 mt-2">' +
          '<button type="button" class="btn btn-sm btn-primary py-0" data-role="approve">'+esc(EV_LBL.approve)+'</button>' +
          '<button type="button" class="btn btn-sm btn-outline-secondary py-0" data-role="decline">'+esc(EV_LBL.decline)+'</button>' +
        '</div></div>';
    }).join('');
    var card = tools.addCard('<div class="fw-semibold mb-2" style="color:#6d28d9"><i class="bi bi-magic me-1"></i>'+esc(EV_LBL.propose)+'</div>'+head+rows);
    var nodes = card.querySelectorAll('.ai-prop');
    nodes.forEach(function(node, i){
      node.querySelector('[data-role="approve"]').onclick = function(){ aiApplyProposals([{ controlDbId: props[i].controlDbId, text: props[i].text }], node); };
      node.querySelector('[data-role="decline"]').onclick = function(){ node.remove(); };
    });
    var allBtn = card.querySelector('[data-role="approve-all"]');
    if(allBtn) allBtn.onclick = function(){
      var items = props.map(function(p){ return { controlDbId: p.controlDbId, text: p.text }; });
      aiApplyProposals(items, card);
    };
  }
};
async function aiRefineEvidence(btn){
  var id=btn.getAttribute('data-cid');
  var editor=document.getElementById('editor-'+id); if(!editor) return;
  var summary=(editor.innerText||'').trim();
  if(summary.length<3){ editor.focus(); return; }
  var orig=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> Refining…';
  try{
    var r=await fetch('/respond/'+INVITE_CODE+'/ai-refine',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({controlId:btn.getAttribute('data-control'),controlTitle:btn.getAttribute('data-title'),controlGuidance:btn.getAttribute('data-guidance'),userSummary:summary})});
    var data=await r.json();
    if(!r.ok||!data.success) throw new Error(data.error||'Could not refine.');
    aiEvidencePreview(editor, id, data.refined);
  }catch(e){ alert(e.message); }
  btn.disabled=false; btn.innerHTML=orig;
}
function aiEvidencePreview(editor, id, refined){
  var esc=function(s){return String(s).replace(/[&<>]/g,function(m){return({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]);});};
  var old=editor.parentNode.querySelector('.ai-ev-preview'); if(old) old.remove();
  var box=document.createElement('div'); box.className='ai-ev-preview';
  box.style.cssText='border:1px solid #ddd6fe;background:#faf7ff;border-radius:8px;padding:8px 10px;margin-top:6px;font-size:13px';
  box.innerHTML='<div class="fw-semibold mb-1" style="color:#6d28d9"><i class="bi bi-stars me-1"></i>AI-refined draft — approve to use</div>'+
    '<div style="white-space:pre-wrap;color:#22303a">'+esc(refined)+'</div>'+
    '<div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-sm btn-primary py-0 aiap">Approve &amp; use</button><button type="button" class="btn btn-sm btn-outline-secondary py-0 aidz">Discard</button></div>';
  box.querySelector('.aiap').onclick=function(){ editor.innerText=refined; box.remove(); if(typeof autoSave==='function') autoSave(id); };
  box.querySelector('.aidz').onclick=function(){ box.remove(); };
  editor.parentNode.appendChild(box);
}
</script>
