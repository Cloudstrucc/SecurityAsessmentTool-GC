          <button type="button" class="btn btn-outline-secondary" onmousedown="eslCmd(event,'italic')"><i>I</i></button>
          <button type="button" class="btn btn-outline-secondary" onmousedown="eslCmd(event,'insertUnorderedList')">•</button>
          <button type="button" class="btn btn-outline-secondary" onmousedown="eslCmd(event,'insertOrderedList')">1.</button>
          <button type="button" class="btn btn-outline-secondary" onmousedown="eslCmd(event,'removeFormat')">⌫</button>
        </div>
        <div class="form-control" id="eslValRte" contenteditable="true" style="min-height:130px"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-outline-danger me-auto" id="eslValRemove">{{t 'esl.removeSlot'}}</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">{{t 'ui.cancel'}}</button>
        <button type="button" class="btn btn-sm btn-primary" id="eslValSave">{{t 'esl.saveValue'}}</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="eslAttModal" tabindex="-1" aria-labelledby="eslAttLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <div class="small text-uppercase opacity-75" style="letter-spacing:.12em;font-size:10.5px">{{t 'esl.attachSlot'}}</div>
          <h5 class="modal-title mb-0" id="eslAttLabel"></h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{t 'ui.close'}}"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning py-2 px-3 small">{{t 'esl.attachGuide'}}</div>
        {{!-- Drop zone. The real <input> stays in the DOM (hidden) so the
              picker, keyboard access and assistive tech all still work — the
              zone is a label for it, not a replacement. --}}
        <div class="esl-drop" id="eslAttDrop" role="button" tabindex="0"
          aria-controls="eslAttInput" aria-describedby="eslAttLimits">
          <i class="bi bi-cloud-arrow-up d-block" style="font-size:1.6rem"></i>
          <span class="esl-drop-label">{{t 'esl.dropHere'}}</span>
          <div class="small mt-1" id="eslAttLimits">{{t 'esl.attachLimits'}}</div>
        </div>
        <input type="file" id="eslAttInput" multiple hidden>
        {{!-- Says "checked", never "clean": files are validated for type and
              active content, but not scanned for malware. --}}
        <div class="form-text fst-italic">{{t 'esl.scanNote'}}</div>
        <div id="eslAttErrors" class="mt-2"></div>
        <div id="eslAttList" class="mt-2"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-outline-danger me-auto" id="eslAttRemove">{{t 'esl.removeSlot'}}</button>
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">{{t 'ui.close'}}</button>
      </div>
    </div>
  </div>
</div>

<script>
/* ── Evidence slots ──────────────────────────────────────────────────────── */
const ESL_I18N = {
  blanksLeft: {{{tjs 'esl.blanksLeft'}}}, complete: {{{tjs 'esl.complete'}}},
  noBlanks: {{{tjs 'esl.noBlanks'}}}, saved: {{{tjs 'esl.saved'}}},
  removed: {{{tjs 'esl.removed'}}}, failed: {{{tjs 'esl.failed'}}},
  newValue: {{{tjs 'esl.newValue'}}}, newAttach: {{{tjs 'esl.newAttach'}}},
  checked: {{{tjs 'esl.checked'}}}, remove: {{{tjs 'ui.remove'}}},
  uploading: {{{tjs 'esl.uploading'}}}
};
let eslActive = null;   // { cid, key, type, label }

function eslCmd(e, cmd){ e.preventDefault(); document.execCommand(cmd, false, null); }

/** Paint every slot span in a control from its data. */
function eslRender(cid, data){
  const editor = document.getElementById('editor-' + cid);
  if (!editor) return;
  const byKey = {};
  (data.slots || []).forEach(s => { byKey[s.key] = s; });
  editor.querySelectorAll('span[data-slot]').forEach(span => {
    const s = byKey[span.getAttribute('data-slot')];
    if (!s) { span.remove(); return; }
    const filled = s.filled;
    const body = filled
      ? (s.type === 'value' ? s.value_text : (s.files[0] ? s.files[0].original_name + (s.files.length > 1 ? ' +' + (s.files.length - 1) : '') : ''))
      : (s.type === 'value' ? 'VALUE: ' : 'ATTACH: ') + s.label;
    span.className = 'ev-slot ' + (s.type === 'value' ? 'ev-slot-value' : 'ev-slot-attach') + (filled ? ' filled' : '');
    span.setAttribute('contenteditable', 'false');
    span.setAttribute('role', 'button');
    span.setAttribute('tabindex', '0');
    span.title = s.label;
    span.textContent = (filled ? '✓ ' : (s.type === 'value' ? '✎ ' : '📎 ')) + body;
  });
  eslPaintProgress(cid, data.progress);
}

function eslPaintProgress(cid, p){
  if (!p) return;
  const bar = document.getElementById('slotbar-' + cid);
  if (!bar) return;
  const pct = p.total ? Math.round(p.filled / p.total * 100) : 0;
  bar.querySelector('.ev-sb-fill').style.width = pct + '%';
  bar.querySelector('.ev-sb-v').textContent = p.values.filled;
  bar.querySelector('.ev-sb-a').textContent = p.attachments.filled;
  const left = p.total - p.filled;
  const el = bar.querySelector('.ev-sb-left');
  el.textContent = left ? ESL_I18N.blanksLeft.replace('{n}', left) : ESL_I18N.complete;
  el.className = 'ev-sb-left fw-semibold ' + (left ? 'text-warning-emphasis' : 'text-success');
  // Mark ready stays disabled until every blank is filled.
  const ready = document.getElementById('readyBtn-' + cid);
  if (ready && ready.getAttribute('data-ready') !== '1') {
    ready.disabled = left > 0;
    ready.title = left > 0 ? ESL_I18N.blanksLeft.replace('{n}', left) : '';
  }
}

async function eslLoad(cid){
  try {
    const r = await fetch('/respond/' + INVITE_CODE + '/slots/' + cid);
    const d = await r.json();
    if (d.success) eslRender(cid, d);
    return d;
  } catch (e) { return null; }
}

/** Open the right modal for a slot. */
async function eslOpen(cid, key){
  const d = await eslLoad(cid);
  if (!d || !d.success) return;
  const s = (d.slots || []).find(x => x.key === key);
  if (!s) return;
  eslActive = { cid, key, type: s.type, label: s.label };
  if (s.type === 'value') {
    document.getElementById('eslValLabel').textContent = s.label;
    document.getElementById('eslValRte').innerHTML = s.value_html || '';
    new bootstrap.Modal(document.getElementById('eslValModal')).show();
  } else {
    document.getElementById('eslAttLabel').textContent = s.label;
    eslPaintFiles(s.files || []);
    document.getElementById('eslAttInput').value = '';
    new bootstrap.Modal(document.getElementById('eslAttModal')).show();
  }
}

function eslPaintFiles(files){
  const list = document.getElementById('eslAttList');
  list.innerHTML = files.map(f =>
    '<div class="d-flex align-items-center gap-2 border rounded p-2 mb-1">' +
    '<span class="fw-semibold small">' + hEsc(f.original_name) + '</span>' +
    '<span class="badge text-bg-success">' + hEsc(ESL_I18N.checked) + '</span>' +
    '<span class="ms-auto"></span>' +
    '<button type="button" class="btn btn-sm btn-outline-danger" data-fid="' + f.id + '">' + hEsc(ESL_I18N.remove) + '</button></div>'
  ).join('') || '';
  list.querySelectorAll('[data-fid]').forEach(b => {
    b.onclick = async () => {
      const a = eslActive; if (!a) return;
      await fetch('/respond/' + INVITE_CODE + '/slots/' + a.cid + '/' + a.key + '/files/' + b.dataset.fid, { method: 'DELETE' });
      const d = await eslLoad(a.cid);
      const s = d && (d.slots || []).find(x => x.key === a.key);
      eslPaintFiles(s ? s.files : []);
    };
  });
}

/* Click (or keyboard) on a chip opens its modal. */
document.addEventListener('click', e => {
  const span = e.target.closest && e.target.closest('span[data-slot]');
  if (!span) return;
  const editor = span.closest('.evidence-editor');
  if (!editor || editor.getAttribute('contenteditable') !== 'true') return;
  e.preventDefault();
  eslOpen(editor.dataset.controlId, span.getAttribute('data-slot'));
});
document.addEventListener('keydown', e => {
  if (e.key !== 'Enter' && e.key !== ' ') return;
  const span = e.target.closest && e.target.closest('span[data-slot]');
  if (!span) return;
  const editor = span.closest('.evidence-editor');
  if (!editor || editor.getAttribute('contenteditable') !== 'true') return;
  e.preventDefault();
  eslOpen(editor.dataset.controlId, span.getAttribute('data-slot'));
});

document.getElementById('eslValSave').onclick = async () => {
  const a = eslActive; if (!a) return;
  const html = document.getElementById('eslValRte').innerHTML;
  const r = await fetch('/respond/' + INVITE_CODE + '/slots/' + a.cid + '/' + a.key, {
    method: 'PUT', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ value_html: html })
  });
  const d = await r.json();
  if (!d.success) { alert(d.message || ESL_I18N.failed); return; }
  bootstrap.Modal.getInstance(document.getElementById('eslValModal')).hide();
  await eslLoad(a.cid);
};

/**
 * Upload a list of files into the active slot, one at a time so each gets its
 * own verdict and the per-slot cap is enforced in order. Rejections are shown
 * against the file that caused them rather than as one opaque alert.
 */
async function eslUpload(fileList){
  const a = eslActive; if (!a || !fileList || !fileList.length) return;
  const drop = document.getElementById('eslAttDrop');
  const errs = document.getElementById('eslAttErrors');
  errs.innerHTML = '';
  drop.classList.add('busy');
  for (const file of Array.from(fileList)) {
    const row = document.createElement('div');
    row.className = 'small text-muted py-1';
    row.textContent = ESL_I18N.uploading.replace('{name}', file.name);
    errs.appendChild(row);
    try {
      const fd = new FormData();
      fd.append('file', file);
      const r = await fetch('/respond/' + INVITE_CODE + '/slots/' + a.cid + '/' + a.key + '/files', { method: 'POST', body: fd });
      const d = await r.json();
      if (d.success) {
        row.remove();
      } else {
        row.className = 'small text-danger py-1';
        row.textContent = file.name + ' — ' + (d.message || ESL_I18N.failed);
      }
    } catch (e) {
      row.className = 'small text-danger py-1';
      row.textContent = file.name + ' — ' + ESL_I18N.failed;
    }
  }
  drop.classList.remove('busy');
  const fresh = await eslLoad(a.cid);
  const s = fresh && (fresh.slots || []).find(x => x.key === a.key);
  eslPaintFiles(s ? s.files : []);
}

document.getElementById('eslAttInput').onchange = function(){
  eslUpload(this.files);
  this.value = '';
};

/* Drop zone: click, keyboard and drag-and-drop all reach the same uploader. */
(function(){
  const drop = document.getElementById('eslAttDrop');
  const input = document.getElementById('eslAttInput');
  if (!drop || !input) return;
  drop.addEventListener('click', () => input.click());
  drop.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
  });
  // The document-level handlers stop the browser from navigating to a file
  // that misses the zone, which would lose whatever the provider had typed.
  ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => {
    e.preventDefault(); e.stopPropagation(); drop.classList.add('over');
  }));
  ['dragleave', 'dragend'].forEach(ev => drop.addEventListener(ev, e => {
    e.preventDefault(); e.stopPropagation(); drop.classList.remove('over');
  }));
  drop.addEventListener('drop', e => {
    e.preventDefault(); e.stopPropagation(); drop.classList.remove('over');
    eslUpload(e.dataTransfer && e.dataTransfer.files);
  });
  ['dragover', 'drop'].forEach(ev =>
    document.addEventListener(ev, e => { if (!e.target.closest('.esl-drop')) e.preventDefault(); }));
})();

async function eslRemoveActive(){
  const a = eslActive; if (!a) return;
  const r = await fetch('/respond/' + INVITE_CODE + '/slots/' + a.cid + '/' + a.key, { method: 'DELETE' });
  const d = await r.json();
  if (!d.success) { alert(d.message || ESL_I18N.failed); return; }
  // The prose stays — the span becomes the text the slot held.
  const editor = document.getElementById('editor-' + a.cid);
  const span = editor && editor.querySelector('span[data-slot="' + a.key + '"]');
  if (span) span.replaceWith(document.createTextNode(d.text || ''));
  ['eslValModal', 'eslAttModal'].forEach(id => {
    const inst = bootstrap.Modal.getInstance(document.getElementById(id)); if (inst) inst.hide();
  });
  eslPaintProgress(a.cid, d.progress);
  saveEvidence(a.cid, true);
}
document.getElementById('eslValRemove').onclick = eslRemoveActive;
document.getElementById('eslAttRemove').onclick = eslRemoveActive;

/** Turn the current selection into a new slot. */
async function eslAddSlot(cid, type){
  const sel = window.getSelection();
  const picked = sel && sel.toString().trim();
  const label = picked ? picked.slice(0, 70) : (type === 'value' ? ESL_I18N.newValue : ESL_I18N.newAttach);
  const r = await fetch('/respond/' + INVITE_CODE + '/slots/' + cid, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ type, label })
  });
  const d = await r.json();
  if (!d.success) { alert(d.message || ESL_I18N.failed); return; }
  const editor = document.getElementById('editor-' + cid);
  const span = document.createElement('span');
  span.setAttribute('data-slot', d.slot.key);
  span.setAttribute('data-slot-type', d.slot.type);
  span.setAttribute('contenteditable', 'false');
  if (picked && sel.rangeCount && editor.contains(sel.anchorNode)) {
    const range = sel.getRangeAt(0); range.deleteContents(); range.insertNode(span);
  } else {
    editor.appendChild(span);
  }
  await saveEvidence(cid, true);
  await eslLoad(cid);
  eslOpen(cid, d.slot.key);
}

/** Scroll to the first unfilled slot and open it. */
async function eslJumpNext(cid){
  const d = await eslLoad(cid);
  if (!d || !d.success) return;
  const next = (d.slots || []).find(s => !s.filled);
  if (!next) { alert(ESL_I18N.noBlanks); return; }
  const editor = document.getElementById('editor-' + cid);
  const span = editor && editor.querySelector('span[data-slot="' + next.key + '"]');
  if (span) span.scrollIntoView({ behavior: 'smooth', block: 'center' });
  eslOpen(cid, next.key);
}

/**
 * Fill-in vs Evidence view.
 *
 * The read view is rebuilt from the live editor each time it is shown. It was
 * server-rendered at page load, which meant a value filled in this session
 * still showed as an unfilled hole until the page was reloaded.
 */
async function eslSetView(cid, mode, btn){
  const editor = document.getElementById('editor-' + cid);
  const read = document.getElementById('readview-' + cid);
  if (!editor || !read) return;
  const editing = mode === 'edit';
  if (!editing) {
    const d = await eslLoad(cid);
    const byKey = {};
    if (d && d.success) (d.slots || []).forEach(s => { byKey[s.key] = s; });
    const clone = editor.cloneNode(true);
    clone.querySelectorAll('span[data-slot]').forEach(span => {
      const s = byKey[span.getAttribute('data-slot')];
      const out = document.createElement('span');
      if (!s) { span.remove(); return; }
      if (s.filled) {
        out.className = s.type === 'value' ? 'ev-slot-val' : 'ev-slot-att';
        out.innerHTML = s.type === 'value'
          ? (s.value_html || '')
          : s.files.map(f => hEsc(f.original_name)).join(', ');
      } else {
        out.className = 'ev-slot-empty';
        out.textContent = '[' + s.label + ']';
      }
      span.replaceWith(out);
    });
    read.innerHTML = clone.innerHTML;
  }
  editor.hidden = !editing;
  read.hidden = editing;
  const bar = document.getElementById('slotbar-' + cid);
  if (bar) bar.querySelectorAll('[data-evview]').forEach(b => b.classList.toggle('active', b === btn));
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.ev-slotbar').forEach(bar => eslLoad(bar.dataset.cid));
});
</script>
