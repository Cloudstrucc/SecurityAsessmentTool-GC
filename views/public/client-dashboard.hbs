<div class="container py-4" style="max-width:960px">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">{{t 'client_dashboard.h1.my_dashboard'}}</h1>
      <p class="text-muted mb-0">Welcome back, {{clientUser.name}}</p>
    </div>
    <a href="/intake" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>{{t 'client_dashboard.link.new_intake'}}</a>
  </div>

  <!-- ══ Assessments ══ -->
  {{#if assessments.length}}
  <div class="form-section">
    <div class="section-header">
      <h3 class="section-title">
        <span class="section-number"><i class="bi bi-shield-check"></i></span>
        My Assessments
      </h3>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>{{t 'client_dashboard.th.project'}}</th>
            <th>{{t 'client_dashboard.th.status'}}</th>
            <th>{{t 'client_dashboard.th.invite_code'}}</th>
            <th>{{t 'client_dashboard.th.created'}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each assessments}}
          <tr>
            <td class="fw-semibold">{{this.project_name}}</td>
            <td>
              {{#if (eq this.status 'draft')}}<span class="badge bg-secondary">{{t 'client_dashboard.span.draft'}}</span>
              {{else if (eq this.status 'evidence-gathering')}}<span class="badge bg-warning text-dark">{{t 'client_dashboard.span.evidence_gathering'}}</span>
              {{else if (eq this.status 'submitted')}}<span class="badge bg-info">{{t 'client_dashboard.span.submitted'}}</span>
              {{else if (eq this.status 'audit')}}<span class="badge bg-primary">{{t 'client_dashboard.span.under_audit'}}</span>
              {{else if (eq this.status 'completed')}}<span class="badge bg-success">{{t 'client_dashboard.span.completed'}}</span>
              {{else}}<span class="badge bg-secondary">{{this.status}}</span>
              {{/if}}
            </td>
            <td><code class="small">{{this.invite_code}}</code></td>
            <td class="small text-muted">{{this.created_at}}</td>
            <td>
              {{#if (eq this.status 'evidence-gathering')}}
                <a href="/respond/{{this.invite_code}}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Respond</a>
              {{else if (eq this.status 'submitted')}}
                <a href="/respond/{{this.invite_code}}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>View</a>
              {{else if (eq this.status 'audit')}}
                <a href="/respond/{{this.invite_code}}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>View</a>
              {{else if (eq this.status 'completed')}}
                <a href="/respond/{{this.invite_code}}" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-check me-1"></i>View Results</a>
              {{/if}}
              {{#if (eq this.ato_type 'iato')}}
                <a href="/respond/{{this.invite_code}}/poam" class="btn btn-sm btn-outline-warning ms-1"><i class="bi bi-list-check me-1"></i>POA&M</a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}

  <!-- ══ Intakes ══ -->
  <div class="form-section">
    <div class="section-header">
      <h3 class="section-title">
        <span class="section-number"><i class="bi bi-inbox"></i></span>
        My Intakes
      </h3>
    </div>
    {{#if intakes.length}}
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>{{t 'client_dashboard.th.reference'}}</th>
            <th>{{t 'client_dashboard.th.project'}}</th>
            <th>{{t 'client_dashboard.th.status'}}</th>
            <th>{{t 'client_dashboard.th.department'}}</th>
            <th>{{t 'client_dashboard.th.submitted'}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each intakes}}
          <tr>
            <td><code class="small">{{this.ref_code}}</code></td>
            <td class="fw-semibold">{{this.project_name}}</td>
            <td>
              {{#if (eq this.status 'draft')}}<span class="badge bg-dark"><i class="bi bi-pencil me-1"></i>{{t 'client_dashboard.span.draft_needs_completion'}}</span>
              {{else if (eq this.status 'pending')}}<span class="badge bg-warning text-dark">{{t 'client_dashboard.span.pending_review'}}</span>
              {{else if (eq this.status 'in-review')}}<span class="badge bg-info">{{t 'client_dashboard.span.in_review'}}</span>
              {{else if (eq this.status 'accepted')}}<span class="badge bg-success">{{t 'client_dashboard.span.accepted'}}</span>
              {{else if (eq this.status 'declined')}}<span class="badge bg-danger">{{t 'client_dashboard.span.declined'}}</span>
              {{else}}<span class="badge bg-secondary">{{this.status}}</span>
              {{/if}}
            </td>
            <td class="small text-muted">{{this.department}}</td>
            <td class="small text-muted">{{this.created_at}}</td>
            <td>
              {{#if (eq this.status 'draft')}}
                <a href="/intake/{{this.ref_code}}/edit" class="btn btn-sm btn-primary"><i class="bi bi-pencil-square me-1"></i>Complete Intake</a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="text-center py-4 text-muted">
      <i class="bi bi-inbox" style="font-size:2rem;opacity:0.4"></i>
      <p class="mt-2">No intakes yet. <a href="/intake">{{t 'client_dashboard.link.submit_your_first_intake'}}</a> to begin the security assessment process.</p>
    </div>
    {{/if}}
  </div>

  <!-- ══ Access Code ══ -->
  <div class="form-section">
    <div class="section-header">
      <h3 class="section-title">
        <span class="section-number"><i class="bi bi-key"></i></span>
        Enter Access Code
      </h3>
    </div>
    <p class="small text-muted mb-3">{{t 'client_dashboard.p.received_an_invite_code_from'}}</p>
    <form action="/respond/access" method="POST" class="d-flex gap-2">
      <input type="text" name="code" class="form-control form-control-sm font-monospace" placeholder="{{t 'client_dashboard.ph.eg_a1b2c3d4'}}" style="max-width:200px" required>
      <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-right me-1"></i>{{t 'client_dashboard.btn.go'}}</button>
    </form>
  </div>
</div>
