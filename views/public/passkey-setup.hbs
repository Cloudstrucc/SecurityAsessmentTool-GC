<div class="container py-5" style="max-width:520px;">
  <div class="text-center mb-4">
    <div style="width:56px;height:56px;border-radius:14px;background:var(--gc-nav,#26374a);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
      <i class="bi bi-person-bounding-box text-white" style="font-size:1.5rem;"></i>
    </div>
    <h3>Register a Passkey</h3>
    <p class="text-muted">Use your device passkey for faster sign-in. Your TOTP authenticator code remains available as a fallback.</p>
  </div>

  <div class="card">
    <div class="card-body p-4">
      {{#if hasWebAuthn}}
        <div class="alert alert-success small">
          <i class="bi bi-check-circle me-1"></i>Passkey already registered. You can re-register to update it.
        </div>
      {{/if}}
      <div class="text-center mb-4">
        <i class="bi bi-fingerprint" style="font-size:3.5rem;color:var(--gc-nav,#26374a);opacity:0.65"></i>
      </div>
      <button class="btn btn-primary w-100 py-2 mb-3" id="registerPasskeyBtn">
        <i class="bi bi-person-bounding-box me-1"></i>Register Passkey
      </button>
      <div id="passkeyStatus" class="small d-none mb-3"></div>
      <a href="/intake" class="btn btn-outline-secondary w-100">
        <i class="bi bi-arrow-right me-1"></i>Continue with TOTP Only
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('registerPasskeyBtn').addEventListener('click', async function() {
    const btn = this;
    const statusEl = document.getElementById('passkeyStatus');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Starting...';
    statusEl.className = 'small mb-3 text-muted';
    statusEl.textContent = 'Waiting for passkey prompt...';
    statusEl.classList.remove('d-none');

    try {
      const optResp = await fetch('/api/webauthn/register-options', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const opts = await optResp.json();
      if (opts.error) throw new Error(opts.error);
      const regResult = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts });
      const verifyResp = await fetch('/api/webauthn/register-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(regResult)
      });
      const data = await verifyResp.json();
      if (!data.success) throw new Error(data.error || 'Passkey registration failed');
      statusEl.className = 'small mb-3 text-success';
      statusEl.innerHTML = '<i class="bi bi-check-circle me-1"></i>Passkey registered. TOTP fallback remains enabled.';
      btn.className = 'btn btn-success w-100 py-2 mb-3';
      btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Registered';
    } catch (err) {
      statusEl.className = 'small mb-3 text-danger';
      statusEl.textContent = err.name === 'NotAllowedError' ? 'Cancelled. You can continue with TOTP.' : err.message;
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-person-bounding-box me-1"></i>Try Again';
    }
  });
});
</script>
