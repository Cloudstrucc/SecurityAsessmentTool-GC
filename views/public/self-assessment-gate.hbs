<style>
.gate-hero{background:linear-gradient(135deg,#1a2e42 0%,#2d4a6a 50%,#3a5a7c 100%);padding:2.5rem 0 4rem;position:relative;overflow:hidden;margin:-1.5rem -15px 0;width:calc(100% + 30px);border-bottom:3px solid #af3c43}
.gate-hero::before{content:'';position:absolute;top:-40%;right:-8%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,0.04) 0%,transparent 70%)}
.gate-hero .gate-inner{position:relative;z-index:1}
.gate-card{background:#fff;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.12);border:none;overflow:hidden}
.gate-card .card-header{font-weight:600;font-size:0.9rem;padding:0.85rem 1.25rem}
</style>

<div class="gate-hero">
  <div class="container gate-inner text-center">
    <i class="bi bi-shield-check" style="font-size:2.5rem;color:rgba(255,255,255,0.8)"></i>
    <h2 class="text-white mt-2 mb-1">{{t 'gate.title'}}</h2>
    <p style="color:rgba(255,255,255,0.65);">{{t 'gate.subtitle'}}</p>
  </div>
</div>

<div class="container" style="margin-top:-2.5rem;position:relative;z-index:2;">
  <div class="row justify-content-center">
    <div class="col-lg-6">

      {{#if requestSubmitted}}
      <div class="gate-card card">
        <div class="card-body p-4 text-center">
          <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
          <h4 class="mt-3">{{t 'gate.submitted'}}</h4>
          <p class="text-muted">{{{t 'gate.submittedD' email=requestEmail}}}</p>
          <p class="text-muted small">{{t 'gate.submittedNote'}}</p>
          <a href="/portal" class="btn btn-outline-secondary mt-2"><i class="bi bi-arrow-left me-1"></i>{{t 'gate.backPortal'}}</a>
        </div>
      </div>
      {{else}}

      <div class="gate-card card mb-4">
        <div class="card-header"><i class="bi bi-key me-2"></i>{{t 'gate.haveCode'}}</div>
        <div class="card-body p-4">
          <form action="/self-assessment" method="GET">
            <div class="mb-3">
              <label for="code" class="form-label">{{t 'gate.codeLabel'}}</label>
              <input type="text" class="form-control form-control-lg text-center text-uppercase" id="code" name="code" placeholder="{{t 'self_assessment_gate.ph.a1b2c3d4'}}" maxlength="10" required style="letter-spacing:3px;font-weight:600;font-family:'Courier New',monospace">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-2"></i>{{t 'gate.startBtn'}}</button>
          </form>
        </div>
      </div>

      <div class="gate-card card">
        <div class="card-header bg-light"><i class="bi bi-envelope me-2"></i>{{t 'gate.requestAccess'}}</div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">{{t 'gate.requestD'}}</p>
          <form action="/self-assessment/request-access" method="POST">
            <div class="mb-3">
              <label for="req_name" class="form-label">{{t 'gate.name'}} <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="req_name" name="name" required placeholder="{{t 'self_assessment_gate.ph.jane_doe'}}">
            </div>
            <div class="mb-3">
              <label for="req_email" class="form-label">{{t 'gate.email'}} <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="req_email" name="email" required placeholder="jane@organization.gc.ca">
            </div>
            <div class="mb-3">
              <label for="req_org" class="form-label">{{t 'gate.org'}}</label>
              <input type="text" class="form-control" id="req_org" name="organization" placeholder="">
            </div>
            <div class="mb-3">
              <label for="req_reason" class="form-label">{{t 'gate.systemQ'}}</label>
              <textarea class="form-control" id="req_reason" name="reason" rows="2" placeholder="{{t 'gate.systemP'}}"></textarea>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100 py-2"><i class="bi bi-send me-2"></i>{{t 'gate.submitBtn'}}</button>
          </form>
        </div>
      </div>

      <div class="text-center mt-3 mb-4"><a href="/portal" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>{{t 'gate.backPortal'}}</a></div>
      {{/if}}
    </div>
  </div>
</div>
