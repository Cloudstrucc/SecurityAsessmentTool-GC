<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-lg-6">
      <div class="text-center mb-4">
        <i class="bi bi-shield-check" style="font-size:3rem;color:var(--cs-accent,#284162)"></i>
        <h2 class="mt-2">Security Self-Assessment</h2>
        <p class="text-muted">Evaluate your system's security posture against applicable frameworks.</p>
      </div>

      {{#if requestSubmitted}}
      <!-- Request submitted confirmation -->
      <div class="card">
        <div class="card-body p-4 text-center">
          <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
          <h4 class="mt-3">Request Submitted!</h4>
          <p class="text-muted">
            Your request has been sent to our security team. You'll receive an email at 
            <strong>{{requestEmail}}</strong> with an access code once approved.
          </p>
          <p class="text-muted small">This typically takes less than 24 hours.</p>
          <a href="/portal" class="btn btn-outline-secondary mt-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Portal
          </a>
        </div>
      </div>
      {{else}}

      <!-- Enter access code -->
      <div class="card mb-4">
        <div class="card-header">
          <i class="bi bi-key me-2"></i>I Have an Access Code
        </div>
        <div class="card-body p-4">
          <form action="/self-assessment" method="GET">
            <div class="mb-3">
              <label for="code" class="form-label">Access Code</label>
              <input type="text" class="form-control form-control-lg text-center text-uppercase" 
                id="code" name="code" placeholder="e.g. A1B2C3D4" maxlength="10" required
                style="letter-spacing:3px;font-weight:600;font-family:'Courier New',monospace">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">
              <i class="bi bi-box-arrow-in-right me-2"></i>Start Assessment
            </button>
          </form>
        </div>
      </div>

      <!-- Request access -->
      <div class="card">
        <div class="card-header bg-light">
          <i class="bi bi-envelope me-2"></i>Request Access
        </div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">Don't have a code? Submit a request and our security team will review it. Once approved, you'll receive an access code by email.</p>
          <form action="/self-assessment/request-access" method="POST">
            <div class="mb-3">
              <label for="req_name" class="form-label">Your Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="req_name" name="name" required placeholder="Jane Doe">
            </div>
            <div class="mb-3">
              <label for="req_email" class="form-label">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="req_email" name="email" required placeholder="jane@organization.gc.ca">
            </div>
            <div class="mb-3">
              <label for="req_org" class="form-label">Organization</label>
              <input type="text" class="form-control" id="req_org" name="organization" placeholder="e.g. Department of Innovation">
            </div>
            <div class="mb-3">
              <label for="req_reason" class="form-label">What system do you want to assess?</label>
              <textarea class="form-control" id="req_reason" name="reason" rows="2" placeholder="Brief description — e.g. public-facing web portal for citizen feedback"></textarea>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100 py-2">
              <i class="bi bi-send me-2"></i>Request Access
            </button>
          </form>
        </div>
      </div>

      <div class="text-center mt-3">
        <a href="/portal" class="text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Portal</a>
      </div>
      {{/if}}
    </div>
  </div>
</div>
