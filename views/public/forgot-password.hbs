<div class="container py-5" style="max-width:520px;">
  <div class="text-center mb-4">
    <i class="bi bi-key" style="font-size:3rem;color:var(--gc-nav,#26374a)"></i>
    <h2 class="mt-2" style="color:var(--gc-nav)">{{t 'rec.title'}}</h2>
    <p class="text-muted">{{t 'rec.intro'}}</p>
  </div>

  <div class="card"><div class="card-body p-4">
    <form method="POST" action="/forgot-password">
      <div class="mb-3">
        <label class="form-label" for="email">{{t 'rec.emailLabel'}}</label>
        <input type="email" class="form-control" id="email" name="email" required autofocus value="{{prefillEmail}}">
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="bi bi-send me-2"></i>{{t 'rec.sendLink'}}
      </button>
    </form>
  </div></div>

  <div class="text-center mt-3">
    <a href="/client/login" class="small text-muted"><i class="bi bi-arrow-left me-1"></i>{{t 'rec.backToSignIn'}}</a>
  </div>
</div>
