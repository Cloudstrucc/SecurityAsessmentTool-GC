<div class="container py-5" style="max-width:520px;">
  <div class="text-center mb-4">
    <i class="bi bi-shield-lock" style="font-size:3rem;color:var(--gc-nav,#26374a)"></i>
    <h2 class="mt-2" style="color:var(--gc-nav)">{{t 'rec.newTitle'}}</h2>
    <p class="text-muted">{{t 'rec.newIntro'}}</p>
  </div>

  <div class="card"><div class="card-body p-4">
    <form method="POST" action="/reset-password/{{token}}">
      <div class="mb-3">
        <label class="form-label" for="password">{{t 'rec.newPassword'}}</label>
        <input type="password" class="form-control" id="password" name="password" required minlength="10" autofocus>
        <div class="form-text">{{t 'rec.pwHint'}}</div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="confirmPassword">{{t 'rec.confirmPassword'}}</label>
        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="10">
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="bi bi-check-circle me-2"></i>{{t 'rec.setPassword'}}
      </button>
    </form>
  </div></div>
</div>
