<div class="container py-5" style="max-width:520px;">
  <div class="text-center mb-4">
    <i class="bi bi-box-arrow-in-right" style="font-size:3rem;color:var(--gc-red)"></i>
    <h2 class="mt-2" style="color:var(--gc-nav)">{{t 'auth.clientSignIn'}}</h2>
    <p class="text-muted">{{t 'auth.clientSignInD'}}</p>
  </div>

  <div class="card">
    <div class="card-body p-4">

      {{#unless mfaStep}}
      <!-- Step 1: Email + Password -->
      <form method="POST" action="/client/login">
        <div class="mb-3">
          <label class="form-label" for="email">{{t 'auth.email'}}</label>
          <input type="email" class="form-control" id="email" name="email" required placeholder="your.name@agency.gc.ca" autofocus value="{{prefillEmail}}">
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">{{t 'auth.password'}}</label>
          <input type="password" class="form-control" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-arrow-right me-2"></i>{{t 'common.continue'}}
        </button>
      </form>
      <div class="d-flex align-items-center my-3 text-muted small">
        <span class="flex-grow-1 border-top"></span><span class="px-2">{{t 'auth.or'}}</span><span class="flex-grow-1 border-top"></span>
      </div>
      <button type="button" id="clientPasskeyLoginBtn" class="btn btn-outline-primary w-100 py-2">
        <i class="bi bi-fingerprint me-2"></i>{{t 'ui.signInWithAPasskey'}}
      </button>
      <div id="clientPasskeyLoginError" class="text-danger small mt-2 d-none"></div>
      {{else}}
      <!-- Step 2: MFA -->
      {{#if hasWebAuthn}}
      <div id="passkeyLoginSection">
        <div class="text-center mb-3">
          <i class="bi bi-person-bounding-box" style="font-size:3rem;color:var(--gc-nav,#26374a)"></i>
        </div>
        <p class="text-center text-muted small mb-3">{{t 'auth.passkeyOrTotp'}}</p>
        <div id="passkeyError" class="alert alert-danger small py-2 d-none"></div>
        <button class="btn btn-primary w-100 py-2 mb-3" id="passkeyLoginBtn" data-user-id="{{userId}}">
          <i class="bi bi-person-bounding-box me-1"></i>{{t 'auth.signInPasskey'}}
        </button>
        <div class="text-center">
          <a href="#" class="small text-muted" id="switchToTotpBtn"><i class="bi bi-key me-1"></i>{{t 'auth.useTotpInstead'}}</a>
        </div>
      </div>
      {{/if}}

      <div id="totpLoginSection" {{#if hasWebAuthn}}class="d-none"{{/if}}>
        <div class="alert alert-info small mb-3">
          <i class="bi bi-shield-lock me-1"></i>
          {{t 'auth.enter6digit'}}
        </div>
      <form method="POST" action="/client/login/mfa">
        <input type="hidden" name="userId" value="{{userId}}">
        <div class="mb-4">
          <label class="form-label fw-bold">{{t 'auth.authCode'}}</label>
          <input type="text" class="form-control form-control-lg text-center" name="token"
            required maxlength="6" pattern="[0-9]{6}" placeholder="000000"
            style="letter-spacing:6px;font-family:'Courier New',monospace;font-weight:700;font-size:1.5rem;"
            autocomplete="one-time-code" inputmode="numeric" autofocus>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-check-circle me-2"></i>{{t 'auth.verifySignIn'}}
        </button>
      </form>
        {{#if hasWebAuthn}}
        <div class="text-center mt-3">
          <a href="#" class="small text-muted" id="switchToPasskeyBtn"><i class="bi bi-person-bounding-box me-1"></i>{{t 'auth.usePasskeyInstead'}}</a>
        </div>
        {{/if}}
      </div>
      {{/unless}}
    </div>
  </div>

  <div class="text-center mt-3">
    <span class="text-muted">{{t 'auth.noAccount'}}</span>
    <a href="/client/register">{{t 'auth.registerHere'}}</a>
  </div>
</div>

{{#unless mfaStep}}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
(function(){
  var btn = document.getElementById('clientPasskeyLoginBtn');
  if (!btn || !window.SimpleWebAuthnBrowser) return;
  var errEl = document.getElementById('clientPasskeyLoginError');
  btn.addEventListener('click', async function(){
    errEl.classList.add('d-none');
    var original = btn.innerHTML; btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + {{{tjs 'auth.waitingPasskey'}}};
    try {
      var optResp = await fetch('/api/webauthn/login-options', { method:'POST', headers:{'Content-Type':'application/json'} });
      var opts = await optResp.json();
      if (!optResp.ok) throw new Error(opts.error || 'Could not start passkey sign-in.');
      var assertion = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: opts });
      var vResp = await fetch('/api/webauthn/login-verify', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(assertion) });
      var data = await vResp.json();
      if (!vResp.ok || !data.success) throw new Error(data.error || 'Passkey sign-in failed.');
      window.location = data.redirect || '/intake';
    } catch (e) {
      errEl.textContent = (e && e.name === 'NotAllowedError') ? {{{tjs 'auth.cancelledUseTotp'}}} : ((e && e.message) ? e.message : 'Passkey sign-in failed. Try your password.');
      errEl.classList.remove('d-none');
      btn.disabled = false; btn.innerHTML = original;
    }
  });
})();
</script>
{{/unless}}

{{#if mfaStep}}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const passkeySection = document.getElementById('passkeyLoginSection');
  const totpSection = document.getElementById('totpLoginSection');
  document.getElementById('switchToTotpBtn')?.addEventListener('click', function(e) {
    e.preventDefault();
    passkeySection?.classList.add('d-none');
    totpSection?.classList.remove('d-none');
    totpSection?.querySelector('input[name="token"]')?.focus();
  });
  document.getElementById('switchToPasskeyBtn')?.addEventListener('click', function(e) {
    e.preventDefault();
    totpSection?.classList.add('d-none');
    passkeySection?.classList.remove('d-none');
  });

  document.getElementById('passkeyLoginBtn')?.addEventListener('click', async function() {
    const errEl = document.getElementById('passkeyError');
    const userId = this.dataset.userId;
    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + {{{tjs 'auth.waitingPasskey'}}};
    errEl.classList.add('d-none');
    try {
      const optResp = await fetch('/api/webauthn/auth-options', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: parseInt(userId) })
      });
      const opts = await optResp.json();
      if (opts.error) throw new Error(opts.error);
      const authResult = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: opts });
      const verifyResp = await fetch('/api/webauthn/auth-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...authResult, _userId: userId })
      });
      const verifyData = await verifyResp.json();
      if (!verifyData.success || !verifyData.sig_token) throw new Error(verifyData.error || 'Verification failed');
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/client/login/webauthn';
      form.innerHTML = '<input type="hidden" name="_sig_token" value="' + verifyData.sig_token + '">';
      document.body.appendChild(form);
      form.submit();
    } catch (err) {
      errEl.textContent = err.name === 'NotAllowedError' ? {{{tjs 'auth.cancelledUseTotp'}}} : err.message;
      errEl.classList.remove('d-none');
      this.disabled = false;
      this.innerHTML = '<i class="bi bi-person-bounding-box me-1"></i>' + {{{tjs 'auth.tryPasskeyAgain'}}};
    }
  });
});
</script>
{{/if}}
