<div class="container py-5" style="max-width:520px;">
  <div class="text-center mb-4">
    <i class="bi bi-person-plus" style="font-size:3rem;color:var(--gc-red)"></i>
    <h2 class="mt-2" style="color:var(--gc-nav)">{{t 'crf.title'}}</h2>
    <p class="text-muted">{{t 'crf.intro'}}</p>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <form method="POST" action="/client/register">
        {{#if inviteCode}}<input type="hidden" name="invite_code" value="{{inviteCode}}">{{/if}}
        <div class="mb-3">
          <label class="form-label" for="name">{{t 'crf.fullName'}} <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="name" name="name" required placeholder="{{t 'crf.fullNamePh'}}" value="{{formData.name}}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="email">{{t 'auth.email'}} <span class="text-danger">*</span></label>
          <input type="email" class="form-control" id="email" name="email" required placeholder="jane.doe@agency.example" value="{{formData.email}}">
          <small class="text-muted">{{t 'crf.emailHint'}}</small>
        </div>
        <div class="mb-3">
          <label class="form-label" for="organization">{{t 'crf.org'}} <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="organization" name="organization" required value="{{formData.organization}}">
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">{{t 'auth.password'}} <span class="text-danger">*</span></label>
          <input type="password" class="form-control" id="password" name="password" required minlength="10" placeholder="{{t 'crf.passwordPh'}}">
          <small class="text-muted">{{t 'crf.passwordHint'}}</small>
        </div>
        <div class="mb-4">
          <label class="form-label" for="confirmPassword">{{t 'crf.confirmPassword'}} <span class="text-danger">*</span></label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="10">
        </div>
        {{#unless inviteCode}}
        <div class="mb-4">
          <label class="form-label" for="invite_code">{{t 'crf.inviteCode'}}</label>
          <input type="text" class="form-control text-uppercase" id="invite_code" name="invite_code">
        </div>
        {{/unless}}
        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-arrow-right me-2"></i>{{t 'crf.continue'}}
        </button>
      </form>
    </div>
  </div>

  <div class="text-center mt-3">
    <span class="text-muted">{{t 'crf.haveAccount'}}</span>
    <a href="/client/login">{{t 'auth.signIn'}}</a>
  </div>
</div>
