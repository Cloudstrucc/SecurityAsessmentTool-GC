<style>
.hero {
  background:
    radial-gradient(820px 440px at 50% -10%, rgba(124,196,238,.20), transparent 62%),
    radial-gradient(680px 400px at 92% 112%, rgba(109,127,202,.16), transparent 60%),
    #0a1626;
  position:relative;
  overflow:hidden;
  border-bottom:3px solid #0ea5e9;
}
.hero-brand {
  padding:.85rem 0;
  border-bottom:1px solid rgba(255,255,255,.08);
  position:relative;
  z-index:2;
}
/* Pull brand (left) and actions (right) to the page edges. */
.hero-brand > .container { max-width:none; padding-left:2rem; padding-right:2rem; }
.brand-link {
  color:#fff;
  text-decoration:none;
  display:flex;
  align-items:center;
  gap:.6rem;
  font-size:.95rem;
}
.brand-link:hover { color:#fff; }
.brand-icon {
  width:38px;
  min-width:38px;
  display:flex;
  align-items:center;
}
.brand-icon img { height:30px; width:auto; }
.brand-name { font-weight:800; letter-spacing:-.01em; }
.brand-sep { color:rgba(255,255,255,.28); margin:0 .2rem; font-weight:300; }
.brand-product { font-weight:500; opacity:.78; font-size:.88rem; }
.btn-existing {
  font-size:.78rem;
  padding:.35rem .9rem;
  border:1px solid rgba(255,255,255,.28);
  border-radius:6px;
  color:rgba(255,255,255,.86);
  background:rgba(255,255,255,.07);
  text-decoration:none;
  transition:all .2s;
}
.btn-existing:hover { background:rgba(255,255,255,.14); color:#fff; }
.btn-signup {
  font-size:.78rem; font-weight:700; padding:.4rem 1rem; border-radius:6px;
  color:#08131f; text-decoration:none; border:1px solid transparent;
  background:linear-gradient(90deg,#8593d6,#7cc4ee); transition:filter .2s;
}
.btn-signup:hover { filter:brightness(1.06); color:#08131f; }
.hero-main {
  padding:3.2rem 0 2.7rem;
  position:relative;
  z-index:1;
}
.hero h1 {
  color:#fff;
  font-weight:800;
  font-size:clamp(2.1rem,4vw,3.8rem);
  line-height:1.08;
  letter-spacing:0;
}
.hero h1 span { background:linear-gradient(90deg,#a9d8f2 0%,#7cc4ee 50%,#8593d6 100%); -webkit-background-clip:text; background-clip:text; color:transparent; }
.hero .lead {
  color:rgba(255,255,255,.76);
  font-size:1.08rem;
  max-width:620px;
}
.hero-point {
  color:rgba(255,255,255,.72);
  font-size:.86rem;
  display:flex;
  align-items:center;
  gap:.45rem;
}
.hero-point i { color:#22c55e; }
.sa-hero-card {
  background:#fff;
  border-radius:12px;
  box-shadow:0 10px 34px rgba(0,0,0,.22);
  overflow:hidden;
  max-width:430px;
  margin-left:auto;
}
.sa-hero-card .sa-header {
  background:linear-gradient(135deg,#143453,#4d9fe0);
  padding:1.5rem;
  text-align:center;
}
.sa-hero-card .sa-header i {
  font-size:2.5rem;
  color:#fff;
  display:block;
  margin-bottom:.5rem;
}
.sa-hero-card .sa-header h3 {
  color:#fff;
  font-size:1.1rem;
  font-weight:800;
  margin:0;
}
.sa-hero-card .sa-header p {
  color:rgba(255,255,255,.82);
  font-size:.82rem;
  margin:.3rem 0 0;
}
.sa-body { padding:1.5rem; }
.sa-step {
  display:flex;
  gap:.75rem;
  align-items:flex-start;
  margin-bottom:.85rem;
  padding-bottom:.85rem;
  border-bottom:1px solid #eef1f5;
}
.sa-step:last-child { border-bottom:none; margin-bottom:0; padding-bottom:0; }
.sa-step-num {
  width:28px;
  height:28px;
  border-radius:50%;
  background:#284162;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:.75rem;
  font-weight:800;
  flex-shrink:0;
}
.sa-step-text { font-size:.86rem; color:#334155; line-height:1.45; }
.sa-step-text strong { color:#26374a; }
.btn-sa-start {
  background:linear-gradient(90deg,#6d7fca 0%,#4d9fe0 50%,#7cc9ee 100%);
  color:#08131f;
  border:none;
  width:100%;
  padding:.88rem;
  border-radius:8px;
  font-weight:800;
  font-size:1rem;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:.5rem;
  transition:all .2s;
  cursor:pointer;
  text-decoration:none;
  box-shadow:0 4px 12px rgba(26,138,74,.3);
}
.btn-sa-start:hover {
  background:linear-gradient(135deg,#15713d,#0f5c30);
  transform:translateY(-1px);
  box-shadow:0 6px 18px rgba(26,138,74,.35);
  color:#fff;
}
.sa-note {
  font-size:.72rem;
  color:#8c96a2;
  text-align:center;
  margin-top:.75rem;
}
.fw-ticker {
  background:rgba(255,255,255,.06);
  border-top:1px solid rgba(255,255,255,.08);
  padding:.75rem 0;
  position:relative;
  z-index:1;
}
.fw-ticker-inner {
  display:flex;
  align-items:center;
  gap:.65rem;
  overflow:hidden;
  flex-wrap:wrap;
  justify-content:center;
}
.fw-label {
  color:rgba(255,255,255,.48);
  font-size:.72rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:1px;
  white-space:nowrap;
}
.fw-badge {
  padding:.22rem .65rem;
  border-radius:4px;
  font-size:.72rem;
  font-weight:700;
  background:rgba(255,255,255,.08);
  color:rgba(255,255,255,.7);
  border:1px solid rgba(255,255,255,.1);
}
.platform-section { padding:2.5rem 0; }
.platform-section h2 {
  font-size:1.3rem;
  font-weight:800;
  color:#26374a;
}
.cap-item { text-align:center; padding:1rem; }
.cap-item i { font-size:1.8rem; color:#284162; }
.cap-title {
  font-weight:800;
  font-size:.9rem;
  margin-top:.5rem;
  color:#26374a;
}
.cap-desc {
  font-size:.76rem;
  color:#64748b;
  margin-top:.2rem;
}
.site-footer { background:#26374a; padding:1.25rem 0; }
.site-footer p { color:rgba(255,255,255,.58); font-size:.78rem; margin:0; }
.site-footer a { color:rgba(255,255,255,.78); text-decoration:none; }
.site-footer a:hover { color:#fff; }
@media(max-width:991px) {
  .hero-main { padding:2.5rem 0; }
  .sa-hero-card { margin:1.25rem auto 0; }
}
@media(max-width:575px) {
  .brand-product,.brand-sep { display:none; }
  .hero-brand .container { gap:.75rem; }
  .hero h1 { font-size:2.05rem; }
  /* Comfortable side padding on phones so hero text/badges don't hug the edge */
  .hero-brand .container,
  .hero-main { padding-left:1.25rem; padding-right:1.25rem; }
  .hero .lead { font-size:1rem; }
  /* Let header actions wrap instead of clipping off-screen */
  .hero-brand .container { flex-wrap:wrap; row-gap:.5rem; }
  .hero-brand .d-flex { flex-wrap:wrap; }
  .btn-existing { font-size:.74rem; padding:.3rem .6rem; }
}
</style>

<div class="hero">
  <div class="hero-brand">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-link" aria-label="Vanguard Cloud Services Security Assessment Platform">
        <span class="brand-icon"><img src="/images/logo-large@2xVCS.png" alt="VCS"></span>
        <span>
          <span class="brand-name">{{t 'brand.company'}}</span>
          <span class="brand-sep">|</span>
          <span class="brand-product">{{t 'brand.product'}}</span>
        </span>
      </a>
      <div class="d-flex align-items-center gap-2">
        <div class="dropdown">
          <a href="#" class="btn-existing dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-globe2 me-1"></i>{{#each supportedLangs}}{{#if this.active}}{{this.short}}{{/if}}{{/each}}
          </a>
          <ul class="dropdown-menu dropdown-menu-end" style="min-width:150px;font-size:.86rem;">
            {{#each supportedLangs}}
              <li><a class="dropdown-item {{#if this.active}}active{{/if}}" href="{{this.url}}">{{this.short}} — {{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <a href="/sa-tool-overview.html" class="btn-existing">
          <i class="bi bi-journal-richtext me-1"></i>Product brief
        </a>
        <a href="/pricing" class="btn-existing">
          <i class="bi bi-tag me-1"></i>Pricing
        </a>
        <a href="/admin/login" class="btn-existing">
          <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
        </a>
        <a href="/register" class="btn-signup">
          <i class="bi bi-person-plus me-1"></i>Register
        </a>
      </div>
    </div>
  </div>

  <div class="container hero-main">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <div class="mb-2">
          <span class="badge" style="background:rgba(124,196,238,.16);color:#a9d8f2;font-size:.72rem;font-weight:700;padding:.3rem .8rem;border-radius:20px;">
            <i class="bi bi-shield-check me-1"></i>{{t 'home.badge'}}
          </span>
        </div>
        <h1 class="mb-3">{{t 'home.headline'}}<br><span>{{t 'home.headlineAccent'}}</span></h1>
        <p class="lead mb-4">{{t 'home.lead'}}</p>
        <div class="d-flex flex-wrap gap-3 mb-3">
          <div class="hero-point"><i class="bi bi-check-circle-fill"></i>{{t 'home.noAccount'}}</div>
          <div class="hero-point"><i class="bi bi-check-circle-fill"></i>{{t 'home.fiveMin'}}</div>
          <div class="hero-point"><i class="bi bi-check-circle-fill"></i>{{t 'home.instantReport'}}</div>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-4 d-lg-none">
          <a href="/self-assessment" class="btn-sa-start" style="max-width:320px;"><i class="bi bi-shield-check"></i>{{t 'saCard.startBtn'}}</a>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block">
        <div class="sa-hero-card">
          <div class="sa-header">
            <i class="bi bi-clipboard2-pulse"></i>
            <h3>{{t 'saCard.title'}}</h3>
            <p>{{t 'saCard.subtitle'}}</p>
          </div>
          <div class="sa-body">
            <div class="sa-step">
              <div class="sa-step-num">1</div>
              <div class="sa-step-text"><strong>{{t 'saCard.step1'}}</strong> {{t 'saCard.step1d'}}</div>
            </div>
            <div class="sa-step">
              <div class="sa-step-num">2</div>
              <div class="sa-step-text"><strong>{{t 'saCard.step2'}}</strong> {{t 'saCard.step2d'}}</div>
            </div>
            <div class="sa-step">
              <div class="sa-step-num">3</div>
              <div class="sa-step-text"><strong>{{t 'saCard.step3'}}</strong> {{t 'saCard.step3d'}}</div>
            </div>
            <a href="/self-assessment" class="btn-sa-start mt-3"><i class="bi bi-shield-check"></i>{{t 'saCard.startBtn'}}</a>
            <div class="sa-note"><i class="bi bi-lock me-1"></i>{{t 'saCard.note'}}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="fw-ticker">
    <div class="container">
      <div class="fw-ticker-inner">
        <span class="fw-label">{{t 'home.frameworks'}}</span>
        {{#each frameworkHighlights}}<span class="fw-badge">{{this}}</span>{{/each}}
        <span class="fw-badge">SOC 2</span>
        <span class="fw-badge">PCI DSS</span>
        <span class="fw-badge">CMMC</span>
      </div>
    </div>
  </div>
</div>

<!-- Plans -->
<div class="vg" id="plans" style="background:var(--vg-mist);border-top:1px solid var(--vg-line);border-bottom:1px solid var(--vg-line)">
  <div class="vg-container" style="padding:52px 24px">
    <div class="vg-center" style="max-width:640px;margin:0 auto 8px">
      <div class="vg-eyebrow" style="justify-content:center">Plans for teams of every size</div>
      <h2 style="font-size:30px;font-weight:750">Start free. Upgrade when you're ready.</h2>
      <p class="vg-muted" style="font-size:15.5px">Every plan includes the full multi-framework platform and AI-assisted evidence. Registration is required — start on a free trial, no card needed.</p>
    </div>
    <div class="vg-price-grid" style="margin-top:26px">
      <div class="vg-plan">
        <div class="vg-plan-name">Trial</div>
        <div class="vg-plan-price">Free</div>
        <div class="vg-plan-tag">14 days, no card. Explore the full workflow.</div>
        <div class="vg-plan-cta"><a href="/register?plan=trial" class="vg-btn vg-btn-ghost vg-btn-block">Start free trial</a></div>
        <ul class="vg-plan-features"><li>1 admin + 2 users</li><li>1 project</li><li>All frameworks</li><li>AI evidence guidance</li></ul>
      </div>
      <div class="vg-plan">
        <div class="vg-plan-name">Team</div>
        <div class="vg-plan-price">$149<span class="per">/mo</span></div>
        <div class="vg-plan-tag">For a single team assessing regularly.</div>
        <div class="vg-plan-cta"><a href="/register?plan=team" class="vg-btn vg-btn-ghost vg-btn-block">Choose Team</a></div>
        <ul class="vg-plan-features"><li>Up to 5 users</li><li>5 projects</li><li>Control inheritance</li></ul>
      </div>
      <div class="vg-plan featured">
        <div class="vg-plan-flag"><span class="vg-badge vg-badge-grad">Most popular</span></div>
        <div class="vg-plan-name">Business</div>
        <div class="vg-plan-price">$449<span class="per">/mo</span></div>
        <div class="vg-plan-tag">For departments authorizing many systems.</div>
        <div class="vg-plan-cta"><a href="/register?plan=business" class="vg-btn vg-btn-primary vg-btn-block">Choose Business</a></div>
        <ul class="vg-plan-features"><li>Up to 20 users</li><li>25 projects</li><li>AI + audit</li><li>Priority support</li></ul>
      </div>
      <div class="vg-plan">
        <div class="vg-plan-name">Enterprise</div>
        <div class="vg-plan-price">Custom</div>
        <div class="vg-plan-tag">Unlimited scale, SSO, dedicated support.</div>
        <div class="vg-plan-cta"><a href="/register?plan=enterprise" class="vg-btn vg-btn-dark vg-btn-block">Get started</a></div>
        <ul class="vg-plan-features"><li>Unlimited users</li><li>Unlimited projects</li><li>SSO / SAML</li></ul>
      </div>
    </div>
    <div class="vg-center" style="margin-top:22px">
      <a href="/pricing" class="vg-nav-link" style="color:var(--vg-sky-600);font-weight:600">See full pricing &amp; pay-as-you-go →</a>
    </div>
  </div>
</div>

<div class="container platform-section">
  <div class="text-center mb-4">
    <h2><i class="bi bi-grid-3x3-gap me-2"></i>{{t 'cap.title'}}</h2>
    <p class="text-muted mb-0">{{t 'cap.subtitle'}}</p>
  </div>
  <div class="row g-3">
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-globe2"></i><div class="cap-title">{{t 'cap.multiJuris'}}</div><div class="cap-desc">{{t 'cap.multiJurisD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-clipboard-check"></i><div class="cap-title">{{t 'cap.lifecycle'}}</div><div class="cap-desc">{{t 'cap.lifecycleD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-people-fill"></i><div class="cap-title">{{t 'cap.collab'}}</div><div class="cap-desc">{{t 'cap.collabD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-shield-fill-check"></i><div class="cap-title">{{t 'cap.mfa'}}</div><div class="cap-desc">{{t 'cap.mfaD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-file-earmark-ruled"></i><div class="cap-title">{{t 'cap.guidance'}}</div><div class="cap-desc">{{t 'cap.guidanceD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-robot"></i><div class="cap-title">{{t 'cap.audit'}}</div><div class="cap-desc">{{t 'cap.auditD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-building"></i><div class="cap-title">{{t 'cap.tenant'}}</div><div class="cap-desc">{{t 'cap.tenantD'}}</div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cap-item"><i class="bi bi-award"></i><div class="cap-title">{{t 'cap.standards'}}</div><div class="cap-desc">{{t 'cap.standardsD'}}</div></div>
    </div>
  </div>
  <div class="text-center mt-4 mb-2">
    <p class="text-muted small">{{t 'brand.tagline'}} {{t 'brand.by'}} <strong>{{t 'brand.company'}}</strong></p>
  </div>
</div>

<div class="site-footer">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2" style="width:100%;padding:0 2rem">
    <p style="margin:0"><img src="/images/logo-large@2xVSCFull.png" alt="Vanguard Cloud Services" style="height:20px"></p>
    <p style="margin:0"><a href="/pricing">Pricing</a> &nbsp;·&nbsp; <a href="/admin/login">Sign in</a> &nbsp;·&nbsp; <a href="/register">Register</a></p>
  </div>
</div>
