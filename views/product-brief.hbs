  <section id="how">
    <div class="eyebrow">{{t 'pb.s3Eyebrow'}}</div>
    <h2>{{t 'pb.s3H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s3P1'}}</p>
    <div class="journey">
      <div class="journey-head"><span class="pill">{{t 'pb.s3Pill'}}</span> {{t 'pb.s3JourneyTitle'}}</div>
      <ol class="steps">
        <li><b>{{t 'pb.s3St1B'}}</b> <span>{{t 'pb.s3St1T'}}</span></li>
        <li><b>{{t 'pb.s3St2B'}}</b> <span>{{t 'pb.s3St2T'}}</span></li>
        <li><b>{{t 'pb.s3St3B'}}</b> <span>{{t 'pb.s3St3T'}}</span></li>
        <li><b>{{t 'pb.s3St4B'}}</b> <span>{{t 'pb.s3St4T'}}</span></li>
        <li><b>{{t 'pb.s3St5B'}}</b> <span>{{t 'pb.s3St5T'}}</span></li>
        <li><b>{{t 'pb.s3St6B'}}</b> <span>{{t 'pb.s3St6T'}}</span></li>
        <li><b>{{t 'pb.s3St7B'}}</b> <span>{{t 'pb.s3St7T'}}</span></li>
      </ol>
    </div>
    <div class="callout"><b>{{t 'pb.s3CalloutB'}}</b> {{t 'pb.s3CalloutT'}}</div>
