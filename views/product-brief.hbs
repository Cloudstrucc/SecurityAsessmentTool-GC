</header>

<main>
  <section id="what">
    <div class="eyebrow">{{t 'pb.s1Eyebrow'}}</div>
    <h2>{{t 'pb.s1H2'}}</h2>
    <div class="rule"></div>
    <p class="lede">{{t 'pb.s1Lede'}}</p>
