  <section id="collab">
    <div class="eyebrow">{{t 'pb.s5Eyebrow'}}</div>
    <h2>{{t 'pb.s5H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s5P1'}}</p>
    <div class="grid2">
      <div class="card"><b>{{t 'pb.s5C1B'}}</b><span>{{t 'pb.s5C1T'}}</span></div>
      <div class="card"><b>{{t 'pb.s5C2B'}}</b><span>{{t 'pb.s5C2T'}}</span></div>
    </div>
    <p>{{t 'pb.s5P2'}}</p>
    <div class="callout"><b>{{t 'pb.s5CalloutB'}}</b> {{t 'pb.s5CalloutT'}}</div>
  </section>

  <section id="knowledge">
    <div class="eyebrow">{{t 'pb.s6Eyebrow'}}</div>
    <h2>{{t 'pb.s6H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s6P1'}}</p>
    <p>{{t 'pb.s6P2'}}</p>
    <ul class="clean">
      <li><strong>{{t 'pb.s6Li1B'}}</strong> {{t 'pb.s6Li1T'}}</li>
      <li><strong>{{t 'pb.s6Li2B'}}</strong> {{t 'pb.s6Li2T'}}</li>
      <li><strong>{{t 'pb.s6Li3B'}}</strong> {{t 'pb.s6Li3T'}}</li>
      <li><strong>{{t 'pb.s6Li4B'}}</strong> {{t 'pb.s6Li4T'}}</li>
    </ul>
    <div class="callout"><b>{{t 'pb.s6CalloutB'}}</b> {{t 'pb.s6CalloutT'}}</div>
  </section>

  <section id="value">
    <div class="eyebrow">{{t 'pb.s7Eyebrow'}}</div>
    <h2>{{t 'pb.s7H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s7P1'}}</p>
    <div class="stats">
      <div class="stat"><div class="big">{{t 'pb.s7Stat1Big'}}</div><div class="lbl">{{t 'pb.s7Stat1Lbl'}}</div></div>
      <div class="stat"><div class="big">{{t 'pb.s7Stat2Big'}}</div><div class="lbl">{{t 'pb.s7Stat2Lbl'}}</div></div>
      <div class="stat"><div class="big">{{t 'pb.s7Stat3Big'}}</div><div class="lbl">{{t 'pb.s7Stat3Lbl'}}</div></div>
    </div>
    <p style="font-size:13.5px;color:var(--muted)">{{t 'pb.s7Note'}}</p>
    <h3>{{t 'pb.s7H3a'}}</h3>
    <table>
      <thead><tr><th>{{t 'pb.s7ThDim'}}</th><th>{{t 'pb.s7ThWas'}}</th><th>{{t 'pb.s7ThNow'}}</th></tr></thead>
      <tbody>
        <tr><td>{{t 'pb.s7R1D'}}</td><td class="was">{{t 'pb.s7R1W'}}</td><td class="now">{{t 'pb.s7R1N'}}</td></tr>
