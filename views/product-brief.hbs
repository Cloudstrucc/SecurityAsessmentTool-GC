  <section id="ai">
    <div class="eyebrow">{{t 'pb.s4Eyebrow'}}</div>
    <h2>{{t 'pb.s4H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s4P1'}}</p>
    <div class="grid3">
      <div class="card"><span class="num">01</span><b>{{t 'pb.s4C1B'}}</b><span>{{t 'pb.s4C1T'}}</span></div>
      <div class="card"><span class="num">02</span><b>{{t 'pb.s4C2B'}}</b><span>{{t 'pb.s4C2T'}}</span></div>
      <div class="card"><span class="num">03</span><b>{{t 'pb.s4C3B'}}</b><span>{{t 'pb.s4C3T'}}</span></div>
