          <text x="625" y="44" fill="#8fd0ee" font-size="13" font-weight="700" letter-spacing="2">WITH VANGUARD SA&amp;A — ONE RECORD</text>
          <g><path class="flow" d="M690 150 H 640" stroke="url(#g1)" stroke-width="2.2" fill="none"/><path class="flow" d="M690 200 H 640" stroke="url(#g1)" stroke-width="2.2" fill="none"/><path class="flow" d="M690 250 H 640" stroke="url(#g1)" stroke-width="2.2" fill="none"/></g>
          <g font-size="11.5" fill="#cfe0f2"><text x="600" y="154" text-anchor="end">Assessor</text><text x="600" y="204" text-anchor="end">Project team</text><text x="600" y="254" text-anchor="end">AI assistant</text></g>
          <rect x="690" y="120" width="150" height="160" rx="16" fill="url(#g1)"/>
          <text x="765" y="182" text-anchor="middle" fill="#0a1626" font-size="14" font-weight="800">Central</text><text x="765" y="202" text-anchor="middle" fill="#0a1626" font-size="14" font-weight="800">assessment</text><text x="765" y="222" text-anchor="middle" fill="#0a1626" font-size="14" font-weight="800">record</text>
