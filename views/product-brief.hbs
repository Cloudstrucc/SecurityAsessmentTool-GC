<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/inter-ui/4.0.2/inter.min.css">
<style>
  .pb-scope{
    --navy-950:#0a1626; --navy-900:#0d2136; --navy-800:#143453;
    --sky-300:#a9d8f2; --sky-400:#7cc4ee; --sky-500:#4d9fe0; --sky-600:#2f80cf;
    --peri-500:#6d7fca; --peri-400:#8593d6; --cyan-500:#4fc8dd;
    --ink:#17273a; --muted:#5f7185; --line:#dce7f2;
    --paper:#ffffff; --mist:#f4f9fd; --soft:#eaf5fd;
    --amber:#e0a53d; --rose:#d98089; --green:#57b894;
    --grad:linear-gradient(90deg,#6d7fca 0%,#4d9fe0 50%,#7cc9ee 100%);
    --grad-soft:linear-gradient(90deg,#8593d6 0%,#7cc4ee 100%);
    font-family:'Inter var',Inter,'Segoe UI',Roboto,Arial,sans-serif;
    color:var(--ink); background:var(--paper); font-size:17px; line-height:1.72; -webkit-font-smoothing:antialiased;
  }
  .pb-scope *{box-sizing:border-box}
  .pb-scope .cover{
    background:
      radial-gradient(820px 440px at 50% -6%, rgba(124,196,238,.24), transparent 62%),
      radial-gradient(680px 400px at 88% 108%, rgba(109,127,202,.18), transparent 60%),
      var(--navy-950);
    color:#fff; display:flex; flex-direction:column; justify-content:space-between;
    padding:60px 8vw 46px; text-align:center; position:relative; min-height:88vh;
  }
  .pb-scope .cover-inner{max-width:820px;margin:auto;display:flex;flex-direction:column;align-items:center}
  .pb-scope .cover-wordmark{position:absolute;top:20px;right:8vw;font-size:13px;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:#a9c0d8}
  .pb-scope .cover-product{
    margin-top:0;font-size:clamp(46px,8vw,96px);font-weight:800;letter-spacing:-.03em;line-height:1.12;padding-bottom:.06em;
    background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .pb-scope .cover-product-tag{margin-top:14px;font-size:13px;font-weight:600;letter-spacing:.30em;text-transform:uppercase;color:#cddbea}
  .pb-scope .cover-eyebrow{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--sky-400);margin:30px 0 22px}
  .pb-scope .cover h1{font-size:clamp(34px,5vw,58px);font-weight:700;line-height:1.08;letter-spacing:-.02em;color:#fff}
  .pb-scope .cover h1 .g{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .pb-scope .cover-sub{margin-top:26px;font-size:18.5px;color:#c2d2e3;max-width:660px;line-height:1.7;font-weight:400}
  .pb-scope .cover-rule{height:3px;width:130px;background:var(--grad);border-radius:2px;margin:34px auto 0}
  .pb-scope .cover-foot{display:flex;justify-content:space-between;align-items:flex-end;color:#8299b2;font-size:13.5px;gap:16px;flex-wrap:wrap;margin-top:40px}
  .pb-scope .cover-foot b{color:#cddbea;font-weight:600}
  .pb-scope main{max-width:780px;margin:0 auto;padding:74px 24px 40px}
  .pb-scope section{margin-bottom:70px}
  .pb-scope .eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--sky-600);margin-bottom:10px}
  .pb-scope h2{font-size:30px;font-weight:700;letter-spacing:-.015em;margin-bottom:16px;line-height:1.18;color:var(--ink)}
  .pb-scope h3{font-size:19px;font-weight:600;margin:28px 0 8px;color:var(--ink)}
  .pb-scope p{margin-bottom:15px;color:#2b3c52}
  .pb-scope p.lede{font-size:19.5px;line-height:1.75;color:var(--ink)}
  .pb-scope .rule{height:3px;width:64px;background:var(--grad);border-radius:2px;margin:0 0 24px}
  .pb-scope strong{font-weight:650;color:var(--ink)}
  .pb-scope ul.clean{list-style:none;margin:16px 0}
  .pb-scope ul.clean li{position:relative;padding-left:26px;margin-bottom:10px;color:#2b3c52}
  .pb-scope ul.clean li::before{content:"";position:absolute;left:0;top:10px;width:9px;height:9px;border-radius:50%;background:var(--grad)}
  .pb-scope .callout{background:var(--soft);border-left:3px solid var(--sky-500);border-radius:0 10px 10px 0;padding:18px 22px;margin:22px 0;color:#22354e;font-size:15.5px;line-height:1.66}
  .pb-scope .callout b{color:var(--navy-800)}
  .pb-scope .callout.warn{background:#fdf4ee;border-left-color:var(--amber)}
  .pb-scope .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:22px 0}
  .pb-scope .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:22px 0}
  .pb-scope .card{background:var(--mist);border:1px solid var(--line);border-radius:14px;padding:20px 22px}
  .pb-scope .card b{display:block;font-size:15.5px;margin-bottom:6px;color:var(--navy-800)}
  .pb-scope .card span{font-size:14px;color:var(--muted);line-height:1.55}
  .pb-scope .card .num{font-size:13px;font-weight:700;letter-spacing:.12em;color:var(--sky-600);display:block;margin-bottom:8px}
  @media(max-width:640px){.pb-scope .grid2,.pb-scope .grid3{grid-template-columns:1fr}}
  .pb-scope .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0}
  .pb-scope .stat{background:var(--navy-900);border-radius:14px;padding:22px 20px;color:#fff;text-align:center}
  .pb-scope .stat .big{font-size:34px;font-weight:750;line-height:1;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .pb-scope .stat .lbl{font-size:12.5px;color:#a9c0d8;margin-top:10px;line-height:1.5}
  @media(max-width:640px){.pb-scope .stats{grid-template-columns:1fr}}
  .pb-scope .diagram{margin:26px 0}
  .pb-scope .canvas{background:radial-gradient(760px 360px at 12% -6%,rgba(124,196,238,.18),transparent 60%),radial-gradient(700px 360px at 92% 106%,rgba(109,127,202,.16),transparent 60%),var(--navy-900);border:1px solid #163654;border-radius:20px;overflow:hidden;width:min(96vw,1060px);margin-left:50%;transform:translateX(-50%)}
  .pb-scope .canvas svg{display:block;width:100%;height:auto}
  .pb-scope text{font-family:Inter,'Segoe UI',Arial,sans-serif}
  .pb-scope .flow{stroke-dasharray:6 7;animation:pbflow 1.7s linear infinite}
  @keyframes pbflow{to{stroke-dashoffset:-13}}
  @media(prefers-reduced-motion:reduce),print{.pb-scope .flow{animation:none}}
  .pb-scope .diagram-caption{font-size:13px;color:var(--muted);text-align:center;padding:13px 16px 6px;line-height:1.55}
  .pb-scope .journey{border:1px solid var(--line);border-radius:16px;overflow:hidden;margin:22px 0}
  .pb-scope .journey-head{background:var(--soft);padding:14px 22px;font-weight:650;color:var(--navy-800);font-size:15.5px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
  .pb-scope .journey-head .pill{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--grad);padding:4px 10px;border-radius:999px}
  .pb-scope .steps{list-style:none;counter-reset:s;padding:8px 0}
  .pb-scope .steps li{counter-increment:s;position:relative;padding:12px 24px 12px 62px;border-bottom:1px solid #eef4fa}
  .pb-scope .steps li:last-child{border-bottom:none}
  .pb-scope .steps li::before{content:counter(s);position:absolute;left:22px;top:12px;width:26px;height:26px;border-radius:50%;background:var(--navy-900);color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center}
  .pb-scope .steps li b{color:var(--navy-800)}
  .pb-scope .steps li span{color:var(--muted);font-size:14.5px}
  .pb-scope table{width:100%;border-collapse:collapse;margin:20px 0;font-size:14.5px}
  .pb-scope th{text-align:left;font-weight:600;color:var(--navy-800);border-bottom:2px solid var(--navy-800);padding:9px 12px}
  .pb-scope td{border-bottom:1px solid var(--line);padding:9px 12px;color:#2b3c52;vertical-align:top}
  .pb-scope td.was{color:#9a5a34}
  .pb-scope td.now{color:#2b6b52}
  .pb-scope .pb-footer{border-top:1px solid var(--line);padding:30px 24px 54px;text-align:center;color:var(--muted);font-size:13px;max-width:780px;margin:0 auto}
  .pb-scope .print-btn{position:fixed;right:22px;bottom:22px;z-index:50;background:var(--navy-900);color:#fff;border:none;border-radius:999px;padding:13px 22px;font:600 14px Inter,'Segoe UI',sans-serif;cursor:pointer;box-shadow:0 12px 32px rgba(10,22,38,.30);display:flex;align-items:center;gap:8px}
  .pb-scope .print-btn:hover{background:var(--sky-600)}
  @media print{.vg-nav{display:none!important}.pb-scope .print-btn{display:none}.pb-scope .canvas{break-inside:avoid}.pb-scope section{break-inside:avoid}}
</style>

