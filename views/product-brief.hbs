      <div class="card"><span class="num">05</span><b>{{t 'pb.s4C5B'}}</b><span>{{t 'pb.s4C5T'}} <em>{{t 'pb.planned'}}</em></span></div>
      <div class="card"><span class="num">06</span><b>{{t 'pb.s4C6B'}}</b><span>{{t 'pb.s4C6T'}} <em>{{t 'pb.planned'}}</em></span></div>
    </div>
    <div class="callout"><b>{{t 'pb.s4CalloutB'}}</b> {{t 'pb.s4CalloutT'}}</div>
