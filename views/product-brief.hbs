  <section id="problem">
    <div class="eyebrow">{{t 'pb.s2Eyebrow'}}</div>
    <h2>{{t 'pb.s2H2'}}</h2>
    <div class="rule"></div>
    <p>{{t 'pb.s2P1'}}</p>
    <ul class="clean">
      <li><strong>{{t 'pb.s2Li1B'}}</strong> {{t 'pb.s2Li1T'}}</li>
      <li><strong>{{t 'pb.s2Li2B'}}</strong> {{t 'pb.s2Li2T'}}</li>
      <li><strong>{{t 'pb.s2Li3B'}}</strong> {{t 'pb.s2Li3T'}}</li>
      <li><strong>{{t 'pb.s2Li4B'}}</strong> {{t 'pb.s2Li4T'}}</li>
      <li><strong>{{t 'pb.s2Li5B'}}</strong> {{t 'pb.s2Li5T'}}</li>
    </ul>
    <p>{{t 'pb.s2P2'}}</p>
    <div class="diagram">
      <div class="canvas">
        <svg viewBox="0 0 1040 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{t 'pb.s2Caption'}}">
          <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6d7fca"/><stop offset="0.5" stop-color="#4d9fe0"/><stop offset="1" stop-color="#7cc9ee"/></linearGradient></defs>
