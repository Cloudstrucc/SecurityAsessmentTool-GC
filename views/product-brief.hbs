          <text x="120" y="197" fill="#f0d8de" font-size="12" text-anchor="middle" font-weight="600">Assessor</text>
          <text x="120" y="212" fill="#c9a7b0" font-size="10.5" text-anchor="middle">+ team</text>
          <g stroke="#7a5060" stroke-width="1.5" fill="none">
            <path d="M154 182 C 240 130, 300 120, 380 108"/><path d="M156 190 C 250 160, 300 156, 380 152"/><path d="M156 205 C 250 205, 300 205, 380 205"/><path d="M156 216 C 250 240, 300 252, 380 258"/><path d="M154 226 C 240 280, 300 296, 380 306"/>
          </g>
          <g font-size="12" fill="#e0c3cb">
            <g><rect x="380" y="92" width="150" height="32" rx="8" fill="#2c1a24" stroke="#5c3a48"/><text x="455" y="112" text-anchor="middle">control_v3_final.xlsx</text></g>
            <g><rect x="380" y="137" width="150" height="32" rx="8" fill="#2c1a24" stroke="#5c3a48"/><text x="455" y="157" text-anchor="middle">RE: RE: evidence?</text></g>
            <g><rect x="380" y="189" width="150" height="32" rx="8" fill="#2c1a24" stroke="#5c3a48"/><text x="455" y="209" text-anchor="middle">screenshots.zip</text></g>
            <g><rect x="380" y="242" width="150" height="32" rx="8" fill="#2c1a24" stroke="#5c3a48"/><text x="455" y="262" text-anchor="middle">\\fileshare\ATO</text></g>
            <g><rect x="380" y="290" width="150" height="32" rx="8" fill="#2c1a24" stroke="#5c3a48"/><text x="455" y="310" text-anchor="middle">report_draft.pdf</text></g>
          </g>
